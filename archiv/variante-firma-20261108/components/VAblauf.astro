---
// Zeitleiste „So läuft es ab“ (firma.de Punkt 8) + „Was Sie beitragen“ (Punkt 12) + Rechtshinweis.
import { ZEITLEISTE, BEITRAG, RECHT } from '../../config/variante';
interface Props { beitrag?: boolean; }
const { beitrag = true } = Astro.props;
---

<section class="section" id="ablauf" aria-labelledby="ablauf-h">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Ablauf</span>
      <h2 id="ablauf-h" class="rule">Von der Anfrage bis online</h2>
      <p class="lead">So läuft es in der Regel ab. Sie wissen bei jedem Schritt, was als Nächstes passiert.</p>
    </div>
    <ol class="vzeit">
      {ZEITLEISTE.map((z) => (
        <li><span class="vzeit__wann">{z.wann}</span><h3>{z.titel}</h3><p>{z.text}</p></li>
      ))}
    </ol>
  </div>
</section>

{beitrag && (
  <section class="section section--alt" id="beitrag" aria-labelledby="beitrag-h">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Ihr Teil</span>
        <h2 id="beitrag-h" class="rule">Was Sie beitragen</h2>
        <p class="lead">Den größten Teil übernehmen wir. Von Ihnen brauchen wir nur wenig.</p>
      </div>
      <ul class="vbeitrag">
        {BEITRAG.map((b) => <li class="card"><h3>{b.titel}</h3><p>{b.text}</p></li>)}
      </ul>
      <p class="v-hinweis">{RECHT}</p>
    </div>
  </section>
)}

<style>
  .vzeit { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-width: 820px; }
  .vzeit li { position: relative; padding: 0 0 28px 34px; border-left: 3px solid var(--accent); margin-left: 9px; }
  .vzeit li:last-child { padding-bottom: 0; border-left-color: transparent; }
  .vzeit li::before { content: ''; position: absolute; left: -11px; top: 2px; width: 19px; height: 19px; border-radius: 50%; background: var(--white); border: 3px solid var(--accent-ink); }
  .vzeit__wann { display: block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 4px; }
  .vzeit h3 { margin: 0 0 4px; font-size: 1.15rem; }
  .vzeit p { margin: 0; line-height: 1.7; color: var(--ink-soft); }
  .vbeitrag { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 720px) { .vbeitrag { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .vbeitrag { grid-template-columns: repeat(4, 1fr); } }
  .vbeitrag h3 { margin: 0 0 6px; font-size: 1.1rem; }
  .vbeitrag p { margin: 0; line-height: 1.7; color: var(--ink-soft); }
</style>
