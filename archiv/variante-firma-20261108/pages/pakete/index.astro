---
// VARIANTE „an firma.de orientiert“ – Pakete (Jamil #5016): drei feste Monatspakete, keine Einmalkosten,
// Preise von Jamil gesetzt (#5028–#5035, 08.11.2026), Kosten über 24 Monate je Paket. Leistungstausch statt Verhandlung.
// noindex, nicht in der Sitemap. /preise/ bleibt unverändert. Rechnung: docs/variante-firma/preise.md.
import VarianteLayout from '../../../components/variante/VarianteLayout.astro';
import VPaketKarte from '../../../components/variante/VPaketKarte.astro';
import VFaq from '../../../components/variante/VFaq.astro';
import VEinmalig from '../../../components/variante/VEinmalig.astro';
import Icon from '../../../components/Icon.astro';
import { href } from '../../../lib/paths';
import { formatEuro, SHOW_HINTS, PREIS_HINWEIS } from '../../../config/site';
import { IS_PREVIEW } from '../../../lib/env';
import { VPAKETE, GRUENDUNG, DAZU, AUF_ANFRAGE, TAUSCH, FAQ_PAKETE, NICHT_ENTHALTEN, RECHT, LAUFZEIT, vergleichZeilen, preis, gesamt } from '../../../config/variante';

const ab = Math.min(...VPAKETE.map(preis));
/** Vergleichstabelle: jede Leistung einmal; Haken, Text (z. B. Stufe der Suchmaschinen-Optimierung) oder „–“ je Paket */
const zeilen = vergleichZeilen();
const hinweise = SHOW_HINTS && IS_PREVIEW;
---

<VarianteLayout
  aktiv="pakete"
  title="Variante: Drei feste Pakete ohne Einmalkosten"
  description={`Variante zum Vergleich: Basis, Plus und Komplett ab ${formatEuro(ab)} im Monat netto. Logo, Google-Profil und Einrichtung inklusive, keine Einmalkosten.`}
>
  <section class="v-hero" aria-labelledby="v-h1">
    <div class="wrap">
      <span class="eyebrow">Pakete und Preise</span>
      <h1 id="v-h1">Drei feste Pakete. Keine Einmalkosten.</h1>
      <p class="lead">Alles, was einmalig Arbeit macht, wie Logo, Google-Profil oder die Suchmaschinen-Optimierung beim Erstellen, steckt schon im Monatspreis. Sie zahlen ab dem ersten Monat denselben festen Betrag.</p>
    </div>
  </section>

  <section class="section section--alt" id="pakete" aria-labelledby="pakete-h">
    <div class="wrap">
      <h2 class="sr-only" id="pakete-h">Die drei Pakete</h2>
      <div class="v-grid3">
        {VPAKETE.map((p) => <VPaketKarte paket={p} />)}
      </div>
      <p class="v-hinweis">{LAUFZEIT} Monate Mindestlaufzeit, danach monatlich kündbar. {PREIS_HINWEIS}</p>
      <p class="v-zusatz vpk__gr">Sie gründen gerade? Das <a href={href('/variante/gruender/')}>Gründungspaket für {formatEuro(preis(GRUENDUNG))} im Monat</a> enthält Logo, Google-Profil und Terminbuchung.</p>
      <VEinmalig />
    </div>
  </section>

  <section class="section" id="tausch" aria-labelledby="tausch-h">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Fair für alle</span>
        <h2 id="tausch-h" class="rule">{TAUSCH.titel}</h2>
      </div>
      <ol class="vtausch">
        {TAUSCH.regeln.map((r, i) => <li class="card"><span class="vtausch__n">{i + 1}</span><h3>{r.titel}</h3><p>{r.text}</p></li>)}
      </ol>
      <p class="vtausch__fair"><Icon name="check" size={20} /> {TAUSCH.fair}</p>
    </div>
  </section>

  <section class="section section--alt" id="vergleich" aria-labelledby="vgl-h">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Im Überblick</span>
        <h2 id="vgl-h" class="rule">Welches Paket passt?</h2>
        <p class="lead">Ein Haken heißt: im Paket inklusive. Wo sich der Umfang unterscheidet, steht er dabei.</p>
      </div>
      <div class="vpk__scroll" role="region" aria-label="Paketvergleich" tabindex="0">
        <table class="vpk">
          <thead><tr><th scope="col">Leistung</th>{VPAKETE.map((p) => <th scope="col">{p.name}<span>{formatEuro(preis(p))} netto / Monat</span></th>)}</tr></thead>
          <tbody>
            {zeilen.map((z) => <tr><th scope="row">{z.text}</th>{z.werte.map((x) => <td>{typeof x === 'string' ? <span class="vpk__wert">{x}</span> : x ? <><Icon name="check" size={18} /><span class="sr-only">enthalten</span></> : <span aria-label="nicht enthalten">–</span>}</td>)}</tr>)}
            <tr><th scope="row">Einmalkosten</th>{VPAKETE.map(() => <td>0 €</td>)}</tr>
            <tr class="vpk__summe"><th scope="row">Kosten über {LAUFZEIT} Monate (netto)</th>{VPAKETE.map((p) => <td>{formatEuro(gesamt(p))}</td>)}</tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="dazu" aria-labelledby="dazu-h">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Auf Wunsch</span>
        <h2 id="dazu-h" class="rule">Dazu buchen, ebenfalls monatlich</h2>
      </div>
      <div class="vdazu">
        {DAZU.map((d) => <div class="card"><h3>{d.name}</h3><p>{d.text}</p><p class="vdazu__preis"><b>{formatEuro(d.preis)}</b> netto / Monat</p></div>)}
        <div class="card"><h3>Auf Anfrage</h3><p>{AUF_ANFRAGE.join(', ')}. Dafür bekommen Sie ein individuelles Angebot.</p></div>
      </div>
      {hinweise && (
        <div class="card v-platzhalter vnicht">
          <span class="v-platzhalter__etikett">Platzhalter</span>
          <h3>Nicht im Preis enthalten</h3>
          <p>Beispiele, die Can und Jamil noch bestätigen: {NICHT_ENTHALTEN.join(', ')}.</p>
        </div>
      )}
      <p class="v-hinweis">{RECHT}</p>
    </div>
  </section>

  <VFaq fragen={FAQ_PAKETE} />

  <section class="section v-cta" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 id="cta-h">Unsicher, welches Paket passt?</h2>
      <p class="lead" style="margin-inline:auto">Im kostenlosen Erstgespräch empfehlen wir Ihnen das passende Paket, auch wenn es das kleinere ist.</p>
      <div class="v-knopfe"><a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch vereinbaren</a></div>
    </div>
  </section>
</VarianteLayout>

<style>
  .vpk__gr { text-align: center; }
  .vtausch { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 720px) { .vtausch { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .vtausch { grid-template-columns: repeat(4, 1fr); } }
  .vtausch li { display: flex; flex-direction: column; gap: 6px; }
  .vtausch h3, .vtausch p { margin: 0; }
  .vtausch p { line-height: 1.7; color: var(--ink-soft); }
  .vtausch__n { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); font-weight: 800; }
  .vtausch__fair { display: flex; gap: 10px; align-items: flex-start; max-width: 820px; margin: 24px 0 0; padding: 16px 20px; border-radius: 14px; background: #e9f6f5; font-weight: 600; line-height: 1.6; }
  .vtausch__fair :global(.icon) { flex: none; margin-top: 3px; color: var(--accent-ink); }
  .vpk__scroll { position: relative; overflow-x: auto; max-width: 980px; margin-inline: auto; border-radius: 16px; border: 1px solid var(--line); background: var(--white); }
  .vpk { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 0.92rem; }
  .vpk th, .vpk td { padding: 11px 12px; border-bottom: 1px solid var(--line); text-align: center; vertical-align: middle; }
  .vpk thead th { background: var(--dark); color: var(--white); font-family: var(--font-head); font-size: 1rem; }
  .vpk thead th span { display: block; font-family: var(--font-body); font-size: 0.78rem; font-weight: 500; }
  .vpk thead th:first-child, .vpk tbody th { text-align: left; font-weight: 600; }
  .vpk td :global(.icon) { color: var(--accent-ink); }
  .vpk__wert { display: inline-block; max-width: 16ch; font-size: 0.86rem; font-weight: 600; line-height: 1.4; color: var(--accent-ink); }
  .vpk tbody tr:nth-child(even) { background: #f7fbfb; }
  .vpk__summe th, .vpk__summe td { font-weight: 700; background: #e9f6f5 !important; border-bottom: 0; }
  .vdazu { display: grid; gap: 16px; }
  @media (min-width: 900px) { .vdazu { grid-template-columns: repeat(3, 1fr); } }
  .vdazu h3 { margin: 0 0 6px; font-size: 1.1rem; }
  .vdazu p { margin: 0; line-height: 1.7; color: var(--ink-soft); }
  .vdazu .vdazu__preis { margin-top: 10px; color: var(--ink); }
  .vdazu__preis b { font-family: var(--font-head); font-size: 1.4rem; }
  .vnicht { margin-top: 20px; }
  .vnicht h3 { margin: 0 0 6px; font-size: 1.1rem; }
  .vnicht p { margin: 0; line-height: 1.7; }
</style>
