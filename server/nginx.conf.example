# Waybuild – nginx-Beispiel (VPS, z. B. Hetzner Cloud). Inhalt von dist/ nach /var/www/waybuild legen.
server {
  listen 80;
  listen [::]:80;
  server_name waybuild.de www.waybuild.de;
  return 301 https://waybuild.de$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name waybuild.de;
  # ssl_certificate /etc/letsencrypt/live/waybuild.de/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/waybuild.de/privkey.pem;

  root /var/www/waybuild;
  index index.html;
  error_page 404 /404.html;

  gzip on;
  gzip_vary on;
  gzip_types text/css text/javascript application/javascript application/json application/xml image/svg+xml image/x-icon application/manifest+json text/plain text/xml;

  # Achtung nginx: ein add_header in einem location-Block ersetzt ALLE add_header von außen.
  # Deshalb stehen die Sicherheits-Header in jedem location-Block.

  # Dateien mit Hash im Namen: ein Jahr, unveränderlich
  location /_astro/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  }
  # Logos, Icons, Social-Bilder im Hauptordner: 30 Tage
  location ~* \.(?:png|jpg|jpeg|svg|ico|webp|avif|woff2)$ {
    add_header Cache-Control "public, max-age=2592000";
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  }
  # HTML, Sitemap, robots.txt: immer frisch prüfen
  location / {
    try_files $uri $uri/ =404;
    add_header Cache-Control "public, max-age=0, must-revalidate";
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  }
}
