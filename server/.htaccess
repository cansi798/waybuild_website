# Waybuild – Apache-Konfiguration (IONOS, Strato, all-inkl, Hetzner Webhosting …)
# Wird beim Live-Build automatisch nach dist/.htaccess kopiert.

# ---- HTTPS + ohne www erzwingen ----------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://waybuild.de%{REQUEST_URI} [L,R=301]

  # Ordner-URLs immer mit abschließendem Slash (passt zu den Canonicals)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

ErrorDocument 404 /404.html
Options -Indexes

# ---- Sicherheits-Header ------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Erst aktivieren, wenn HTTPS dauerhaft sicher läuft:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Caching: Dateien mit Hash im Namen (/_astro/) dürfen ewig gecacht werden -----
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Komprimierung -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/avif .avif
