---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { href } from '../../lib/paths';
import SnAbschluss from '../../components/startneu/SnAbschluss.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/start-neu.css';
import '../../styles/seite-wissen.css';
// Neues Aussehen im Stil der Startseite (Jamil Talk qh87y3sj #5892, 14.11.2026): ruhiges Karten-Raster, Abschluss wie auf der
// Startseite. Stil: src/styles/seite-wissen.css (.swi-).

const artikel = (await getCollection('ratgeber')).sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime());
---

<BaseLayout
  title="Ratgeber: Website, Kosten & Technik"
  description="Ratgeber für Unternehmen: was eine Website kostet, mieten oder kaufen, individuelle Software, Nextcloud statt Microsoft 365 und IT-Wartungsverträge."
  breadcrumb={[{ name: 'Ratgeber', path: '/ratgeber/' }]}
>
  <PageHeader eyebrow="Ratgeber" title="Kurz erklärt." lead="Das Wichtigste zu Websites, Software, Cloud und IT, in wenigen Minuten gelesen." />
  <section class="section sn swi swi--papier" aria-label="Alle Ratgeber">
    <div class="wrap">
      <ul class="swi-raster swi-raster--artikel">
        {artikel.map((a, i) => (
          <li>
            <a class="swi-artikel" href={href(`/ratgeber/${a.id}/`)}>
              <span class="swi-karte__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="sn-h4">{a.data.title}</h2>
              <p>{a.data.kurz[0]}</p>
              <span class="swi-artikel__mehr">Lesen <Icon name="arrow" size={18} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SnAbschluss />
</BaseLayout>

