---
// Preis-Seite (Jamil, Talk qh87y3sj #5056, 08.11.2026 „ok go“): die Pakete Basis · Plus sind die richtige Website,
// optional dazu das Komplettpaket (Auftragsverwaltung, #5450–#5464). Daten AUSSCHLIESSLICH aus src/config/pakete-abo.ts (Preise nie fest in Texte schreiben).
// SEIT 14.11.2026 im Stil der neuen Startseite (Jamil Talk qh87y3sj #5892): Pakete, Komplettpaket und „Einmalig dazu“ über die
// Startseiten-Komponente SnAngebot (gleiche Optik, gleiches Buchungsfenster), danach Vergleich der Pakete · So starten Sie ·
// Ausbaustufen · Hinweise · SnAbschluss. Stil: start-neu.css + src/styles/seite-preise.css (Präfix .spr-).
// Die sechs Fragen und der Link „Alle Preise“ aus SnAngebot sind hier ausgeblendet (Paket-FAQ nur auf /fragen/, Jamil #5140–#5142).
// Sprungmarken: #preise, #websites (vor den Paketen), #pakete, #pk-basis, #pk-plus, #komplettpaket, #einmalig, #baukasten (SnAngebot),
// #vergleich, #start, #stundensaetze, #software, #cloud, #beratung – alle erhalten.
// SnVergleich (Anbieter-Vergleich der Startseite) bewusst NICHT eingebunden: es trägt ebenfalls id="vergleich" (doppelte ID).
// Vorher (Fundament/Wegweiser/Wahrzeichen aus site.ts PAKETE): Sicherung Branch vor-pakete-live-20261108.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import SnAngebot from '../components/startneu/SnAngebot.astro';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import { SHOW_HINTS } from '../config/site';
import { IS_PREVIEW } from '../lib/env';
import { SAEULEN } from '../config/angebot';
import { leistungenNach } from '../config/leistungen';
import { serviceSchema } from '../lib/schema';
import { href } from '../lib/paths';
import {
  ABO_PAKETE, KOMPLETTPAKET, euro, jahresPreis, jahresBrutto, aboPreisAb, komplettPreis, vergleichsZeilen, LAUFZEIT_MONATE, B2B_HINWEIS,
  AUF_ANFRAGE, NICHT_ENTHALTEN, RECHT,
} from '../config/pakete-abo';
import '../styles/start-neu.css';
import '../styles/seite-preise.css';

const ausbau = SAEULEN.filter((s) => s.id !== 'websites');
const zeilen = vergleichsZeilen();
const hinweise = SHOW_HINTS && IS_PREVIEW;

/** Für beide Pakete gleich (aus der Leistung „Website“ und den bisherigen Paketinhalten). */
const GLEICH: { t: string; w: string | true }[] = [
  { t: 'Einrichtung', w: '0 €' },
  { t: 'Mobilfreundlich für Handy, Tablet und PC', w: true },
  { t: 'Texte mit Ihnen erarbeitet', w: true },
  { t: 'Impressum und Datenschutzerklärung nach aktuellem Stand', w: true },
  { t: 'Hosting in Deutschland, SSL, Updates, Sicherungen', w: true },
  { t: 'Änderungen per Nachricht, im fairen Rahmen', w: true },
];

const START = [
  { t: 'Erstgespräch', x: 'Kostenlos und unverbindlich. Wir lernen Ihr Unternehmen kennen und empfehlen das passende Paket.' },
  { t: 'Entwurf und Freigabe', x: 'Wir schreiben die Texte mit Ihnen und setzen die Website KI-gestützt um. Sie prüfen und geben frei.' },
  { t: 'Live und betreut', x: 'Ihre Website geht online. Danach pflegen wir sie, und Änderungen schicken Sie einfach per Nachricht.' },
];

const preiseText = ABO_PAKETE.map((p) => `${p.name} ${euro(p.preis)}`).join(', ');
const komplettText = `Optional dazu: ${KOMPLETTPAKET.name} mit Auftragsverwaltung, nur ${komplettPreis()}.`;
---

<BaseLayout
  title={`Preise: Website-Abo ab ${euro(aboPreisAb())} im Monat`}
  description={`${preiseText} im Monat netto, keine Einrichtungskosten, keine Seitenbegrenzung. Optional dazu: ${KOMPLETTPAKET.name} ${komplettPreis()}.`}
  schema={[serviceSchema(Astro.site)]}
  breadcrumb={[{ name: 'Preise', path: '/preise/' }]}
>
  <PageHeader eyebrow="Preise" title="Zwei Pakete. Fester Monatspreis." lead={`${preiseText} im Monat, netto zzgl. MwSt. Keine Einrichtungskosten, keine Seitenbegrenzung, keine versteckten Kosten. ${komplettText}`} />

  <!-- alte Sprungmarken, direkt vor den Paketen -->
  <span id="preise" class="spr-anker" aria-hidden="true"></span>
  <span id="websites" class="spr-anker" aria-hidden="true"></span>

  <!-- Pakete · Komplettpaket · Einmalig dazu · Sicherheit (Hintergrund Sand), Anker #pakete -->
  <SnAngebot />

  <!-- Hintergründe: Pakete Sand → Vergleich Weiß → Start Papier → Ausbaustufen Weiß → Abschluss Hauch -->
  <section class="section sn spr-vgl" id="vergleich" aria-labelledby="spr-vgl-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--mitte">
        <p class="sn-kenn">Im Überblick</p>
        <h2 id="spr-vgl-h" class="sn-h2">Welches Paket passt?</h2>
        <p class="sn-lead">Ein Haken heißt: im Paket inklusive. Wo sich der Umfang unterscheidet, steht er dabei.</p>
      </div>
      <div class="spr-vgl__tafel" role="region" aria-label="Paketvergleich" tabindex="0">
        <table class="spr-vgl__tabelle">
          <caption class="sr-only">Vergleich der Pakete {ABO_PAKETE.map((p) => p.name).join(' und ')}</caption>
          <thead>
            <tr><th scope="col">Leistung</th>{ABO_PAKETE.map((p) => <th scope="col" class:list={{ 'spr-vgl__tipp': p.empfohlen }}>{p.name}<span>{euro(p.preis)} netto / Monat</span></th>)}</tr>
          </thead>
          <tbody>
            {zeilen.map((z) => (
              <tr><th scope="row">{z.text}</th>{z.werte.map((x) => <td>{typeof x === 'string' ? <span class="spr-vgl__wert">{x}</span> : x ? <><span class="spr-vgl__ja" aria-hidden="true"><Icon name="check" size={16} /></span><span class="sr-only">enthalten</span></> : <><span class="spr-vgl__nein" aria-hidden="true">–</span><span class="sr-only">nicht enthalten</span></>}</td>)}</tr>
            ))}
            {GLEICH.map((g) => (
              <tr><th scope="row">{g.t}</th>{ABO_PAKETE.map(() => <td>{g.w === true ? <><span class="spr-vgl__ja" aria-hidden="true"><Icon name="check" size={16} /></span><span class="sr-only">enthalten</span></> : <span class="spr-vgl__wert">{g.w}</span>}</td>)}</tr>
            ))}
            <tr><th scope="row">Mindestlaufzeit</th>{ABO_PAKETE.map(() => <td>{LAUFZEIT_MONATE} Monate</td>)}</tr>
            <tr class="spr-vgl__summe"><th scope="row">Kosten pro Jahr (netto)</th>{ABO_PAKETE.map((p) => <td>{euro(jahresPreis(p.preis))}<span>{euro(jahresBrutto(p.preis))} brutto</span></td>)}</tr>
          </tbody>
        </table>
      </div>
      <p class="sn-fein sn-fein--mitte">{LAUFZEIT_MONATE} Monate Mindestlaufzeit. Danach ist das Abo monatlich kündbar, mit einem Monat Frist zum Monatsende. {B2B_HINWEIS}</p>
    </div>
  </section>

  <section class="section sn spr-start" id="start" aria-labelledby="spr-start-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div class="spr-kopf__titel">
          <p class="sn-kenn">So starten Sie</p>
          <h2 id="spr-start-h" class="sn-h2">In drei Schritten online.</h2>
        </div>
        <!-- von uns ergänzt (#5892) -->
        <p class="sn-lead">Vom ersten Gespräch bis zur fertigen Website begleiten wir Sie persönlich.</p>
      </div>
      <ol class="spr-schritte">
        {START.map((st, i) => (
          <li class="spr-schritt">
            <span class="spr-schritt__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="sn-h4">{st.t}</h3>
            <p>{st.x}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section sn spr-ausbau" id="stundensaetze" aria-labelledby="spr-ausbau-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div class="spr-kopf__titel">
          <p class="sn-kenn">Mehr als eine Website?</p>
          <h2 id="spr-ausbau-h" class="sn-h2">Ausbaustufen auf Anfrage</h2>
        </div>
        <p class="sn-lead">{`Die Website ist der erste Schritt. Für größere Vorhaben, zum Beispiel ${AUF_ANFRAGE.slice(0, 2).join(' oder ')}, erstellen wir ein individuelles Angebot.`}</p>
      </div>
      <ul class="spr-stufen">
        {ausbau.map((s) => (
          <li id={s.id} class="spr-stufe">
            <p class="spr-stufe__tag">Individuelles Angebot</p>
            <h3 class="sn-h3">{s.title}</h3>
            <p class="spr-stufe__text">{s.claim}</p>
            <ul class="spr-stufe__liste">
              {/* Titel ohne Link: die alten Leistungsseiten sind gelöscht (Jamil, Talk qh87y3sj #5322) */}
              {leistungenNach(s.id).filter((l) => l.slug !== 'abo-wartung').map((l) => <li><span class="sn-punkt" aria-hidden="true"></span><span>{l.title}</span></li>)}
            </ul>
          </li>
        ))}
      </ul>
      {hinweise && (
        <div class="spr-nicht">
          <span class="spr-nicht__etikett">Platzhalter</span>
          <h3 class="sn-h4">Nicht im Preis enthalten</h3>
          <p>Beispiele, die Can und Jamil noch bestätigen: {NICHT_ENTHALTEN.join(', ')}.</p>
        </div>
      )}
      <p class="sn-fein">{RECHT}</p>
      <p class="sn-fein spr-b2b">{B2B_HINWEIS}</p>
    </div>
  </section>

  <!-- Paket-FAQ: alle Fragen auf /fragen/ (Jamil #5140–#5142). Alter Abschluss „Unsicher, welches Paket passt?“ durch SnAbschluss ersetzt (#5892). -->
  <SnAbschluss />
</BaseLayout>
