---
// Preis-Seite nach der Unternehmensvision (17.10.2026): EIN Angebot, EIN Preis – keine Pakete, keine Tarife.
// Der Monatspreis kommt aus config/site.ts → WAAS.preisMonat (null = „im Erstgespräch“ + Fehlt-Hinweis in der Vorschau).
// Sprungmarken #websites, #software, #cloud, #beratung, #stundensaetze wurden früher verlinkt – sie bleiben erhalten.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Inklusive from '../components/Inklusive.astro';
import Icon from '../components/Icon.astro';
import Hint from '../components/Hint.astro';
import Faq from '../components/Faq.astro';
import { WAAS, MODELL, preisKurz } from '../config/site';
import { SAEULEN, NETTO_HINWEIS } from '../config/angebot';
import { leistungenNach } from '../config/leistungen';
import { faqSchema, serviceSchema } from '../lib/schema';
import { href } from '../lib/paths';

const ausbau = SAEULEN.filter((s) => s.id !== 'websites');
---

<BaseLayout
  title="Preis: ein Angebot, ein fester Monatspreis"
  description={`${WAAS.name}: ein fester Monatspreis, keine Einrichtungskosten, ${WAAS.laufzeitMonate} Monate Laufzeit. Website, Hosting, Wartung, Backups und Betreuung inklusive.`}
  schema={[serviceSchema(Astro.site), faqSchema()]}
  breadcrumb={[{ name: 'Preise', path: '/preise/' }]}
>
  <PageHeader eyebrow="Preis" title="Ein Preis. Alles drin." lead="Keine Pakete, keine Tarife, keine Einrichtungskosten." />

  <section class="section" id="websites" aria-labelledby="angebot-h">
    <div class="wrap offer">
      <article class="offer__card">
        <span class="eyebrow">Das Angebot</span>
        <h2 id="angebot-h">{WAAS.name}</h2>
        <p class="offer__preis"><b>{preisKurz()}</b>{WAAS.preisMonat && <span> netto</span>}</p>
        {!WAAS.preisMonat && <p class="offer__hinweis">Den Preis nennen wir Ihnen im kostenlosen Erstgespräch.</p>}
        {!WAAS.preisMonat && <Hint block label="Monatspreis für Website as a Service festlegen" where="src/config/site.ts → WAAS.preisMonat" />}
        <ul class="offer__modell">
          {MODELL.map((m) => <li><Icon name="check" size={18} /> {m}</li>)}
        </ul>
        <a class="btn btn--primary btn--lg offer__btn" href={href('/kontakt/')}>Kostenloses Erstgespräch</a>
        <p class="offer__netto">{NETTO_HINWEIS}</p>
      </article>
      <div>
        <SectionHead eyebrow="Enthalten" pre="Alles in " accent="einem Preis" text={WAAS.claim} />
        <Inklusive narrow />
      </div>
    </div>
  </section>

  <section class="section section--sand" id="stundensaetze" aria-labelledby="ausbau-h">
    <div class="wrap">
      <SectionHead eyebrow="Mehr als eine Website?" pre="Ausbaustufen auf " accent="Anfrage" text="Die Website ist der erste Schritt. Software, Cloud & IT und Beratung bieten wir individuell an." id="ausbau-h" />
      <ul class="ausbau">
        {ausbau.map((s) => (
          <li id={s.id} class="card ausbau__card">
            <span class="ausbau__icon"><Icon name={s.icon} size={22} /></span>
            <h3>{s.title}</h3>
            <p>{s.claim}</p>
            <ul class="ausbau__links">
              {leistungenNach(s.id).filter((l) => l.slug !== 'abo-wartung').map((l) => <li><a href={href(`/leistungen/${l.slug}/`)}>{l.title}</a></li>)}
            </ul>
            <span class="ausbau__tag">Individuelles Angebot</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq />
</BaseLayout>

<style>
  .offer { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 960px) { .offer { grid-template-columns: 0.85fr 1.15fr; gap: 56px; } }
  .offer :global(.section-head) { margin-bottom: 20px; }
  .offer__card {
    position: relative; overflow: hidden; display: grid; gap: 10px; justify-items: start;
    background: var(--dark); color: var(--paper); border-radius: 22px; padding: clamp(24px, 4vw, 36px);
    box-shadow: 0 24px 48px -20px rgb(0 79 76 / 45%);
  }
  .offer__card::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.5;
    background-image: radial-gradient(circle, rgb(0 166 161 / 0.3) 1.1px, transparent 1.6px); background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 90% 0%, #000 10%, transparent 60%);
  }
  .offer__card > * { position: relative; margin: 0; }
  .offer__card .eyebrow { color: var(--accent); }
  .offer__card h2 { color: var(--white); font-size: clamp(1.7rem, 3.4vw, 2.3rem); }
  .offer__preis { font-size: 0.95rem; color: var(--dark-soft); }
  .offer__preis b { font-family: var(--font-head); font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--accent); letter-spacing: -0.02em; }
  .offer__hinweis { color: var(--dark-lead); }
  .offer__modell { list-style: none; padding: 14px 0; display: grid; gap: 8px; width: 100%; border-block: 1px solid var(--dark-line); }
  .offer__modell li { display: flex; gap: 10px; align-items: center; font-weight: 600; }
  .offer__modell :global(.icon) { color: var(--accent); flex: none; }
  .offer__btn { margin-top: 6px !important; }
  @media (max-width: 599px) { .offer__btn { width: 100%; } }
  .offer__netto { font-size: 0.8rem; color: var(--dark-soft); }

  .ausbau { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 900px) { .ausbau { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .ausbau__card { display: flex; flex-direction: column; gap: 8px; border-radius: 18px; scroll-margin-top: 90px; }
  .ausbau__card h3, .ausbau__card p { margin: 0; }
  .ausbau__card p { color: var(--ink-soft); font-size: 0.95rem; }
  .ausbau__icon { width: 44px; height: 44px; border-radius: 12px; background: var(--dark); color: var(--accent); display: inline-grid; place-items: center; }
  .ausbau__links { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 0.92rem; }
  .ausbau__links a { font-weight: 650; color: var(--accent-ink); text-underline-offset: 3px; }
  .ausbau__tag { margin-top: auto; padding-top: 8px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
</style>
