---
// ENTWURF: Drei Abo-Pakete 2027 (Can, Talk qh87y3sj 4499–4501, 04.11.2026). Nicht verlinkt, noindex.
// Erst nach „Go“ von Can und Jamil übernehmen (dann PAKETE in config/site.ts ersetzen).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { PAKETE_2027, IN_ALLEN_2027, ABHEBEN_2027, EINFUEHRUNG, LAUFZEIT_2027, netto, euro2 } from '../config/pakete2027';
---

<BaseLayout
  title="Pakete 2027 (Entwurf)"
  description="Entwurf der drei Website-Abo-Pakete Auftritt, Wachstum und Marke von waybuild. Interne Vorschau, noch nicht freigegeben."
  noindex
  breadcrumb={[{ name: 'Pakete 2027', path: '/pakete-2027/' }]}
>
  <PageHeader eyebrow="Entwurf · nicht freigegeben" title="Drei Pakete. Alles aus einer Hand." lead="Website, E-Mail-Signatur, Briefvorlage und Logo: passend zueinander, zum festen Monatspreis und ohne Einrichtungskosten." />

  <section class="section section--alt p3" id="pakete" aria-labelledby="p3-h">
    <div class="wrap">
      <h2 class="sr-only" id="p3-h">Die drei Pakete</h2>
      <div class="p3__grid">
        {PAKETE_2027.map((p) => (
          <article class:list={['p3k', { 'p3k--top': p.empfohlen }]} aria-labelledby={`p3-${p.id}`}>
            {p.empfohlen && <span class="p3k__badge">Empfehlung</span>}
            <h3 id={`p3-${p.id}`}>{p.name}</h3>
            <p class="p3k__kurz">{p.kurz}</p>
            <p class="p3k__preis"><b>{euro2(p.brutto)}</b> <span>/ Monat inkl. MwSt.<br />{euro2(netto(p.brutto))} netto</span></p>
            {p.id === EINFUEHRUNG.paket && (
              <p class="p3k__aktion"><Icon name="spark" size={16} /> Erste {EINFUEHRUNG.kunden} Kunden: {euro2(EINFUEHRUNG.brutto)} / Monat</p>
            )}
            <p class="p3k__fuer">{p.fuer}</p>
            <ul class="p3k__extras">{p.extras.map((e) => <li><Icon name="doc" size={16} /> {e}</li>)}</ul>
            <ul class="p3k__liste">{p.features.map((f) => <li><Icon name="check" size={18} /> {f}</li>)}</ul>
            <a class:list={['btn btn--lg p3k__btn', p.empfohlen ? 'btn--primary' : 'btn--dark']} href={`${href('/kontakt/')}?paket=${encodeURIComponent(`${p.name} (${euro2(p.brutto)} / Monat)`)}`}>Erstgespräch vereinbaren<span class="sr-only">: {p.name}</span></a>
          </article>
        ))}
      </div>
      <p class="p3__hinweis">0 € Einrichtung · {LAUFZEIT_2027} · Kleine Änderungen per Nachricht inklusive, größere Umbauten nach Absprache.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="p3-inkl-h">
    <div class="wrap">
      <SectionHead center eyebrow="In allen Paketen" pre="Immer " accent="dabei." id="p3-inkl-h" />
      <ul class="check-row p3__inkl">{IN_ALLEN_2027.map((m) => <li><Icon name="check" size={18} /> {m}</li>)}</ul>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="p3-ab-h">
    <div class="wrap">
      <SectionHead center eyebrow="Im Vergleich" pre="Was uns " accent="abhebt." id="p3-ab-h" />
      <ul class="p3__ab">
        {ABHEBEN_2027.map((a) => <li class="card"><h3>{a.titel}</h3><p>{a.text}</p></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .p3__grid { display: grid; gap: 18px; max-width: 1180px; margin-inline: auto; }
  @media (min-width: 980px) { .p3__grid { grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; } }
  .p3k { position: relative; display: flex; flex-direction: column; gap: 10px; background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(22px, 3vw, 30px); }
  .p3k > * { margin: 0; }
  .p3k--top { background: var(--dark); color: var(--paper); border-color: var(--dark); box-shadow: 0 24px 48px -20px rgb(0 79 76 / 45%); }
  .p3k h3 { font-size: clamp(1.4rem, 2.4vw, 1.65rem); }
  .p3k--top h3 { color: var(--white); }
  .p3k__badge { align-self: flex-start; padding: 4px 12px; border-radius: 99px; background: var(--accent); color: var(--dark); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .p3k__kurz { font-weight: 600; color: var(--accent-ink); }
  .p3k--top .p3k__kurz { color: var(--accent); }
  .p3k__preis { display: flex; align-items: center; gap: 10px; padding-block: 6px; flex-wrap: wrap; }
  .p3k__preis b { font-family: var(--font-head); font-size: clamp(2.1rem, 4vw, 2.6rem); line-height: 1; letter-spacing: -0.02em; color: var(--ink); }
  .p3k--top .p3k__preis b { color: var(--white); }
  .p3k__preis span { font-size: 0.85rem; line-height: 1.35; color: var(--ink-soft); }
  .p3k--top .p3k__preis span, .p3k--top .p3k__fuer { color: var(--dark-lead); }
  .p3k__aktion { align-self: flex-start; padding: 6px 12px; border-radius: 10px; background: #e3f6f5; color: var(--accent-ink); font-size: 0.88rem; font-weight: 650; }
  .p3k__aktion :global(.icon) { vertical-align: -3px; }
  .p3k__fuer { font-size: 0.95rem; color: var(--ink-soft); }
  .p3k__extras { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .p3k__extras li { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 99px; border: 1px solid var(--accent); color: var(--accent-ink); font-size: 0.82rem; font-weight: 650; }
  .p3k--top .p3k__extras li { color: var(--accent); }
  .p3k__liste { list-style: none; padding: 14px 0 6px; display: grid; gap: 9px; border-top: 1px solid var(--line); }
  .p3k--top .p3k__liste { border-color: var(--dark-line); }
  .p3k__liste li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.95rem; line-height: 1.45; }
  .p3k__liste :global(.icon) { flex: none; margin-top: 2px; color: var(--accent-ink); }
  .p3k--top .p3k__liste :global(.icon) { color: var(--accent); }
  .p3k__btn { margin-top: auto !important; width: 100%; text-align: center; }
  .p3__hinweis { max-width: 1180px; margin: 22px auto 0; text-align: center; font-size: 0.9rem; color: var(--ink-soft); line-height: 1.6; }
  .p3__inkl { justify-content: center; max-width: 900px; margin-inline: auto; }
  .p3__ab { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) { .p3__ab { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .p3__ab { grid-template-columns: repeat(4, 1fr); } }
  .p3__ab h3 { margin: 0 0 6px; font-size: 1.1rem; }
  .p3__ab p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; }
</style>
