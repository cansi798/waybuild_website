---
// /ueber-uns/ im Stil der neuen Startseite (Jamil, Talk qh87y3sj #5892, 14.11.2026). Inhalte erhalten (Mission, Werte, Fakten),
// Optik wie src/components/startneu/. Abschnitte: Mission (Weiß) → Team (Papier) → Werte (Weiß) → Arbeitsweise (Papier) → SnAbschluss (Hauch).
// Team: TEAM aus config/startseite.ts (Can „Chief Executive Officer“, Jamil „Chief Operating Officer“). Fotos + Test-Zitate NUR unter
// derselben Bedingung wie SnTeam.astro (SHOW_HINTS && IS_PREVIEW, #5636/#5637); sonst nur Name und Rolle mit Initialen.
// Zitate NICHT in strukturierte Daten übernehmen. Stil: styles/seite-ueber.css (.su-).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Hint from '../components/Hint.astro';
import Bild from '../components/Bild.astro';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import { TEAM } from '../config/startseite';
import { IS_PREVIEW } from '../lib/env';
import { SHOW_HINTS } from '../config/site';
import '../styles/start-neu.css';
import '../styles/seite-ueber.css';

const TEAM_ZEIGEN = SHOW_HINTS && IS_PREVIEW; // gleiche Bedingung wie SnTeam.astro
const initialen = (n: string) => n.split(/\s+/).map((t) => t[0]).join('').slice(0, 2).toUpperCase();

const values = [
  { title: 'Menschlich', text: 'Strategie, Erfahrung und Verständnis für Ihr Geschäft.' },
  { title: 'Schnell', text: 'KI beschleunigt die Umsetzung.' },
  { title: 'Transparent', text: 'Fester Monatspreis, keine versteckten Kosten.' },
  { title: 'Langfristig', text: 'Wir entwickeln Ihre Website laufend weiter. Kunden sollen bleiben, weil es passt.' },
];

// von uns ergänzt (#5892): Arbeitsweise in drei Schritten, Wortlaut aus den bisherigen Texten dieser Seite und /warum-waybuild/
const arbeitsweise = [
  { title: 'Menschliche Beratung', text: 'Gemeinsam mit Ihnen entwickeln wir Zielgruppen, Positionierung und Customer Journey.' },
  { title: 'KI-gestützte Umsetzung', text: 'Danach setzt unsere KI die Ergebnisse schnell um.' },
  { title: 'Kontinuierliche Verbesserung', text: 'Wir entwickeln Ihre Website laufend weiter, auch nach dem Livegang.' },
];
const nr = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  title="Über uns: wer hinter waybuild steht"
  description="waybuild verbindet menschliche Beratung mit KI-gestützter Umsetzung: digitale Unternehmensplattformen für kleine und mittlere Unternehmen."
  breadcrumb={[{ name: 'Über uns', path: '/ueber-uns/' }]}
>
  <PageHeader
    eyebrow="Über uns"
    title={"Wir bauen digitale Unternehmens­plattformen."}
    lead="Für kleine und mittlere Unternehmen, ohne technische Hürden, lange Projekte oder hohe Einmalinvestitionen."
  />

  <!-- 1 · Mission (Weiß) -->
  <section class="section sn su-mission" aria-labelledby="mission-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div>
          <p class="sn-kenn">Unsere Mission</p>
          <h2 id="mission-h" class="sn-h2 sn-h2--klein">Viele Unternehmen wissen, dass es KI gibt, aber nicht, wie daraus eine Website wird, die Kunden bringt. <span class="su-akzent">Dabei helfen wir.</span></h2>
        </div>
        <div class="su-mission__text">
          <p class="sn-lead">Wir kombinieren menschliche Beratung mit der Geschwindigkeit moderner KI-Systeme.</p>
          <p>Wir wollen kleinen und mittleren Unternehmen helfen, professioneller aufzutreten, effizienter zu arbeiten und langfristig zu wachsen. Die Website ist dabei nur der erste Schritt.</p>
        </div>
      </div>
      <Hint block label="Persönliche Gründungsgeschichte" where="src/pages/ueber-uns.astro">
        Ein, zwei Sätze in eigenen Worten: Wer seid ihr, woher kommt ihr, warum macht ihr das? Das wirkt stärker als jeder Werbetext.
      </Hint>
    </div>
  </section>

  <!-- 2 · Team (Papier) -->
  <section class="section sn su-team" id="team" aria-labelledby="su-team-h">
    <div class="wrap">
      <div class="sn-kopf">
        <p class="sn-kenn">Team</p>
        <h2 id="su-team-h" class="sn-h2">{TEAM.titel}</h2>
        <p class="sn-lead">{TEAM.einleitung}</p>
      </div>
      <ul class="su-personen">
        {TEAM.personen.map((m) => (
          <li class="su-person">
            <div class="su-person__foto">
              {TEAM_ZEIGEN
                ? <Bild name={m.foto} alt={m.alt} widths={[180, 360]} sizes="120px" class="su-person__bild" />
                : <span class="su-person__initialen" aria-hidden="true">{initialen(m.name)}</span>}
            </div>
            <div class="su-person__text">
              <h3 class="sn-h3">{m.name}</h3>
              <p class="su-person__rolle">{m.rolle}</p>
              {TEAM_ZEIGEN && <blockquote class="su-person__zitat"><p>„{m.zitat}“</p></blockquote>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · Werte (Weiß): große Typografie, Nummern, feine Linien -->
  <section class="section sn su-werte" aria-labelledby="werte-h">
    <div class="wrap">
      <div class="sn-kopf">
        <p class="sn-kenn">Unsere Werte</p>
        <h2 id="werte-h" class="sn-h2">Wofür wir stehen.</h2>
      </div>
      <ul class="su-werte__liste">
        {values.map((v, i) => (
          <li class="su-wert reveal">
            <span class="su-nr" aria-hidden="true">{nr(i)}</span>
            <h3 class="su-wert__titel">{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · Arbeitsweise (Papier), von uns ergänzt (#5892) -->
  <section class="section sn su-weise" aria-labelledby="weise-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div>
          <p class="sn-kenn">Wie wir arbeiten</p>
          <h2 id="weise-h" class="sn-h2">Erst verstehen, dann bauen.</h2>
        </div>
        <p class="sn-lead">Die Ideen entwickeln wir mit Ihnen. Die KI beschleunigt nur die Umsetzung.</p>
      </div>
      <ol class="su-weise__liste">
        {arbeitsweise.map((a, i) => (
          <li class="su-schritt reveal">
            <span class="su-nr" aria-hidden="true">{nr(i)}</span>
            <h3 class="sn-h4">{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <SnAbschluss />
</BaseLayout>
