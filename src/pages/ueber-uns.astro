---
// /ueber-uns/ im Stil der neuen Startseite (Jamil, Talk qh87y3sj #5892, 14.11.2026). Inhalte erhalten (Mission, Werte, Fakten),
// Optik wie src/components/startneu/. Abschnitte: Mission + Gründung + Fakten (Weiß) → Team (Papier) → Werte (Weiß) → So arbeiten wir (SnAblauf lang) → SnAbschluss (Hauch).
// Team: TEAM aus config/startseite.ts (Can „Chief Executive Officer“, Jamil „Chief Operating Officer“). Fotos + Test-Zitate NUR unter
// derselben Bedingung wie SnTeam.astro (SHOW_HINTS && IS_PREVIEW, #5636/#5637); sonst nur Name und Rolle mit Initialen.
// Zitate NICHT in strukturierte Daten übernehmen. Stil: styles/seite-ueber.css (.su-).
import { hl } from '../lib/hl';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Hint from '../components/Hint.astro';
import Bild from '../components/Bild.astro';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import SnAblauf from '../components/startneu/SnAblauf.astro';
import { TEAM } from '../config/startseite';
import { IS_PREVIEW } from '../lib/env';
import { SHOW_HINTS, FAKTEN } from '../config/site';
import { POSITIONIERUNG } from '../config/variante';
import { UEBER_KOPF, GRUENDUNG, FAKTEN_TITEL } from '../config/ueber-uns';
import { href } from '../lib/paths';
import { seitenSchema } from '../lib/schema';
const U_TITEL = 'Über uns: wer hinter webgold steht';
const U_TEXT = 'webgold verbindet menschliche Beratung mit KI-gestützter Umsetzung: Ihre Website im Abo und auf Wunsch eine Web-App, für kleine und mittlere Unternehmen.';
import '../styles/start-neu.css';
import '../styles/seite-ueber.css';

const TEAM_ZEIGEN = SHOW_HINTS && IS_PREVIEW; // gleiche Bedingung wie SnTeam.astro
const initialen = (n: string) => n.split(/\s+/).map((t) => t[0]).join('').slice(0, 2).toUpperCase();

const values: { title: string; text: string; link?: { label: string; path: string } }[] = [
  { title: 'Menschlich', text: 'Strategie, Erfahrung und Verständnis für Ihr Geschäft.' },
  { title: 'Schnell', text: 'KI beschleunigt die Umsetzung.' },
  { title: 'Transparent', text: 'Fester Monatspreis, alle Kosten auf einen Blick.', link: { label: 'Zu den Preisen', path: '/preise/' } }, // Jamil #6011, Audit #5953 W3
  { title: 'Langfristig', text: 'Wir entwickeln Ihre Website laufend weiter. Kunden sollen bleiben, weil es passt.' },
];

// Die frühere „Arbeitsweise in drei Schritten“ (#5892) ist durch „So arbeiten wir“ in acht Schritten ersetzt (Jamil #6055 Fr. 14, SnAblauf lang).
// Gründungsgeschichte: Entwurf nur in der Vorschau, bis Can und Jamil bestätigen (Fr. 10).
const GRUENDUNG_ZEIGEN = GRUENDUNG.bestaetigt || (SHOW_HINTS && IS_PREVIEW);
const nr = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  title={U_TITEL}
  description={U_TEXT}
  schema={[seitenSchema(Astro.site, 'AboutPage', '/ueber-uns/', U_TITEL, U_TEXT)]}
  breadcrumb={[{ name: 'Über uns', path: '/ueber-uns/' }]}
>
  <PageHeader
    eyebrow="Über uns"
    title={UEBER_KOPF.titel}
    lead={`${POSITIONIERUNG} ${UEBER_KOPF.leadNach}`}
  />

  <!-- 1 · Mission (Weiß) -->
  <section class="section sn su-mission" aria-labelledby="mission-h">
    <div class="wrap">
      <div class="sn-kopf">
        <div>
          <p class="sn-kenn">Unsere Mission</p>
          <h2 id="mission-h" class="sn-h2 sn-h2--klein">Viele Unternehmen wissen, dass es KI gibt, aber nicht, wie daraus eine Website wird, die Kunden bringt. <mark class="hl su-akzent">Dabei helfen wir.</mark></h2>
        </div>
        <div class="su-mission__text">
          <p class="sn-lead">Wir kombinieren menschliche Beratung mit der Geschwindigkeit moderner KI-Systeme.</p>
          <p>Wir wollen kleinen und mittleren Unternehmen helfen, professioneller aufzutreten, effizienter zu arbeiten und langfristig zu wachsen. Die Website ist dabei nur der erste Schritt.</p>
        </div>
      </div>
      {GRUENDUNG_ZEIGEN && (
        <div class:list={['su-gruendung', { 'su-gruendung--entwurf': !GRUENDUNG.bestaetigt }]}>
          {!GRUENDUNG.bestaetigt && <p class="su-gruendung__etikett">{GRUENDUNG.etikett}</p>}
          <h3 class="sn-h3">{GRUENDUNG.titel}</h3>
          {GRUENDUNG.absaetze.map((a) => <p>{a}</p>)}
          {!GRUENDUNG.bestaetigt && <Hint block label={GRUENDUNG.hinweis} where="src/config/ueber-uns.ts → GRUENDUNG" />}
        </div>
      )}
      <!-- Belegbare Fakten (Jamil #6055 Fr. 11): Gründungsjahr, betreute Websites, keine Tracking-Cookies -->
      <div class="su-fakten">
        <h3 class="sr-only">{FAKTEN_TITEL}</h3>
        <ul class="su-fakten__liste">
          {FAKTEN.map((f) => <li><strong>{f.wert}</strong><span>{f.text}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2 · Team (Papier) -->
  <section class="section sn su-team" id="team" aria-labelledby="su-team-h">
    <div class="wrap">
      <div class="sn-kopf">
        <p class="sn-kenn">Team</p>
        <h2 id="su-team-h" class="sn-h2" set:html={hl(TEAM.titel)}></h2>
        <p class="sn-lead">{TEAM.einleitung}</p>
      </div>
      <ul class="su-personen">
        {TEAM.personen.map((m) => (
          <li class="su-person">
            <div class="su-person__foto">
              {TEAM_ZEIGEN
                ? <Bild name={m.foto} alt={m.alt} widths={[180, 360]} sizes="120px" class="su-person__bild" />
                : <span class="su-person__initialen" aria-hidden="true">{initialen(m.name)}</span>}
            </div>
            <div class="su-person__text">
              <h3 class="sn-h3">{m.name}</h3>
              <p class="su-person__rolle">{m.rolle}</p>
              <p class="su-person__aufgabe">{m.aufgabe}</p>{/* Jamil #6055 Fr. 19 */}
              {TEAM_ZEIGEN && <blockquote class="su-person__zitat"><p>„{m.zitat}“</p></blockquote>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · Werte (Weiß): große Typografie, Nummern, feine Linien -->
  <section class="section sn su-werte" aria-labelledby="werte-h">
    <div class="wrap">
      <div class="sn-kopf">
        <p class="sn-kenn">Unsere Werte</p>
        <h2 id="werte-h" class="sn-h2">Wofür wir <mark class="hl">stehen</mark>.</h2>
      </div>
      <ul class="su-werte__liste">
        {values.map((v, i) => (
          <li class="su-wert reveal">
            <span class="su-nr" aria-hidden="true">{nr(i)}</span>
            <h3 class="su-wert__titel">{v.title}</h3>
            <p>{v.text}{v.link && <> <a class="su-wert__link" href={href(v.link.path)}>{v.link.label}</a></>}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · So arbeiten wir: alle acht Schritte (Jamil #6055 Fr. 14; Kurzfassung in fünf Schritten auf Startseite und /preise/) -->
  <SnAblauf lang />

  <SnAbschluss />
</BaseLayout>
