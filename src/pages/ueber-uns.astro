---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Hint from '../components/Hint.astro';
import Val from '../components/Val.astro';
import { company } from '../config/site';
import More from '../components/More.astro';
import Bild from '../components/Bild.astro';

const values = [
  { title: 'Individuell', text: 'Jede Website ein Unikat.' },
  { title: 'Ehrlich', text: 'Offene Preise, kurze Laufzeiten.' },
  { title: 'Schnell', text: 'Schnelle Seiten, schnelle Antworten.' },
  { title: 'Sorgenfrei', text: 'Technik? Machen wir.' },
];
---

<BaseLayout
  title="Über uns – das Team hinter Waybuild"
  description="Waybuild entwickelt individuelle Websites im Abo für kleine und mittlere Unternehmen – ohne WordPress, mit eigener Technologie und persönlicher Betreuung."
  breadcrumb={[{ name: 'Über uns', path: '/ueber-uns/' }]}
>
  <PageHeader
    eyebrow="Über uns"
    title="Wir bauen den Weg ins Netz."
    lead="Websites wie von Großen – für kleine und mittlere Unternehmen."
  />

  <section class="section">
    <div class="wrap story">
      <div class="story__text">
        <h2>Warum es uns gibt</h2>
        <p class="story__lead">Agentur zu teuer. Baukasten zu mühsam. WordPress zu langsam. <strong>Wir machen es anders.</strong></p>
        <More label="Unsere Geschichte">
          <p>
            Viele Betriebe stehen vor derselben Wahl: Entweder eine teure Agentur mit fünfstelligem Angebot – oder ein
            Baukasten, bei dem am Ende doch alles selbst gemacht werden muss. Dazwischen: WordPress-Seiten, die nach zwei
            Jahren langsam, unsicher und veraltet sind.
          </p>
          <p>
            Wir haben Waybuild gegründet, um das zu ändern. Mit eigener, schlanker Technologie entwickeln wir Websites,
            die schnell laden, sicher sind und individuell zu jedem Unternehmen passen. Und weil wir sie im Abo anbieten,
            bleiben sie das auch: Wir kümmern uns dauerhaft um Hosting, E-Mails, Updates und Änderungen.
          </p>
        </More>
        <Hint block label="Persönliche Gründungsgeschichte" where="src/pages/ueber-uns.astro">
          Ein, zwei Sätze in eigenen Worten: Wer seid ihr, woher kommt ihr, warum macht ihr das? Das wirkt stärker als jeder Werbetext.
        </Hint>
      </div>

      <aside class="founder">
        <Bild name="team/gruender" alt={`${company.managingDirector} – Gründung & Geschäftsführung von Waybuild`} widths={[400, 800]} sizes="(min-width: 900px) 400px, 100vw" class="founder__img">
          <div class="founder__photo" role="img" aria-label="Foto der Geschäftsführung (folgt)">
            <span>Foto folgt</span>
          </div>
          <Hint label="Foto: src/assets/bilder/team/gruender.jpg" where="src/assets/bilder/LIESMICH.md" />
        </Bild>
        <p class="founder__name"><Val value={company.managingDirector} label="Name Geschäftsführung" where="src/config/site.ts → company.managingDirector" /></p>
        <p class="founder__role">Gründung & Geschäftsführung</p>
      </aside>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="werte-h">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Unsere Werte</span>
        <h2 id="werte-h">Wofür wir stehen</h2>
      </div>
      <div class="values">
        {values.map((v) => (
          <div class="card">
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Lernen wir uns kennen." />
</BaseLayout>

<style>
  .story { display: grid; gap: 40px; }
  @media (min-width: 900px) { .story { grid-template-columns: 1.5fr 1fr; gap: 72px; align-items: start; } }
  .story__lead { font-size: clamp(1.3rem, 2.6vw, 1.7rem); line-height: 1.35; color: var(--ink-soft); }
  .story__lead strong { color: var(--ink); }
  .founder { display: grid; gap: 4px; }
  .founder :global(.founder__img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 24px; margin-bottom: 14px; }
  .founder__photo {
    aspect-ratio: 1; border-radius: 24px; display: grid; place-items: center; margin-bottom: 14px;
    background: radial-gradient(circle at 50% 38%, #ffd2bd 0 18%, transparent 19%), linear-gradient(160deg, #ff8a5c, #ff5a1f 55%, #c9410f);
    color: rgb(255 255 255 / 85%); font-weight: 600;
  }
  .founder__photo span { margin-top: 55%; }
  .founder__name { font-family: var(--font-head); font-size: 1.4rem; font-weight: 700; margin: 0; }
  .founder__role { color: var(--accent-ink); font-weight: 600; margin: 0 0 8px; }
  .values { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 900px) { .values { grid-template-columns: repeat(4, 1fr); } }
  .values p { color: var(--ink-soft); margin: 0; }
</style>
