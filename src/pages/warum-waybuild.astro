---
// Positionierung „Warum waybuild“. STRENG: nur überprüfbare Fakten – keine erfundenen Zahlen, Kundenstimmen,
// Logos, Zertifikate oder Auszeichnungen; Vergleich nur mit Anbieter-TYPEN, nie mit echten Wettbewerbern.
// Neu im Stil der Startseite (Jamil, Talk qh87y3sj #5892, 14.11.2026): Inhalte erhalten, Optik wie src/components/startneu/.
// Der alte Vergleich (VERGLEICH aus variante.ts, Tabelle + Handy-Karten) ist hier durch die Vergleichstabelle der Startseite
// ersetzt (SnVergleich, Daten config/start-vergleich.ts). VERGLEICH in variante.ts bleibt (llms.txt.ts und Hinweis in SnVergleich).
// Abschnitte im Wechsel: Papier → Weiß (Vergleich) → Hauch → Weiß → Papier → Hauch (SnAbschluss). Stil: styles/seite-warum.css (.sw2-).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import SnVergleich from '../components/startneu/SnVergleich.astro';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import { SAEULEN } from '../config/angebot';
import { href } from '../lib/paths';
import '../styles/start-neu.css';
import '../styles/seite-warum.css';

const unterschiede: { title: string; text: string; link?: { label: string; path: string } }[] = [
  { title: 'Beratung zuerst', text: 'Zielgruppen, Positionierung, Customer Journey: Wir denken mit Ihnen, bevor gebaut wird.' },
  { title: 'KI-gestützte Umsetzung', text: 'Die Ideen entwickeln wir mit Ihnen. Danach beschleunigt die KI die Umsetzung, und Ihre Website ist deutlich schneller fertig.' },
  { title: 'Fester Monatspreis, alles drin', text: 'Feste Pakete, keine Einrichtungskosten, keine versteckten Kosten.', link: { label: 'Zum Preis', path: '/preise/' } },
  { title: 'Keine Seitenbegrenzung', text: 'Ihre Website wächst mit Ihrem Unternehmen. Wir zählen keine Seiten, eine neue Seite kostet keinen Aufpreis.' },
  { title: 'Kontinuierliche Verbesserung', text: 'Wir entwickeln Ihre Website laufend weiter, auch nach dem Livegang.' },
  { title: 'Ein Ansprechpartner', text: 'Vom Erstgespräch bis zur Betreuung spricht dieselbe Person mit Ihnen, die Ihr Unternehmen kennt.' },
];

const eigenbetrieb = [
  'Zwei-Faktor-Anmeldung',
  'Videokonferenzen über das Talk-High-Performance-Backend',
  'Online-Dokumentenbearbeitung direkt im Browser',
  'Digitales Dokumentenarchiv mit Paperless',
  'Automatische Backups',
];

const passt = [
  'Sie führen ein kleines oder mittleres Unternehmen, zum Beispiel aus Handwerk, Dienstleistung, Beratung, IT oder Immobilien.',
  'Sie möchten planbare Kosten statt hoher Einmalinvestitionen.',
  'Sie suchen einen Partner für die Digitalisierung, der mehr liefert als ein KI-Tool.',
  'Sie möchten sich auf Ihr Kerngeschäft konzentrieren.',
];
const passtNicht = [
  'Sie sind Privatperson: Unser Angebot richtet sich ausschließlich an Unternehmen und Selbstständige (B2B).',
  'Sie möchten alles selbst bauen und verwalten: Dann ist ein Baukasten die günstigere Wahl.',
];
const nr = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  title="Warum waybuild? Keine klassische Webagentur"
  description="Was waybuild von Baukasten und klassischer Agentur unterscheidet: persönliche Beratung, KI-gestützte Umsetzung, ein Ansprechpartner, fester Monatspreis."
  breadcrumb={[{ name: 'Warum waybuild', path: '/warum-waybuild/' }]}
>
  <PageHeader
    eyebrow="Warum waybuild"
    title="Keine klassische Webagentur."
    lead="Wir verkaufen keine Websites. Wir verkaufen digitale Kundenerlebnisse."
  >
    <p class="sw2-ph-cta"><a class="btn btn--primary" href={href('/kontakt/')}>Kostenlose Erstberatung</a> <a class="btn btn--ghost" href={href('/preise/')}>Preis ansehen</a></p>
  </PageHeader>

  <!-- 1 · Was uns unterscheidet (Papier): sechs Punkte als nummerierte Typografie statt Icon-Kacheln -->
  <section class="section sn sw2-unterschied" aria-labelledby="unterschied-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div>
          <p class="sn-kenn">Was uns unterscheidet</p>
          <h2 id="unterschied-h" class="sn-h2">Ein echter Digitalisierungs&shy;partner.</h2>
        </div>
        <!-- von uns ergänzt (#5892) -->
        <p class="sn-lead">Sechs Dinge, die wir anders machen als ein Baukasten oder eine klassische Agentur.</p>
      </div>
      <ol class="sw2-punkte">
        {unterschiede.map((u, i) => (
          <li class="sw2-punkt reveal">
            <span class="sw2-nr" aria-hidden="true">{nr(i)}</span>
            <h3 class="sn-h4">{u.title}</h3>
            <p>{u.text}</p>
            {u.link && <a class="sn-link" href={href(u.link.path)}>{u.link.label} <Icon name="arrow" size={18} /></a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 2 · Vergleich (Weiß): gleiche Tabelle wie auf der Startseite (Anker #vergleich) -->
  <SnVergleich />

  <!-- 3 · Eigenbetrieb (Hauch) -->
  <section class="section sn sw2-eigen" aria-labelledby="eigen-h">
    <div class="wrap sw2-eigen__innen">
      <div>
        <p class="sn-kenn">Wir nutzen, was wir verkaufen</p>
        <h2 id="eigen-h" class="sn-h2 sn-h2--klein">Unsere eigene IT läuft auf derselben Technik.</h2>
        <p class="sn-lead sw2-eigen__lead">waybuild betreibt selbst eine gehärtete Nextcloud. Sie ist die Basis für unsere Plattform-Vision.</p>
      </div>
      <ul class="sw2-liste">
        {eigenbetrieb.map((e) => <li><span class="sw2-punktzeichen" aria-hidden="true"></span><span>{e}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 4 · Für wen (Weiß) -->
  <section class="section sn sw2-fuerwen" aria-labelledby="fuerwen-h">
    <div class="wrap">
      <div class="sn-kopf">
        <p class="sn-kenn">Ehrlich gesagt</p>
        <h2 id="fuerwen-h" class="sn-h2">Für wen wir (nicht) passen.</h2>
      </div>
      <div class="sw2-fit">
        <div class="sw2-fit__karte sw2-fit__karte--ja">
          <h3 class="sn-h3">Wir passen zu Ihnen, wenn …</h3>
          <ul class="sw2-liste">
            {passt.map((p) => <li><span class="sw2-zeichen sw2-zeichen--ja" aria-hidden="true"><Icon name="check" size={16} /></span><span>{p}</span></li>)}
          </ul>
        </div>
        <div class="sw2-fit__karte sw2-fit__karte--nein">
          <h3 class="sn-h3">Wir passen nicht, wenn …</h3>
          <ul class="sw2-liste">
            {passtNicht.map((p) => <li><span class="sw2-zeichen sw2-zeichen--nein" aria-hidden="true"><Icon name="close" size={16} /></span><span>{p}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Ziel / Säulen (Papier) -->
  <section class="section sn sw2-saeulen" aria-labelledby="saeulen-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div>
          <p class="sn-kenn">Unser Ziel</p>
          <h2 id="saeulen-h" class="sn-h2">Die Website ist nur der erste Schritt.</h2>
        </div>
        <p class="sn-lead">Daraus entwickeln wir Schritt für Schritt ein digitales Betriebssystem für KMU.</p>
      </div>
      <ul class="sw2-saeulen__liste">
        {SAEULEN.map((s, i) => (
          <li class="sw2-saeule reveal">
            <span class="sw2-nr" aria-hidden="true">{nr(i)}</span>
            <h3 class="sn-h4">{s.title}</h3>
            <p class="sw2-saeule__text">{s.claim}</p>
            <p class="sw2-saeule__ab">{s.ab}</p>
            <a class="sn-link" href={href(`/leistungen/#${s.id}`)}>Mehr erfahren<span class="sr-only"> zu {s.title}</span> <Icon name="arrow" size={18} /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SnAbschluss />
</BaseLayout>
