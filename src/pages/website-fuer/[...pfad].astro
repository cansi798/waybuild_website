import Weiterleitung from '../../components/Weiterleitung.astro';

export function getStaticPaths() {
  const alteBranchen = ['handwerker', 'arztpraxen', 'gastronomie', 'kanzleien', 'immobilienmakler', 'friseure-kosmetik'];
  return [{ params: { pfad: undefined } }, ...alteBranchen.map((pfad) => ({ params: { pfad } }))];
}
