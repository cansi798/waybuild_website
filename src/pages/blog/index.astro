---
// Blog-Übersicht (Jamil, Talk qh87y3sj #5264): neueste Beiträge zuerst, Karten wie /ratgeber/.
// Entwürfe (draft: true) erscheinen mit Hinweis „Entwurf“, damit nichts endgültig wirkt.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SEITEN_FOTO } from '../../config/bilder';
import { getCollection } from 'astro:content';
import { href } from '../../lib/paths';
import SnAbschluss from '../../components/startneu/SnAbschluss.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/start-neu.css';
import '../../styles/seite-wissen.css';
// Neues Aussehen im Stil der Startseite (Jamil Talk qh87y3sj #5892, 14.11.2026): ruhiges Karten-Raster, Abschluss wie auf der
// Startseite. Stil: src/styles/seite-wissen.css (.swi-).

const beitraege = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const datum = (d: Date) => d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Blog: Websites, Sichtbarkeit & KI"
  description="Der waybuild-Blog: Gedanken und Einordnungen rund um Websites, Sichtbarkeit bei Google und in der KI-Suche für kleine und mittlere Unternehmen."
  breadcrumb={[{ name: 'Blog', path: '/blog/' }]}
>
  <PageHeader eyebrow="Blog" title="Gedanken aus der Praxis." foto={SEITEN_FOTO.blog} lead="Wie wir arbeiten, was sich gerade ändert und was das für Ihr Unternehmen bedeutet." />
  <section class="section sn swi swi--papier" aria-label="Alle Blog-Beiträge">
    <div class="wrap">
      <ul class="swi-raster swi-raster--artikel">
        {beitraege.map((b) => (
          <li>
            <a class="swi-artikel" href={href(`/blog/${b.id}/`)}>
              <span class="swi-artikel__meta">
                <time datetime={b.data.date.toISOString()}>{datum(b.data.date)}</time>
                {b.data.draft && <span class="swi-entwurf">Entwurf</span>}
              </span>
              <h2 class="sn-h4">{b.data.title}</h2>
              <p>{b.data.description}</p>
              <span class="swi-artikel__mehr">Lesen <Icon name="arrow" size={18} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SnAbschluss />
</BaseLayout>

