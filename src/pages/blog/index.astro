---
// Blog-Übersicht (Jamil, Talk qh87y3sj #5264): neueste Beiträge zuerst, Karten wie /ratgeber/.
// Entwürfe (draft: true) erscheinen mit Hinweis „Entwurf“, damit nichts endgültig wirkt.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { href } from '../../lib/paths';

const beitraege = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const datum = (d: Date) => d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Blog: Websites, Sichtbarkeit & KI"
  description="Der waybuild-Blog: Gedanken und Einordnungen rund um Websites, Sichtbarkeit bei Google und in der KI-Suche für kleine und mittlere Unternehmen."
  breadcrumb={[{ name: 'Blog', path: '/blog/' }]}
>
  <PageHeader eyebrow="Blog" title="Gedanken aus der Praxis." lead="Wie wir arbeiten, was sich gerade ändert und was das für Ihr Unternehmen bedeutet." />
  <section class="section">
    <div class="wrap">
      <ul class="bl">
        {beitraege.map((b) => (
          <li>
            <a class="bl__card" href={href(`/blog/${b.id}/`)}>
              <span class="bl__meta">
                <time datetime={b.data.date.toISOString()}>{datum(b.data.date)}</time>
                {b.data.draft && <span class="bl__draft">Entwurf</span>}
              </span>
              <h2>{b.data.title}</h2>
              <p>{b.data.description}</p>
              <span class="bl__more">Lesen →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .bl { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 900px) { .bl { grid-template-columns: repeat(3, 1fr); } }
  .bl__card { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 26px; background: var(--white); border: 1px solid var(--line); border-radius: 18px; text-decoration: none; transition: border-color 0.2s ease, transform 0.2s ease; }
  .bl__card:hover { border-color: var(--dark); transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .bl__card { transition: none; } .bl__card:hover { transform: none; } }
  .bl__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--ink-soft); }
  .bl__draft { padding: 2px 10px; border-radius: 999px; border: 1px solid var(--accent-ink); color: var(--accent-ink); font-weight: 650; font-size: 0.78rem; }
  .bl__card h2 { font-size: 1.3rem; margin: 0; }
  .bl__card p { color: var(--ink-soft); margin: 0; }
  .bl__more { margin-top: auto; font-weight: 650; color: var(--accent-ink); }
</style>
