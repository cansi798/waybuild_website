---
// ZWEITE STARTSEITE unter /neu/ (Can, Sitzung 11.11.2026): nur Vorschau neben der heutigen Startseite, die unverändert bleibt.
// noindex, nicht im Menü, nicht in der Sitemap (astro.config.mjs), nicht in llms.txt; im Live-Paket entfernt (scripts/postbuild.mjs).
// Fundament: diese Seite, src/styles/neu.css, src/components/neu/Abschnitt.astro, src/components/neu/vertrag.ts.
// Die Abschnitte liegen als src/components/neu/<paket>/<Name>.astro und sind fest eingebunden (so prüft „npm run check“ auch
// ihre Eigenschaften). Jeder Abschnitt bekommt genau `links`, der Hero zusätzlich `dreiD`.
// Flächen der Reihe nach: dunkel (Hero), weiß, sand, weiß, sand, weiß, sand, weiß, dunkel (Schluss).
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { NeuLinks } from '../../components/neu/vertrag';
import { href } from '../../lib/paths';
import { aboPreisAb, euro } from '../../config/pakete-abo';
import { ANLIEGEN } from '../../config/startseite';
import NeuHero from '../../components/neu/hero/NeuHero.astro';
import NeuKundenreise from '../../components/neu/reise/NeuKundenreise.astro';
import NeuVorteile from '../../components/neu/reise/NeuVorteile.astro';
import NeuVorgehen from '../../components/neu/reise/NeuVorgehen.astro';
import NeuVergleich from '../../components/neu/angebot/NeuVergleich.astro';
import NeuPakete from '../../components/neu/angebot/NeuPakete.astro';
import NeuBeispiele from '../../components/neu/abschluss/NeuBeispiele.astro';
import NeuFragen from '../../components/neu/abschluss/NeuFragen.astro';
import NeuAbschluss from '../../components/neu/abschluss/NeuAbschluss.astro';
import '../../styles/neu.css';

// Titel und Beschreibung wörtlich wie auf der heutigen Startseite (dort nur lokale Konstanten in src/pages/index.astro)
const V_TITEL = 'Website-Abo: fertig betreut, fester Monatspreis';
const V_DESCRIPTION = `Website, E-Mail und Google-Profil in zwei festen Paketen ab ${euro(aboPreisAb())} im Monat netto, ohne Einrichtungskosten. Hosting in Deutschland.`;

// Schalter: 3D-Bühne, Beispiele und Fragen lassen sich mit einer Zeile abschalten
const ZEIGE = { hero3d: true, beispiele: true, fragen: true };

const kontakt = (paket: string) => href(`/kontakt/?paket=${encodeURIComponent(paket)}`);
const links: NeuLinks = {
  erstberatung: kontakt(ANLIEGEN.erstberatung.paket),
  bewerten: kontakt(ANLIEGEN.bewerten.paket),
  pakete: '#pakete',
  preise: href('/preise/'),
  beispiele: href('/beispiele/'),
  fragen: href('/fragen/'),
};
---

<BaseLayout title={V_TITEL} description={V_DESCRIPTION} noindex thema="besucherreise">
  <div class="neu">
    <NeuHero links={links} dreiD={ZEIGE.hero3d} />
    <NeuKundenreise links={links} />
    <NeuVorteile links={links} />
    <NeuVorgehen links={links} />
    <NeuVergleich links={links} />
    <NeuPakete links={links} />
    {ZEIGE.beispiele && <NeuBeispiele links={links} />}
    {ZEIGE.fragen && <NeuFragen links={links} />}
    <NeuAbschluss links={links} />
  </div>
</BaseLayout>
