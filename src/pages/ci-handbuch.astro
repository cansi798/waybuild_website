---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Logo from '../components/Logo.astro';
import { company } from '../config/site';
import { href } from '../lib/paths';

const rgb = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  return `${(n >> 16) & 255} · ${(n >> 8) & 255} · ${n & 255}`;
};

const colors = [
  { name: 'Nachtblau', token: '--ink', hex: '#0e1a2b', role: 'Primärfarbe. Text, dunkle Flächen, Buttons.', share: 30, dark: true },
  { name: 'Signal-Orange', token: '--accent', hex: '#ff5a1f', role: 'Akzent. Handlungsaufforderungen, Hervorhebungen. Sparsam!', share: 10, dark: false },
  { name: 'Papier', token: '--paper', hex: '#f7f5f0', role: 'Hintergrund. Warm statt klinisch weiß.', share: 50, dark: false },
  { name: 'Sand', token: '--paper-2', hex: '#efebe3', role: 'Sekundäre Flächen, Abschnittswechsel.', share: 8, dark: false },
  { name: 'Rost', token: '--accent-ink', hex: '#b83a0b', role: 'Orange als Textfarbe auf hellem Grund (Kontrast AA).', share: 1, dark: true },
  { name: 'Schiefer', token: '--ink-soft', hex: '#3b4a5e', role: 'Fließtext sekundär, Beschreibungen.', share: 1, dark: true },
];

const typeScale = [
  { label: 'H1 · Bricolage 750', size: 'clamp(2.4rem, 6vw, 4.1rem)', sample: 'Ein Unikat.', head: true },
  { label: 'H2 · Bricolage 700', size: 'clamp(1.8rem, 4vw, 2.9rem)', sample: 'Ein Preis. Alles drin.', head: true },
  { label: 'H3 · Bricolage 650', size: '1.25rem', sample: 'Unbegrenzte E-Mail-Postfächer', head: true },
  { label: 'Lead · Figtree 400', size: '1.25rem', sample: 'Wir entwickeln Ihre Website individuell nach Ihren Wünschen.', head: false },
  { label: 'Text · Figtree 400', size: '1.0625rem', sample: 'Hosting, Domain, E-Mails und Wartung inklusive – für einen festen Monatspreis.', head: false },
  { label: 'Eyebrow · Figtree 700, Versalien', size: '0.8rem', sample: 'WEBSITE-ABO FÜR UNTERNEHMEN', head: false },
];

const tone = [
  { do: 'Wir richten Ihre Postfächer ein.', dont: 'Wir bieten innovative E-Mail-Lösungen.' },
  { do: 'Live in 14 Tagen.', dont: 'Zeitnahe Umsetzung nach Absprache.' },
  { do: '49 € im Monat, netto. Einrichtung 290 €.', dont: 'Attraktive Konditionen auf Anfrage.' },
  { do: 'Wir empfehlen den kleineren Tarif – der reicht Ihnen.', dont: 'Holen Sie das Maximum raus mit Premium!' },
];

const sections = [
  ['marke', 'Marke'], ['logo', 'Logo'], ['farben', 'Farben'], ['typo', 'Typografie'],
  ['elemente', 'Elemente'], ['sprache', 'Sprache'], ['anwendung', 'Anwendung'], ['downloads', 'Downloads'],
];
---

<BaseLayout
  title="CI-Handbuch – Corporate Identity"
  description={`Corporate-Identity-Handbuch der ${company.legalName}: Logo, Farben, Typografie, Gestaltungselemente und Tonalität.`}
  noindex
>
  <PageHeader
    eyebrow="CI-Handbuch · Version 1.0"
    title="So sieht Waybuild aus. Und so klingt es."
    lead="Dieses Handbuch hält fest, wie die Marke Waybuild auftritt – auf der Website, in E-Mails, auf Visitenkarten und überall sonst. Einheitlich auftreten heißt: wiedererkannt werden."
  >
    <nav class="toc" aria-label="Kapitel">
      {sections.map(([id, label], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{label}</a>)}
    </nav>
  </PageHeader>

  <!-- 01 Marke -->
  <section class="section ch" id="marke">
    <div class="wrap">
      <header class="ch__head"><span>01</span><h2>Markenkern</h2></header>
      <div class="grid grid--2 gap">
        <div>
          <p class="big">„Websites, die für Unternehmen arbeiten – nicht umgekehrt.“</p>
          <p class="muted">
            Waybuild baut den Weg (<em>way</em>) ins Netz (<em>build</em>). Wir nehmen kleinen und mittleren Unternehmen die
            komplette digitale Basis ab: Website, Server, E-Mail, Sichtbarkeit. Individuell entwickelt, fair im Abo.
          </p>
        </div>
        <dl class="values">
          <div><dt>Individuell</dt><dd>Jede Website ist ein Unikat. Keine Templates, kein Baukasten.</dd></div>
          <div><dt>Ehrlich</dt><dd>Nettopreise offen, kurze Laufzeiten, klare Leistung. Kein Kleingedrucktes.</dd></div>
          <div><dt>Schnell</dt><dd>Schnelle Websites, schnelle Antworten, schneller Livegang.</dd></div>
          <div><dt>Sorgenfrei</dt><dd>Wir kümmern uns um die Technik, damit sich Kunden um ihr Geschäft kümmern.</dd></div>
        </dl>
      </div>
      <div class="claim">
        <span class="label">Claim</span>
        <p>{company.slogan}</p>
        <span class="label">Kurz-Claim</span>
        <p>Ihre Website. Ein Unikat. Komplett betreut.</p>
      </div>
    </div>
  </section>

  <!-- 02 Logo -->
  <section class="section section--alt ch" id="logo">
    <div class="wrap">
      <header class="ch__head"><span>02</span><h2>Logo</h2></header>
      <p class="muted narrow">
        Das Logo besteht aus der <strong>Bildmarke</strong> (ein „W“ als Weg-Linie, die auf und ab geht – wie ein Bauplan
        oder ein Pfad) und der <strong>Wortmarke</strong> „way<b>build</b>“ in Bricolage Grotesque: „way“ in Regular,
        „build“ in ExtraBold. Immer klein geschrieben.
      </p>
      <div class="logos">
        <figure class="logo-box"><div class="stage"><Logo /></div><figcaption>Standard auf hellem Grund</figcaption></figure>
        <figure class="logo-box logo-box--dark"><div class="stage stage--dark"><Logo /></div><figcaption>Negativ auf Nachtblau</figcaption></figure>
        <figure class="logo-box"><div class="stage stage--orange"><Logo /></div><figcaption>Auf Signal-Orange (nur Sonderfälle)</figcaption></figure>
      </div>
      <div class="grid grid--3 gap rules">
        <div class="card">
          <h3>Schutzzone</h3>
          <div class="zone"><span><Logo /></span></div>
          <p class="muted">Rund um das Logo mindestens die Höhe der Bildmarke frei lassen.</p>
        </div>
        <div class="card">
          <h3>Mindestgröße</h3>
          <p class="minsize"><span class="m1"><Logo /></span></p>
          <p class="muted">Gesamtlogo digital ≥ 100 px breit, Druck ≥ 25 mm. Darunter nur die Bildmarke verwenden (Favicon ab 16 px).</p>
        </div>
        <div class="card">
          <h3>Nicht erlaubt</h3>
          <ul class="donts">
            <li>Farben verändern oder Verläufe einsetzen</li>
            <li>Verzerren, drehen, schräg stellen</li>
            <li>Schatten, Konturen oder Effekte</li>
            <li>„Waybuild“ mit großem W in der Wortmarke</li>
            <li>Auf unruhigen Fotos ohne Fläche platzieren</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Farben -->
  <section class="section ch" id="farben">
    <div class="wrap">
      <header class="ch__head"><span>03</span><h2>Farben</h2></header>
      <p class="muted narrow">
        Warmes Papier, tiefes Nachtblau und ein Signal-Orange, das auffällt – weil es selten ist. Faustregel:{' '}
        <strong>60 % hell, 30 % Nachtblau, 10 % Orange.</strong>
      </p>
      <div class="ratio" aria-hidden="true">
        {colors.filter((c) => c.share > 1).map((c) => <span style={`flex:${c.share};background:${c.hex}`}></span>)}
      </div>
      <div class="swatches">
        {colors.map((c) => (
          <article class="sw">
            <div class="sw__chip" style={`background:${c.hex};color:${c.dark ? '#f7f5f0' : '#0e1a2b'}`}>
              <span>{c.name}</span>
            </div>
            <dl>
              <div><dt>HEX</dt><dd>{c.hex.toUpperCase()}</dd></div>
              <div><dt>RGB</dt><dd>{rgb(c.hex)}</dd></div>
              <div><dt>CSS</dt><dd><code>var({c.token})</code></dd></div>
            </dl>
            <p>{c.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 Typografie -->
  <section class="section section--alt ch" id="typo">
    <div class="wrap">
      <header class="ch__head"><span>04</span><h2>Typografie</h2></header>
      <div class="grid grid--2 gap fonts">
        <div class="card font-card">
          <p class="font-card__aa head">Aa</p>
          <h3>Bricolage Grotesque</h3>
          <p class="muted">Überschriften, Logo, Zahlen. Charakterstark mit leicht kantigen Details – „gebaut“, nicht glatt. Gewichte 600–800, Laufweite −2 %.</p>
        </div>
        <div class="card font-card">
          <p class="font-card__aa">Aa</p>
          <h3>Figtree</h3>
          <p class="muted">Fließtext, Buttons, Navigation. Freundlich, sehr gut lesbar auf dem Smartphone. Gewichte 400–700.</p>
        </div>
      </div>
      <p class="muted small">Beide Schriften sind Open Source (SIL OFL) und werden lokal eingebunden – keine Verbindung zu Google Fonts (DSGVO).</p>
      <div class="scale">
        {typeScale.map((t) => (
          <div class="scale__row">
            <span class="label">{t.label}<br /><code>{t.size}</code></span>
            <p class={t.head ? 'head' : ''} style={`font-size:${t.size};${t.label.startsWith('Eyebrow') ? 'letter-spacing:.12em;font-weight:700;color:var(--accent-ink)' : ''}${t.label.startsWith('H') ? `;font-weight:${t.label.match(/\d{3}/)?.[0]}` : ''}`}>{t.sample}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 Elemente -->
  <section class="section ch" id="elemente">
    <div class="wrap">
      <header class="ch__head"><span>05</span><h2>Gestaltungselemente</h2></header>
      <div class="grid grid--3 gap">
        <div class="card">
          <h3>Bauplan-Raster</h3>
          <div class="demo demo--grid"></div>
          <p class="muted">Ein feines 48-px-Raster, weich ausgeblendet, zitiert den Bauplan. Nur als Hintergrund, nie dominant.</p>
        </div>
        <div class="card">
          <h3>Buttons</h3>
          <div class="demo demo--btns">
            <a class="btn btn--primary" href="#elemente">Primär</a>
            <a class="btn btn--dark" href="#elemente">Sekundär</a>
            <a class="btn btn--ghost" href="#elemente">Ghost</a>
          </div>
          <p class="muted">Immer vollrund (Pill), mind. 48 px hoch. Pro Bereich nur ein orangefarbener Button.</p>
        </div>
        <div class="card">
          <h3>Radien & Flächen</h3>
          <div class="demo demo--radii"><span style="border-radius:10px">10</span><span style="border-radius:14px">14</span><span style="border-radius:20px">20</span><span style="border-radius:28px">28</span></div>
          <p class="muted">Eingaben 10 px, Karten 14 px, Tarife 20 px, große Flächen 28 px. 1 px Linien in Sand statt Schatten.</p>
        </div>
        <div class="card">
          <h3>Icons</h3>
          <div class="demo demo--icons">
            <svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z M4 7l8 6 8-6" /></svg>
            <svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z M9 12l2 2 4-4" /></svg>
            <svg viewBox="0 0 24 24"><path d="M5 12.5l4 4 10-10" /></svg>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l3 2" /></svg>
          </div>
          <p class="muted">Linien-Icons, 2 px Strichstärke, runde Enden. Keine gefüllten oder bunten Icons, keine Emojis.</p>
        </div>
        <div class="card">
          <h3>Nummerierung</h3>
          <div class="demo demo--nums"><span>01</span><span>02</span><span>03</span></div>
          <p class="muted">Zweistellige Nummern in Bricolage, Orange/Rost – für Vorteile, Schritte, Kapitel.</p>
        </div>
        <div class="card">
          <h3>Bildsprache</h3>
          <div class="demo demo--photo"></div>
          <p class="muted">Echte Menschen, echte Betriebe, natürliches Licht. Keine Stockfotos mit Anzug-Handschlag. Warme Farbstimmung passend zu Papier & Orange.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Sprache -->
  <section class="section section--dark ch" id="sprache">
    <div class="wrap">
      <header class="ch__head"><span>06</span><h2>Sprache & Tonalität</h2></header>
      <div class="grid grid--2 gap">
        <ul class="tone-rules">
          <li><strong>Wir siezen.</strong> Respektvoll, aber nie steif.</li>
          <li><strong>Kurz und konkret.</strong> Zahlen statt Adjektive: „14 Tage“ statt „zeitnah“.</li>
          <li><strong>Ehrlich.</strong> Preise immer mit „netto“. Keine künstliche Verknappung.</li>
          <li><strong>Nutzen vor Technik.</strong> „Lädt in unter 1 Sekunde“ statt „statisch generiert“.</li>
          <li><strong>Keine Fachbegriffe</strong> ohne Erklärung. Kein Denglisch, wo es ein deutsches Wort gibt.</li>
        </ul>
        <div class="tone">
          {tone.map((t) => (
            <div class="tone__pair">
              <p class="tone__do"><span>✓</span>{t.do}</p>
              <p class="tone__dont"><span>✕</span>{t.dont}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Anwendung -->
  <section class="section ch" id="anwendung">
    <div class="wrap">
      <header class="ch__head"><span>07</span><h2>Anwendungen</h2></header>
      <div class="grid grid--2 gap">
        <figure>
          <div class="bcard">
            <div class="bcard__front"><Logo /></div>
            <div class="bcard__back">
              <strong>{company.managingDirector}</strong>
              <span>Geschäftsführung</span>
              <span class="bcard__c">{company.email}<br />{company.phone || '+49 …'}<br />waybuild.de</span>
            </div>
          </div>
          <figcaption class="muted small">Visitenkarte 85 × 55 mm – Vorderseite Nachtblau, Rückseite Papier.</figcaption>
        </figure>
        <figure>
          <div class="sig">
            <p>Mit freundlichen Grüßen</p>
            <p><strong>{company.managingDirector}</strong><br /><span class="muted">Geschäftsführung</span></p>
            <p class="sig__logo"><Logo /></p>
            <p class="small">
              {company.legalName}<br />
              {company.street} · {company.zip} {company.city}<br />
              <a href={`mailto:${company.email}`}>{company.email}</a> · waybuild.de
            </p>
            <p class="sig__legal">Registergericht: {company.registerCourt} · {company.registerNumber} · Geschäftsführung: {company.managingDirector}</p>
          </div>
          <figcaption class="muted small">E-Mail-Signatur – inkl. Pflichtangaben für die UG (§ 35a GmbHG).</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 08 Downloads -->
  <section class="section section--alt ch" id="downloads">
    <div class="wrap">
      <header class="ch__head"><span>08</span><h2>Downloads</h2></header>
      <ul class="dl">
        <li><a href={href('/brand/waybuild-bildmarke.svg')} download>Bildmarke dunkel (SVG)</a></li>
        <li><a href={href('/brand/waybuild-bildmarke-hell.svg')} download>Bildmarke hell (SVG)</a></li>
        <li><a href={href('/brand/waybuild-bildmarke-512.png')} download>Bildmarke 512 px (PNG)</a></li>
        <li><a href={href('/og-image.png')} download>Social-Media-Vorschau 1200 × 630 (PNG)</a></li>
      </ul>
      <p class="muted small">Schriften: Bricolage Grotesque und Figtree kostenlos über fontsource.org bzw. Google Fonts (für Offline-Nutzung installieren).</p>
    </div>
  </section>
</BaseLayout>

<style>
  .toc { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .toc a { display: inline-flex; gap: 8px; text-decoration: none; font-size: 0.9rem; font-weight: 600; padding: 8px 14px; border-radius: 99px; background: var(--white); border: 1px solid var(--line); }
  .toc a span { color: var(--accent-ink); font-family: var(--font-head); }
  .toc a:hover { border-color: var(--ink); }

  .ch { scroll-margin-top: 70px; }
  .ch__head { display: flex; align-items: baseline; gap: 18px; margin-bottom: 28px; border-bottom: 2px solid currentColor; padding-bottom: 14px; }
  .ch__head span { font-family: var(--font-head); font-weight: 750; font-size: 1.1rem; color: var(--accent-ink); }
  .section--dark .ch__head span { color: var(--accent); }
  .ch__head h2 { margin: 0; }
  .gap { gap: 24px 48px; }
  .muted { color: var(--ink-soft); }
  .section--dark .muted { color: #aab5c3; }
  .small { font-size: 0.9rem; }
  .narrow { max-width: 68ch; margin-bottom: 28px; }
  .label { display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }
  .head { font-family: var(--font-head); letter-spacing: -0.02em; }
  .big { font-family: var(--font-head); font-size: clamp(1.6rem, 3.4vw, 2.4rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; }

  .values { display: grid; gap: 0; margin: 0; }
  .values div { padding: 14px 0; border-top: 1px solid var(--line); }
  .values dt { font-weight: 700; font-family: var(--font-head); font-size: 1.15rem; }
  .values dd { margin: 0; color: var(--ink-soft); }
  .claim { margin-top: 40px; display: grid; gap: 6px; padding: 28px; border-radius: 20px; background: var(--ink); color: var(--paper); }
  .claim .label { color: var(--accent); }
  .claim p { font-family: var(--font-head); font-size: clamp(1.2rem, 2.6vw, 1.6rem); font-weight: 650; margin: 0 0 14px; }

  .logos { display: grid; gap: 16px; margin-bottom: 24px; }
  @media (min-width: 800px) { .logos { grid-template-columns: repeat(3, 1fr); } }
  .logo-box { margin: 0; }
  .logo-box figcaption { font-size: 0.85rem; color: var(--ink-soft); margin-top: 8px; }
  .stage { display: grid; place-items: center; aspect-ratio: 16 / 9; background: var(--paper); border: 1px solid var(--line); border-radius: 16px; }
  .stage :global(.logo) { transform: scale(1.5); }
  .stage--dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .stage--dark :global(.logo svg rect) { fill: var(--paper); }
  .stage--orange { background: var(--accent); border-color: var(--accent); }
  .stage--orange :global(.logo svg path) { stroke: var(--paper); }
  .rules h3 { margin-bottom: 14px; }
  .zone { display: grid; place-items: center; padding: 28px; background: repeating-linear-gradient(45deg, rgb(255 90 31 / 10%) 0 6px, transparent 6px 12px); border: 1px dashed var(--accent); border-radius: 10px; }
  .zone span { background: var(--white); padding: 4px; }
  .minsize { display: flex; align-items: center; min-height: 80px; }
  .m1 :global(.logo) { transform: scale(0.8); transform-origin: left center; }
  .donts { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .donts li { padding-left: 24px; position: relative; }
  .donts li::before { content: '✕'; position: absolute; left: 0; color: #d4462a; font-weight: 800; }

  .ratio { display: flex; height: 22px; border-radius: 99px; overflow: hidden; border: 1px solid var(--line); margin-bottom: 28px; }
  .swatches { display: grid; gap: 16px; }
  @media (min-width: 640px) { .swatches { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .swatches { grid-template-columns: repeat(3, 1fr); } }
  .sw { background: var(--white); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .sw__chip { height: 120px; display: flex; align-items: flex-end; padding: 16px; font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; border-bottom: 1px solid var(--line); }
  .sw dl { margin: 0; padding: 14px 16px 0; display: grid; gap: 4px; font-size: 0.9rem; }
  .sw dl div { display: flex; justify-content: space-between; gap: 12px; }
  .sw dt { color: var(--ink-soft); }
  .sw dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .sw p { padding: 10px 16px 16px; margin: 0; font-size: 0.9rem; color: var(--ink-soft); }
  code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.85em; }

  .fonts { margin-bottom: 12px; }
  .font-card__aa { font-size: 4.5rem; line-height: 1; margin: 0 0 12px; font-weight: 700; }
  .scale { margin-top: 28px; border-top: 1px solid var(--line); }
  .scale__row { display: grid; gap: 6px 24px; padding: 20px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  @media (min-width: 800px) { .scale__row { grid-template-columns: 240px 1fr; } }
  .scale__row p { margin: 0; line-height: 1.15; }

  .demo { height: 120px; border-radius: 12px; margin-bottom: 14px; display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; background: var(--paper); }
  .demo--grid { background-image: linear-gradient(rgb(14 26 43 / 10%) 1px, transparent 1px), linear-gradient(90deg, rgb(14 26 43 / 10%) 1px, transparent 1px); background-size: 16px 16px; mask-image: radial-gradient(ellipse, #000 30%, transparent 75%); }
  .demo--btns { height: auto; padding: 16px; }
  .demo--btns .btn { min-height: 40px; padding: 0.5em 1em; font-size: 0.9rem; }
  .demo--radii span { width: 52px; height: 52px; display: grid; place-items: center; background: var(--white); border: 1px solid var(--line); font-size: 0.8rem; color: var(--ink-soft); }
  .demo--icons svg { width: 34px; height: 34px; fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .demo--nums span { font-family: var(--font-head); font-weight: 750; font-size: 2rem; color: var(--accent-ink); }
  .demo--photo { background: radial-gradient(circle at 70% 35%, #ffd2bd 0 14%, transparent 15%), linear-gradient(160deg, #ff8a5c, #ff5a1f 50%, #0e1a2b 130%); }

  .tone-rules { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .tone-rules strong { color: var(--accent); display: block; font-family: var(--font-head); font-size: 1.15rem; }
  .tone { display: grid; gap: 14px; }
  .tone__pair { border: 1px solid #25344a; border-radius: 14px; overflow: hidden; }
