---
// Beispiele (früher „Referenzen“, Jamil, Talk qh87y3sj #5288, 09.11.2026): echte Projekte nach Bereichen, zuerst „Websites“.
// Seit #5322 (Q5) heißt die Seite „Beispiele“ unter /beispiele/; /referenzen/ ist nur noch eine Weiterleitung (src/pages/referenzen.astro).
// Bereiche in src/config/referenzen.ts (später z. B. „Software“), Projekte = REFERENZEN in src/config/startseite.ts (Regeln dort:
// nur Belegtes, Link nur bei status 'online').
// Neu im Stil der Startseite (Jamil #5892, 14.11.2026): je Projekt eine ruhige, große Karte (Bildschirmfoto im Browserrahmen +
// Ausgangslage/Umsetzung/Ergebnis), am PC abwechselnd links/rechts. Danach der Beispiel-Film (SnBeispiel, Anker #beispiel) und
// SnAbschluss. Hintergründe: Bereiche Weiß/Papier im Wechsel → Film Papier (statt Hauch, damit er sich vom Abschluss absetzt) → Hauch.
// Stil: styles/seite-beispiele.css (.sb-).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Bild from '../components/Bild.astro';
import Icon from '../components/Icon.astro';
import SnBeispiel from '../components/startneu/SnBeispiel.astro';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import { REFERENZ_BEREICHE } from '../config/referenzen';
import { REFERENZEN } from '../config/startseite';
import { href } from '../lib/paths';
import '../styles/start-neu.css';
import '../styles/seite-beispiele.css';

// Fakten der früheren Siegel-Leiste dieser Seite
const fakten = ['In der Regel 14 Tage nach Ihren Inhalten online', 'Schnelle Ladezeiten', 'Hosting in Deutschland'];
---

<BaseLayout
  title="Beispiele aus unserer Arbeit"
  description="Echte Projekte von waybuild: Websites für Unternehmen aus Norderstedt und Hamburg, mit Ausgangslage, Umsetzung und gemessenem Ergebnis."
  breadcrumb={[{ name: 'Beispiele', path: '/beispiele/' }]}
>
  <PageHeader eyebrow="Beispiele" title="Beispiele aus unserer Arbeit." lead="Echte Projekte unserer Kunden, sortiert nach Bereichen. Was noch nicht online ist, kennzeichnen wir ehrlich als Vorschau.">
    {REFERENZ_BEREICHE.length > 1 && (
      <nav class="sb-bereiche" aria-label="Bereiche">
        <ul>{REFERENZ_BEREICHE.map((b) => <li><a href={`#${b.id}`}>{b.titel}</a></li>)}</ul>
      </nav>
    )}
  </PageHeader>

  {REFERENZ_BEREICHE.map((b, i) => (
    <section class:list={['section sn sb-bereich', { 'sb-bereich--papier': i % 2 === 1 }]} id={b.id} aria-labelledby={`${b.id}-h`}>
      <div class="wrap">
        <div class="sn-kopf sn-kopf--zweispaltig">
          <div>
            <p class="sn-kenn">Bereich</p>
            <h2 id={`${b.id}-h`} class="sn-h2">{b.titel}</h2>
          </div>
          <div>
            <p class="sn-lead">{b.text}</p>
            <ul class="sb-fakten">{fakten.map((f) => <li>{f}</li>)}</ul>
          </div>
        </div>

        <ul class="sb-projekte">
          {b.liste.map((r, k) => (
            <li class:list={['sb-projekt reveal', { 'sb-projekt--gespiegelt': k % 2 === 1 }]}>
              <div class="sb-projekt__bild">
                <span class="sb-projekt__leiste" aria-hidden="true"><i></i><i></i><i></i></span>
                {r.name && r.bild
                  ? <Bild name={r.bild} alt={`Startseite der Website von ${r.name}${r.status === 'vorschau' ? ' (Vorschau)' : ''}`} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 640px, calc(100vw - 64px)" class="sb-projekt__img" />
                  : <span class="sb-projekt__leer" aria-hidden="true">{r.branche}</span>}
              </div>
              <div class="sb-projekt__text">
                <div class="sb-projekt__kopf">
                  <span class:list={['sb-status', `sb-status--${r.status}`]}>{REFERENZEN.etikett[r.status]}</span>
                  <span class="sb-projekt__branche">{r.name ? r.branche : ''}{r.name && r.ort ? ' · ' : ''}{r.ort}</span>
                </div>
                <h3 class="sn-h3 sb-projekt__name">{r.name ?? r.branche}</h3>
                <dl class="sb-fakten-dl">
                  <div><dt>Ausgangslage</dt><dd>{r.ausgang}</dd></div>
                  <div><dt>Umsetzung</dt><dd>{r.gemacht}</dd></div>
                  {r.ergebnis && <div class="sb-ergebnis"><dt>Ergebnis</dt><dd>{r.ergebnis}</dd></div>}
                </dl>
                {r.status === 'online' && r.url && (
                  <a class="sn-link" href={r.url} target="_blank" rel="noopener">Website ansehen: {r.urlText ?? r.url}<span class="sr-only"> (öffnet in neuem Tab)</span> <Icon name="arrow" size={18} /></a>
                )}
              </div>
            </li>
          ))}
        </ul>

        <p class="sn-fein">{REFERENZEN.messung}</p>
        {b.id === 'websites' && <p class="sb-mehr"><a class="sn-link" href={href('/leistungen/website/')}>Mehr zur Leistung Website <Icon name="arrow" size={18} /></a></p>}
      </div>
    </section>
  ))}

  <!-- Beispiel-Film „So kann es laufen.“ (wie auf der Startseite, Bühne auch unter /so-kann-es-laufen/) -->
  <div class="sb-film">
    <SnBeispiel />
  </div>

  <SnAbschluss />
</BaseLayout>
