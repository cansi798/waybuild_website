---
// /leistungen/<slug>/ – seit 09.11.2026 zwei Quellen (Jamil, Talk qh87y3sj #5274 Vorschlag, #5276 „ok“):
// 1. NEU: die 13 Leistungen aus src/content/leistungen/ (4 Gruppen, Seite: components/leistungen/LeistungSeite.astro).
// 2. ALTBESTAND aus src/config/leistungen.ts (components/leistungen/AltLeistung.astro): bleibt erreichbar, aber unverlinkt,
//    noindex und nicht in der Sitemap. Gleicher Slug wie eine neue Leistung → die neue Seite gewinnt.
import LeistungSeite from '../../components/leistungen/LeistungSeite.astro';
import AltLeistung from '../../components/leistungen/AltLeistung.astro';
import { leistungen as altBestand, type Leistung } from '../../config/leistungen';
import { leistungenNeu, type LeistungNeu } from '../../config/leistungen-neu';

export async function getStaticPaths() {
  const neu = await leistungenNeu();
  const neueSlugs = new Set(neu.map((l) => l.id));
  return [
    ...neu.map((eintrag) => ({ params: { slug: eintrag.id }, props: { eintrag } })),
    ...altBestand.filter((l) => !neueSlugs.has(l.slug)).map((l) => ({ params: { slug: l.slug }, props: { alt: l } })),
  ];
}

const { eintrag, alt } = Astro.props as { eintrag?: LeistungNeu; alt?: Leistung };
---

{eintrag ? <LeistungSeite eintrag={eintrag} /> : alt && <AltLeistung l={alt} />}
