---
// /leistungen/<slug>/: die 12 Leistungen (Social Media seit #5630 nur Weiterleitung) aus src/content/leistungen/ (4 Gruppen, Seite: components/leistungen/LeistungSeite.astro;
// Jamil, Talk qh87y3sj #5274/#5276). Die alten Leistungsseiten sind gelöscht (Jamil, Talk qh87y3sj #5322, Q6); ihre Adressen
// sind kleine Weiterleitungsseiten auf die passende neue Seite (ALT_WEITERLEITUNGEN in src/config/leistungen-neu.ts).
import LeistungSeite from '../../components/leistungen/LeistungSeite.astro';
import Weiterleitung from '../../components/Weiterleitung.astro';
import { leistungenNeu, ALT_WEITERLEITUNGEN, type LeistungNeu } from '../../config/leistungen-neu';

export async function getStaticPaths() {
  const neu = await leistungenNeu();
  const neueSlugs = new Set(neu.map((l) => l.id));
  return [
    ...neu.map((eintrag) => ({ params: { slug: eintrag.id }, props: { eintrag } })),
    ...Object.entries(ALT_WEITERLEITUNGEN).filter(([slug]) => !neueSlugs.has(slug)).map(([slug, weiter]) => ({ params: { slug }, props: { weiter } })),
  ];
}

const { eintrag, weiter } = Astro.props as { eintrag?: LeistungNeu; weiter?: { ziel: string; name: string } };
---

{eintrag ? <LeistungSeite eintrag={eintrag} /> : weiter && <Weiterleitung ziel={weiter.ziel} name={weiter.name} />}
