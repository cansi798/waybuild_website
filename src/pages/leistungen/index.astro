---
// /leistungen/ – Übersicht NEU (Jamil, Talk qh87y3sj #5274 Vorschlag, #5276 „ok“, 09.11.2026): vier Gruppen entlang der
// Kundenreise, je Leistung eine Karte (menuTitel, kurz, Paket-Hinweis ohne Preis). Daten: src/content/leistungen/ +
// src/config/leistungen-neu.ts. Die frühere Übersicht „Website as a Service“ mit Ausbaustufen (Altbestand
// src/config/leistungen.ts) liegt in Git (Sicherung Branch vor-leistungen-neu-20261109).
// SEIT 14.11.2026 im Stil der neuen Startseite (Jamil Talk qh87y3sj #5892): sn-Bausteine (start-neu.css), ruhige Karten ohne
// Icon-Kacheln, Hintergründe im Wechsel Weiß/Papier, danach SnSystem (Website + WebApp), Preis-Hinweis und SnAbschluss.
// Eigener Stil: src/styles/seite-leistungen.css (Präfix .sl-). Anker #gefunden, #vertrauen, #anfragen, #betreuung bleiben.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import SnSystem from '../../components/startneu/SnSystem.astro';
import SnAbschluss from '../../components/startneu/SnAbschluss.astro';
import { gruppenMitLeistungen, paketAnzeige } from '../../config/leistungen-neu';
import { ABO_PAKETE, aboPreisAb, euro } from '../../config/pakete-abo';
import { href, absolute } from '../../lib/paths';
import '../../styles/start-neu.css';
import '../../styles/seite-leistungen.css';

const gruppen = await gruppenMitLeistungen();
const nr = (n: number) => String(n).padStart(2, '0');

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen von waybuild',
  itemListElement: gruppen.flatMap((g) => g.eintraege).map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: l.data.title,
    url: absolute(`/leistungen/${l.id}/`, Astro.site),
  })),
};
---

<BaseLayout
  title="Leistungen: von Website bis Betreuung"
  description="Alle Leistungen von waybuild entlang der Kundenreise: gefunden werden, Vertrauen gewinnen, Anfragen und Abläufe, Betreuung und Verbesserung."
  schema={[itemList]}
  breadcrumb={[{ name: 'Leistungen', path: '/leistungen/' }]}
>
  <PageHeader eyebrow="Leistungen" title="Alles, was aus Interessenten Kunden macht." lead="Unsere Leistungen folgen dem Weg Ihrer Kunden: vom ersten Eindruck über die Anfrage bis zur Betreuung danach.">
    <!-- früher Link auf /#kundenreise; die Kundenreise ist seit 14.11.2026 nicht mehr auf der Startseite (#5843–#5855) -->
    <p class="sl-ph-hinweis"><a href="#system">Warum Website und WebApp zusammen stark sind</a></p>
  </PageHeader>

  <!-- Sprungleiste zu den vier Bereichen: Zahl + Name, keine Kacheln -->
  <nav class="sl-sprung" aria-label="Leistungsbereiche">
    <div class="wrap">
      <ol class="sl-sprung__liste">
        {gruppen.map((g, i) => (
          <li><a href={`#${g.id}`}><span class="sl-sprung__nr" aria-hidden="true">{nr(i + 1)}</span>{g.titel}</a></li>
        ))}
      </ol>
    </div>
  </nav>

  {gruppen.map((g, i) => (
    <section class:list={['section sn sl-gruppe', i % 2 === 1 ? 'sl-gruppe--papier' : 'sl-gruppe--weiss']} id={g.id} aria-labelledby={`${g.id}-h`}>
      <div class="wrap">
        <div class="sn-kopf sn-kopf--zweispaltig sl-gruppe__kopf">
          <div class="sl-gruppe__titel">
            <p class="sn-kenn">Bereich {i + 1} von {gruppen.length}</p>
            <h2 id={`${g.id}-h`} class="sn-h2 sn-h2--klein">{g.titel}</h2>
          </div>
          <p class="sn-lead">{g.text}</p>
        </div>
        <ul class="sl-karten">
          {g.eintraege.map((l, j) => (
            <li class="sl-karte">
              <span class="sl-karte__nr" aria-hidden="true">{nr(i + 1)}.{j + 1}</span>
              <h3 class="sn-h4 sl-karte__titel"><a href={href(`/leistungen/${l.id}/`)}>{l.data.menuTitel}</a></h3>
              <p class="sl-karte__text">{l.data.kurz}</p>
              <p class="sl-karte__paket">{paketAnzeige(l.data.paket)}</p>
              <span class="sl-karte__mehr" aria-hidden="true">Mehr erfahren <Icon name="arrow" size={18} /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <SnSystem />

  <!-- Preis-Hinweis zwischen System und Abschluss (von uns ergänzt (#5892)); Preise nur aus pakete-abo.ts -->
  <section class="section sn sl-preis" aria-labelledby="sl-preis-h">
    <div class="wrap sl-preis__innen">
      <div class="sl-preis__text">
        <p class="sn-kenn">Preise</p>
        <h2 id="sl-preis-h" class="sn-h2 sn-h2--klein">Feste Pakete statt Einzelpreise.</h2>
        <p class="sn-lead">Viele dieser Leistungen stecken schon in unseren Paketen. Was darüber hinausgeht, bieten wir Ihnen nach einem Gespräch an.</p>
      </div>
      <div class="sl-preis__zahlen">
        <ul class="sl-preis__liste">
          {ABO_PAKETE.map((p) => (
            <li><span class="sl-preis__name">{p.name}</span><span class="sl-preis__betrag">{euro(p.preis)}</span><span class="sl-preis__einheit">netto im Monat</span></li>
          ))}
        </ul>
        <a class="sn-link" href={href('/preise/')}>Alle Preise ab {euro(aboPreisAb())} ansehen <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <SnAbschluss />
</BaseLayout>
