---
// Leistungen nach der Unternehmensvision (17.10.2026): EINE Lösung „Website as a Service“.
// 1 Was drin ist (9 Bestandteile) → 2 Was wir damit bauen (#websites) → 3 Ausbaustufen auf Anfrage (#ausbau,
// mit den alten Sprungmarken #software, #cloud, #beratung) → CTA.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import LeistungGrafik from '../../components/LeistungGrafik.astro';
import Inklusive from '../../components/Inklusive.astro';
import Icon from '../../components/Icon.astro';
import { leistungen, leistungenNach, leistungAb } from '../../config/leistungen';
import { WAAS, preisLang } from '../../config/site';
import { SAEULEN, NETTO_HINWEIS } from '../../config/angebot';
import { href, absolute } from '../../lib/paths';
import { serviceSchema } from '../../lib/schema';

const websites = leistungenNach('websites');
const ausbau = SAEULEN.filter((s) => s.id !== 'websites');

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen von waybuild',
  itemListElement: leistungen.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: l.title,
    url: absolute(`/leistungen/${l.slug}/`, Astro.site),
  })),
};
---

<BaseLayout
  title="Leistungen: Website as a Service"
  description={`Eine Lösung statt vieler Pakete: ${WAAS.name} – Beratung, KI-gestützte Erstellung, Hosting, Wartung und Betreuung zum festen Monatspreis.`}
  schema={[serviceSchema(Astro.site), itemList]}
  breadcrumb={[{ name: 'Leistungen', path: '/leistungen/' }]}
>
  <PageHeader eyebrow="Leistungen" title={`Eine Lösung: ${WAAS.name}.`} lead={WAAS.claim}>
    <p class="ph-preis"><Icon name="euro" size={20} /> {preisLang()} · 0 € Einrichtung · {WAAS.laufzeitMonate} Monate</p>
  </PageHeader>

  <section class="section" aria-labelledby="inkl-h">
    <div class="wrap">
      <SectionHead eyebrow="Enthalten" pre="Was " accent="drin ist" id="inkl-h" />
      <Inklusive />
    </div>
  </section>

  <section class="section section--sand saeule" id="websites" aria-labelledby="websites-h">
    <div class="wrap">
      <SectionHead eyebrow={WAAS.name} pre="Was wir damit " accent="bauen" text="Gleiches Modell, gleicher Service – je nachdem, was Ihr Unternehmen braucht." id="websites-h" />
      <div class="lgrid">
        {websites.map((l) => (
          <a class="card lcard reveal" href={href(`/leistungen/${l.slug}/`)}>
            <div class="lcard__media"><LeistungGrafik art={l.grafik} /></div>
            <div class="lcard__body">
              <span class="lcard__icon"><Icon name={l.icon} size={22} /></span>
              <h3>{l.title}</h3>
              <p>{l.teaser}</p>
              <span class="lcard__plan">{leistungAb(l)}</span>
            </div>
          </a>
        ))}
        <div class="card lfill">
          <span class="eyebrow">Erstgespräch</span>
          <p class="lfill__ab">Nicht sicher, was Sie brauchen?</p>
          <p>In der Beratung klären wir Zielgruppen, Positionierung und Ziele – danach wissen Sie, was Ihre Website leisten muss.</p>
          <div class="lfill__actions">
            <a class="btn btn--primary btn--sm" href={href('/kontakt/')}>Erstgespräch</a>
            <a class="btn btn--sm lfill__ghost" href={href('/preise/')}>Preis ansehen</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section saeule" id="ausbau" aria-labelledby="ausbau-h">
    <div class="wrap">
      <SectionHead eyebrow="Ausbaustufen · auf Anfrage" pre="Die Website ist der " accent="erste Schritt." text="Darauf aufbauend setzen wir individuelle Projekte um – auf dem Weg zur digitalen Unternehmensplattform." id="ausbau-h" />
      <div class="ausbau">
        {ausbau.map((s) => (
          <div class="ausbau__gruppe" id={s.id}>
            <h3><Icon name={s.icon} size={20} /> {s.title}</h3>
            <ul>
              {leistungenNach(s.id).map((l) => (
                <li><a href={href(`/leistungen/${l.slug}/`)}><strong>{l.title}</strong><span>{l.teaser}</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="incl"><a href={href('/#plattform')}>Unsere Plattform-Vision ansehen →</a></p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap cta">
      <div>
        <span class="eyebrow">Keine klassische Webagentur</span>
        <h2>Menschliche Beratung. KI-gestützte Umsetzung.</h2>
        <p class="lead">Und danach: kontinuierliche Verbesserung.</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Kostenloses Erstgespräch</a>
        <a class="btn btn--lg cta__ghost" href={href('/warum-waybuild/')}>Warum waybuild?</a>
      </div>
    </div>
    <p class="wrap netto">{NETTO_HINWEIS}</p>
  </section>
</BaseLayout>

<style>
  .ph-preis { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 6px 0 0; font-weight: 650; }
  .ph-preis :global(.icon) { color: var(--accent-ink); }
  .saeule { scroll-margin-top: 72px; }
  .lgrid { display: grid; gap: 20px; }
  @media (min-width: 720px) { .lgrid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .lgrid { grid-template-columns: repeat(3, 1fr); } }
  .lcard { padding: 0; overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .lcard__media { position: relative; aspect-ratio: 16 / 8; background: var(--paper-2); overflow: hidden; }
  .lcard__body { padding: 22px; display: grid; gap: 8px; align-content: start; }
  .lcard__icon { z-index: 2; width: 44px; height: 44px; border-radius: 12px; background: var(--dark); color: var(--accent); display: inline-grid; place-items: center; margin-top: -44px; position: relative; box-shadow: var(--shadow); }
  .lcard h3 { font-size: 1.3rem; margin: 6px 0 0; }
  .lcard p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .lcard__plan { font-size: 0.82rem; font-weight: 650; color: var(--accent-ink); margin-top: 4px; }
  .lfill { background: var(--dark); color: var(--paper); border-color: var(--dark); display: grid; align-content: center; gap: 10px; }
  .lfill .eyebrow { margin: 0; color: var(--accent); }
  .lfill p { margin: 0; color: var(--dark-lead); font-size: 0.95rem; max-width: 52ch; }
  .lfill .lfill__ab { font-family: var(--font-head); font-size: 1.5rem; font-weight: 700; color: var(--white); }
  .lfill__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .lfill__ghost { border-color: rgb(255 255 255 / 55%); color: var(--white); background: transparent; }

  .ausbau { display: grid; gap: 16px; }
  @media (min-width: 900px) { .ausbau { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .ausbau__gruppe { scroll-margin-top: 90px; background: var(--white); border: 1.5px dashed var(--line); border-radius: 18px; padding: 20px; }
  .ausbau__gruppe h3 { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; font-size: 1.15rem; }
  .ausbau__gruppe h3 :global(.icon) { color: var(--accent-ink); }
  .ausbau__gruppe ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .ausbau__gruppe li + li { border-top: 1px solid var(--line); }
  .ausbau__gruppe a { display: grid; gap: 2px; padding: 10px 0; text-decoration: none; }
  .ausbau__gruppe a strong { color: var(--accent-ink); }
  .ausbau__gruppe a span { font-size: 0.88rem; color: var(--ink-soft); }
  .ausbau__gruppe a:hover strong { text-decoration: underline; }
  .incl { margin: 24px 0 0; text-align: center; font-size: 0.92rem; }
  .incl a { font-weight: 650; color: var(--accent-ink); }

  .cta { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 960px) { .cta { grid-template-columns: 1.4fr 1fr; gap: 48px; } }
  .cta h2 { margin-bottom: 0.4em; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta__ghost { background: transparent; border-color: rgb(255 255 255 / 55%); color: var(--white); }
  .cta__ghost:hover { background: rgb(255 255 255 / 12%); }
  .netto { margin-top: 28px; font-size: 0.82rem; color: var(--dark-soft); }
  @media (max-width: 767px) { .cta__actions .btn { width: 100%; } }
</style>
