---
// /leistungen/ – Übersicht NEU (Jamil, Talk qh87y3sj #5274 Vorschlag, #5276 „ok“, 09.11.2026): vier Gruppen entlang der
// Kundenreise, je Leistung eine Karte (menuTitel, kurz, Paket-Hinweis ohne Preis). Daten: src/content/leistungen/ +
// src/config/leistungen-neu.ts. Die frühere Übersicht „Website as a Service“ mit Ausbaustufen (Altbestand
// src/config/leistungen.ts) liegt in Git (Sicherung Branch vor-leistungen-neu-20261109).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { gruppenMitLeistungen, ICONS, paketAnzeige } from '../../config/leistungen-neu';
import { ANLIEGEN } from '../../config/startseite';
import { href, absolute } from '../../lib/paths';

const gruppen = await gruppenMitLeistungen();
const erstberatung = href(`/kontakt/?paket=${encodeURIComponent(ANLIEGEN.erstberatung.paket)}`);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen von waybuild',
  itemListElement: gruppen.flatMap((g) => g.eintraege).map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: l.data.title,
    url: absolute(`/leistungen/${l.id}/`, Astro.site),
  })),
};
---

<BaseLayout
  title="Leistungen: von Website bis Betreuung"
  description="Alle Leistungen von waybuild entlang der Kundenreise: gefunden werden, Vertrauen gewinnen, Anfragen und Abläufe, Betreuung und Verbesserung."
  schema={[itemList]}
  breadcrumb={[{ name: 'Leistungen', path: '/leistungen/' }]}
>
  <PageHeader eyebrow="Leistungen" title="Alles, was aus Interessenten Kunden macht." lead="Unsere Leistungen folgen dem Weg Ihrer Kunden: vom ersten Eindruck über die Anfrage bis zur Betreuung danach.">
    <p class="ph-hinweis"><a href={href('/#kundenreise')}>Die Kundenreise auf der Startseite ansehen</a></p>
  </PageHeader>

  <nav class="lsprung wrap" aria-label="Leistungsgruppen">
    <ul>
      {gruppen.map((g, i) => (
        <li><a href={`#${g.id}`}><span aria-hidden="true">{i + 1}</span>{g.titel}</a></li>
      ))}
    </ul>
  </nav>

  {gruppen.map((g, i) => (
    <section class:list={['section lgruppe', { 'section--sand': i % 2 === 1 }]} id={g.id} aria-labelledby={`${g.id}-h`}>
      <div class="wrap">
        <div class="lgruppe__kopf">
          <span class="lgruppe__nr" aria-hidden="true">{i + 1}</span>
          <div>
            <h2 id={`${g.id}-h`}>{g.titel}</h2>
            <p class="lead">{g.text}</p>
          </div>
        </div>
        <ul class="lkarten">
          {g.eintraege.map((l) => (
            <li>
              <a class="card lkarte" href={href(`/leistungen/${l.id}/`)}>
                <span class="lkarte__icon"><Icon name={ICONS[l.id] ?? 'check'} size={22} /></span>
                <h3>{l.data.menuTitel}</h3>
                <p>{l.data.kurz}</p>
                <span class="lkarte__paket">{paketAnzeige(l.data.paket)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section lcta-sec">
    <div class="wrap lcta">
      <div>
        <h2>Nicht sicher, was Sie brauchen?</h2>
        <p class="lead">In der kostenlosen Erstberatung, rund 20 Minuten, sehen wir uns gemeinsam an, wo Sie am meisten gewinnen.</p>
      </div>
      <div class="lcta__knoepfe">
        <a class="btn btn--primary btn--lg" href={erstberatung}>{ANLIEGEN.erstberatung.label}</a>
        <a class="btn btn--lg btn--ghost lcta__ghost" href={href('/preise/')}>Preise ansehen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ph-hinweis { margin: 10px 0 0; }
  .ph-hinweis a { font-weight: 650; color: var(--accent-ink); text-underline-offset: 3px; }

  /* Sprungleiste zu den vier Gruppen */
  .lsprung { padding-block: 18px; }
  .lsprung ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .lsprung a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 6px 14px 6px 6px; border-radius: 999px; background: var(--white); border: 1px solid var(--line); font-weight: 650; font-size: 0.92rem; color: var(--ink); text-decoration: none; }
  .lsprung a:hover { border-color: var(--accent-ink); }
  .lsprung a span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent-ink); color: var(--white); font-size: 0.8rem; }

  .lgruppe { scroll-margin-top: calc(var(--header-h) + 8px); padding-block: clamp(40px, 7vw, 88px); }
  .lgruppe__kopf { display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start; max-width: 760px; margin-bottom: clamp(20px, 4vw, 36px); }
  .lgruppe__kopf h2 { margin: 0 0 0.3em; overflow-wrap: break-word; }
  .lgruppe__kopf .lead { margin: 0; }
  .lgruppe__nr { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--dark); color: var(--accent); font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; margin-top: 2px; }

  .lkarten { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 700px) { .lkarten { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .lkarten { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .lkarte { display: grid; gap: 6px; align-content: start; height: 100%; text-decoration: none; color: var(--ink); transition: border-color 0.2s ease, transform 0.2s ease; }
  .lkarte:hover { border-color: var(--accent-ink); transform: translateY(-2px); }
  .lkarte h3 { margin: 4px 0 0; font-size: 1.15rem; color: var(--dark); overflow-wrap: break-word; hyphens: auto; }
  .lkarte p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.6; }
  .lkarte__icon { width: 42px; height: 42px; border-radius: 12px; background: var(--dark); color: var(--accent); display: inline-grid; place-items: center; }
  .lkarte__paket { margin-top: 6px; font-size: 0.82rem; font-weight: 650; color: var(--accent-ink); }
  @media (prefers-reduced-motion: reduce) { .lkarte, .lkarte:hover { transition: none; transform: none; } }

  .lcta { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 960px) { .lcta { grid-template-columns: 1.4fr 1fr; gap: 48px; } }
  .lcta h2 { margin-bottom: 0.4em; }
  .lcta .lead { margin: 0; }
  .lcta__knoepfe { display: flex; flex-wrap: wrap; gap: 12px; }
  .lcta-sec { padding-block: clamp(40px, 6vw, 72px); }
  .lcta { background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(24px, 4vw, 44px); width: min(100% - 32px, var(--wrap)); }
  .lcta__ghost { color: var(--accent-ink); }
  @media (max-width: 767px) { .lcta__knoepfe .btn { width: 100%; } }
</style>
