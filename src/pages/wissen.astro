---
// Übersicht „Wissen“ (Jamil, Talk qh87y3sj #5264, 09.11.2026): Ratgeber, Häufige Fragen und Blog an einem Ort.
// In der Navigation als Menüpunkt „Wissen“ (src/config/nav.ts); Eintrag „Alles im Überblick“ seit #5675 entfernt (Footer verlinkt weiter). In der Sitemap (Standard).
// Je Bereich die neuesten zwei bis drei Einträge, Daten aus den Sammlungen ratgeber/blog und aus src/config/fragen.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SEITEN_FOTO } from '../config/bilder';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { href } from '../lib/paths';
import { FRAGEN_TITEL, fragenNachThema } from '../config/fragen';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import '../styles/start-neu.css';
import '../styles/seite-wissen.css';
// Neues Aussehen im Stil der Startseite (Jamil Talk qh87y3sj #5892, 14.11.2026): drei ruhige Karten mit Nummer statt Icon-Kachel,
// Einträge als Liste mit feinen Linien, Abschluss wie auf der Startseite. Stil: src/styles/seite-wissen.css (.swi-).

const datumText = (d: Date) => d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });

// Ratgeber: die drei neuesten Artikel
const ratgeber = (await getCollection('ratgeber'))
  .sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime())
  .slice(0, 3)
  .map((a) => ({ titel: a.data.title, path: `/ratgeber/${a.id}/`, info: datumText(a.data.datum) }));

// Häufige Fragen: drei Kernfragen (Preis, Tempo, Vertrag), Sprung zum Thema auf /fragen/; Platzhalter nie
const TOP = ['Was kostet eine Website bei waybuild?', 'Wie schnell ist meine Website online?', 'Wie lange läuft der Vertrag?'];
const gruppen = fragenNachThema();
const mitThema = gruppen.flatMap((g) => g.fragen.filter((f) => !f.platzhalter).map((f) => ({ f, id: g.id })));
const fragen = [
  ...TOP.map((q) => mitThema.find((x) => x.f.q === q)).filter((x): x is (typeof mitThema)[number] => !!x),
  ...mitThema.filter((x) => !TOP.includes(x.f.q)),
].slice(0, 3).map((x) => ({ titel: x.f.q, path: `/fragen/#${x.id}`, info: '' }));

// Blog: die neuesten Beiträge (Entwürfe nur mit Hinweis „Entwurf“, wie auf /blog/)
const blog = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((b) => ({ titel: b.data.title, path: `/blog/${b.id}/`, info: datumText(b.data.date), entwurf: !!b.data.draft }));

const BEREICHE: { titel: string; text: string; path: string; alle: string; eintraege: { titel: string; path: string; info: string; entwurf?: boolean }[] }[] = [
  { titel: 'Ratgeber', text: 'Kurz erklärt: was eine Website kostet, mieten oder kaufen, Software, Cloud und IT.', path: '/ratgeber/', alle: 'Alle Ratgeber', eintraege: ratgeber },
  { titel: FRAGEN_TITEL, text: 'Antworten zu Paketen und Preisen, Ablauf, Technik und Vertrag.', path: '/fragen/', alle: 'Alle Fragen', eintraege: fragen },
  { titel: 'Blog', text: 'Einordnungen zu Websites, Sichtbarkeit bei Google und in der KI-Suche für kleine und mittlere Unternehmen.', path: '/blog/', alle: 'Zum Blog', eintraege: blog },
];
---

<BaseLayout
  title="Wissen: Ratgeber, Fragen und Blog"
  description="Wissen von waybuild an einem Ort: Ratgeber zu Website, Software und Cloud, häufige Fragen zu Paketen und Ablauf sowie Beiträge im Blog."
  breadcrumb={[{ name: 'Wissen', path: '/wissen/' }]}
>
  <PageHeader eyebrow="Ratgeber, Fragen und Blog" title="Wissen" foto={SEITEN_FOTO.wissen} lead="Hier finden Sie unsere Ratgeber, die häufigsten Fragen und den Blog an einem Ort. Kurz erklärt, rund um Website, Software und Cloud für Unternehmen." />

  <section class="section sn swi" aria-labelledby="swi-h">
    <div class="wrap">
      <!-- von uns ergänzt (#5892): Kopf über den drei Bereichen -->
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div>
          <p class="sn-kenn">Drei Bereiche</p>
          <h2 id="swi-h" class="sn-h2 sn-h2--klein">Kurz erklärt, wenn Sie es brauchen.</h2>
        </div>
        <p class="sn-lead">Lesen Sie in Ruhe nach, bevor Sie entscheiden. Je Bereich sehen Sie hier die neuesten Einträge.</p>
      </div>
      <ul class="swi-raster">
        {BEREICHE.map((b, i) => (
          <li class="swi-karte">
            <span class="swi-karte__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="sn-h3"><a href={href(b.path)}>{b.titel}</a></h3>
            <p class="swi-karte__text">{b.text}</p>
            {b.eintraege.length > 0 && (
              <ul class="swi-liste">
                {b.eintraege.map((e) => (
                  <li>
                    <a href={href(e.path)}>
                      <span class="swi-liste__titel">{e.titel}</span>
                      {(e.entwurf || e.info) && (
                        <small>{e.entwurf && <span class="swi-entwurf">Entwurf</span>}{e.info}</small>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <a class="sn-link swi-karte__alle" href={href(b.path)}>{b.alle} <Icon name="arrow" size={18} /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SnAbschluss />
</BaseLayout>

