---
// Abschluss der Customer Journey: Bestätigung + nächste Schritte + sinnvolle Wartezeit-Inhalte.
// 15.11.2026 (Jamil #6038, Audit D2/D3): ohne erneuten Kontaktblock im Footer, stattdessen Film und Beispiele; zweite
// Vorbereitungs-Liste für die Web-App.
import { BEISPIEL_LINK } from '../config/beispiel';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { company } from '../config/site';
import { href } from '../lib/paths';
import { J_START, J_ERST } from '../config/start-6176';
// Nächste Schritte je Weg (Loop 22.11.2026, MKT-004): ?weg=gespraech|schnell von den Formularen der Startseite (J6Start).
// Nur Angaben, die dort schon stehen (Jamils Texte in config/start-6176.ts); ohne ?weg bleibt alles wie bisher.
const vorschau = J_ERST.karten[1];
const zeiten = 'zeiten' in vorschau ? vorschau.zeiten : []; // „Website: Nächster Werktag“, „Software: In 3 Werktagen“
const WEGE = {
  gespraech: [
    { strong: 'Gespräch', span: J_START.gespraech.titel.replace(/^.*\((.*)\)$/, '$1, kostenlos') },
    { strong: 'Ihre Vorschau', span: zeiten.join(' · ') },
  ],
  schnell: [
    { strong: 'Ihre Website-Vorschau', span: 'am nächsten Werktag, Link per E-Mail' },
    { strong: 'Wenn es passt', span: 'Feinschliff in Ihrem Tempo' },
  ],
};
---

<BaseLayout title="Vielen Dank für Ihre Anfrage" description="Ihre Anfrage ist bei uns angekommen." noindex hideMobileCta ohneKontaktkopf>
  <section class="section thanks" data-wege={JSON.stringify(WEGE)}>
    <div class="wrap">
      <span class="thanks__icon" aria-hidden="true">✓</span>
      <h1>Danke<span data-name></span>! Ihre Anfrage ist da.</h1>
      <p class="lead">Wir melden uns persönlich, in der Regel bis <strong data-deadline>zum nächsten Werktag</strong>.</p>

      <ol class="next">
        <li class="is-done"><Icon name="mail" /><strong>Anfrage gesendet</strong><span>Erledigt</span></li>
        <li><Icon name="chat" /><strong>Wir melden uns</strong><span>per E-Mail oder Telefon</span></li>
        <li data-schritt="0"><Icon name="calendar" /><strong>Erstgespräch</strong><span>30 Min., kostenlos</span>{/* Jamil #6055 Fr. 15 */}</li>
        <li data-schritt="1"><Icon name="rocket" /><strong>In der Regel 14 Tage</strong><span>nach Ihren Inhalten online</span></li>
      </ol>

      <div class="prep card">
        <h2>Zur Vorbereitung (optional)</h2>
        <h3>Für Ihre Website</h3>
        <ul>
          <li>Logo und ggf. Farben Ihres Unternehmens</li>
          <li>Bestehende Domain / Website, falls vorhanden</li>
          <li>2–3 Websites, die Ihnen gefallen</li>
        </ul>
        <h3>Für die Web-App</h3>
        <ul>
          <li>Wie kommen Anfragen heute bei Ihnen an (Telefon, E-Mail, WhatsApp, Formular)?</li>
          <li>Welche Programme nutzen Sie schon, zum Beispiel für Angebote und Rechnungen?</li>
          <li>Welcher Schritt kostet Sie im Alltag am meisten Zeit?</li>
        </ul>
        <p class="muted">Einfach als Antwort auf unsere E-Mail senden: <a href={`mailto:${company.email}`}>{company.email}</a></p>
      </div>

      <div class="bisdahin">
        <h2>Bis dahin</h2>
        <p class="bisdahin__links"><a class="btn btn--primary" href={href('/so-kann-es-laufen/')}>{BEISPIEL_LINK}: der Film</a> <a class="btn btn--ghost" href={href('/beispiele/')}>Beispiele ansehen</a></p>
      </div>

      <p class="back"><a href={href('/')}>Zur Startseite</a> · <a href={href('/ratgeber/')}>Ratgeber lesen</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(location.search);
  const name = params.get('name');
  // Schritte 3 und 4 je Weg (MKT-004)
  try {
    const wege = JSON.parse(document.querySelector<HTMLElement>('[data-wege]')?.dataset.wege ?? '{}') as Record<string, { strong: string; span: string }[]>;
    (wege[params.get('weg') ?? ''] ?? []).forEach((s, i) => {
      const li = document.querySelector(`[data-schritt="${i}"]`);
      if (!li) return;
      li.querySelector('strong')!.textContent = s.strong;
      li.querySelector('span')!.textContent = s.span;
    });
  } catch { /* bleibt Standard */ }
  if (name) document.querySelector('[data-name]')!.textContent = `, ${name.slice(0, 30)}`;
  // Nächsten Werktag berechnen (Sa/So überspringen)
  const d = new Date();
  do d.setDate(d.getDate() + 1); while (d.getDay() === 0 || d.getDay() === 6);
  document.querySelector('[data-deadline]')!.textContent = d.toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long' });
</script>

<style>
  .thanks { text-align: center; }
  .thanks .lead { margin-inline: auto; }
  .thanks__icon { display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--ok); color: #fff; font-size: 2rem; font-weight: 800; margin-bottom: 20px; }
  .thanks h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .next { list-style: none; padding: 0; margin: 40px auto; max-width: 900px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 800px) { .next { grid-template-columns: repeat(4, 1fr); } }
  .next li { display: grid; justify-items: center; gap: 6px; padding: 20px 12px; background: var(--white); border: 1px solid var(--line); border-radius: 16px; color: var(--ink-soft); font-size: 0.9rem; }
  .next li strong { color: var(--ink); font-size: 1rem; }
  .next li.is-done { border-color: var(--ok); }
  .next li.is-done :global(.icon) { color: var(--ok); }
  .prep { max-width: 560px; margin: 0 auto; text-align: left; }
  .prep h2 { font-size: 1.2rem; }
  .prep h3 { font-size: 1rem; margin: 14px 0 6px; }
  .bisdahin { margin-top: 36px; }
  .bisdahin h2 { font-size: 1.2rem; }
  .bisdahin__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 0; }
  .prep ul { padding-left: 1.2em; margin: 0 0 12px; }
  .muted { color: var(--ink-soft); font-size: 0.92rem; margin: 0; }
  .back { margin-top: 32px; }
</style>
