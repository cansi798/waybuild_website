---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { company, phoneTel, whatsappLink, HOURS, WAAS } from '../config/site';
import Val from '../components/Val.astro';
import Hint from '../components/Hint.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { seitenSchema } from '../lib/schema';
const K_TITEL = 'Kontakt & kostenlose Erstberatung';
const K_TEXT = 'Kostenlose Erstberatung zum Website-Abo anfragen: persönliche Beratung, Antwort in der Regel am nächsten Werktag, unverbindlich und ohne Verkaufsdruck.';
import { leistungen } from '../config/leistungen';
import { ABO_PAKETE, KOMPLETTPAKET, EINMALIG_DAZU, BUCHEN, euro, einmalSumme, gesamtZeile, komplettPreis, komplettZeile, monatMitKomplett, einzelnMitKomplett } from '../config/pakete-abo';
import { VORSCHAU, vorschauText } from '../config/vorschau';
import { ANLIEGEN } from '../config/startseite';
// Anliegen ohne Paketbezug (Haupt-Knopf „Kostenlose Erstberatung“ in Hero, Kopfzeile, Leiste: ?paket=Kostenlose%20Erstberatung).
// Sie öffnen KEINE Paket-/Extras-Wahl und werden als „anliegen“ mitgesendet (Loop 22.11.2026, MKT-001).
const anliegenWerte = Object.values(ANLIEGEN).map((a) => a.paket);

const interessen = [
  // Jamil #5956–#5958 (15.11.2026): jedes Paket einzeln auswählbar, alle „Auf Anfrage“-Einträge entfernt
  ...ABO_PAKETE.map((p) => ({ value: p.id, label: `${p.name}: ${euro(p.preis)} im Monat netto` })),
  { value: 'rundum', label: `${KOMPLETTPAKET.name} (Website + Web-App): ${komplettPreis()} im Monat netto` },
];
const websiteSlugs = leistungen.filter((l) => l.saeule === 'websites').map((l) => l.slug);
// Paketwahl (Jamil #5056): ?paket=Plus (auch „Paket Plus“ oder „Plus (149,99 € / Monat)“) wählt das Paket vor,
// ?dazu=logo,papiere hakt Einmal-Leistungen an, ?dazu=alle (oder gesamtpaket) das Gesamtpaket „Alle vier Extras“
// (Jamil #5085–#5089). ?buchen=1 kommt vom Fenster „Paket anfragen“ (vorher „Direkt buchen“): Knopf „Paket anfragen“ (Jamil #6055 Fr. 18), Betreff „Buchung“.
// Komplettpaket (Jamil #5450–#5464): optional zusätzlich zu Basis oder Plus, ?komplett=1 (oder ?paket=Komplettpaket) hakt
// es an. Monatssumme mit Kombipreis, aber nicht zusammen mit dem Gesamtpaket „Alle vier Extras“ (Gründerpaket, #5464).
// Beides sichtbar und änderbar, gesendet als Text.
const kombiDaten = Object.fromEntries(ABO_PAKETE.map((p) => [p.id, {
  name: p.name, preis: p.preis, mit: monatMitKomplett(p.id), einzeln: einzelnMitKomplett(p.id), kombi: KOMPLETTPAKET.kombiPreis[p.id] != null,
}]));
const paketText = (p: (typeof ABO_PAKETE)[number]) => `${p.name} (${euro(p.preis)} / Monat netto)`;

// Versand: Jamil #6055 Fr. 3 – das Formular wird später mit unserem CRM verbunden. Bis dahin bleibt der Versand wie er ist
// (Web3Forms, falls ein Key gesetzt ist, sonst E-Mail-Programm). Beim CRM-Anschluss hier endpoint/Versand im Skript unten umstellen.
// Versand über Web3Forms (kostenlos, ohne eigenen Server). Der Access-Key ist laut Anbieter öffentlich nutzbar.
// Ohne Key öffnet sich als Rückfall das E-Mail-Programm. Key setzen: GitHub → Settings → Variables → WEB3FORMS_KEY
// Neues Aussehen im Stil der Startseite (Jamil Talk qh87y3sj #5892, 14.11.2026): Formular funktional unverändert
// (Felder, name-Attribute, IDs, data-*, Skript), nur der Rahmen und die Optik sind neu. Stil: src/styles/seite-kontakt.css (.sk-).
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const endpoint = formKey ? 'https://api.web3forms.com/submit' : '';
import '../styles/start-neu.css';
import '../styles/seite-kontakt.css';
---

<BaseLayout
  title={K_TITEL}
  description={K_TEXT}
  schema={[seitenSchema(Astro.site, 'ContactPage', '/kontakt/', K_TITEL, K_TEXT)]}
  breadcrumb={[{ name: 'Kontakt', path: '/kontakt/' }]}
  hideMobileCta
  ohneKontaktkopf
>
  <PageHeader
    eyebrow="Kontakt"
    title="Lassen Sie uns sprechen."
    lead="Antwort in der Regel am nächsten Werktag. Erstberatung kostenlos."
  />

  <section class="section sn sk" aria-labelledby="sk-form-h">
    <div class="wrap contact sk-raster">
      <div class="sk-formteil">
      <!-- von uns ergänzt (#5892): kurzer Kopf über dem Formular -->
      <div class="sk-kopf">
        <p class="sn-kenn">Kostenlose Erstberatung</p>
        <h2 id="sk-form-h" class="sn-h2 sn-h2--klein">Erzählen Sie uns kurz, worum es geht.</h2>
        <p class="sk-kopf__text">Ein paar Angaben genügen. Pflichtfelder sind mit * markiert.</p>
        <!-- Kostenlose Vorschau (Jamil #6061), Text zentral in config/vorschau.ts -->
        <p class="sk-vorschau"><strong>{VORSCHAU.titel}</strong><span>{vorschauText()}</span></p>
      </div>
      <form class="form card sk-form" id="contact-form" data-kombi={JSON.stringify(kombiDaten)} data-nur-mit-website={KOMPLETTPAKET.nurMitWebsite ? "1" : ""} data-ab={KOMPLETTPAKET.kombiAb ? '1' : ''} data-kombi-gruender={KOMPLETTPAKET.kombiMitGruenderpaket ? '1' : ''} data-komplett-name={KOMPLETTPAKET.name} data-endpoint={endpoint} data-key={formKey} data-mailto={company.email} data-absenden={BUCHEN.absenden} data-thanks={href('/danke/')} data-website-slugs={websiteSlugs.join(',')} data-anliegen={JSON.stringify(anliegenWerte)} novalidate>
        <label>Worum geht es?
          <select name="interesse">
            <option value="">Noch unsicher – bitte beraten Sie mich</option>
            {interessen.map((i) => <option value={i.value}>{i.label}</option>)}
          </select>
        </label>
        <fieldset class="wahl" id="wahl" hidden>
          <legend>Paket <small>(optional, ändern geht auch später)</small></legend>
          <select name="paket_wahl" aria-label="Paket">
            <option value="">Noch offen, bitte beraten Sie mich</option>
            {ABO_PAKETE.map((p) => <option value={p.id} data-name={p.name} data-text={paketText(p)}>{p.name}: {euro(p.preis)} im Monat netto</option>)}
          </select>
          <label class="wahl__opt wahl__opt--komplett"><input type="checkbox" name="komplett_wahl" value={KOMPLETTPAKET.id} data-text={komplettZeile()} /> <span>{KOMPLETTPAKET.name} dazu <b>{komplettPreis()}</b> im Monat netto <small>{KOMPLETTPAKET.kurz}</small>{KOMPLETTPAKET.nurMitWebsite && <small>Nur zusammen mit {ABO_PAKETE.map((p) => p.name).join(' oder ')} buchbar, bitte zuerst ein Paket wählen.</small>}</span></label>
          <p class="wahl__summe" id="wahl-monat" aria-live="polite" hidden>Monatlich: <b id="wahl-monat-b"></b> netto <small id="wahl-monat-statt"></small></p>
          <p class="wahl__kopf">{EINMALIG_DAZU.titel} <small>(optional, Festpreis netto)</small></p>
          <div class="wahl__dazu">
            {EINMALIG_DAZU.liste.map((e) => (
              <label class="wahl__opt"><input type="checkbox" name="einmalig_wahl" value={e.id} data-preis={e.preis} data-text={`${e.name} (${euro(e.preis)} einmalig netto)`} /> <span>{e.name} <b>{euro(e.preis)}</b></span></label>
            ))}
            <label class="wahl__opt wahl__opt--alle"><input type="checkbox" name="einmalig_alle" value={EINMALIG_DAZU.gesamt.id} data-preis={EINMALIG_DAZU.gesamt.preis} data-text={`${EINMALIG_DAZU.gesamt.name} als Gesamtpaket (${euro(EINMALIG_DAZU.gesamt.preis)} statt ${euro(einmalSumme())} einmalig netto): ${EINMALIG_DAZU.liste.map((e) => e.name).join(', ')}`} /> <span>{gesamtZeile()}</span></label>
          </div>
          <p class="wahl__summe" aria-live="polite">Extras einmalig: <b id="wahl-summe">0 €</b> netto</p>
          <p class="wahl__hinweis">{BUCHEN.kaufHinweis}</p>
        </fieldset>
        <div class="row">
          <label>Name*<input name="name" autocomplete="name" required /></label>
          <label>E-Mail*<input name="email" type="email" inputmode="email" autocomplete="email" required /></label>
        </div>
        <div class="row">
          <label><span>Telefon <small>(für Rückruf)</small></span><input name="telefon" type="tel" inputmode="tel" autocomplete="tel" /></label>
          <label>Unternehmen<input name="firma" autocomplete="organization" /></label>
        </div>
        <label><span>Nachricht <small>(optional)</small></span><textarea name="nachricht" rows="4" placeholder="z. B. Branche, Anzahl Mitarbeitende, bestehende Domain oder Software …"></textarea></label>
        <input type="hidden" name="branche" value="" />
        <input type="hidden" name="paket" value="" />
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="check-mit" id="check-mit" hidden>
          <p class="check-mit__kopf">Diese Angaben von der Startseite senden wir mit</p>
          <p class="check-mit__text" id="check-mit-text"></p>
          <button type="button" class="btn btn--ghost btn--sm" id="check-mit-weg">Nicht mitsenden</button>
        </div>
        <label class="check">
          <input type="checkbox" name="datenschutz" required />
          <span>Ich habe die <a href={href('/datenschutz/')}>Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage einverstanden.*</span>
        </label>
        <button class="btn btn--primary" type="submit">Kostenlose Erstberatung anfragen</button>
        <ol class="after" aria-label="So geht es weiter">
          <li><strong>Heute</strong> Anfrage senden</li>
          <li><strong>1 Werktag</strong> In der Regel melden wir uns</li>
          <li><strong>30 Min.</strong> Erstberatung</li>{/* Jamil #6055 Fr. 15 */}
        </ol>
        {!endpoint && (
          <Hint label="Formular-Versand (Anbindung an unser CRM folgt, Jamil #6055 Fr. 3)" where="src/pages/kontakt.astro (Versand) bzw. GitHub → Variables → WEB3FORMS_KEY">
            {' '}– aktuell öffnet sich nur das E-Mail-Programm.
          </Hint>
        )}
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
      </div>

      <!-- div statt aside: lag in einer section (axe landmark-complementary-is-top-level, Loop 22.11.2026) -->
      <div class="side sk-seite">
        <div class="card side__card sk-karte">
          <h2 id="sk-draht-h" class="sn-h4">Direkter Draht</h2>
          <p class="sk-karte__text">Lieber gleich sprechen? Erreichen Sie uns auch so.</p><!-- von uns ergänzt (#5892) -->
          <ul class="sk-wege">
            <li><a class="sk-weg" href={`tel:${phoneTel()}`}><Icon name="phone" size={20} /><span><small>Telefon</small>{company.phone}</span></a></li>
            <li><a class="sk-weg" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /><span><small>WhatsApp</small>Nachricht schreiben<span class="sr-only"> (öffnet in neuem Tab)</span></span></a></li>
            <li><a class="sk-weg" href={`mailto:${company.email}`}><Icon name="mail" size={20} /><span><small>E-Mail</small>{company.email}</span></a></li>
          </ul>
          <p class="muted sk-zeiten">{HOURS}</p>
          <p class="muted sk-adresse">{company.legalName}<br /><Val value={company.street} label="Straße" where="src/config/site.ts → company.street" /><br /><Val value={company.zip} label="PLZ" where="src/config/site.ts → company.zip" /> <Val value={company.city} label="Ort" where="src/config/site.ts → company.city" /></p>
        </div>
        <ul class="promise sk-versprechen">
          <li><strong>Antwort in der Regel am nächsten Werktag</strong>Persönlich, nicht automatisiert.</li>
          <li><strong>Kostenlos & unverbindlich</strong>Die Erstberatung kostet nichts.</li>
          <li><strong>Ehrliche Beratung</strong>Wir empfehlen, was Sie wirklich brauchen.</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    // Früher verlinkte Tarif-Parameter (?tarif=…) gelten als Website-Anfrage
    const tarif = new URLSearchParams(location.search).get('tarif');
    // Branche von der Branchen-Landingpage mitnehmen
    const branche = new URLSearchParams(location.search).get('branche');
    if (branche) (form.elements.namedItem('branche') as HTMLInputElement).value = branche.slice(0, 40);
    // Interesse aus ?leistung=… (Detailseiten) vorbelegen, Paket aus ?paket=… mitnehmen
    const params = new URLSearchParams(location.search);
    const interesse = form.elements.namedItem('interesse') as HTMLSelectElement;
    const websiteSlugs = (form.dataset.websiteSlugs ?? '').split(',');
    const leistung = params.get('leistung') ?? '';
    // ?dazu=… allein (Block „Neu starten oder neu aufstellen?“, Jamil #5283) zeigt ebenfalls die Paket- und Extras-Wahl
    // ?paket=Kostenlose Erstberatung (Haupt-Knopf) ist ein Anliegen, kein Paket: keine Paketwahl, Anliegen wird mitgesendet (MKT-001)
    const paketRoh = (params.get('paket') ?? '').trim();
    const anliegen = (JSON.parse(form.dataset.anliegen ?? '[]') as string[]).find((a) => a.toLowerCase() === paketRoh.toLowerCase()) ?? '';
    const paketKontext = websiteSlugs.includes(leistung) || !!tarif || (!!paketRoh && !anliegen) || !!params.get('dazu') || !!params.get('komplett');
    // ?leistung=rundum bzw. Auswahl „Website + Web-App“ (Jamil #5944): wie Website, mit angehaktem „Individuelle Software“
    if (leistung === 'rundum') interesse.value = 'rundum';
    // Paketwahl: sichtbar, sobald es um das Website-Abo geht; ?paket=… wählt vor (Groß-/Kleinschreibung egal).
    const wahl = document.getElementById('wahl') as HTMLFieldSetElement | null;
    const wahlSelect = form.elements.namedItem('paket_wahl') as HTMLSelectElement | null;
    const paket = anliegen ? '' : paketRoh;
    const norm = (t: string) => t.toLowerCase().replace(/^paket\s+/, '');
    // alte Werte (Basis/Plus, vor der Umbenennung am 14.11.2026) werden weiter akzeptiert
    const alt: Record<string, string> = { basis: 'basis', plus: 'plus' };
    const altId = alt[norm(paket).split(/[\s(]/)[0]];
    const treffer = wahlSelect ? [...wahlSelect.options].find((o) => (o.dataset.name && norm(paket).startsWith(o.dataset.name.toLowerCase())) || (altId && o.value === altId)) : undefined;
    // ?paket=Komplettpaket (oder Komplett) bzw. ?komplett=1 hakt das Komplettpaket an, Grundpaket bleibt wählbar
    const komplettBox = form.querySelector<HTMLInputElement>('input[name="komplett_wahl"]');
    const istKomplett = (t: string) => norm(t).startsWith('komplett') || norm(t).startsWith('rundum'); // „Individuelle Software“ seit #5936
    const komplettParam = params.get('komplett') === '1' || istKomplett(paket) || interesse.value === 'rundum';
    if (komplettBox && komplettParam) komplettBox.checked = true;
    if (treffer && wahlSelect) wahlSelect.value = treffer.value;
    // Auswahl „Worum geht es?“ = gewähltes Paket (#5957): Individuelle Software, sonst das erkannte Paket
    if (komplettParam) interesse.value = 'rundum';
    else if (treffer) interesse.value = treffer.value;
    else if (paketKontext && !interesse.value) interesse.value = '';
    else if (paket && !istKomplett(paket)) (form.elements.namedItem('paket') as HTMLInputElement).value = paket.slice(0, 60);
    // Komplettpaket nur zusammen mit Profi-Website oder Website + Google & KI (Jamil, Talk qh87y3sj #5642, 12.11.2026): ohne gewähltes Paket gesperrt und
    // nicht angehakt; ein Wunsch aus dem Link (?komplett=1) wird gemerkt und beim Wählen eines Pakets wieder angehakt.
    let komplettWunsch = komplettParam;
    const komplettPruefen = () => {
      if (!komplettBox || !wahlSelect) return;
      // seit Jamil #6400 einzeln buchbar: Sperre nur noch, wenn data-nur-mit-website gesetzt ist
      const ohnePaket = !wahlSelect.value && form.dataset.nurMitWebsite === '1';
      komplettBox.disabled = ohnePaket;
      komplettBox.checked = ohnePaket ? false : komplettBox.checked || komplettWunsch;
    };
    komplettBox?.addEventListener("change", () => { komplettWunsch = komplettBox!.checked; });
    wahlSelect?.addEventListener('change', komplettPruefen);
    komplettPruefen();
    const dazu = (params.get('dazu') ?? '').split(',').map((d) => d.trim()).filter(Boolean);
    const extras = [...form.querySelectorAll<HTMLInputElement>('input[name="einmalig_wahl"]')];
    const alle = form.querySelector<HTMLInputElement>('input[name="einmalig_alle"]');
    const gesamtGewaehlt = dazu.some((d) => ['alle', 'gesamtpaket', 'gesamt'].includes(d.toLowerCase()));
    extras.forEach((c) => { if (gesamtGewaehlt || dazu.includes(c.value)) c.checked = true; });
    // Gesamtpaket: wird gewählt, sobald alle vier angekreuzt sind; Abwählen eines Extras hebt es auf
    const summeEl = document.getElementById('wahl-summe');
    const eurS = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 }).format(n);
    // Monatlich (Paket + optional Komplettpaket): Kombipreis, außer zusammen mit dem Gesamtpaket der Extras (#5464)
    const kombi = JSON.parse(form.dataset.kombi ?? '{}') as Record<string, { name: string; preis: number; mit: number; einzeln: number; kombi: boolean }>;
    const abS = form.dataset.ab ? 'ab ' : '';
    const monatEl = document.getElementById('wahl-monat');
    let monatText = '';
    const monatSumme = () => {
      const p = kombi[wahlSelect?.value ?? ''];
      monatText = '';
      if (!monatEl) return;
      monatEl.hidden = !p;
      if (!p) return;
      const mitK = !!komplettBox?.checked;
      const gilt = mitK && p.kombi && (!alle?.checked || !!form.dataset.kombiGruender);
      const betrag = !mitK ? eurS(p.preis) : `${abS}${eurS(gilt ? p.mit : p.einzeln)}`;
      const statt = gilt ? `(Kombipreis ${p.name} + ${form.dataset.komplettName}, statt einzeln ${abS}${eurS(p.einzeln)})`
        : mitK && p.kombi && alle?.checked ? '(Einzelpreise: mit dem Gesamtpaket der Extras gilt kein Kombipreis)' : '';
      document.getElementById('wahl-monat-b')!.textContent = betrag;
      document.getElementById('wahl-monat-statt')!.textContent = statt;
      if (mitK) monatText = `${betrag} netto${statt ? ` ${statt}` : ''}`;
    };
    const extrasSumme = () => {
      if (alle && extras.every((c) => c.checked)) alle.checked = true;
      const betrag = alle?.checked ? Number(alle.dataset.preis) : extras.filter((c) => c.checked).reduce((s, c) => s + Number(c.dataset.preis), 0);
      if (summeEl) summeEl.textContent = eurS(betrag);
      monatSumme();
    };
    wahlSelect?.addEventListener('change', monatSumme);
    komplettBox?.addEventListener('change', monatSumme);
    extras.forEach((c) => c.addEventListener('change', () => { if (!c.checked && alle) alle.checked = false; extrasSumme(); }));
    alle?.addEventListener('change', () => { extras.forEach((c) => (c.checked = alle.checked)); extrasSumme(); });
    extrasSumme();
    const buchen = params.get('buchen') === '1';
    const absenden = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (buchen && absenden) absenden.textContent = form.dataset.absenden ?? 'Paket anfragen'; // Jamil #6055 Fr. 18
    const paketIds = [...(wahlSelect?.options ?? [])].map((o) => o.value).filter(Boolean);
    const mitPaket = () => interesse.value === 'rundum' || paketIds.includes(interesse.value);
    // Auswahl oben ↔ Paketwahl unten abgleichen (#5957): Paket gewählt → Paketwahl setzen, Individuelle Software → Haken setzen
    const zeigeWahl = () => {
      if (wahl) wahl.hidden = !mitPaket() && !paketKontext; // ?dazu=… (Extras) zeigt die Wahl auch ohne Paket
      if (!wahlSelect || !komplettBox) return;
      if (interesse.value === 'rundum') { if (!wahlSelect.value) wahlSelect.value = paketIds[0] ?? ''; komplettWunsch = true; }
      else if (paketIds.includes(interesse.value)) { wahlSelect.value = interesse.value; komplettWunsch = false; komplettBox.checked = false; }
      komplettPruefen();
    };
    komplettBox?.addEventListener('change', () => { if (komplettBox.checked) interesse.value = 'rundum'; else if (wahlSelect?.value) interesse.value = wahlSelect.value; });
    wahlSelect?.addEventListener('change', () => { if (interesse.value !== 'rundum' && wahlSelect.value) interesse.value = wahlSelect.value; });
    zeigeWahl();
    interesse.addEventListener('change', zeigeWahl);

    // Kundenreise-Check (Startseite, am 09.11.2026 entfernt, Jamil #5211–#5213; wird wie der Baukasten nur noch gelesen,
    // falls ein alter Tab offen ist): nur nach aktiver Wahl („Ergebnis mitschicken“). Sichtbar und abwählbar,
    // übertragen erst beim Absenden zusammen mit der Anfrage (sessionStorage, endet mit dem Tab).
    // 'wb-abo-baukasten' = Zusammenstellung vom früheren Startseiten-Stand (bis 08.11.2026); wird weiter gelesen,
    // falls ein alter Tab noch offen ist (JSON v2 oder reiner Text).
    let abo: { summeMonat: number; summeEinmalig: number } | null = null;
    const eurF = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', minimumFractionDigits: Math.round(n * 100) % 100 ? 2 : 0, maximumFractionDigits: 2 }).format(n);
    const aboText = (v: string) => {
      let d: { v?: number; monatlich?: [string, number][]; einmalig?: [string, number][]; anfrage?: string[]; summeMonat?: number; bruttoMonat?: number; summeEinmalig?: number; bruttoEinmalig?: number };
      try { d = JSON.parse(v); } catch { return v; }
      if (!d || d.v !== 2 || !Array.isArray(d.monatlich)) return v;
      abo = { summeMonat: Number(d.summeMonat), summeEinmalig: Number(d.summeEinmalig) };
      const teile = [
        'Monatlich:', ...d.monatlich.map(([n, p], i) => `${i ? '+ ' : ''}${n}: ${eurF(p)}`),
        `Summe monatlich: ${eurF(Number(d.summeMonat))} netto zzgl. MwSt. (${eurF(Number(d.bruttoMonat))} inkl. MwSt.)`,
      ];
      if (d.einmalig?.length) teile.push('', 'Einmalig (Festpreis):', ...d.einmalig.map(([n, p]) => `+ ${n}: ${eurF(p)}`),
        `Summe einmalig: ${eurF(Number(d.summeEinmalig))} netto zzgl. MwSt. (${eurF(Number(d.bruttoEinmalig))} inkl. MwSt.)`);
      if (d.anfrage?.length) teile.push('', `Auf Anfrage: ${d.anfrage.join(', ')}`);
      return teile.join('\n');
    };
    let checkText = '';
    const ueber: [string, string][] = [['wb-kundenreise-check', 'Kundenreise-Check'], ['wb-abo-baukasten', 'Frühere Auswahl']];
    try { checkText = ueber.map(([k, t]) => { const v = sessionStorage.getItem(k); return v ? `${t}:\n${k === 'wb-abo-baukasten' ? aboText(v) : v}` : ''; }).filter(Boolean).join('\n\n'); } catch { checkText = ''; }
    const checkBox = document.getElementById('check-mit');
    if (checkText && checkBox) {
      document.getElementById('check-mit-text')!.textContent = checkText;
      checkBox.hidden = false;
      document.getElementById('check-mit-weg')?.addEventListener('click', () => {
        checkText = ''; abo = null;
        try { ueber.forEach(([k]) => sessionStorage.removeItem(k)); } catch { /* egal */ }
        checkBox.hidden = true;
      });
    }
    const mitCheck = (nachricht: string) => (checkText ? `${nachricht ? `${nachricht}\n\n` : ''}${checkText}` : nachricht);

    const interessText = (d: Record<string, string>) => (!d.interesse && anliegen ? anliegen : null) ?? interesse.querySelector<HTMLOptionElement>(`option[value="${CSS.escape(d.interesse ?? '')}"]`)?.textContent ?? 'Beratung';
    const status = form.querySelector<HTMLElement>('.form__status')!;
    // Eigene Fehlermeldungen unter JEDEM fehlenden Pflichtfeld statt nur der Browser-Blase am ersten (Jamil #6038, Audit B4).
    // Verknüpft per aria-describedby + aria-invalid, verschwindet beim Korrigieren; Fokus auf das erste fehlende Feld.
    const meldung = (f: HTMLInputElement) => {
      if (f.type === 'checkbox') return 'Bitte stimmen Sie der Datenschutzerklärung zu.';
      if (f.validity.valueMissing) return f.name === 'email' ? 'Bitte geben Sie Ihre E-Mail-Adresse an.' : 'Bitte geben Sie Ihren Namen an.';
      return 'Bitte prüfen Sie die E-Mail-Adresse (zum Beispiel name@firma.de).';
    };
    const pflicht = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));
    const zeigeFehler = (f: HTMLInputElement) => {
      const id = `fehler-${f.name}`;
      let el = document.getElementById(id);
      if (f.validity.valid) { el?.remove(); f.removeAttribute('aria-invalid'); f.removeAttribute('aria-describedby'); return true; }
      if (!el) {
        el = document.createElement('span');
        el.id = id; el.className = 'form__fehler';
        (f.type === 'checkbox' ? f.closest('label')! : f).insertAdjacentElement('afterend', el);
      }
      el.textContent = meldung(f);
      f.setAttribute('aria-invalid', 'true'); f.setAttribute('aria-describedby', id);
      return false;
    };
    pflicht.forEach((f) => f.addEventListener(f.type === 'checkbox' ? 'change' : 'input', () => { if (f.hasAttribute('aria-invalid')) zeigeFehler(f); }));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fehlend = pflicht.filter((f) => !zeigeFehler(f));
      if (fehlend.length) { fehlend[0].focus(); return; }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.website) return; // Honeypot: Bots füllen das versteckte Feld aus
      delete data.website;
      data.nachricht = mitCheck(data.nachricht ?? '');
      // Paketwahl als lesbarer Text: gewähltes Paket vor einem evtl. Anliegen-Text (z. B. vom Check), Einmal-Leistungen als Liste
      delete data.paket_wahl; delete data.einmalig_wahl; delete data.einmalig_alle; delete data.komplett_wahl;
      const gewaehlt = mitPaket() ? wahlSelect?.selectedOptions[0]?.dataset.text ?? '' : '';
      if (gewaehlt) data.paket = data.paket ? `${gewaehlt}; ${data.paket}` : gewaehlt;
      if (mitPaket() && komplettBox?.checked) {
        data.komplettpaket = komplettBox.dataset.text ?? form.dataset.komplettName ?? '';
        if (monatText) data.monatlich = monatText;
        if (data.paket) data.paket = `${data.paket} + ${form.dataset.komplettName}`; // ohne Grundpaket nicht wählbar (#5642)
      }
      const einmalig = !mitPaket() ? [] : alle?.checked ? [alle.dataset.text ?? 'Alle vier Extras'] : extras.filter((c) => c.checked).map((c) => c.dataset.text ?? c.value);
      if (anliegen) data.anliegen = anliegen; // MKT-001: z. B. „Kostenlose Erstberatung“ vom Haupt-Knopf
      if (buchen) data.anliegen = 'Paketanfrage über „Paket anfragen“ (Vertrag und Auftragsbestätigung per E-Mail)'; // Jamil #6055 Fr. 18
      if (einmalig.length) data.einmalig = einmalig.join(', ');
      // Summen der früheren Zusammenstellung zusätzlich als eigene Felder (nur alter Stand)
      const a = abo as { summeMonat: number; summeEinmalig: number } | null;
      if (a) { data.abo_monatlich = `${eurF(a.summeMonat)} netto`; data.abo_einmalig = `${eurF(a.summeEinmalig)} netto`; }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        const body = `Name: ${data.name}\nUnternehmen: ${data.firma}\nE-Mail: ${data.email}\nTelefon: ${data.telefon}\nInteresse: ${interessText(data)}${data.anliegen && data.anliegen !== interessText(data) ? `\nAnliegen: ${data.anliegen}` : ''}${data.paket ? `\nPaket: ${data.paket}` : ''}${data.monatlich ? `\nMonatlich: ${data.monatlich}` : ''}${data.einmalig ? `\nEinmalig dazu: ${data.einmalig}` : ''}${data.branche ? `\nBranche: ${data.branche}` : ''}\n\n${data.nachricht}`;
        location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(`${buchen ? 'Buchung' : 'Anfrage'}: ${interessText(data)}`)}&body=${encodeURIComponent(body)}`;
        status.textContent = 'Ihr E-Mail-Programm hat sich geöffnet. Bitte senden Sie die Nachricht dort ab.';
        return;
      }
      status.textContent = 'Wird gesendet …';
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...data,
            access_key: form.dataset.key,
            subject: `${buchen ? 'Buchung' : 'Anfrage'}: ${interessText(data)}${data.paket ? ` – ${data.paket}` : ''}${data.branche ? ` (${data.branche})` : ''}`,
            from_name: 'webgold Website',
            replyto: data.email,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(String(res.status));
        // Abschluss der Journey: Danke-Seite mit nächsten Schritten
        try { ueber.forEach(([k]) => sessionStorage.removeItem(k)); } catch { /* egal */ }
        location.href = `${form.dataset.thanks}?name=${encodeURIComponent(data.name.split(' ')[0])}${buchen ? '&weg=buchung' : ''}`; // Danke je Weg (MKT-013)
      } catch {
        button.disabled = false;
        status.textContent = `Das hat leider nicht geklappt. Bitte schreiben Sie uns direkt an ${form.dataset.mailto}.`;
      }
    });
  }
</script>

