---
// Weiterleitung /referenzen/ → /beispiele/ (Jamil, Talk qh87y3sj #5322, Q5, 09.11.2026: „Referenzen“ heißt jetzt „Beispiele“).
// Eigene Seite statt Astro-redirects, weil diese den Base-Pfad der Vorschau nicht setzen. noindex, canonical auf /beispiele/,
// nicht in der Sitemap (astro.config.mjs). Bewusst ohne BaseLayout, damit Meta-Refresh und Canonical im <head> stehen.
import { href, absolute } from '../lib/paths';

const ziel = href('/beispiele/');
const canonical = absolute('/beispiele/', Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Beispiele aus unserer Arbeit | Waybuild</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${ziel}`} />
    <style>body { margin: 0; padding: 40px 16px; background: #ffffff; color: #1a1a1a; font: 1.0625rem/1.7 system-ui, sans-serif; } a { color: #006b68; }</style>
  </head>
  <body>
    <p>Diese Seite heißt jetzt „Beispiele“: <a href={ziel}>Beispiele aus unserer Arbeit</a></p>
    <script is:inline define:vars={{ ziel }}>location.replace(ziel);</script>
  </body>
</html>
