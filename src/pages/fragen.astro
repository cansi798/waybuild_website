---
// Seite „Häufige Fragen“ (Jamil, Talk qh87y3sj #5136–#5138, 08.11.2026): alle Fragen ohne Doppelte, nach Themen,
// aufklappbar (<details>), FAQPage-JSON-LD. Daten: src/config/fragen.ts (Quellen site.ts faqs + pakete-abo.ts FAQ_PAKETE).
// Verlinkt NUR im Footer (Spalte „Unternehmen“), nicht in der Navigation. In der Sitemap (Standard).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SHOW_HINTS } from '../config/site';
import { IS_PREVIEW } from '../lib/env';
import { FRAGEN_TITEL, fragenNachThema } from '../config/fragen';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import '../styles/start-neu.css';
import '../styles/seite-fragen.css';
// Neues Aussehen im Stil der Startseite (Jamil Talk qh87y3sj #5892, 14.11.2026): Themen links (am PC mitlaufend), Fragen rechts als
// ruhige Akkordeon-Liste mit feinen Linien; Abschluss wie auf der Startseite (SnAbschluss). Stil: src/styles/seite-fragen.css (.sf-).

const zeigePlatzhalter = SHOW_HINTS && IS_PREVIEW;
const gruppen = fragenNachThema()
  .map((g) => ({ ...g, fragen: g.fragen.filter((f) => !f.platzhalter || zeigePlatzhalter) }))
  .filter((g) => g.fragen.length);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: gruppen.flatMap((g) => g.fragen).filter((f) => !f.platzhalter)
    .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title={FRAGEN_TITEL}
  description="Häufige Fragen zu Website as a Service bei waybuild: Pakete und Preise, Ablauf, Technik und Betreuung, Vertrag und Laufzeit."
  breadcrumb={[{ name: FRAGEN_TITEL, path: '/fragen/' }]}
  schema={[faqLd]}
>
  <PageHeader eyebrow="Fragen und Antworten" title={FRAGEN_TITEL} lead="Die wichtigsten Antworten auf einen Blick. Ihre Frage ist nicht dabei? Wir antworten in der Regel am nächsten Werktag." />

  <section class="section sn sf" aria-label="Fragen nach Themen">
    <div class="wrap sf-raster">
      <nav class="sf-themen" aria-label="Themen">
        <p class="sf-themen__kopf">Themen</p>
        <ul>
          {gruppen.map((g) => <li><a href={`#${g.id}`}>{g.titel}<span class="sf-themen__zahl" aria-hidden="true">{g.fragen.length}</span></a></li>)}
        </ul>
      </nav>
      <div class="sf-gruppen">
        {gruppen.map((g, gi) => (
          <section class="sf-gruppe" id={g.id} aria-labelledby={`${g.id}-h`}>
            <div class="sf-gruppe__kopf">
              <span class="sf-gruppe__nr" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</span>
              <h2 id={`${g.id}-h`} class="sn-h3">{g.titel}</h2>
            </div>
            <div class="sf-liste">
              {g.fragen.map((f) => (
                <details class:list={['sf-frage', { 'sf-frage--platzhalter': f.platzhalter }]}>
                  <summary><h3>{f.q}</h3><span class="sf-frage__zeichen" aria-hidden="true"></span></summary>
                  <div class="sf-frage__antwort">
                    {f.platzhalter && <span class="sf-etikett">Platzhalter, nur Vorschau</span>}
                    <p>{f.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <SnAbschluss />
</BaseLayout>

