---
// Startseite nach dem Bauwelt-Muster (Wunsch 11.10.2026), übertragen auf „Websites im Abo“ (B2B):
// 1 Vollbild-Hero → 2 Zahlen-Band → 3 Leistungs-Kacheln → 4 Ablauf-Zeichnung → 5 Referenz-Slider (Muster)
// → 6 Betreuung („Alles im Blick“) → 7 Tarife + Tarif-Finder → 8 Versprechen-Siegel → 9 Branchen-Band
// → 10 Warum kein WordPress → 11 FAQ → Footer-Kopf mit Direktkontakt (im Footer).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import LeistungKarten from '../components/LeistungKarten.astro';
import Ablauf from '../components/Ablauf.astro';
import RefSlider from '../components/RefSlider.astro';
import Betreuung from '../components/Betreuung.astro';
import TarifSektion from '../components/TarifSektion.astro';
import Siegel from '../components/Siegel.astro';
import Industries from '../components/Industries.astro';
import WhyNotWordPress from '../components/WhyNotWordPress.astro';
import Faq from '../components/Faq.astro';
import { faqSchema, serviceSchema } from '../lib/schema';
import { plans } from '../config/site';

const cheapest = Math.min(...plans.map((p) => p.monthly));
---

<BaseLayout
  title="Website im Abo für Unternehmen – individuell & betreut | waybuild"
  description={`Individuelle Website im Abo ab ${cheapest} €/Monat netto: Design, Hosting, Domain, unbegrenzte E-Mails & Pflege inklusive. Für Unternehmen (B2B). Live in 14 Tagen.`}
  schema={[serviceSchema(Astro.site), faqSchema()]}
>
  <Hero />
  <Stats />
  <LeistungKarten />
  <Ablauf />
  <RefSlider />
  <Betreuung />
  <TarifSektion />
  <Siegel />
  <Industries />
  <WhyNotWordPress />
  <Faq />
</BaseLayout>
