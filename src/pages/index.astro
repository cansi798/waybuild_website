---
// Startseite – B2B entlang der Customer Journey (Feedback Jamil, 19.10.2026):
// 1 Hero (Nutzen + Preisanker + Erstgespräch) → 2 Problem → Lösung (Schmerzpunkte, „eine Sprachnachricht genügt“)
// → 3 Preise: zwei Varianten (Website / Intelligente Website) → 4 Was die intelligente Website macht (Beispiel)
// → 5 Ablauf in vier Schritten → 6 Service-Versprechen (SLAs in Alltagssprache) → 7 Zielgruppen
// → 8 Plattform-Ausblick → 9 FAQ → Footer-Kopf mit Direktkontakt (CTA).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Schmerzpunkte from '../components/Schmerzpunkte.astro';
import Pakete from '../components/Pakete.astro';
import Vision from '../components/Vision.astro';
import Ablauf from '../components/Ablauf.astro';
import Siegel from '../components/Siegel.astro';
import Zielgruppen from '../components/Zielgruppen.astro';
import Plattform from '../components/Plattform.astro';
import Faq from '../components/Faq.astro';
import { serviceSchema, faqSchema } from '../lib/schema';
import { PAKETE, formatEuro } from '../config/site';
---

<BaseLayout
  title="Website as a Service für Unternehmen"
  description={`Website as a Service für KMU: persönliche Beratung, KI-gestützte Umsetzung, Änderungen per Sprachnachricht. Ab ${formatEuro(PAKETE[0].preis)} im Monat, 0 € Einrichtung, zzgl. MwSt.`}
  schema={[serviceSchema(Astro.site), faqSchema()]}
>
  <Hero />
  <Schmerzpunkte />
  <Pakete />
  <Vision />
  <Ablauf />
  <Siegel />
  <Zielgruppen />
  <Plattform />
  <Faq />
</BaseLayout>
