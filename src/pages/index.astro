---
// STARTSEITE der waybuild Website. Neudesign unter dem Hero am 13.11.2026 (Jamil, Sprachnachricht Talk qh87y3sj #5810:
// „komplett neu designen, passend zu unserem Design … Hero nicht anfassen“; Sicherung Tag vor-startseite-neudesign-20261113).
// Sechs Teile (abgestimmt #5787–#5791): 1 Aufmerksamkeit = Hero (UNVERÄNDERT: Markup, Texte, variante-start.css) + zwei Produkte
// (gleitet über den stehenden Hero, .stapel-paar + scripts/stapel.ts) · 2 Problem · 3 Lösung (Kundenreise mit Leistungen je Station,
// Beispiel-Film) · 4 Beweis (echte Projekte, „Ganz entspannt“, Team nur Vorschau) · 5 Angebot (Pakete, Sicherheit, Fragen)
// · 6 Handlung (Ablauf + Erstberatung). Komponenten src/components/startneu/, Texte src/config/startneu.ts, Stil src/styles/start-neu.css.
// SEIT 14.11.2026 neue Reihenfolge nach Jamils Konzept (Talk qh87y3sj #5843–#5855, Sicherung Tag vor-jamil-konzept-20261114):
// Hero (neue Texte, Design gleich) → „Ganz gleich, wo Sie gerade stehen.“ (SnWege, gleitet über den Hero) → „Kommt Ihnen das bekannt
// vor?“ (SnProblem) → Phasen (SnPhasen) → Website + WebApp (SnSystem) → Partner (SnPartner) → Abschluss (SnAbschluss).
// Produkte, Kundenreise, Beweis, Angebot und Handlung sind nicht mehr auf der Startseite (Komponenten bleiben im Ordner).
// Frühere Stände und Entscheidungen: Git-Verlauf und Tags (z. B. vor-startseite-6abschnitte-20261113).
// WICHTIG: In dieser Datei KEIN <style>-Block (Astro würde sonst data-astro-cid-Attribute an den Hero hängen).
import BaseLayout from '../layouts/BaseLayout.astro';
import SnWege from '../components/startneu/SnWege.astro';
import SnProblem from '../components/startneu/SnProblem.astro';
import SnPhasen from '../components/startneu/SnPhasen.astro';
import SnSystem from '../components/startneu/SnSystem.astro';
import SnPartner from '../components/startneu/SnPartner.astro';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import { serviceSchema } from '../lib/schema';
import { href } from '../lib/paths';
import { ABO_PAKETE, KOMPLETTPAKET, aboPreisAb, euro, komplettPreis } from '../config/pakete-abo';
import { V_HERO, HERO_KNOPF } from '../config/variante';
import { ANLIEGEN } from '../config/startseite';
import '../styles/startseite.css';
import '../styles/variante-start.css';
import '../styles/start-neu.css';

const kontakt = (paket: string) => href(`/kontakt/?paket=${encodeURIComponent(paket)}`);

// Hero (Jamil #5061/#5062, #5114): unverändert
const ab = aboPreisAb();
/** Hero: Satz in Wörter teilen (je Wort ein span, Jamil #5114) */
const woerter = (t: string) => t.split(/\s+/).filter(Boolean);
const V_TITEL = 'Website-Abo: fertig betreut, fester Monatspreis';
const V_DESCRIPTION = `Website, E-Mail und Google-Profil in zwei festen Paketen ab ${euro(ab)} im Monat netto, ohne Einrichtungskosten. Hosting in Deutschland.`;
const V_SERVICE = `Website-Abo für kleine und mittlere Unternehmen: Wir erstellen die Website, richten E-Mail-Postfächer und Google-Profil ein und betreuen alles danach. Zwei feste Pakete (${ABO_PAKETE.map((p) => `${p.name} ${euro(p.preis)}`).join(', ')} im Monat netto), optional dazu das ${KOMPLETTPAKET.name} mit Auftragsverwaltung (${komplettPreis()} im Monat netto), keine Einrichtungskosten; Logo, Signatur, Geschäftspapiere und Visitenkarten einmalig dazubuchbar.`;
// FAQPage-JSON-LD nur auf /fragen/ (Jamil #5136–#5138); die sechs Fragen unten im Angebot sind sichtbarer Text ohne Schema.
---

<BaseLayout
  title={V_TITEL}
  description={V_DESCRIPTION}
  schema={[serviceSchema(Astro.site, V_SERVICE)]}
  thema="besucherreise"
  stapel
>
  <!-- Erster Bildschirm (Jamil #5085–#5124): ganz in Türkis, mittig, ohne Preise, ein Knopf, vier kurze Vorteile unten im selben Verlauf; weicher, sehr
       langsam bewegter Mesh-Verlauf (4 Farbflächen, nur CSS) statt Linienmuster; Einblenden Wort für Wort (variante-start.css). -->
  <!-- Stapel nur am Hero (Jamil, Talk qh87y3sj #5152–#5155, 09.11.2026): .stapel-paar umschließt Hero und „Was wir für Sie machen.“ (seit 13.11.2026, vorher Kundenreise); nur darin
       bleibt der Hero stehen (sticky), die Kundenreise gleitet darüber. Danach scrollt die Seite ganz normal (stapel.ts). -->
  <div class="stapel-paar">
  <section class="v-hero"><!-- ohne aria-labelledby: gleicher Satz wie die alte H2 weiter unten (axe landmark-unique) -->
    <div class="v-mesh" aria-hidden="true"><span class="v-blob v-blob--1"></span><span class="v-blob v-blob--2"></span><span class="v-blob v-blob--3"></span><span class="v-blob v-blob--4"></span></div>
    <div class="wrap v-hero__mitte">
      <!-- Wort für Wort wie firma.de (Jamil #5114): jedes Wort ein span mit --i (Reihenfolge), nur CSS. Die H1 hat den ganzen
           Satz als aria-label, die Wort-spans sind aria-hidden; Leerzeichen bleiben echte Textknoten (Kopieren = normaler Text). -->
      <h1 id="v-h1" class="v-titel" aria-label={V_HERO.titel}>{woerter(V_HERO.titel).map((w, i) => <><span class="v-wort" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>)}</h1>
      <!-- Unterzeile: was wir technisch übernehmen (Jamil, Talk qh87y3sj #5159–#5168, 09.11.2026). „Für Gründer …“ entfernt (#5165);
           blendet als Ganzes nach der H1 ein (nicht Wort für Wort, dafür ist der Satz zu lang). -->
      <p class="lead v-unter v-ein v-ein--2">{V_HERO.unter}</p>
      <!-- Ein Knopf (#5121–#5124): weiß, Schrift #006b68, sanfter Lichtschein alle 3 s + Glanz (variante-start.css) -->
      <div class="v-knopfe v-ein v-ein--3">
        <a class="btn v-leucht" href={kontakt(ANLIEGEN.erstberatung.paket)}>{HERO_KNOPF}</a>
      </div>
      <!-- Vertrauenshinweis unter dem Knopf (Jamil #5847, 14.11.2026) -->
      <p class="v-fuer v-ein v-ein--4">{V_HERO.fuer}</p>
    </div>
    <!-- Leiste mit vier Vorteilen entfernt (Jamil, Talk qh87y3sj #5166, 09.11.2026) -->
  </section>

  <!-- „Ganz gleich, wo Sie gerade stehen.“ (Jamil #5848) gleitet über den stehenden Hero -->
  <SnWege />
  </div>

  <SnProblem />
  <SnPhasen />
  <SnSystem />
  <SnPartner />
  <SnAbschluss />
</BaseLayout>

<script>
  import '../scripts/stapel.ts';
  import '../scripts/start-neu.ts';
</script>
