---
// STARTSEITE der waybuild Website (Stand 06.11.2026 abends). Alle Texte WÖRTLICH von Jamil (Talk qh87y3sj):
//   Hero (Headline 4771, Subheadline 4783, Kundengeschichte in fünf Stationen 4784)
//   · 2 Bausteine, die nicht passen (4786/4787; Abschnitt 1 auf Jamils Wunsch entfernt, 4806)
//   · 3 Verstehen. Empfehlen. Umsetzen. (4788) + Woran wir glauben (4795/4796) in einem Abschnitt (4809, #denkweise) · 4 Vier Bereiche + Pakete (4789)
//   · 5 Darauf können Sie sich verlassen (entfernt 08.11., #5136–#5138) · Check (#check, Vorschlag aus 4768; entfernt 09.11., #5211–#5213) · Abschluss (4792) · Claim (4793)
// 08.11.2026 „einladender“ (Jamil 4927/4929, Rethinking NC Rethinking_Startseite-einladend_2026-11-08; Sicherung Branch
//   vor-einladend-20261108): Claim oben im Hero, Prinzipien mit Zeichen + Linie, „Verlassen“ hinter die Prinzipien,
//   Leistungsdetails zum Aufklappen. Texte unverändert.
// 08.11.2026 (Jamil #4983–#4989; Sicherung Branch vor-hero-bausteine-20261108): Hero ohne Claim- und Zielgruppenzeile,
//   Bausteine als vier getrennte Module mit verlorener Anfrage (statt Puzzle), Erstberatung in #denkweise integriert
//   (vier Schritte Verstehen/Empfehlen/Umsetzen/Verbessern), eigener Abschnitt „So läuft die Erstberatung“ entfernt.
// Sicherung des Stands vom 05.11.: Branch vor-unternehmensauftritt-20261106.
// Texte in src/config/startseite.ts, Stil in src/styles/startseite.css (Bewegung: kundenreise.ts, stapel.ts; startseite.ts und vorgehen.ts am 09.11. entfernt)
// (nur transform/opacity/stroke-dashoffset). Farben seit 08.11.2026 (Jamil #5008) wieder CI-Türkis wie alle Seiten; thema="besucherreise" steuert nur noch Kopf/Fuß-Inhalte.
// Die alte Startseite (/hauptseite-alt/) ist gelöscht (Jamil, Talk qh87y3sj #5322, Q8); Sicherung Branch vor-aufraeumen-20261109.
//
// 08.11.2026 19:23 (Jamil, Talk qh87y3sj #5061/#5062 „Go“/„Ok“; Sicherung Branch vor-variante-start-20261108 = 80ba83c):
//   OBEN steht jetzt die KOMPLETTE Startseite der Variante „an firma.de orientiert“ (Einstieg, Vertrauensleiste, Kontrastsatz,
//   Pakete, Vergleich, Zeitleiste, Was Sie beitragen (entfernt 09.11., #5211–#5213), Fragen und Antworten, Abschluss; Code aus archiv/variante-firma-20261108,
//   Texte src/config/variante.ts, Pakete/Preise/FAQ aus src/config/pakete-abo.ts). Ohne Banner und Navigation der Variante,
//   ohne Gründungspaket, Links auf /variante/… → /preise/.
//   DARUNTER alle bisherigen Abschnitte unverändert, getrennt durch „Bisherige Startseite, zum Aussortieren“ (nur Vorschau).
//   Jamil sortiert selbst aus. Doppelte IDs: alte Blöcke mit Suffix -alt (#pakete-alt samt #baukasten-alt am 08.11. entfernt, #5136–#5138);
//   #pakete und #baukasten zeigen auf den neuen Teil; #check (Kundenreise-Check) seit 09.11. entfernt (#5211–#5213).
//   Der bisherige Hero ist ein zweiter Block mit H2 statt H1 (Text gleich), damit die Seite genau eine H1 hat.
// 09.11.2026 (Jamil, Talk qh87y3sj #5181–#5187; Sicherung Branch vor-kundenreise-20261109): nach dem Hero die Kundenreise als
//   Journey-Map (#kundenreise), danach „So arbeiten wir.“ (#arbeitsweise). Entfernt: „Einzelne Lösungen funktionieren.“
//   (Bausteine) und „Ein Kunde interessiert sich nicht für Ihre Systeme.“ (#loesungen); BAUSTEINE/BEREICHE/BAUKASTEN-Daten
//   sind aus startseite.ts entfernt (Baukasten-Daten liegen bei der archivierten Komponente unter archiv/baukasten-20261108/).
// 09.11.2026 (Jamil, Talk qh87y3sj #5188, „ok 2b 3 ja“ #5190; Sicherung Branch vor-so-gehen-wir-vor-20261109): nach der Kundenreise
//   „So gehen wir vor“ (Verstehen, Verbinden, Verbessern; Komponente start/SoGehenWirVor.astro, Texte config/vorgehen.ts). Er trägt
//   jetzt die Anker #denkweise und #erstberatung; der alte Abschnitt „Verstehen. Empfehlen. Umsetzen. Verbessern.“ (VERSTEHEN) ist entfernt.
// 09.11.2026 (Jamil, Talk qh87y3sj #5192, „ok“ #5194; Sicherung Branch vor-prinzipien-volltext-20261109): „So arbeiten wir.“ (#arbeitsweise)
//   mit Jamils vollem Text (start/Prinzipien.astro, PRINZIPIEN in config/vorgehen.ts) statt der kurzen Fassung (ARBEITSWEISE entfernt).
import BaseLayout from '../layouts/BaseLayout.astro';
import SoGehenWirVor from '../components/start/SoGehenWirVor.astro';
import Vorteile from '../components/start/Vorteile.astro';
import Sichtbarkeit from '../components/sichtbarkeit/Sichtbarkeit.astro';
import PaketKarten from '../components/pakete/PaketKarten.astro';
import EinmaligDazu from '../components/pakete/EinmaligDazu.astro';
import KomplettKarte from '../components/pakete/KomplettKarte.astro';
import VVergleich from '../components/variante/VVergleich.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../config/site';
import { SEITEN_FOTO } from '../config/bilder';
import { serviceSchema } from '../lib/schema';
import { href } from '../lib/paths';
import { IS_PREVIEW } from '../lib/env';
import { SHOW_HINTS } from '../config/site';
import { B2B_HINWEIS, ABO_PAKETE, KOMPLETTPAKET, aboPreisAb, euro, komplettPreis, LAUFZEIT_HINWEIS } from '../config/pakete-abo';
import { V_HERO, HERO_KNOPF, KUNDENREISE, VERGLEICH } from '../config/variante';
import { ANLIEGEN, TEAM, STIMMEN, ABSCHLUSS } from '../config/startseite';
import '../styles/startseite.css';
import '../styles/variante-start.css';
import '../styles/kundenreise.css';
import '../styles/fotos-start.css';

/** Symbol je Station der Kundenreise (Bühne, 12.11.2026): Aufmerksamkeit, Vertrauen, Anfrage, Bearbeitung, Betreuung */
const KR_SYMBOL: IconName[] = ['eye', 'shield', 'chat', 'ablauf', 'users'];
const kontakt = (paket: string) => href(`/kontakt/?paket=${encodeURIComponent(paket)}`);
// Platzhalter (Team-Fotos, Kundenstimmen; Jamil #4934) nur in der Vorschau, solange die Hinweise an sind
const PLATZHALTER = SHOW_HINTS && IS_PREVIEW;
// „Was unsere Kunden sagen“ (#stimmen) ausgeblendet, Jamil #5289; erst mit echten, freigegebenen Zitaten wieder einschalten
const STIMMEN_ZEIGEN = false;

// Neuer Teil oben (Variante-Startseite, Jamil #5061/#5062)
const ab = aboPreisAb();
/** Hero: Satz in Wörter teilen (je Wort ein span, Jamil #5114) */
const woerter = (t: string) => t.split(/\s+/).filter(Boolean);
const V_TITEL = 'Website-Abo: fertig betreut, fester Monatspreis';
const V_DESCRIPTION = `Website, E-Mail und Google-Profil in zwei festen Paketen ab ${euro(ab)} im Monat netto, ohne Einrichtungskosten. Hosting in Deutschland.`;
const V_SERVICE = `Website-Abo für kleine und mittlere Unternehmen: Wir erstellen die Website, richten E-Mail-Postfächer und Google-Profil ein und betreuen alles danach. Zwei feste Pakete (${ABO_PAKETE.map((p) => `${p.name} ${euro(p.preis)}`).join(', ')} im Monat netto), optional dazu das ${KOMPLETTPAKET.name} mit Auftragsverwaltung (${komplettPreis()} im Monat netto), keine Einrichtungskosten; Logo, Signatur, Geschäftspapiere und Visitenkarten einmalig dazubuchbar.`;
// FAQPage-JSON-LD der Startseite entfällt: die Fragen stehen seit #5136–#5138 auf /fragen/ (dort mit JSON-LD)


---

<BaseLayout
  title={V_TITEL}
  description={V_DESCRIPTION}
  schema={[serviceSchema(Astro.site, V_SERVICE)]}
  thema="besucherreise"
  stapel
>
  <!-- ============ NEU OBEN: Startseite der Variante „an firma.de orientiert“ (Jamil #5061/#5062, 08.11.2026) ============ -->
  <!-- Erster Bildschirm (Jamil #5085–#5124): ganz in Türkis, mittig, ohne Preise, ein Knopf, vier kurze Vorteile unten im selben Verlauf; weicher, sehr
       langsam bewegter Mesh-Verlauf (4 Farbflächen, nur CSS) statt Linienmuster; Einblenden Wort für Wort (variante-start.css). -->
  <!-- Stapel nur am Hero (Jamil, Talk qh87y3sj #5152–#5155, 09.11.2026): .stapel-paar umschließt Hero und Kundenreise; nur darin
       bleibt der Hero stehen (sticky), die Kundenreise gleitet darüber. Danach scrollt die Seite ganz normal (stapel.ts). -->
  <div class="stapel-paar">
  <section class="v-hero"><!-- ohne aria-labelledby: gleicher Satz wie die alte H2 weiter unten (axe landmark-unique) -->
    <div class="v-mesh" aria-hidden="true"><span class="v-blob v-blob--1"></span><span class="v-blob v-blob--2"></span><span class="v-blob v-blob--3"></span><span class="v-blob v-blob--4"></span></div>
    <div class="wrap v-hero__mitte">
      <!-- Wort für Wort wie firma.de (Jamil #5114): jedes Wort ein span mit --i (Reihenfolge), nur CSS. Die H1 hat den ganzen
           Satz als aria-label, die Wort-spans sind aria-hidden; Leerzeichen bleiben echte Textknoten (Kopieren = normaler Text). -->
      <h1 id="v-h1" class="v-titel" aria-label={V_HERO.titel}>{woerter(V_HERO.titel).map((w, i) => <><span class="v-wort" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>)}</h1>
      <!-- Unterzeile: was wir technisch übernehmen (Jamil, Talk qh87y3sj #5159–#5168, 09.11.2026). „Für Gründer …“ entfernt (#5165);
           blendet als Ganzes nach der H1 ein (nicht Wort für Wort, dafür ist der Satz zu lang). -->
      <p class="lead v-unter v-ein v-ein--2">{V_HERO.unter}</p>
      <!-- Ein Knopf (#5121–#5124): weiß, Schrift #006b68, sanfter Lichtschein alle 3 s + Glanz (variante-start.css) -->
      <div class="v-knopfe v-ein v-ein--3">
        <a class="btn v-leucht" href={kontakt(ANLIEGEN.erstberatung.paket)}>{HERO_KNOPF}</a>
      </div>
    </div>
    <!-- Leiste mit vier Vorteilen entfernt (Jamil, Talk qh87y3sj #5166, 09.11.2026) -->
  </section>

  <!-- Kundenreise als „Bühne“ (Jamil, Talk qh87y3sj #5596/#5598/#5599/#5601/#5602, Variante A, 12.11.2026; Sicherung Tag
       vor-kundenreise-buehne-20261112). Vorher (seit 09.11., #5181–#5334): Journey-Map mit fünf Kreisen an einer Linie und je einem
       Glühbirnen-Knopf, der die Antwort „So sieht es im besten Fall aus“ aufklappte. Kette und Linie sind entfernt; die Antworten
       stehen jetzt immer sichtbar in jedem Schritt (mit kleiner Glühbirne als Zeichen), damit kein Inhalt verloren geht.
       Am Rechner (ab 48rem breit und 36rem hoch, JS, ohne reduzierte Bewegung): die Bühne bleibt beim Scrollen stehen (sticky), je
       Scroll-Stück erscheint der nächste Schritt groß in der Mitte (Zahl, Symbol, Überschrift, Frage, Antwort), der vorige rückt
       klein und blass nach oben aus; oben eine Fortschrittsleiste; zum Schluss „zufriedener Kunde“ mit Haken. Am Handy Karten
       untereinander, die einzeln hereingleiten. Ohne JS oder bei reduzierter Bewegung: alles sofort sichtbar untereinander.
       Alle Schritte stehen immer im HTML (Screenreader lesen alle, h2 → h3). Texte wörtlich aus KUNDENREISE (config/variante.ts),
       Stil src/styles/kundenreise.css, Bewegung src/scripts/kundenreise.ts. Bleibt der Abschnitt, der über den stehenden Hero
       gleitet (.stapel-paar, H2-id kontrast-h unverändert). -->
  <section class="section vreise" id="kundenreise" aria-labelledby="kontrast-h">
    <div class="wrap kr">
      <h2 id="kontrast-h" class="kr-titel">{KUNDENREISE.titel}</h2>
      <p class="lead kr-intro">{KUNDENREISE.intro}</p>
    </div>
    <div class="krb" data-kundenreise>
      <div class="krb-buehne">
        <div class="krb-leiste" aria-hidden="true">
          {[...KUNDENREISE.stationen, null].map(() => <span class="krb-segment"></span>)}
        </div>
        <div class="krb-flaeche wrap">
          <ol class="krb-schritte">
            {KUNDENREISE.stationen.map((st, i) => (
              <li class="krb-schritt" data-krb-schritt>
                <div class="krb-karte">
                  <div class="krb-marke" aria-hidden="true">
                    <span class="krb-zahl">{i + 1}</span>
                    <span class="krb-symbol"><Icon name={KR_SYMBOL[i] ?? 'check'} size={26} /></span>
                  </div>
                  <div class="krb-inhalt">
                    <h3 class="krb-name">{st.name}</h3>
                    <p class="krb-frage">{st.frage}</p>
                    <div class="krb-antwort">
                      <p class="krb-antwort__titel"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" /><path d="M9 18h6" /><path d="M10 22h4" /></svg>{KUNDENREISE.antwortTitel}</p>
                      <p class="krb-antwort__text">{st.antwort}</p>
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ol>
          <p class="krb-schritt krb-ziel" data-krb-schritt>
            <span class="krb-haken" aria-hidden="true"><Icon name="check" size={40} /></span>
            <span class="krb-ziel__text">{KUNDENREISE.ziel}</span>
          </p>
        </div>
      </div>
    </div>
    <!-- Abschluss der Kundenreise (Jamil, Talk qh87y3sj #5275, 09.11.2026): Satz + Knopf „Jetzt starten“ (Erstberatung, wie der Hero-Knopf) -->
    <div class="wrap kr kr-schluss">
      <p class="kr-schluss__satz">{KUNDENREISE.schluss}</p>
      <div class="v-knopfe kr-cta">
        <a class="btn kr-leucht" href={kontakt(ANLIEGEN.erstberatung.paket)}>{KUNDENREISE.knopf}</a>
      </div>
    </div>
  </section>
  </div>

  <!-- Was Sie davon haben. (#vorteile, Jamil, Talk qh87y3sj #5381 „Warum sollte der Websitebesucher unser Kunde werden?“, 10.11.2026;
       Sicherung Branch vor-vorteile-20261110): sechs Vorteile aus Kundensicht mit Linien-Icons, zartes Türkis zwischen Kundenreise
       (Papier) und „So gehen wir vor“ (Weiß). Komponente start/Vorteile.astro, Texte VORTEILE in config/startseite.ts. -->
  <Vorteile />


  <!-- Was wir für Ihre Sichtbarkeit tun. (Jamil, Talk qh87y3sj #5363, 10.11.2026; Sicherung Branch vor-arbeitsweise-panels-20261109):
       drei Felder Wir analysieren / Wir optimieren für Google / Wir optimieren für KI-Suche mit gezeichneten Beispiel-Ansichten
       („Beispielhafte Darstellung“, keine echten Daten, keine Logos), Hintergrund Sand. Komponenten components/sichtbarkeit/, Texte
       config/sichtbarkeit.ts; dieselben Felder stehen auf /leistungen/suchmaschinen-optimierung/, /google-profil/ und /auswertung/. -->
  <Sichtbarkeit />

  <!-- „So arbeiten wir.“ (#arbeitsweise, Verantwortung/Einfachheit/Verlässlichkeit) entfernt (Jamil, Talk qh87y3sj #5606/#5610, 12.11.2026;
       Sicherung Tag vor-kundenreise-buehne-20261112). -->

  <!-- Pakete der Variante, jetzt mit den Paketdaten aus pakete-abo.ts (Preise, Jahreskosten, Einmalig dazubuchen).
       Anker #pakete und #baukasten (alte Links) zeigen hierher. -->
  <!-- Hintergründe (Jamil, Talk qh87y3sj #5204, 09.11.2026; #ablauf seit #5337 in „So gehen wir vor“): So gehen wir vor (Weiß)
       → So arbeiten wir. (zartes Türkis) → #pakete hell → #vergleich Sand → darunter im Wechsel. -->
  <section class="section" id="pakete" aria-labelledby="pakete-h">
    <span id="baukasten" class="pk-start__anker" aria-hidden="true"></span>
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Pakete</span>
        <h2 id="pakete-h" class="rule">Zwei Pakete. Feste Monatspreise.</h2>
        <p class="lead">Einrichtung, Technik und Betreuung sind im Monatspreis enthalten. Keine Einrichtungsgebühr. So bleiben Ihre Kosten planbar.</p>
      </div>
      <EinmaligDazu id="einmalig" />
      <PaketKarten details={false} />
      <!-- ohne Ablauf-Kette Anfrage → … → Buchhaltung, die drei Vorteile bleiben (Jamil, Talk qh87y3sj #5606/#5610, 12.11.2026) -->
      <KomplettKarte kette={false} />
      <p class="v-hinweis"><a href={href('/preise/')}>Alle Inhalte, Vergleich und Zusatzleistungen ansehen</a> · {LAUFZEIT_HINWEIS} {B2B_HINWEIS}</p>
    </div>
  </section>

  <!-- So gehen wir vor (Jamil, Talk qh87y3sj #5188, „ok 2b 3 ja“ #5190, 09.11.2026), seit #5337 zusammengeführt mit „Von der Anfrage
       bis online“ (Sicherung vor-vorgehen-ablauf-20261109): links Kopf und drei Phasen, rechts sechs Schritte als Kartenstapel.
       Anker #denkweise (Abschnitt), #ablauf (Beginn des Stapels), #erstberatung (Karte Erstgespräch).
       Seit 12.11.2026 direkt nach den Preisen (#pakete), vor dem Vergleich (Jamil, Talk qh87y3sj #5612); links nur noch Kopf
       (Phasen entfernt, #5606/#5610), auf den Karten nur die Zeitangabe (#5598). Anker ziehen mit. -->
  <SoGehenWirVor />

  <section class="section section--alt" id="vergleich" aria-labelledby="vgl-h">
    <div class="wrap">
      <!-- Stockfoto neben der Überschrift (Jamil, Talk qh87y3sj #5362): PC rechts, Handy darunter; lazy, keine Bildunterschrift -->
      <div class="sf-kopf">
      <div class="section-head">
        <span class="eyebrow">Im Vergleich</span>
        <h2 id="vgl-h" class="rule">Wir machen den Unterschied</h2>
        <p class="lead">Sechs Fragen, die Ihnen bei der Wahl helfen.</p>
      </div>
      <Foto id={SEITEN_FOTO.startVergleich} sizes="(min-width: 1200px) 420px, (min-width: 900px) 36vw, calc(100vw - 32px)" class="sf-kopf__foto" />
      </div>
      <!-- Vier Karten statt Tabelle (Jamil, Talk qh87y3sj #5210): components/variante/VVergleich.astro -->
      <VVergleich />
      <p class="v-hinweis">{VERGLEICH.hinweis}</p>
    </div>
  </section>

  <!-- „Von der Anfrage bis online“ (#ablauf) in „So gehen wir vor“ aufgegangen (Jamil, Talk qh87y3sj #5337) -->

  <!-- Fragen und Antworten (#fragen) entfernt: eigene Seite /fragen/ (Jamil #5136–#5138) -->

  <!-- „Welches Paket passt zu Ihnen?“ (.v-cta, zwei Knöpfe) entfernt (Jamil, Talk qh87y3sj #5211–#5213, 09.11.2026) -->

  <!-- ============ DARUNTER: bisherige Abschnitte. Gelber Trenner „Bisherige Startseite, zum Aussortieren“ und der alte
       Hero (StartHero mit Kreislauf; Komponente bleibt erhalten) entfernt, Jamil #5140–#5142 ============ -->

  <!-- Hintergründe unten im Wechsel (09.11.2026, nach dem Entfernen von „Was Sie beitragen“, „Welches Paket passt zu Ihnen?“ und
       Kundenreise-Check, Jamil #5211–#5213; #stimmen ausgeblendet, Jamil #5289; #ablauf in „So gehen wir vor“, #5337): nach
       #vergleich (Sand) in der Vorschau #team hell, Abschluss Sand; ohne Platzhalter (live) Abschluss hell (#referenzen entfernt, Jamil #5322 Q9). -->
  <!-- „Verstehen. Empfehlen. Umsetzen. Verbessern.“ (#denkweise) entfernt; ersetzt durch „So gehen wir vor“ nach der Kundenreise -->

  <!-- Wer hinter waybuild steht (Jamil #4934 Punkt 2, 08.11.2026). NUR PLATZHALTER (rot
       gestrichelt, „Foto folgt“), keine KI-Gesichter, keine erfundenen Texte; echt sind nur Namen und Rollen. Nur in der Vorschau. -->
  {PLATZHALTER && (
    <section class="bs" id="team" aria-labelledby="bs-team">
      <div class="wrap">
        <div class="bs-kopf bs-kopf--mitte">
          <h2 id="bs-team">{TEAM.titel}</h2>
          <p class="bs-lead">{TEAM.einleitung}</p>
        </div>
        <ul class="team4">
          {TEAM.personen.map((m) => (
            <li class="team4__karte platzhalter">
              <span class="platzhalter__etikett">{TEAM.platzhalter}</span>
              <div class="team4__foto" role="img" aria-label={`${TEAM.fotoFolgt}: ${m.name}`}>
                <span class="team4__kuerzel" aria-hidden="true">{m.kuerzel}</span>
                <span class="team4__folgt" aria-hidden="true">{TEAM.fotoFolgt}</span>
              </div>
              <div>
                <h3 class="team4__name">{m.name}</h3>
                <p class="team4__rolle">{m.rolle}</p>
                <p class="team4__text">{m.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- „Darauf können Sie sich verlassen“ entfernt (Jamil #5136–#5138) -->

  <!-- Preisteil unten (#pakete-alt) entfernt (Jamil #5136–#5138); Pakete stehen oben in #pakete -->

  <!-- „Beispiele aus unserer Arbeit“ (#referenzen) von der Startseite entfernt (Jamil, Talk qh87y3sj #5322, Q9); der Abschnitt
       steht weiter auf /leistungen/website/ und /beispiele/ (Komponente components/referenzen/ReferenzKarten.astro). -->

  <!-- Kundenstimmen (Jamil #4934 Punkt 3): NUR PLATZHALTER, keine erfundenen Zitate/Namen/Sterne.
       Ausgeblendet (Jamil, Talk qh87y3sj #5289 „entfernen“): Markup und STIMMEN bleiben für spätere echte, freigegebene
       Kundenstimmen; dann STIMMEN_ZEIGEN auf true setzen und den Hintergrund-Wechsel (Abschluss) prüfen. -->
  {STIMMEN_ZEIGEN && PLATZHALTER && (
    <section class="bs bs--alt" id="stimmen" aria-labelledby="bs-stimmen">
      <div class="wrap">
        <div class="bs-kopf bs-kopf--mitte"><h2 id="bs-stimmen">{STIMMEN.titel}</h2></div>
        <ul class="stimmen4">
          {STIMMEN.quellen.map((q) => (
            <li class="stimme4 platzhalter">
              <span class="platzhalter__etikett">{STIMMEN.platzhalter}</span>
              <blockquote class="stimme4__zitat"><p>{STIMMEN.zitat}</p></blockquote>
              <p class="stimme4__quelle">{q}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

