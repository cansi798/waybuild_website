---
// Startseite nach der Unternehmensvision (Jamil, 17.10.2026) – wenig Text, klare Struktur:
// 1 Hero (Positionierung + EIN CTA) → 2 Website as a Service („Ein Preis. Ein Ansprechpartner. Ein System.“, 9 Bestandteile)
// → 3 Arbeitsweise (Beratung → KI-Umsetzung → Verbesserung, animiert) → 4 Geschäftsmodell (6 Siegel)
// → 5 Zielgruppen → 6 Vision „Die intelligente Website“ (Solarteur-Beispiel) → 7 Plattform-Bausteine
// → Footer-Kopf mit Direktkontakt (CTA).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Angebot from '../components/Angebot.astro';
import Ablauf from '../components/Ablauf.astro';
import Siegel from '../components/Siegel.astro';
import Zielgruppen from '../components/Zielgruppen.astro';
import Vision from '../components/Vision.astro';
import Plattform from '../components/Plattform.astro';
import { serviceSchema } from '../lib/schema';
---

<BaseLayout
  title="Digitale Unternehmensplattformen für KMU"
  description="Keine klassische Webagentur: Website as a Service für KMU – persönliche Beratung, KI-gestützte Umsetzung, fester Monatspreis, keine Einrichtungskosten."
  schema={[serviceSchema(Astro.site)]}
>
  <Hero />
  <Angebot />
  <Ablauf />
  <Siegel />
  <Zielgruppen />
  <Vision />
  <Plattform />
</BaseLayout>
