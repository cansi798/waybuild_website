---
// STARTSEITE der waybuild Website (Stand 06.11.2026 abends). Alle Texte WÖRTLICH von Jamil (Talk qh87y3sj):
//   Hero (Headline 4771, Subheadline 4783, Kundengeschichte in fünf Stationen 4784)
//   · 2 Bausteine, die nicht passen (4786/4787; Abschnitt 1 auf Jamils Wunsch entfernt, 4806)
//   · 3 Verstehen. Empfehlen. Umsetzen. (4788) + Woran wir glauben (4795/4796) in einem Abschnitt (4809, #denkweise) · 4 Vier Bereiche + Pakete (4789)
//   · 5 Darauf können Sie sich verlassen (4790/4791; seit 08.11. direkt hinter 3) · Check (#check, Vorschlag aus 4768) · Abschluss (4792) · Claim (4793)
// 08.11.2026 „einladender“ (Jamil 4927/4929, Rethinking NC Rethinking_Startseite-einladend_2026-11-08; Sicherung Branch
//   vor-einladend-20261108): Claim oben im Hero, Prinzipien mit Zeichen + Linie, „Verlassen“ hinter die Prinzipien,
//   Leistungsdetails zum Aufklappen. Texte unverändert.
// 08.11.2026 (Jamil #4983–#4989; Sicherung Branch vor-hero-bausteine-20261108): Hero ohne Claim- und Zielgruppenzeile,
//   Bausteine als vier getrennte Module mit verlorener Anfrage (statt Puzzle), Erstberatung in #denkweise integriert
//   (vier Schritte Verstehen/Empfehlen/Umsetzen/Verbessern), eigener Abschnitt „So läuft die Erstberatung“ entfernt.
// Sicherung des Stands vom 05.11.: Branch vor-unternehmensauftritt-20261106.
// Texte in src/config/startseite.ts, Stil in src/styles/startseite.css, Bewegung in src/scripts/startseite.ts
// (nur transform/opacity/stroke-dashoffset). Farben seit 08.11.2026 (Jamil #5008) wieder CI-Türkis wie alle Seiten; thema="besucherreise" steuert nur noch Kopf/Fuß-Inhalte.
// Die alte Startseite steht unverändert unter /hauptseite-alt/.
//
// 08.11.2026 19:23 (Jamil, Talk qh87y3sj #5061/#5062 „Go“/„Ok“; Sicherung Branch vor-variante-start-20261108 = 80ba83c):
//   OBEN steht jetzt die KOMPLETTE Startseite der Variante „an firma.de orientiert“ (Einstieg, Vertrauensleiste, Kontrastsatz,
//   Pakete, Vergleich, Zeitleiste, Was Sie beitragen, Fragen und Antworten, Abschluss; Code aus archiv/variante-firma-20261108,
//   Texte src/config/variante.ts, Pakete/Preise/FAQ aus src/config/pakete-abo.ts). Ohne Banner und Navigation der Variante,
//   ohne Gründungspaket, Links auf /variante/… → /preise/.
//   DARUNTER alle bisherigen Abschnitte unverändert, getrennt durch „Bisherige Startseite, zum Aussortieren“ (nur Vorschau).
//   Jamil sortiert selbst aus. Doppelte IDs: alte Blöcke mit Suffix -alt (#pakete-alt, #baukasten-alt, pk-…-alt);
//   #pakete und #baukasten zeigen auf den neuen Teil, #check auf den bisherigen Check (die Variante hat keinen).
//   Der bisherige Hero ist ein zweiter Block mit H2 statt H1 (Text gleich), damit die Seite genau eine H1 hat.
import BaseLayout from '../layouts/BaseLayout.astro';
import StartHero from '../components/start/StartHero.astro';
import Check from '../components/start/Check.astro';
import PaketKarten from '../components/pakete/PaketKarten.astro';
import EinmaligDazu from '../components/pakete/EinmaligDazu.astro';
import VAblauf from '../components/variante/VAblauf.astro';
import VFaq from '../components/variante/VFaq.astro';
import Icon from '../components/Icon.astro';
import { serviceSchema } from '../lib/schema';
import { href } from '../lib/paths';
import Bild from '../components/Bild.astro';
import { IS_PREVIEW } from '../lib/env';
import { SHOW_HINTS } from '../config/site';
import { B2B_HINWEIS, paketById, ABO_PAKETE, aboPreisAb, euro, FAQ_PAKETE, LAUFZEIT_HINWEIS } from '../config/pakete-abo';
import { V_HERO, VERTRAUEN, KONTRAST, VERGLEICH, TRENNER } from '../config/variante';
import { ANLIEGEN, BAUSTEINE, VERSTEHEN, BEREICHE, PAKET_JE_LEISTUNG, BAUKASTEN, REFERENZEN, TEAM, STIMMEN, VERLASSEN, ABSCHLUSS, CLAIM, MARKE } from '../config/startseite';
import '../styles/startseite.css';
import '../styles/variante-start.css';

const kontakt = (paket: string) => href(`/kontakt/?paket=${encodeURIComponent(paket)}`);
// Platzhalter (Team-Fotos, Kundenstimmen; Jamil #4934) nur in der Vorschau, solange die Hinweise an sind
const PLATZHALTER = SHOW_HINTS && IS_PREVIEW;

// Neuer Teil oben (Variante-Startseite, Jamil #5061/#5062)
const ab = aboPreisAb();
const analyse = kontakt(ANLIEGEN.analyse.paket);
const V_FAQ = FAQ_PAKETE.slice(0, 5);
const V_TITEL = 'Website-Abo: fertig betreut, fester Monatspreis';
const V_DESCRIPTION = `Website, E-Mail und Google-Profil in drei festen Paketen ab ${euro(ab)} im Monat netto, ohne Einrichtungskosten. Hosting in Deutschland.`;
const V_SERVICE = `Website-Abo für kleine und mittlere Unternehmen: Wir erstellen die Website, richten E-Mail-Postfächer und Google-Profil ein und betreuen alles danach. Drei feste Pakete (${ABO_PAKETE.map((p) => `${p.name} ${euro(p.preis)}`).join(', ')} im Monat netto), keine Einrichtungskosten; Logo, Signatur, Geschäftspapiere und Visitenkarten einmalig dazubuchbar.`;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: V_FAQ.filter((f) => !f.platzhalter).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// Abschnitt 2 (Jamil #4986, 08.11.2026: Puzzle „zu verspielt“, „seriöser und animiert, damit der Painpoint klar wird“):
// vier ruhige Module, die nicht verbunden sind. Eine Anfrage wandert von der Website los und bleibt in der Lücke hängen,
// dann wird derselbe Eintrag zweimal von Hand gepflegt, am Ende bleibt offen, wie alles zusammenhängt.
// Reihenfolge = BAUSTEINE.werkzeuge (Website, Kundenverwaltung, Social Media, Prozesse). Icons 24er-Raster, nur Linien.
const MODUL_ICON = [
  '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 8.5h18"/><path d="M6.5 12h7M6.5 15.5h10" stroke="#00a6a1"/>',
  '<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="10.6" r="2.2"/><path d="M5.8 16.2c.6-1.6 1.8-2.4 3.2-2.4s2.6.8 3.2 2.4"/><path d="M14.5 10h3.5M14.5 13.5h3.5" stroke="#00a6a1"/>',
  '<circle cx="17" cy="6" r="2.5"/><circle cx="7" cy="12" r="2.5"/><circle cx="17" cy="18" r="2.5"/><path d="M9.2 10.8l5.6-3.4M9.2 13.2l5.6 3.4" stroke="#00a6a1"/>',
  '<rect x="3" y="3.5" width="7.5" height="6" rx="1.5"/><rect x="13.5" y="14.5" width="7.5" height="6" rx="1.5"/><path d="M6.75 9.5v4a2 2 0 0 0 2 2h4.75" stroke="#00a6a1"/><path d="M11.5 13.5l2 2-2 2" stroke="#00a6a1"/>',
];
// Lange Wörter dürfen nur an der Silbengrenze umbrechen (Jamils Text bleibt unverändert, nur ein weiches Trennzeichen)
const modulName = (w: string) => w.replace(/\.$/, '').replace('Kundenverwaltung', 'Kunden\u00ADverwaltung');
// Verbindungen: h = nach rechts zum Nachbarn, v = nach unten
const MODUL_VERB: string[][] = [['h', 'v'], ['v'], ['h'], []];

// Abschnitt 4: kleine Zeichnungen je Bereich (dieselben Motive wie in der Hero-Geschichte)
const BEREICH_ICON = [
  '<rect x="13" y="6" width="22" height="36" rx="5" fill="#004f4c"/><rect x="16" y="11" width="16" height="24" rx="2" fill="#f7f5f0"/><circle cx="35" cy="8" r="6" fill="#00a6a1"/>',
  '<rect x="6" y="12" width="36" height="25" rx="4" fill="#fff" stroke="#004f4c" stroke-width="2.4"/><path d="M6 14 L24 28 L42 14" fill="none" stroke="#004f4c" stroke-width="2.4" stroke-linejoin="round"/><circle cx="40" cy="12" r="5" fill="#00a6a1"/>',
  '<circle cx="19" cy="20" r="10" fill="none" stroke="#004f4c" stroke-width="5" stroke-dasharray="3.6 2.7"/><circle cx="19" cy="20" r="7" fill="#004f4c"/><circle cx="19" cy="20" r="2.8" fill="#f7f5f0"/><circle cx="34" cy="33" r="7" fill="none" stroke="#7fd0cc" stroke-width="4" stroke-dasharray="2.8 2.1"/><circle cx="34" cy="33" r="5" fill="#7fd0cc"/><circle cx="34" cy="33" r="2" fill="#f7f5f0"/>',
  '<path d="M24 40 c-2 -2 -16 -10 -16 -20 c0 -6 5 -10 10 -10 c3 0 5 2 6 4 c1 -2 3 -4 6 -4 c5 0 10 4 10 10 c0 10 -14 18 -16 20 Z" fill="#00a6a1"/>',
];

// Abschnitt 3: ruhige Zeichen für die drei Prinzipien statt Nummern (Rethinking 08.11.): Gespräch = Verstehen,
// Wegweiser = Empfehlen, Haken = Umsetzen. Stil wie die Hero-Geschichte (Dunkeltürkis, Türkis, Hell-Türkis, runde Enden).
const PRINZIP_ICON = [
  '<path d="M7 11 h22 a4 4 0 0 1 4 4 v11 a4 4 0 0 1 -4 4 h-12 l-7 6 v-6 h-3 a4 4 0 0 1 -4 -4 v-11 a4 4 0 0 1 4 -4 z" fill="#004f4c"/><path d="M36 19 h5 a4 4 0 0 1 4 4 v10 a4 4 0 0 1 -4 4 h-2 v5 l-6 -5 h-9 a4 4 0 0 1 -4 -4 v-1" fill="#7fd0cc"/><circle cx="12" cy="20.5" r="2" fill="#f7f5f0"/><circle cx="18" cy="20.5" r="2" fill="#f7f5f0"/><circle cx="24" cy="20.5" r="2" fill="#f7f5f0"/>',
  '<rect x="22" y="6" width="4" height="38" rx="2" fill="#004f4c"/><path d="M10 10 h24 l6 5 l-6 5 h-24 a2 2 0 0 1 -2 -2 v-6 a2 2 0 0 1 2 -2 z" fill="#7fd0cc"/><path d="M38 23 h-24 l-6 5 l6 5 h24 a2 2 0 0 0 2 -2 v-6 a2 2 0 0 0 -2 -2 z" fill="#00a6a1"/>',
  '<circle cx="24" cy="24" r="18" fill="#00a6a1"/><path d="M15.5 24.5 l6 6 l11 -12" fill="none" stroke="#004f4c" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/>',
  // Verbessern (Jamil #4989): steigende Linie über einer Grundlinie, gleicher Stil
  '<rect x="6" y="39" width="36" height="3.6" rx="1.8" fill="#7fd0cc"/><path d="M8 32 L18 22 L26 28 L39 14" fill="none" stroke="#004f4c" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M30 13 h10 v10" fill="none" stroke="#004f4c" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/>',
];

// Referenzen: Symbol in der stilisierten Vorschau (keine echten Screenshots/Logos, solange nicht freigegeben)
const MOTIV: Record<string, string> = {
  bad: '<rect x="0" y="34" width="86" height="34" rx="12" fill="#7fd0cc"/><path d="M14 34 V12 a10 10 0 0 1 20 0" fill="none" stroke="#004f4c" stroke-width="5" stroke-linecap="round"/><circle cx="34" cy="20" r="4" fill="#00a6a1"/>',
  lack: '<rect x="8" y="8" width="34" height="58" rx="8" fill="#004f4c"/><rect x="16" y="0" width="18" height="12" rx="3" fill="#7fd0cc"/><circle cx="62" cy="22" r="7" fill="#00a6a1"/><circle cx="74" cy="40" r="5" fill="#00a6a1" opacity="0.7"/><circle cx="62" cy="54" r="4" fill="#00a6a1" opacity="0.5"/>',
  sprache: '<rect x="0" y="6" width="54" height="36" rx="10" fill="#004f4c"/><path d="M12 42 l0 12 l12 -12" fill="#004f4c"/><rect x="34" y="30" width="54" height="36" rx="10" fill="#7fd0cc"/><path d="M76 66 l0 10 l-10 -10" fill="#7fd0cc"/>',
  film: '<rect x="0" y="14" width="62" height="46" rx="8" fill="#004f4c"/><path d="M62 30 L88 16 V58 L62 44 Z" fill="#7fd0cc"/><circle cx="22" cy="37" r="9" fill="#00a6a1"/>',
  wissen: '<circle cx="44" cy="28" r="22" fill="#00a6a1"/><rect x="34" y="50" width="20" height="12" rx="3" fill="#004f4c"/><path d="M36 28 l6 6 l10 -12" fill="none" stroke="#004f4c" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>',
};
// Abschnitt 4: Paket-Hinweis je Leistung (Jamil #5056), Namen aus pakete-abo.ts
const paketLabel = (pk: 'basis' | 'plus' | 'komplett' | 'anfrage') =>
  pk === 'anfrage' ? 'Auf Anfrage, eigenes Angebot' : pk === 'basis' ? 'In allen Paketen enthalten' : pk === 'komplett' ? `Im Paket ${paketById('komplett').name} enthalten` : `Ab Paket ${paketById(pk).name} enthalten`;
---

<BaseLayout
  title={V_TITEL}
  description={V_DESCRIPTION}
  schema={[serviceSchema(Astro.site, V_SERVICE), faqLd]}
  thema="besucherreise"
>
  <!-- ============ NEU OBEN: Startseite der Variante „an firma.de orientiert“ (Jamil #5061/#5062, 08.11.2026) ============ -->
  <section class="v-hero" aria-labelledby="v-h1">
    <div class="wrap vhero">
      <div>
      <span class="eyebrow">{V_HERO.eyebrow}</span>
      <h1 id="v-h1">{V_HERO.titel}</h1>
      <p class="lead">{V_HERO.unter} Ab <strong>{euro(ab)}</strong> im Monat, netto zzgl. MwSt.</p>
      <div class="v-knopfe">
        <a class="btn btn--primary btn--lg" href={href('/preise/')}>Neue Website</a>
        <a class="btn btn--umriss btn--lg" href={analyse}>Ich habe schon eine Website</a>
      </div>
      </div>
      <aside class="vblick card" aria-label="Pakete auf einen Blick">
        <p class="vblick__k">Auf einen Blick</p>
        <ul>
          {ABO_PAKETE.map((p) => (
            <li><a href={href('/preise/')}><span><b>{p.name}</b><small>{p.kurz}</small></span><strong>{euro(p.preis)}</strong></a></li>
          ))}
        </ul>
        <p class="vblick__s">netto im Monat zzgl. MwSt. · keine Einrichtungskosten</p>
      </aside>
    </div>
  </section>

  <div class="v-vertrauen" aria-label="Fakten über waybuild">
    <ul class="wrap">
      {VERTRAUEN.map((v) => <li><Icon name={v.icon} size={18} /> {v.text}</li>)}
      <li><Icon name="layout" size={18} /> <a href="#referenzen">{REFERENZEN.liste.length} Kundenprojekte als Beispiel</a></li>
    </ul>
  </div>

  <section class="section vkontrast" aria-labelledby="kontrast-h">
    <div class="wrap v-text">
      <h2 id="kontrast-h">{KONTRAST.satz}</h2>
      <p class="lead">{KONTRAST.text}</p>
    </div>
  </section>

  <!-- Pakete der Variante, jetzt mit den Paketdaten aus pakete-abo.ts (Preise, Jahreskosten, Einmalig dazubuchen).
       Anker #pakete und #baukasten (alte Links aus Check und Hero) zeigen hierher. -->
  <section class="section section--alt" id="pakete" aria-labelledby="pakete-h">
    <span id="baukasten" class="pk-start__anker" aria-hidden="true"></span>
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Pakete</span>
        <h2 id="pakete-h" class="rule">Drei Pakete. Feste Monatspreise.</h2>
        <p class="lead">Einrichtung, Technik und Betreuung sind im Monatspreis enthalten. Keine Rechnung am Anfang.</p>
      </div>
      <PaketKarten details={false} />
      <EinmaligDazu id="einmalig" />
      <p class="v-hinweis"><a href={href('/preise/')}>Alle Inhalte, Vergleich und Zusatzleistungen ansehen</a> · {LAUFZEIT_HINWEIS} {B2B_HINWEIS}</p>
    </div>
  </section>

  <section class="section" id="vergleich" aria-labelledby="vgl-h">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Im Vergleich</span>
        <h2 id="vgl-h" class="rule">Selbst machen, Baukasten, Agentur oder waybuild?</h2>
        <p class="lead">Fünf Fragen, die sich fast jeder Betrieb stellt.</p>
      </div>
      <div class="vvgl__scroll" role="region" aria-label="Vergleich nach Anbieter-Art" tabindex="0">
        <table class="vvgl">
          <thead><tr><th scope="col">Frage</th>{VERGLEICH.spalten.map((sp) => <th scope="col">{sp}</th>)}</tr></thead>
          <tbody>
            {VERGLEICH.zeilen.map((z) => <tr><th scope="row">{z.frage}</th>{z.werte.map((w, i) => <td class:list={{ 'vvgl__wir': i === 3 }}>{w}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <p class="v-hinweis">{VERGLEICH.hinweis}</p>
    </div>
  </section>

  <VAblauf />

  <VFaq fragen={V_FAQ} />

  <section class="section v-cta" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 id="cta-h">Welches Paket passt zu Ihnen?</h2>
      <p class="lead" style="margin-inline:auto">Im kostenlosen Erstgespräch, rund 20 Minuten, empfehlen wir Ihnen das passende Paket. Ehrlich, auch wenn es das kleinere ist.</p>
      <div class="v-knopfe">
        <a class="btn btn--primary btn--lg" href={kontakt(ANLIEGEN.erstberatung.paket)}>Erstgespräch vereinbaren</a>
        <a class="btn btn--umriss btn--lg" href={href('/preise/')}>Pakete vergleichen</a>
      </div>
    </div>
  </section>

  <!-- ============ DARUNTER: bisherige Startseite unverändert, zum Aussortieren durch Jamil ============ -->
  {PLATZHALTER && (
    <section class="alt-trenner" id="bisherige-startseite" aria-labelledby="alt-trenner-h">
      <div class="wrap">
        <h2 id="alt-trenner-h">{TRENNER.titel}</h2>
        <p>{TRENNER.hinweis}</p>
      </div>
    </section>
  )}

  <!-- Hero (bisherig; H2 statt H1, Text gleich) -->
  <StartHero ebene="h2" />

  <!-- 2 · Die meisten Unternehmen optimieren einzelne Werkzeuge (Jamil 4786/4787): vier getrennte Module, eine Anfrage geht
       in der Lücke verloren (Jamil #4986). Die Verlust-Zeilen links leuchten synchron zur Animation auf. -->
  <section class="bs bs--alt" aria-labelledby="bs-bausteine">
    <div class="wrap bs-zwei bs-zwei--mitte">
      <div class="bs-kopf">
        <h2 id="bs-bausteine">{BAUSTEINE.titel}</h2>
        <p class="bs-unter">{BAUSTEINE.unter}</p>
        <ul class="werkzeuge">{BAUSTEINE.werkzeuge.map((w) => <li>{w}</li>)}</ul>
        <p class="bs-lead"><strong>{BAUSTEINE.text[0]}</strong></p>
        <p class="bs-lead">{BAUSTEINE.text[1]}</p>
        <ul class="verluste">{BAUSTEINE.verluste.map((v) => <li>{v}</li>)}</ul>
      </div>
      <figure class="bstn" data-zeichne data-schleife data-mit=".verluste" aria-hidden="true">
        <div class="bstn__raster">
          {BAUSTEINE.werkzeuge.map((w, i) => (
            <div class={`bstn__karte bstn__karte--${i}`}>
              <span class="bstn__icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#004f4c" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={MODUL_ICON[i]} /></span>
              <span class="bstn__name">{modulName(w)}</span>
              <span class="bstn__zeilen"><i></i><i></i>{(i === 1 || i === 3) && <i class={`bstn__eintrag bstn__eintrag--${i}`}></i>}</span>
              {MODUL_VERB[i].map((r) => <span class={`bstn__verb bstn__verb--${r}`}><i></i></span>)}
              {i === 0 && (
                <span class="bstn__brief">
                  <svg viewBox="0 0 24 18" width="24" height="18" focusable="false"><rect x="1" y="1" width="22" height="16" rx="2.5" fill="#fff" stroke="#004f4c" stroke-width="1.6"/><path d="M2.5 2.5 L12 10 L21.5 2.5" fill="none" stroke="#004f4c" stroke-width="1.6" stroke-linejoin="round"/><circle cx="21" cy="2.5" r="3.2" fill="#00a6a1"/></svg>
                  <svg class="bstn__brief-rot" viewBox="0 0 24 18" width="24" height="18" focusable="false"><rect x="1" y="1" width="22" height="16" rx="2.5" fill="#fbf1ee" stroke="#b8695c" stroke-width="1.6"/><path d="M2.5 2.5 L12 10 L21.5 2.5" fill="none" stroke="#b8695c" stroke-width="1.6" stroke-linejoin="round"/></svg>
                </span>
              )}
            </div>
          ))}
          <span class="bstn__frage"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#9a4a3f" stroke-width="2" stroke-linecap="round" focusable="false"><path d="M9.2 9.2a2.9 2.9 0 1 1 4 2.7c-.8.35-1.2.95-1.2 1.8v.6"/><circle cx="12" cy="17.6" r="1.1" fill="#9a4a3f" stroke="none"/></svg></span>
        </div>
      </figure>
    </div>
  </section>

  <!-- 3 · Verstehen. Empfehlen. Umsetzen. (Jamil 4788) zusammengelegt mit „Woran wir glauben“ (4795/4796, Jamil 4809):
       große Karten mit dem passenden Wert, darunter dezent „Was Sie von uns nicht erwarten müssen“.
       08.11.2026 (Jamil #4988/#4989): mit „So läuft die Erstberatung“ kombiniert (Verstehen = das kurze Gespräch) und um
       „Verbessern“ ergänzt, vier Schritte an einer türkisen Linie; CTA Erstberatung darunter. Anker #erstberatung = Karte 1. -->
  <section class="bs" id="denkweise" aria-labelledby="bs-verstehen">
    <div class="wrap">
      <div class="bs-kopf bs-kopf--mitte">
        <h2 id="bs-verstehen">{VERSTEHEN.titel}</h2>
        <p class="bs-lead">{VERSTEHEN.einleitung}</p>
        <ul class="verstehen-chips">{VERSTEHEN.liste.map((l) => <li>{l}</li>)}</ul>
        <p class="bs-lead">{VERSTEHEN.schluss[0]} <strong>{VERSTEHEN.schluss[1]}</strong></p>
      </div>
      <ol class="schritte3" data-zeichne>
        {VERSTEHEN.karten.map((k, i) => (
          <li class="schritt3" id={i === 0 ? 'erstberatung' : undefined} style={`--i:${i}`}>
            <span class="schritt3__zeichen" aria-hidden="true"><svg viewBox="0 0 48 48" width="34" height="34" focusable="false" set:html={PRINZIP_ICON[i]} /></span>
            <h3 class="schritt3__wort">{k.wort}</h3>
            <p class="schritt3__leit">{k.leit}</p>
            <p class="schritt3__text">{k.text}</p>
            {k.hinweis && <p class="schritt3__hinweis"><a href="#pakete">{k.hinweis}</a></p>}
          </li>
        ))}
      </ol>
      <div class="ohne">
        <p class="ohne__kopf">{VERSTEHEN.nichtKopf}</p>
        <ul class="ohne__liste">{VERSTEHEN.nicht.map((n) => <li>{n}</li>)}</ul>
      </div>
      <p class="erst4__cta"><a class="btn btn--marke btn--lg" href={kontakt(ANLIEGEN.erstberatung.paket)}>{ANLIEGEN.erstberatung.label}</a></p>
    </div>
  </section>

  <!-- Wer hinter waybuild steht (Jamil #4934 Punkt 2, 08.11.2026): direkt nach den Prinzipien. NUR PLATZHALTER (rot
       gestrichelt, „Foto folgt“), keine KI-Gesichter, keine erfundenen Texte; echt sind nur Namen und Rollen. Nur in der Vorschau. -->
  {PLATZHALTER && (
    <section class="bs bs--alt" id="team" aria-labelledby="bs-team">
      <div class="wrap">
        <div class="bs-kopf bs-kopf--mitte">
          <h2 id="bs-team">{TEAM.titel}</h2>
          <p class="bs-lead">{TEAM.einleitung}</p>
        </div>
        <ul class="team4">
          {TEAM.personen.map((m) => (
            <li class="team4__karte platzhalter">
              <span class="platzhalter__etikett">{TEAM.platzhalter}</span>
              <div class="team4__foto" role="img" aria-label={`${TEAM.fotoFolgt}: ${m.name}`}>
                <span class="team4__kuerzel" aria-hidden="true">{m.kuerzel}</span>
                <span class="team4__folgt" aria-hidden="true">{TEAM.fotoFolgt}</span>
              </div>
              <div>
                <h3 class="team4__name">{m.name}</h3>
                <p class="team4__rolle">{m.rolle}</p>
                <p class="team4__text">{m.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Darauf können Sie sich verlassen (Jamil 4790/4791): große Schlagworte, viel Weißraum, keine Icons.
       08.11. (Rethinking „einladender“, Jamil 4927/4929): direkt hinter die drei Prinzipien gerückt, damit die Haltung
       gebündelt VOR Leistungen und Preisen steht (vorher hinter den Referenzen). -->
  <section class="bs bs--dunkel verlassen" aria-labelledby="bs-verlassen">
    <div class="wrap">
      <h2 id="bs-verlassen" class="verlassen__titel">{VERLASSEN.titel}</h2>
      <ul class="verlassen__liste">
        {VERLASSEN.saetze.map((t, i) => <li class:list={['reveal', { 'ist-letzt': i === VERLASSEN.saetze.length - 1 }]}>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- 4 · Ein Kunde interessiert sich nicht für Ihre Systeme (Jamil 4811 + 4871–4876 + 4879): jede Leistung genau EIN Mal an
       ihrer Station (Liste weiter aus BAUKASTEN in startseite.ts erzeugt, OHNE Preise), darunter „Was dazugehört“
       (dazu, Jamil 4909). Der Abo-Baukasten selbst ist seit 08.11.2026 (Jamil #5056) durch die drei Pakete ersetzt
       (Abschnitt #pakete darunter); Komponente archiviert unter archiv/baukasten-20261108/. -->
  <section class="bs bs--alt bs--voll" id="loesungen" aria-labelledby="bs-bereiche">
    <div class="wrap">
      <div class="bs-kopf bs-kopf--mitte">
        <h2 id="bs-bereiche">{BEREICHE.titel}</h2>
        <p class="bs-unter bs-unter--mitte">{BEREICHE.unter}</p>
        <p class="bs-lead">{BEREICHE.einleitung}</p>
        <p class="bs-hinweis">{BEREICHE.hinweis}</p>
      </div>
      <ol class="reise4">
        {BEREICHE.stationen.map((st, i) => (
          <li class="station4 reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="station4__kopf">
              <svg class="station4__icon" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true" set:html={BEREICH_ICON[i]} />
              <div><h3>{st.titel}</h3><p class="station4__ziel">{st.ziel}</p></div>
            </div>
            <ul class="station4__liste">
              {[...BAUKASTEN.basis.teile.map((t) => ({ name: t.text, station: t.station, dazu: t.dazu, pk: 'basis' as const })),
                ...BAUKASTEN.bausteine.filter((b) => !b.zu).map((b) => {
                  const pk = PAKET_JE_LEISTUNG[b.id] ?? 'anfrage';
                  // Ergänzungen (zu) anhängen; steckt die Ergänzung in einem anderen Paket, steht es dahinter
                  const extra = BAUKASTEN.bausteine.filter((o) => o.zu === b.id).flatMap((o) => o.dazu.map((d) => (PAKET_JE_LEISTUNG[o.id] && PAKET_JE_LEISTUNG[o.id] !== pk && PAKET_JE_LEISTUNG[o.id] !== 'anfrage' ? `${d} (ab Paket ${paketById(PAKET_JE_LEISTUNG[o.id] as 'plus').name})` : d)));
                  return { ...b, pk, dazu: [...b.dazu, ...extra] };
                })]
                .filter((l) => l.station === st.id).map((l) => (
                <li><details class="station4__mehr">
                  <summary><span class="station4__text">{l.name}<span class:list={['station4__paket', { 'station4__paket--anfrage': l.pk === 'anfrage' }]}>{paketLabel(l.pk)}</span></span><span class="station4__plus" aria-hidden="true"></span></summary>
                  <ul class="station4__dazu">{l.dazu.map((d) => <li>{d}</li>)}</ul>
                </details></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Preisteil (Jamil, Talk qh87y3sj #5056, 08.11.2026): die drei Pakete Basis · Plus · Komplett kompakt, Daten aus
       src/config/pakete-abo.ts, alle Details auf /preise/. Anker #baukasten bleibt für alte Links (Check, Hero). -->
  <section class="bs bs--alt pk-start" id="pakete-alt" aria-labelledby="bs-pakete">
    <span id="baukasten-alt" class="pk-start__anker" aria-hidden="true"></span>
    <div class="wrap">
      <div class="bs-kopf bs-kopf--mitte">
        <h2 id="bs-pakete">Drei Pakete. Fester Monatspreis.</h2>
        <p class="bs-lead">Website, Technik und Betreuung sind immer dabei. Je nach Paket kommen Google, laufende Verbesserung oder Logo und Geschäftspapiere dazu.</p>
      </div>
      <PaketKarten kompakt idSuffix="-alt" />
      <p class="pk-start__mehr"><a class="btn btn--umriss btn--lg" href={href('/preise/')}>Alle Leistungen und Preise vergleichen</a></p>
      <p class="pk-start__netto">{B2B_HINWEIS} Logo, Geschäftspapiere und Visitenkarten können Sie auch einmalig dazubuchen.</p>
    </div>
  </section>

  <!-- Referenzen (Jamil 4876; seit 08.11.2026 mit Namen, Jamil #4932): Bild der Kunden-Website oben, darunter Name,
       Branche · Ort, Ausgangslage/Umsetzung/Ergebnis. Link nur bei Live-Seiten, sonst nur das Etikett „Vorschau“. -->
  <section class="bs" id="referenzen" aria-labelledby="bs-referenzen">
    <div class="wrap">
      <div class="bs-kopf bs-kopf--mitte">
        <h2 id="bs-referenzen">{REFERENZEN.titel}</h2>
        <p class="bs-lead">{REFERENZEN.einleitung}</p>
      </div>
      <ul class="refs4">
        {REFERENZEN.liste.map((r, i) => (
          <li class="ref4 reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
            <div class:list={['ref4__bild', `ref4__bild--${r.motiv}`]}>
              {r.name && r.bild
                ? <Bild name={r.bild} alt={`Startseite der Website von ${r.name}${r.status === 'vorschau' ? ' (Vorschau)' : ''}`} widths={[400, 800]} sizes="(min-width: 1100px) 360px, (min-width: 700px) 46vw, calc(100vw - 72px)" class="ref4__img" />
                : (
                  <svg viewBox="0 0 320 200" focusable="false" aria-hidden="true">
                    <rect x="0" y="0" width="320" height="200" rx="14" fill="#ffffff" />
                    <rect x="0" y="0" width="320" height="24" rx="14" fill="#efebe3" /><rect x="0" y="12" width="320" height="12" fill="#efebe3" />
                    <circle cx="16" cy="12" r="4" fill="#cdc6ba" /><circle cx="30" cy="12" r="4" fill="#cdc6ba" /><circle cx="44" cy="12" r="4" fill="#cdc6ba" />
                    <rect x="22" y="46" width="130" height="14" rx="7" fill="#004f4c" /><rect x="22" y="70" width="110" height="9" rx="4.5" fill="#cdc6ba" /><rect x="22" y="86" width="90" height="9" rx="4.5" fill="#cdc6ba" />
                    <rect x="22" y="110" width="74" height="22" rx="11" fill="#7fd0cc" />
                    <rect x="22" y="152" width="80" height="30" rx="8" fill="#f7f5f0" /><rect x="112" y="152" width="80" height="30" rx="8" fill="#f7f5f0" /><rect x="202" y="152" width="96" height="30" rx="8" fill="#f7f5f0" />
                    <g transform="translate(212 40)" set:html={MOTIV[r.motiv] ?? ''} />
                  </svg>
                )}
              <span class:list={['ref4__etikett', `ref4__etikett--${r.status}`]}>{REFERENZEN.etikett[r.status]}</span>
            </div>
            <div class="ref4__inhalt">
              <h3 class="ref4__titel">{r.name ?? r.branche}</h3>
              <p class="ref4__branche">{r.name ? r.branche : ''}{r.name && r.ort ? ' · ' : ''}{r.ort}</p>
              <dl class="ref4__fakten">
                <div><dt>Ausgangslage</dt><dd>{r.ausgang}</dd></div>
                <div><dt>Umsetzung</dt><dd>{r.gemacht}</dd></div>
                {r.ergebnis && <div class="ref4__ergebnis"><dt>Ergebnis</dt><dd>{r.ergebnis}</dd></div>}
              </dl>
              {r.status === 'online' && r.url && (
                <a class="ref4__link" href={r.url} target="_blank" rel="noopener">Website ansehen<span class="ref4__url">{r.urlText ?? r.url}</span><span class="sr-only"> (öffnet in neuem Tab)</span></a>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p class="ref4__messung">{REFERENZEN.messung}</p>
    </div>
  </section>

  <!-- Kundenstimmen (Jamil #4934 Punkt 3): NUR PLATZHALTER, keine erfundenen Zitate/Namen/Sterne. Nur in der Vorschau. -->
  {PLATZHALTER && (
    <section class="bs bs--alt" id="stimmen" aria-labelledby="bs-stimmen">
      <div class="wrap">
        <div class="bs-kopf bs-kopf--mitte"><h2 id="bs-stimmen">{STIMMEN.titel}</h2></div>
        <ul class="stimmen4">
          {STIMMEN.quellen.map((q) => (
            <li class="stimme4 platzhalter">
              <span class="platzhalter__etikett">{STIMMEN.platzhalter}</span>
              <blockquote class="stimme4__zitat"><p>{STIMMEN.zitat}</p></blockquote>
              <p class="stimme4__quelle">{q}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Kundenreise-Check: seit 08.11. (Jamil #4934 Punkt 6) weiter unten, hinter Referenzen und Kundenstimmen -->
  <Check />

  <!-- „So läuft die Erstberatung“ seit 08.11.2026 Teil von #denkweise (Jamil #4988/#4989) -->

  <!-- Abschluss (Jamil 4792) + Claim (4793): viel Weißraum, keine Animation -->
  <section class="bs abschluss" aria-labelledby="bs-abschluss">
    <div class="wrap abschluss__innen">
      <h2 id="bs-abschluss" class="abschluss__titel">{ABSCHLUSS.titel}</h2>
      <p class="abschluss__text abschluss__text--ruhig">{ABSCHLUSS.text}</p>
      <a class="btn btn--marke btn--lg" href={kontakt(ANLIEGEN.bewerten.paket)}>{ABSCHLUSS.cta}</a>
      <p class="abschluss__unter">{ABSCHLUSS.unterCta}</p>
      <p class="claim"><span class="claim__marke">{MARKE}</span>{CLAIM}</p>
    </div>
  </section>
</BaseLayout>

