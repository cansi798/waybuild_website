---
// STARTSEITE der waybuild Website. Neudesign unter dem Hero am 13.11.2026 (Jamil, Sprachnachricht Talk qh87y3sj #5810:
// „komplett neu designen, passend zu unserem Design … Hero nicht anfassen“; Sicherung Tag vor-startseite-neudesign-20261113).
// Sechs Teile (abgestimmt #5787–#5791): 1 Aufmerksamkeit = Hero (UNVERÄNDERT: Markup, Texte, variante-start.css) + zwei Produkte
// (gleitet über den stehenden Hero, .stapel-paar + scripts/stapel.ts) · 2 Problem · 3 Lösung (Kundenreise mit Leistungen je Station,
// Beispiel-Film) · 4 Beweis (echte Projekte, „Ganz entspannt“, Team nur Vorschau) · 5 Angebot (Pakete, Sicherheit, Fragen)
// · 6 Handlung (Ablauf + Erstberatung). Komponenten src/components/startneu/, Texte src/config/startneu.ts, Stil src/styles/start-neu.css.
// SEIT 14.11.2026 neue Reihenfolge nach Jamils Konzept (Talk qh87y3sj #5843–#5855, Sicherung Tag vor-jamil-konzept-20261114):
// Hero (neue Texte, Design gleich) → „Ganz gleich, wo Sie gerade stehen.“ (SnWege, gleitet über den Hero) → „Kommt Ihnen das bekannt
// vor?“ (SnProblem) → Phasen (SnPhasen) → Website + Web-App (SnSystem) → Partner (SnPartner) → Abschluss (SnAbschluss).
// Jamil #5858/#5859 (14.11.2026) wieder rein (Beispiel-Film SnBeispiel seit #5896 wieder raus, bleibt auf /so-kann-es-laufen/ und /beispiele/): Can + Jamil (SnTeam), Vergleich (SnVergleich),
// Ablauf (SnAblauf), Preise unten (SnAngebot). Hintergründe im Wechsel: Hauch/Papier/Weiß. Produkte, Kundenreise, Projekte (SnBeweis) bleiben draußen.
// 15.11.2026 (Jamil #5967–#5969): Vergleich vor Team, Preise vor Ablauf, keine FAQ auf der Startseite (nur /fragen/).
// 15.11.2026 (Jamil #6011, Audit #5953): Belegzeile im Hero (E2), echte Projekte (SnBeweis nurProjekte) vor den Paketen (V1).
// 15.11.2026 (Jamil #6038, Audit P6/M1): Pakete kompakt (nur Karten, Wahlhilfe, Link auf /preise/), Extras und Sicherheit auf /preise/.
// Frühere Stände und Entscheidungen: Git-Verlauf und Tags (z. B. vor-startseite-6abschnitte-20261113).
// 16.11.2026 (Jamil #6176, Sicherung Tag vor-jamil-6176-20261116): neue erste Abschnitte 1 Hero (J6Hero), 2 Problem (J6Problem),
// 3 Lösung (J6Loesung), Texte in src/config/start-6176.ts. Ausgeblendet per Schalter ALT_ZEIGEN dort: alter Hero, SnWege, SnProblem.
// Dazu Jamil #6179: 4 Anders (J6Anders) · 5 Wachsen (J6Wachsen) · 6 Prozessberatung (J6Prozess) · 7 Referenzen (J6Referenzen)
// · 8 Vertrauen (J6Vertrauen) · Pakete kompakt (SnAngebot, bleibt) · Abschluss-CTA (J6Abschluss). Alle früheren Abschnitte danach
// per ALT_ZEIGEN ausgeblendet (nicht gelöscht). FAQ (9) unverändert: auf der Startseite gibt es seit #5967 keine, nur /fragen/ (#6177).
// WICHTIG: In dieser Datei KEIN <style>-Block (Astro würde sonst data-astro-cid-Attribute an den Hero hängen).
import BaseLayout from '../layouts/BaseLayout.astro';
import J6Hero from '../components/start6176/J6Hero.astro';
import J6Leistungen from '../components/start6176/J6Leistungen.astro'; // Jamil #7250/#7251: Website + Web-App direkt nach dem Hero
import J6Problem from '../components/start6176/J6Problem.astro';
import J6Loesung from '../components/start6176/J6Loesung.astro';
import J6Wechsler from '../components/start6176/J6Wechsler.astro';
import J6Erstsehen from '../components/start6176/J6Erstsehen.astro';
import J6Umstieg from '../components/start6176/J6Umstieg.astro';
import J6Preise from '../components/start6176/J6Preise.astro';
import J6Start from '../components/start6176/J6Start.astro';
import J6Anders from '../components/start6176/J6Anders.astro';
import J6Wachsen from '../components/start6176/J6Wachsen.astro';
import J6Prozess from '../components/start6176/J6Prozess.astro';
import J6Referenzen from '../components/start6176/J6Referenzen.astro';
import J6Vertrauen from '../components/start6176/J6Vertrauen.astro';
import J6Abschluss from '../components/start6176/J6Abschluss.astro';
import { ALT_ZEIGEN, PAKETE_ZEIGEN } from '../config/start-6176';
import SnWege from '../components/startneu/SnWege.astro';
import SnProblem from '../components/startneu/SnProblem.astro';
import SnPhasen from '../components/startneu/SnPhasen.astro';
import SnSystem from '../components/startneu/SnSystem.astro';
import SnAbschluss from '../components/startneu/SnAbschluss.astro';
import SnTeam from '../components/startneu/SnTeam.astro';
import SnVergleich from '../components/startneu/SnVergleich.astro';
import SnAblauf from '../components/startneu/SnAblauf.astro';
import SnAngebot from '../components/startneu/SnAngebot.astro';
import SnBeweis from '../components/startneu/SnBeweis.astro';
import SnBewertungen from '../components/startneu/SnBewertungen.astro';
import { serviceSchema } from '../lib/schema';
import { href } from '../lib/paths';
import { ABO_PAKETE, KOMPLETTPAKET, aboPreisAb, euro, komplettPreis } from '../config/pakete-abo';
import { V_HERO, HERO_KNOPF } from '../config/variante';
import { ANLIEGEN } from '../config/startseite';
import { VORSCHAU } from '../config/vorschau';
import '../styles/startseite.css';
import '../styles/variante-start.css';
import '../styles/start-neu.css';
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url'; // Preload gegen Hero-CLS
import '../styles/start-6176.css'; // Jamil #6176: Hero, Problem, Lösung
import '../styles/start-farben.css'; // neue Farben + Plus Jakarta Sans nur Startseite (Jamil #5899/#5900/#5903)

const kontakt = (paket: string) => href(`/kontakt/?paket=${encodeURIComponent(paket)}`);

// Hero (Jamil #5061/#5062, #5114): unverändert
const ab = aboPreisAb();
/** Hero: Satz in Wörter teilen (je Wort ein span, Jamil #5114) */
const woerter = (t: string) => t.split(/\s+/).filter(Boolean);
const V_TITEL = 'Website-Abo und Web-App zum festen Monatspreis'; // Jamil #6055 Fr. 13: Google-Text passt zur H1
const V_DESCRIPTION = `Ihre Website im Abo, auf Wunsch mit Web-App: feste Pakete ab ${euro(ab)} im Monat netto, ohne Einrichtungskosten. Hosting in Deutschland.`; // Jamil #6055 Fr. 13
const V_SERVICE = `Website-Abo für kleine und mittlere Unternehmen: Wir erstellen die Website, richten E-Mail-Postfächer und Google-Profil ein und betreuen alles danach. Drei Pakete: zwei Website-Pakete (${ABO_PAKETE.map((p) => `${p.name} ${euro(p.preis)}`).join(', ')} im Monat netto), dazu das ${KOMPLETTPAKET.name} mit Website und Auftragsverwaltung (${komplettPreis()} im Monat netto), keine Einrichtungskosten; Logo, Signatur, Geschäftspapiere und Visitenkarten einmalig dazubuchbar.`;
// FAQPage-JSON-LD nur auf /fragen/ (Jamil #5136–#5138); die sechs Fragen unten im Angebot sind sichtbarer Text ohne Schema.
---

<BaseLayout
  title={V_TITEL}
  description={V_DESCRIPTION}
  schema={[serviceSchema(Astro.site, V_SERVICE)]}
  thema="besucherreise"
  stapel
>
  <link slot="head" rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
  <!-- Jamil #6176 (16.11.2026): 1 Hero · 2 Problem · 3 Lösung -->
  <J6Hero />
  {/* Jamil #7250/#7251 (24.11.2026): direkt nach dem Hero die zwei Leistungen Website + Web-App (grafisch) */}
  <J6Leistungen />
  <J6Problem />
  {/* 3. Lösung: seit Jamil #6378/#6379 (19.11.2026) „Websites und Software nach Maß“ mit Wechsler; alte Fassung über ALT_ZEIGEN.loesungAlt */}
  {ALT_ZEIGEN.loesungAlt ? <J6Loesung /> : <J6Wechsler />}
  {/* 4. Jamil #6388 (19.11.2026): „Kein Lastenheft. Kein Risiko. Erst sehen, dann entscheiden.“ direkt nach dem Wechsler */}
  <J6Erstsehen />
  {/* 5. Jamil #6391 (19.11.2026): „Keine Angst vor dem Umstieg – wir nehmen Ihr Team mit“ (Sorglos-Matrix) */}
  <J6Umstieg />
  {/* 6. Jamil #6400 (19.11.2026): „Klare Monatspreise. Keine bösen Überraschungen.“ – ersetzt die Paketkarten (PAKETE_ZEIGEN = false) */}
  <J6Preise />
  <!-- Jamil #6179 (16.11.2026): 4 Anders · 5 Wachsen · 6 Prozessberatung · 7 Referenzen · 8 Vertrauen · Pakete · Abschluss -->
  {/* „Wir entwickeln uns mit Ihrem Unternehmen weiter.“ seit #6388 abschaltbar (ALT_ZEIGEN.weiterentwickelnAbschnitt), seit #6390 hinter Abschnitt 5 */}
  {ALT_ZEIGEN.weiterentwickelnAbschnitt && <J6Anders />}
  {/* seit Jamil #6408–#6412 ausgeblendet (Schalter in config/start-6176.ts) */}
  {ALT_ZEIGEN.wachsenAbschnitt && <J6Wachsen />}
  {ALT_ZEIGEN.prozessAbschnitt && <J6Prozess />}
  {ALT_ZEIGEN.referenzenAbschnitt && <J6Referenzen />}
  {ALT_ZEIGEN.vertrauenAbschnitt && <J6Vertrauen />}
  <!-- Pakete kompakt nach „Verlässlichkeit“ (endet mit „Fester Monatspreis“), direkt vor dem Abschluss -->
  {PAKETE_ZEIGEN && <SnAngebot zeigeFragen={false} kompakt />}
  {/* 7. Jamil #6402 (19.11.2026): Abschluss mit zwei Mini-Formularen; alter Abschluss-CTA über ALT_ZEIGEN.abschlussCtaAlt */}
  {ALT_ZEIGEN.abschlussCtaAlt ? <J6Abschluss /> : <J6Start />}

  <!-- Erster Bildschirm (Jamil #5085–#5124): ganz in Türkis, mittig, ohne Preise, ein Knopf, vier kurze Vorteile unten im selben Verlauf; weicher, sehr
       langsam bewegter Mesh-Verlauf (4 Farbflächen, nur CSS) statt Linienmuster; Einblenden Wort für Wort (variante-start.css). -->
  <!-- Stapel nur am Hero (Jamil, Talk qh87y3sj #5152–#5155, 09.11.2026): .stapel-paar umschließt Hero und „Was wir für Sie machen.“ (seit 13.11.2026, vorher Kundenreise); nur darin
       bleibt der Hero stehen (sticky), die Kundenreise gleitet darüber. Danach scrollt die Seite ganz normal (stapel.ts). -->
  {ALT_ZEIGEN.heroAlt && (
  <div class="stapel-paar">
  <section class="v-hero"><!-- ohne aria-labelledby: gleicher Satz wie die alte H2 weiter unten (axe landmark-unique) -->
    <div class="v-mesh" aria-hidden="true"><span class="v-blob v-blob--1"></span><span class="v-blob v-blob--2"></span><span class="v-blob v-blob--3"></span><span class="v-blob v-blob--4"></span></div>
    <div class="wrap v-hero__mitte">
      <!-- Wort für Wort wie firma.de (Jamil #5114): jedes Wort ein span mit --i (Reihenfolge), nur CSS. Die H1 hat den ganzen
           Satz als aria-label, die Wort-spans sind aria-hidden; Leerzeichen bleiben echte Textknoten (Kopieren = normaler Text). -->
      <h1 id="v-h1" class="v-titel" aria-label={V_HERO.titel}>{woerter(V_HERO.titel).map((w, i) => <><span class="v-wort" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>)}</h1>
      <!-- Unterzeile: was wir technisch übernehmen (Jamil, Talk qh87y3sj #5159–#5168, 09.11.2026). „Für Gründer …“ entfernt (#5165);
           blendet als Ganzes nach der H1 ein (nicht Wort für Wort, dafür ist der Satz zu lang). -->
      <p class="lead v-unter v-ein v-ein--2">{V_HERO.unter}</p>
      <!-- Ein Knopf (#5121–#5124): weiß, Schrift #EFBF04, sanfter Lichtschein alle 3 s + Glanz (variante-start.css) -->
      <div class="v-knopfe v-ein v-ein--3">
        <a class="btn v-leucht" href={kontakt(ANLIEGEN.erstberatung.paket)}>{HERO_KNOPF}</a>
      </div>
      <!-- Kostenlose Vorschau direkt am Hauptknopf (Jamil #6061, Text zentral in config/vorschau.ts, keine Zahlungsaussage) -->
      <p class="v-vorschau v-ein v-ein--4"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg><span>{VORSCHAU.kurz}</span></p>
      <!-- Vertrauenshinweis unter dem Knopf (Jamil #5847, 14.11.2026) -->
      <p class="v-fuer v-ein v-ein--4">{V_HERO.fuer}</p>
      <!-- Belegzeile aus belegten Fakten, Preis aus pakete-abo.ts (Jamil #6011, Audit #5953 E2) -->
      <p class="v-beleg v-ein v-ein--4">{[`ab ${euro(ab)} netto im Monat`, ...V_HERO.beleg].map((t, i) => <>{i > 0 && <span class="v-beleg__punkt" aria-hidden="true"> · </span>}<span class="v-beleg__teil">{t}</span></>)}</p>
    </div>
    <!-- Leiste mit vier Vorteilen entfernt (Jamil, Talk qh87y3sj #5166, 09.11.2026) -->
  </section>

  <!-- „Ganz gleich, wo Sie gerade stehen.“ (Jamil #5848) gleitet über den stehenden Hero -->
  {ALT_ZEIGEN.wegeAlt && <SnWege />}
  </div>
  )}
  {!ALT_ZEIGEN.heroAlt && ALT_ZEIGEN.wegeAlt && <SnWege />}

  {ALT_ZEIGEN.problemAlt && <SnProblem />}
  {ALT_ZEIGEN.phasenAlt && <SnPhasen />}
  {ALT_ZEIGEN.systemAlt && <SnSystem />}
  {ALT_ZEIGEN.vergleichAlt && <SnVergleich />}
  {ALT_ZEIGEN.teamAlt && <SnTeam />}
  <!-- Echte Projekte vor den Paketen (Jamil #6011, Audit #5953 V1): nur vorhandene Projekte aus /beispiele/, ohne Kundenzitate -->
  {ALT_ZEIGEN.beweisAlt && <SnBeweis nurProjekte />}
  <!-- Bewertungen Google/Trustpilot: erst mit echten Bewertungen sichtbar, vorher nur Platzhalter in der Vorschau (Jamil #6055 Fr. 6) -->
  {ALT_ZEIGEN.bewertungenAlt && <SnBewertungen />}
  {ALT_ZEIGEN.ablaufAlt && <SnAblauf />}
  {ALT_ZEIGEN.abschlussAlt && <SnAbschluss />}
</BaseLayout>

<script>
  import '../scripts/stapel.ts';
  import '../scripts/start-neu.ts';
</script>
<!-- Jamil #6182/#6192: Bewegung Startseite (Einblenden, Hero-Beispiele). Eigener script-Block, damit beide klein genug bleiben,
     um inline eingebettet zu werden (keine zusätzliche Anfrage vor dem ersten Bild, LCP wie vorher). -->
<script>
  import '../scripts/start-6182.ts';
</script>
