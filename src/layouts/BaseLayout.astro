---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MobileCta from '../components/MobileCta.astro';
import { company, isMissing, SHOW_HINTS } from '../config/site';
import { launchTodos } from '../config/launch';
import { href, absolute } from '../lib/paths';
import { IS_PREVIEW } from '../lib/env';

interface Props {
  title: string;
  description: string;
  /** Zusätzliche JSON-LD-Objekte für diese Seite */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  breadcrumb?: { name: string; path: string }[];
  /** Mobile Sticky-CTA ausblenden (z. B. auf der Kontaktseite selbst) */
  hideMobileCta?: boolean;
}

const { title, description, schema = [], noindex = false, breadcrumb, hideMobileCta = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteRoot = absolute('/', Astro.site);
const ogImage = absolute('/og-image.png', Astro.site);
const fullTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;

const hasAddress = ![company.street, company.zip, company.city].some(isMissing);

const organization = {
  '@context': 'https://schema.org',
  // Mit vollständiger Adresse zusätzlich lokales Unternehmen → Chance auf lokale Suchergebnisse
  '@type': hasAddress ? ['Organization', 'ProfessionalService'] : 'Organization',
  '@id': `${siteRoot}#organization`,
  name: company.legalName,
  alternateName: company.name,
  url: siteRoot,
  logo: absolute('/icon-512.png', Astro.site),
  image: ogImage,
  slogan: company.slogan,
  ...(company.sameAs.length ? { sameAs: company.sameAs } : {}),
  ...(hasAddress ? { priceRange: '€€', areaServed: { '@type': 'Country', name: 'Deutschland' } } : {}),
  email: company.email,
  ...(!isMissing(company.phone) ? { telephone: company.phone } : {}),
  // Adresse erst ausgeben, wenn sie vollständig ist – nie Platzhalter an Google melden
  ...(!hasAddress
    ? {}
    : {
        address: {
          '@type': 'PostalAddress',
          streetAddress: company.street,
          postalCode: company.zip,
          addressLocality: company.city,
          addressCountry: company.country,
        },
      }),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  url: siteRoot,
  name: company.name,
  inLanguage: 'de-DE',
  publisher: { '@id': `${siteRoot}#organization` },
};

const breadcrumbSchema = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Start', path: '/' }, ...breadcrumb].map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: absolute(b.path, Astro.site),
  })),
};

const openTodos = launchTodos.filter((t) => !t.done).length;

const jsonLd = [organization, website, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={IS_PREVIEW ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#0e1a2b" />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Waybuild – Ihre Website. Ein Unikat. Komplett betreut." />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    {IS_PREVIEW && <div class="preview-bar">Vorschau – noch nicht veröffentlicht</div>}
    <Header />
    <main id="main">
      {breadcrumb && <Breadcrumbs items={breadcrumb} />}
      <slot />
    </main>
    <Footer />
    {!hideMobileCta && <MobileCta />}
    {SHOW_HINTS && openTodos > 0 && (
      <a class="todo-badge" href={href('/checkliste/')}>
        <span aria-hidden="true">!</span> {openTodos}<em> Punkte offen bis zum Start</em>
      </a>
    )}
  </body>
</html>

<style>
  .todo-badge {
    position: fixed; right: 16px; bottom: 16px; z-index: 60;
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff4c2; color: #5c4400; border: 1.5px dashed #d4a300; border-radius: 99px;
    padding: 8px 14px; font-size: 0.85rem; font-weight: 650; text-decoration: none;
    box-shadow: 0 8px 24px rgb(14 26 43 / 18%);
  }
  .todo-badge span { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #d4a300; color: #fff; font-size: 0.72rem; font-weight: 800; }
  @media print { .todo-badge { display: none; } }
  .preview-bar { background: #0e1a2b; color: #aab5c3; text-align: center; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 16px; }
  /* Mobil: über der Sticky-CTA-Leiste, kompakter */
  .todo-badge em { font-style: normal; }
  @media (max-width: 959px) { .todo-badge { bottom: 84px; right: 10px; padding: 6px 10px; font-size: 0.8rem; } .todo-badge em { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
</style>
