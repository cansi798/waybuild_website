---
import { company } from '../config/site';
import { href } from '../lib/paths';
import Logo from './Logo.astro';
import { GRUPPEN } from '../config/leistungen-neu';
import FooterKontakt from './FooterKontakt.astro';
import { BEISPIEL_LINK } from '../config/beispiel';

// thema 'besucherreise' (neue Startseite): ohne Kontaktkopf (der Abschluss der Seite ist der CTA).
// Seit 14.11.2026 (#5892) auch ausgeblendet auf jeder Seite mit dem neuen Abschluss SnAbschluss (#kontakt-start), per CSS :has(),
// damit dort nicht zwei Abschlüsse hintereinander stehen.
// Logo C (Negativ) auf allen Seiten, auch auf der Startseite (Jamil, Talk qh87y3sj #5226/#5227 „überall“).
// ohneKontaktkopf: Kontakt- und Danke-Seite ohne den Block „Kostenlose Erstberatung … anrufen / WhatsApp“ (Jamil #6038, Audit H7/D2):
// dort steht der Kontakt schon im Inhalt bzw. die Anfrage ist bereits gesendet.
interface Props { thema?: 'besucherreise'; ohneKontaktkopf?: boolean }
const reise = Astro.props.thema === 'besucherreise' || !!Astro.props.ohneKontaktkopf;

const year = new Date().getFullYear();
---

<footer class="footer section--dark">
  {!reise && <div class="footer__kontaktkopf"><FooterKontakt /></div>}
  <div class:list={['wrap footer__grid', { 'footer__grid--ohne-kopf': reise }]}>
    <div>
      <Logo variante="aufgold" />
      <p class="footer__claim">{company.slogan}</p>
    </div>
    <nav aria-label="Footer">
      <h2 class="footer__h">Leistungen</h2>
      <ul>
        {/* Neue Leistungen in vier Gruppen, Altbestand nicht mehr verlinkt (Jamil, Talk qh87y3sj #5274/#5276) */}
        {GRUPPEN.map((g) => <li><a href={href(`/leistungen/#${g.id}`)}>{g.titel}</a></li>)}
        <li><a href={href('/leistungen/')}>Alle Leistungen im Überblick</a></li>
        <li><a href={href('/preise/')}>Preise</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="footer__h">Unternehmen</h2>
      <ul>
        <li><a href={href('/ueber-uns/')}>Über uns</a></li>
        <li><a href={href('/beispiele/')}>Beispiele</a></li>
        {/* Animiertes Beispiel (Jamil, Talk qh87y3sj #5678/#5680, 13.11.2026): nur hier und im Teaser der Startseite verlinkt, nicht im Menü */}
        <li><a href={href('/so-kann-es-laufen/')}>{BEISPIEL_LINK}</a></li>
        <li><a href={href('/warum-wir/')}>Warum webgold</a></li>
        <li><a href={href('/kontakt/')}>Kontakt</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__h">Wissen</h2>
      <ul>
        <li><a href={href('/ratgeber/')}>Ratgeber</a></li>
        <li><a href={href('/fragen/')}>Häufige Fragen</a></li>
        <li><a href={href('/blog/')}>Blog</a></li>
        <li><a href={href('/wissen/')}>Alles im Überblick</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__h">Rechtliches</h2>
      <ul>
        <li><a href={href('/impressum/')}>Impressum</a></li>
        <li><a href={href('/datenschutz/')}>Datenschutz</a></li>
        <li><a href={href('/agb/')}>AGB</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <small>© {year} {company.name} ist ein Angebot der {company.legalName}. Alle Preise netto zzgl. gesetzl. USt.</small>{/* Jamil #6055 Fr. 22 (vorher „– powered by …“); Impressum unverändert */}
  </div>
</footer>

<style>
  :global(body:has(#kontakt-start)) .footer__kontaktkopf { display: none; }
  /* Fußzeile dunkles Logo-Türkis #8C6D12 auf der ganzen Website (Jamil, Talk qh87y3sj #5072, 08.11.2026):
   * Überschriften, Links und Text Weiß (6,36 : 1) bzw. #F1F5F9 (5,7 : 1, auch Kleintext), Hover unterstrichen,
   * Linien Weiß 22 %, Fokusrahmen Weiß. Gilt auch für den Kontaktkopf (FooterKontakt) der übrigen Seiten. */
  /* Seit Jamil #6442 (20.11.2026): Fußzeile in Gold mit Slate-Schrift (#0F172A auf #D4AF37 ≈ 8,5 : 1), Links unterstrichen */
  .footer { padding-block: 0 calc(28px + env(safe-area-inset-bottom)); background: linear-gradient(160deg, #D4AF37 0%, #E2C15A 100%); color: #0F172A; }
  .footer :global(:focus-visible) { outline: 3px solid #0F172A; outline-offset: 3px; }
  .footer__grid { padding-top: clamp(32px, 5vw, 48px); border-top: 1px solid rgb(15 23 42 / 22%); }
  .footer__grid--ohne-kopf { border-top: 0; padding-top: clamp(44px, 6vw, 64px); }
  @media (max-width: 599px) {
    .footer__grid { gap: 20px 16px; }
    .footer ul { display: flex; flex-wrap: wrap; gap: 0 16px; }
    .footer__h { margin-bottom: 4px; }
  }
  @media (max-width: 599px) { .footer li a { padding: 6px 0; font-size: 0.92rem; } .footer__claim { margin-top: 10px; } .footer__bottom { margin-top: 28px; } }
  /* Logo auf dunklem Grund: Negativ-Fassung von Entwurf C („way“ #A8EAE4 4,71 : 1, „build“ Weiß 6,36 : 1),
   * keine weiße Kachel mehr (die war nur für das alte PNG nötig; Jamil, Talk qh87y3sj #5226/#5227) */
  .footer__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
  .footer__grid > :first-child { grid-column: 1 / -1; }
  /* Spalte „Branchen“ entfernt (Jamil, Talk qh87y3sj #5261); Logo oben über die ganze Breite.
   * Spalte „Wissen“ (Ratgeber, Häufige Fragen, Blog, Übersicht; Jamil, Talk qh87y3sj #5264) an der Stelle der
   * früheren Spalte „Branchen“: vier Link-Blöcke, schmal 2 × 2, ab 900 px vier Spalten nebeneinander. */
  @media (min-width: 720px) { .footer__grid { gap: 36px; } }
  @media (min-width: 900px) { .footer__grid { grid-template-columns: repeat(4, 1fr); } }
  .footer__claim { color: #1E293B; margin-top: 16px; max-width: 32ch; }
  .footer__h { font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: #1E293B; margin-bottom: 12px; }
  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer li a { display: inline-block; padding: 6px 0; color: #0F172A; text-decoration: underline; text-decoration-color: rgb(15 23 42 / 35%); text-underline-offset: 4px; }
  .footer li a:hover { color: #0F172A; text-decoration-color: #0F172A; }
  .footer__bottom { margin-top: 48px; padding-top: 20px; border-top: 1px solid rgb(15 23 42 / 22%); color: #1E293B; }
</style>
