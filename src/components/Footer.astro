---
import { company } from '../config/site';
import { href } from '../lib/paths';
import Logo from './Logo.astro';
import { leistungen } from '../config/leistungen';
import FooterKontakt from './FooterKontakt.astro';

// thema 'besucherreise' (neue Startseite): ohne Kontaktkopf (der Abschluss der Seite ist der CTA).
// Logo C (Negativ) auf allen Seiten, auch auf der Startseite (Jamil, Talk qh87y3sj #5226/#5227 „überall“).
interface Props { thema?: 'besucherreise' }
const reise = Astro.props.thema === 'besucherreise';

const year = new Date().getFullYear();
---

<footer class="footer section--dark">
  {!reise && <FooterKontakt />}
  <div class:list={['wrap footer__grid', { 'footer__grid--ohne-kopf': reise }]}>
    <div>
      <Logo variante="negativ" />
      <p class="footer__claim">{company.slogan}</p>
    </div>
    <nav aria-label="Footer">
      <h2 class="footer__h">Leistungen</h2>
      <ul>
        <li><a href={href('/leistungen/')}>Website as a Service</a></li>
        {leistungen.filter((l) => l.saeule !== 'websites').map((l) => <li><a href={href(`/leistungen/${l.slug}/`)}>{l.title}</a></li>)}
        <li><a href={href('/preise/')}>Preise</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="footer__h">Unternehmen</h2>
      <ul>
        <li><a href={href('/ueber-uns/')}>Über uns</a></li>
        <li><a href={href('/referenzen/')}>Referenzen</a></li>
        <li><a href={href('/warum-waybuild/')}>Warum waybuild</a></li>
        <li><a href={href('/ratgeber/')}>Ratgeber</a></li>
        <li><a href={href('/fragen/')}>Häufige Fragen</a></li>
        <li><a href={href('/kontakt/')}>Kontakt</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__h">Rechtliches</h2>
      <ul>
        <li><a href={href('/impressum/')}>Impressum</a></li>
        <li><a href={href('/datenschutz/')}>Datenschutz</a></li>
        <li><a href={href('/agb/')}>AGB</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <small>© {year} {company.legalName}. Alle Preise netto zzgl. gesetzl. USt.</small>
  </div>
</footer>

<style>
  /* Fußzeile dunkles Logo-Türkis #006b68 auf der ganzen Website (Jamil, Talk qh87y3sj #5072, 08.11.2026):
   * Überschriften, Links und Text Weiß (6,36 : 1) bzw. #e6f6f5 (5,7 : 1, auch Kleintext), Hover unterstrichen,
   * Linien Weiß 22 %, Fokusrahmen Weiß. Gilt auch für den Kontaktkopf (FooterKontakt) der übrigen Seiten. */
  .footer { padding-block: 0 calc(28px + env(safe-area-inset-bottom)); background: var(--accent-ink); color: var(--white); }
  .footer :global(:focus-visible) { outline-color: var(--white); }
  .footer__grid { padding-top: clamp(32px, 5vw, 48px); border-top: 1px solid rgb(255 255 255 / 22%); }
  .footer__grid--ohne-kopf { border-top: 0; padding-top: clamp(44px, 6vw, 64px); }
  @media (max-width: 599px) {
    .footer__grid { gap: 20px 16px; }
    .footer ul { display: flex; flex-wrap: wrap; gap: 0 16px; }
    .footer__h { margin-bottom: 4px; }
  }
  @media (max-width: 599px) { .footer li a { padding: 6px 0; font-size: 0.92rem; } .footer__claim { margin-top: 10px; } .footer__bottom { margin-top: 28px; } }
  /* Logo auf dunklem Grund: Negativ-Fassung von Entwurf C („way“ #A8EAE4 4,71 : 1, „build“ Weiß 6,36 : 1),
   * keine weiße Kachel mehr (die war nur für das alte PNG nötig; Jamil, Talk qh87y3sj #5226/#5227) */
  .footer__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
  .footer__grid > :first-child { grid-column: 1 / -1; }
  /* Spalte „Branchen“ entfernt (Jamil, Talk qh87y3sj #5261): Logo oben, darunter drei Link-Blöcke.
   * Schmal 2 Spalten (Rechtliches über die ganze Breite), ab 720 px drei Spalten, ab 1100 px vier Spuren
   * (Spaltenbreite wie bisher, die Blöcke stehen links bündig). */
  .footer__grid > :last-child { grid-column: 1 / -1; }
  @media (min-width: 720px) { .footer__grid { gap: 36px; grid-template-columns: repeat(3, 1fr); } .footer__grid > :last-child { grid-column: auto; } }
  @media (min-width: 1100px) { .footer__grid { grid-template-columns: repeat(4, 1fr); } }
  .footer__claim { color: var(--on-dark-soft); margin-top: 16px; max-width: 32ch; }
  .footer__h { font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-dark-soft); margin-bottom: 12px; }
  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer li a { display: inline-block; padding: 6px 0; text-decoration: none; color: var(--white); }
  .footer li a:hover { color: var(--white); text-decoration: underline; text-underline-offset: 4px; }
  .footer__bottom { margin-top: 48px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / 22%); color: var(--on-dark-soft); }
</style>
