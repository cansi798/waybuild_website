---
// Heller Footer-Kopf (seit 20.11.2026, Jamil #6521; vorher dunkel) auf jeder Seite (Bauwelt-Muster): Leitsatz + Direktkontakt
// (Kostenlose Erstberatung, Telefon, WhatsApp, E-Mail). Ersetzt das frühere CTA-Band.
import { href } from '../lib/paths';
import { company, phoneTel, whatsappLink, HOURS } from '../config/site';
import { FOOTER_KONTAKT as F } from '../config/home';
import { ANLIEGEN } from '../config/startseite';
import Icon from './Icon.astro';
---

<section class="fkontakt section--dark" aria-labelledby="fkontakt-titel">
  <div class="wrap fkontakt__inner">
    <h2 id="fkontakt-titel">{F.pre}<mark class="hl accent">{F.accent}</mark></h2>
    <p class="fkontakt__sub">{F.sub}</p>
    <p class="fkontakt__text">{F.text}</p>

    <h3 class="fkontakt__head">{F.kontaktHead}</h3>
    <p class="fkontakt__text">{F.kontaktText}</p>
    <div class="fkontakt__actions">
      <a class="btn btn--primary" href={href('/kontakt/')}><Icon name="calendar" size={18} /> {ANLIEGEN.erstberatung.label}</a>
      <a class="btn fkontakt__ghost" href={`tel:${phoneTel()}`}><Icon name="phone" size={18} /> {company.phone} anrufen</a>
      <a class="btn fkontakt__ghost" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Per WhatsApp schreiben</a>
      <a class="btn fkontakt__ghost fkontakt__mail" href={`mailto:${company.email}`}><Icon name="mail" size={18} /> {company.email}</a>
    </div>
    <p class="fkontakt__zeiten">{HOURS}</p>
  </div>
</section>

<style>
  /* Seit 20.11.2026 hell wie die Abschluss-Box der Startseite (Jamil #6515/#6521): Goldstich #FFFEFB, feine Goldlinie oben,
     Schrift Anthrazit, Hauptknopf Gold mit dunkler Schrift, Nebenknöpfe mit Anthrazit-Rand. Vorher weiße Schrift auf dunkler/goldener Fläche. */
  .fkontakt { padding-block: clamp(56px, 8vw, 96px); background: #FFFEFB; color: #111827; }
  .fkontakt :global(.accent) { color: #111827; }
  .fkontakt__inner { display: grid; justify-items: center; text-align: center; gap: 12px; }
  .fkontakt__inner h2, .fkontakt__inner h3, .fkontakt__inner p { margin: 0; color: #111827; }
  .fkontakt__inner .fkontakt__sub { font-family: var(--font-head); font-weight: 650; font-size: 1.2rem; color: #374151; }
  .fkontakt__inner .fkontakt__text { color: #4B5563; max-width: 46rem; }
  .fkontakt__head { margin-top: 24px !important; font-size: 1.35rem; }
  .fkontakt__actions { display: grid; gap: 10px; width: 100%; max-width: 22rem; margin-top: 6px; }
  @media (min-width: 960px) { .fkontakt__actions { grid-template-columns: auto auto; justify-content: center; max-width: 48rem; } .fkontakt__actions .btn { white-space: nowrap; } }
  .fkontakt__actions .btn { justify-content: center; padding: 0.7em 1.4em; font-size: 0.95rem; gap: 8px; }
  .fkontakt__actions .btn--primary { background: #EFBF04; border-color: #EFBF04; color: #111827; box-shadow: 0 16px 32px -18px rgb(140 109 18 / 60%); }
  .fkontakt__actions .btn--primary:hover { background: #EFBF04; border-color: #EFBF04; }
  .fkontakt__ghost { background: #FFFFFF; border-color: #111827; color: #111827; }
  .fkontakt__ghost:hover { background: #FBF3D5; border-color: #111827; }
  .fkontakt__inner .fkontakt__zeiten { color: #4B5563; font-size: 0.9rem; margin-top: 4px !important; }
  .fkontakt :global(:focus-visible) { outline-color: #EFBF04; }
</style>
