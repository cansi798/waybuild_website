---
// Laptop für das Beispiel „So kann es laufen“ (Jamil, Talk qh87y3sj #5678/#5680, 13.11.2026).
// Deckel mit Bildschirm (etwa 16 : 10) und flaches Unterteil mit Griffmulde. Gleiche Kontur/Radien-Logik wie Handy/Tablet.
// Größe: so breit wie der umgebende Größen-Container erlaubt; eigene Breite per --gr-breite.
// Im Bildschirm gilt var(--px) = 1/640 der Bildschirmbreite.
import '../../../styles/beispiel-mockup.css';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div class:list={['gr', 'gr-laptop', cls]}>
  <div class="gr-gehaeuse"></div>
  <span class="gr-kamera"></span>
  <div class="gr-schirm">
    <div class="gr-inhalt"><slot /></div>
  </div>
  <div class="gr-basis"></div>
</div>
