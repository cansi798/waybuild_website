---
// Szene 10 „Alles im Blick“ des Beispiels „So kann es laufen“ (Jamil, Talk qh87y3sj #5678/#5680, 13.11.2026).
// Drehbuch: Kundenportal (Laptop): nächste Schritte als Liste, Termin, Status; Knopf „Angebot annehmen“ → ✓ angenommen.
// Wird auch als ruhende Vorschau im Teaser der Startseite gezeigt (variante="mini", Laptop hinter dem Handy von Szene 1):
// deshalb steht das Wichtigste (Angebot ✓ angenommen, Termin) in der RECHTEN Spalte, die links vom Handy verdeckt wird nicht.
// Anleitung: docs/beispiel-szenen-anleitung.md, Referenz: Szene01.astro. Kopfzeile des Portals: 10-13/PortalKopf.astro.
// Phasen (3):
//   0  Ausgang: Portal öffnet sich, nur die Kopfzeile steht
//   1  Auftrag mit Status „Angebot liegt vor“, Liste „Nächste Schritte“, Angebot und Termin gleiten nacheinander herein;
//      der Knopf „Angebot annehmen“ pulsiert sanft
//   2  Finger tippt auf „Angebot annehmen“
//   3  ✓ Angenommen: Knopf wird grün, Status „Angebot angenommen“, Schritt abgehakt, Ausführung ist der nächste Schritt,
//      Hinweis „Der Betrieb ist informiert.“
// Endzustand (ohne JS, reduzierte Bewegung, Variante „mini“) = Phase 3.
import SzeneRahmen from '../SzeneRahmen.astro';
import Laptop from '../geraete/Laptop.astro';
import PortalKopf from './10-13/PortalKopf.astro';

interface Props { variante?: 'buehne' | 'mini' }
const { variante = 'buehne' } = Astro.props;

const haken = '<path d="M5 12.5l4.2 4.2L19 7" />';
---

<SzeneRahmen nr={10} phasen={3} takt={1500} format="quer" variante={variante}>
  <Laptop>
    <div class="sz10-app">
      <PortalKopf />
      <div class="sz10-raster">
        <!-- links: Auftrag + nächste Schritte -->
        <div class="sz10-spalte">
          <div class="bm-karte sz10-auftrag sz10-ein sz10-ein--1">
            <p class="bm-klein">Ihr Auftrag</p>
            <p class="sz10-auftrag-titel">Wohnzimmer streichen</p>
            <p class="bm-klein">Wände in Salbei · Decke in Weiß</p>
            <span class="sz10-status">
              <span class="bm-chip sz10-status-offen"><i></i>Angebot liegt vor</span>
              <span class="bm-chip bm-chip--ok sz10-status-an"><i></i>Angebot angenommen</span>
            </span>
          </div>
          <div class="bm-karte sz10-schritte sz10-ein sz10-ein--2">
            <p class="sz10-kopf">Nächste Schritte</p>
            <ol class="sz10-liste">
              <li class="sz10-schritt sz10-schritt--fertig">
                <span class="sz10-punkt"><svg viewBox="0 0 24 24" set:html={haken} /></span>
                <span class="sz10-was">Besichtigung</span><span class="sz10-wann">Do, 19.11.</span>
              </li>
              <li class="sz10-schritt sz10-schritt--angebot">
                <span class="sz10-punkt"><i class="sz10-ring"></i><svg class="sz10-haken" viewBox="0 0 24 24" set:html={haken} /></span>
                <span class="sz10-was">Angebot annehmen</span>
                <span class="sz10-wann sz10-stapel"><span class="sz10-wann-offen">offen</span><span class="sz10-wann-an">erledigt</span></span>
              </li>
              <li class="sz10-schritt sz10-schritt--naechst">
                <span class="sz10-punkt"></span>
                <span class="sz10-was">Ausführung</span><span class="sz10-wann">Mo, 30.11.</span>
              </li>
              <li class="sz10-schritt">
                <span class="sz10-punkt"></span>
                <span class="sz10-was">Abnahme</span><span class="sz10-wann">danach</span>
              </li>
              <li class="sz10-schritt">
                <span class="sz10-punkt"></span>
                <span class="sz10-was">Rechnung</span><span class="sz10-wann">automatisch</span>
              </li>
            </ol>
          </div>
        </div>

        <!-- rechts: Angebot mit Knopf, Termin, Hinweis -->
        <div class="sz10-spalte">
          <div class="bm-karte bm-karte--marke sz10-angebot sz10-ein sz10-ein--3">
            <p class="sz10-angebot-kopf"><span class="bm-klein">Angebot Nr. 041</span><span class="bm-chip">PDF</span></p>
            <p class="sz10-angebot-was">Malerarbeiten Wohnzimmer</p>
            <p class="sz10-preis">1.404,20 €</p>
            <p class="bm-klein">inkl. MwSt.</p>
            <span class="sz10-knopfbox">
              <span class="bm-knopf sz10-annehmen">Angebot annehmen</span>
              <span class="bm-knopf sz10-angenommen"><span class="bm-ok"><svg viewBox="0 0 24 24" set:html={haken} /></span>Angenommen</span>
              <span class="bm-tipp sz10-tipp"></span>
            </span>
          </div>
          <div class="bm-karte sz10-termin sz10-ein sz10-ein--4">
            <span class="sz10-kal"><b>Mo</b><span>30</span></span>
            <span class="sz10-termin-text"><span class="bm-klein">Termin Ausführung</span><b>Mo, 30.11. · 8:00 Uhr</b></span>
          </div>
          <p class="sz10-hinweis"><span class="bm-ok"><svg viewBox="0 0 24 24" set:html={haken} /></span>Der Betrieb ist informiert.</p>
        </div>
      </div>
    </div>
  </Laptop>
</SzeneRahmen>

<style is:global>
  /* ===== Szene 10 „Alles im Blick“ – alle Regeln mit .sz10 (global, eindeutig) =====
   * GRUNDFORM = ENDZUSTAND (Phase 3). Vorzustände NUR unter .sz10[data-phase]:not([data-erreicht~="k"]). Bewegt: transform/opacity. */
  .sz10-app { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .sz10-app p { margin: 0; }
  .sz10-raster { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: calc(14 * var(--px)); padding: var(--bsp-a4); }
  .sz10-spalte { display: flex; flex-direction: column; gap: calc(10 * var(--px)); min-width: 0; }

  /* Auftrag + Status */
  .sz10-auftrag { display: flex; flex-direction: column; gap: calc(3 * var(--px)); }
  .sz10-auftrag-titel { font-family: var(--font-head); font-size: var(--bsp-schrift-l); font-weight: 700; color: var(--bsp-text); letter-spacing: -0.01em; }
  .sz10-status { display: grid; justify-items: start; margin-top: var(--bsp-a1); }
  .sz10-status > * { grid-area: 1 / 1; }
  .sz10-status .bm-chip { font-size: var(--bsp-schrift-s); padding: calc(4 * var(--px)) calc(10 * var(--px)); }
  .sz10-status .bm-chip i { width: calc(7 * var(--px)); height: calc(7 * var(--px)); border-radius: 50%; background: currentColor; }
  .sz10-status-offen { opacity: 0; }

  /* Nächste Schritte */
  .sz10-schritte { padding-bottom: calc(6 * var(--px)); }
  .sz10-kopf { font-family: var(--font-head); font-size: var(--bsp-schrift-m); font-weight: 700; color: var(--bsp-text); margin-bottom: calc(2 * var(--px)) !important; }
  .sz10-liste { list-style: none; margin: 0; padding: 0; }
  .sz10-schritt { position: relative; display: flex; align-items: center; gap: var(--bsp-a2); height: calc(29 * var(--px)); font-size: var(--bsp-schrift-s); color: var(--bsp-text-leise); }
  .sz10-schritt + .sz10-schritt { border-top: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .sz10-was { flex: 1; min-width: 0; white-space: nowrap; }
  .sz10-wann { flex: none; font-size: var(--bsp-schrift-xs); color: var(--bsp-text-leise); }
  .sz10-punkt { position: relative; flex: none; display: grid; place-items: center; width: calc(18 * var(--px)); height: calc(18 * var(--px)); border-radius: 50%;
    box-shadow: inset 0 0 0 calc(1.5 * var(--px)) #c5cfcd; }
  .sz10-punkt svg { width: 64%; height: 64%; fill: none; stroke: var(--bsp-weiss); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  .sz10-schritt--fertig, .sz10-schritt--angebot { color: var(--bsp-text); }
  .sz10-schritt--fertig .sz10-punkt { background: var(--bsp-ok); box-shadow: none; }
  .sz10-schritt--angebot .sz10-punkt { background: var(--bsp-ok); box-shadow: none; }
  .sz10-ring { position: absolute; inset: 0; border-radius: 50%; background: var(--bsp-weiss); box-shadow: inset 0 0 0 calc(2 * var(--px)) var(--bsp-tuerkis), 0 0 0 calc(3 * var(--px)) rgb(0 166 161 / 18%); opacity: 0; }
  .sz10-haken { position: relative; }
  .sz10-stapel { display: grid; justify-items: end; }
  .sz10-stapel > * { grid-area: 1 / 1; }
  .sz10-wann-offen { color: var(--bsp-tinte); font-weight: 650; opacity: 0; }
  .sz10-wann-an { color: var(--bsp-ok); font-weight: 650; }
  /* Ausführung ist jetzt „als Nächstes“: zarte Fläche + Türkis-Ring */
  .sz10-schritt--naechst { color: var(--bsp-text); font-weight: 600; }
  .sz10-schritt--naechst::before { content: ''; position: absolute; inset: calc(2 * var(--px)) calc(-6 * var(--px)); z-index: -1; border-radius: var(--bsp-r-s); background: var(--bsp-flaeche); }
  .sz10-schritt--naechst .sz10-punkt { box-shadow: inset 0 0 0 calc(2 * var(--px)) var(--bsp-tuerkis); }
  .sz10-schritt--naechst .sz10-wann { color: var(--bsp-tinte); font-weight: 650; }
  .sz10-liste { position: relative; z-index: 0; }

  /* Angebot */
  .sz10-angebot { display: flex; flex-direction: column; gap: calc(3 * var(--px)); }
  .sz10-angebot-kopf { display: flex; justify-content: space-between; align-items: center; }
  .sz10-angebot-was { font-size: var(--bsp-schrift-m); font-weight: 600; color: var(--bsp-text); }
  .sz10-preis { font-family: var(--font-head); font-size: var(--bsp-schrift-xxl); font-weight: 700; color: var(--bsp-text); letter-spacing: -0.02em; line-height: 1.15; margin-top: calc(2 * var(--px)) !important; }
  .sz10-knopfbox { position: relative; display: grid; margin-top: var(--bsp-a2); }
  .sz10-knopfbox > .bm-knopf { grid-area: 1 / 1; min-height: calc(40 * var(--px)); font-size: var(--bsp-schrift-m); }
  .sz10-annehmen { opacity: 0; transform: scale(0.96); }
  .sz10 .sz10-angenommen { background: var(--bsp-ok-flaeche); color: var(--bsp-ok); gap: var(--bsp-a2); box-shadow: inset 0 0 0 calc(1.5 * var(--px)) rgb(23 112 73 / 35%); }
  .sz10-angenommen .bm-ok { width: calc(20 * var(--px)); height: calc(20 * var(--px)); }
  .sz10-tipp { left: 50%; top: 50%; }

  /* Termin */
  .sz10-termin { display: flex; align-items: center; gap: calc(10 * var(--px)); padding: calc(10 * var(--px)) var(--bsp-a3); }
  .sz10-kal { flex: none; display: flex; flex-direction: column; width: calc(38 * var(--px)); border-radius: calc(7 * var(--px)); overflow: hidden; text-align: center;
    box-shadow: inset 0 0 0 calc(1 * var(--px)) var(--bsp-linie); background: var(--bsp-weiss); }
  .sz10-kal b { display: block; padding: calc(1 * var(--px)) 0; background: var(--bsp-tinte); color: var(--bsp-weiss); font-size: var(--bsp-schrift-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .sz10-kal span { display: block; padding: calc(1 * var(--px)) 0 calc(3 * var(--px)); font-family: var(--font-head); font-size: var(--bsp-schrift-l); font-weight: 700; color: var(--bsp-text); line-height: 1.15; }
  .sz10-termin-text { min-width: 0; display: flex; flex-direction: column; gap: calc(1 * var(--px)); }
  .sz10-termin-text b { font-size: var(--bsp-schrift-s); font-weight: 650; color: var(--bsp-text); white-space: nowrap; }

  /* Hinweis nach dem Annehmen */
  .sz10-hinweis { display: flex; align-items: center; gap: var(--bsp-a2); padding: calc(8 * var(--px)) var(--bsp-a3); border-radius: var(--bsp-r-m); background: var(--bsp-nacht); color: var(--bsp-weiss);
    font-size: var(--bsp-schrift-s); font-weight: 600; box-shadow: 0 calc(8 * var(--px)) calc(18 * var(--px)) calc(-10 * var(--px)) rgb(0 79 76 / 60%); }
  .sz10-hinweis .bm-ok { flex: none; width: calc(18 * var(--px)); height: calc(18 * var(--px)); background: var(--bsp-tuerkis); }

  /* Übergänge (in beide Richtungen) */
  .sz10-ein { transition: opacity var(--bsp-dauer) var(--bsp-ease), transform var(--bsp-dauer) var(--bsp-ease); }
  .sz10-ein--1 { transition-delay: var(--bsp-auftritt); }
  .sz10-ein--2 { transition-delay: calc(var(--bsp-auftritt) + 1 * var(--bsp-versatz)); }
  .sz10-ein--3 { transition-delay: calc(var(--bsp-auftritt) + 2 * var(--bsp-versatz)); }
  .sz10-ein--4 { transition-delay: calc(var(--bsp-auftritt) + 3 * var(--bsp-versatz)); }
  .sz10-status > *, .sz10-stapel > *, .sz10-ring { transition: opacity var(--bsp-dauer-kurz) ease; }
  .sz10-annehmen { transition: opacity var(--bsp-dauer-kurz) ease, transform var(--bsp-dauer-kurz) ease; }
  .sz10 .sz10-angenommen { transition: opacity var(--bsp-dauer-kurz) ease, transform var(--bsp-dauer) var(--bsp-ease-feder); }
  .sz10-haken { transition: opacity var(--bsp-dauer-kurz) ease 0.15s, transform var(--bsp-dauer) var(--bsp-ease-feder) 0.15s; }
  .sz10-schritt--naechst::before, .sz10-schritt--naechst .sz10-punkt { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.3s; }
  .sz10-hinweis { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.45s, transform var(--bsp-dauer) var(--bsp-ease-feder) 0.45s; }

  /* ── Vorzustände (nur mit Engine) ── */
  /* vor Phase 1: nur die Kopfzeile */
  .sz10[data-phase]:not([data-erreicht~="1"]) .sz10-ein { opacity: 0; transform: translateY(calc(14 * var(--px))); }
  /* vor Phase 3: Angebot noch offen */
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-status-offen,
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-wann-offen,
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-ring { opacity: 1; }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-status-an,
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-wann-an { opacity: 0; }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-haken { opacity: 0; transform: scale(0.4); }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-annehmen { opacity: 1; transform: none; }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-angenommen { opacity: 0; transform: scale(0.85); }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-schritt--naechst::before { opacity: 0; }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-schritt--naechst { font-weight: 400; }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-schritt--naechst .sz10-punkt { box-shadow: inset 0 0 0 calc(1.5 * var(--px)) #c5cfcd; }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-schritt--naechst .sz10-wann { color: var(--bsp-text-leise); font-weight: 400; }
  .sz10[data-phase]:not([data-erreicht~="3"]) .sz10-hinweis { opacity: 0; transform: translateY(calc(10 * var(--px))); }
  /* Phase 1: Knopf lädt sanft zum Klicken ein (nur solange gezeigt) */
  .sz10[data-aktiv][data-phase="1"] .sz10-annehmen { animation: bm-puls 1.6s var(--bsp-ease) 1.1s infinite; }
  /* Phase 2: Finger tippt auf „Angebot annehmen“ */
  .sz10[data-phase="2"] .sz10-tipp { animation: bm-tippen 0.8s var(--bsp-ease) 0.25s both; }
  .sz10[data-phase="2"] .sz10-annehmen { transform: scale(0.97); transition-delay: 0.3s; }
</style>
