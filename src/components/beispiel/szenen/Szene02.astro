---
// Szene 2 „Überzeugt“ des Beispiels „So kann es laufen“ (Jamil, Talk qh87y3sj #5678/#5680, 13.11.2026).
// Drehbuch: Handy, Website des Malerbetriebs mit Fotos echter Arbeiten, Bewertungen, klaren Preisen, Scroll-Bewegung.
// Aufbau/Regeln wie die Referenz Szene01.astro (docs/beispiel-szenen-anleitung.md).
// Rechtliches: „Fotos“ sind gezeichnete Flächen (SVG, ohne ids), Bewertungen nur mit Kürzeln, Preise als Beispiel.
// Phasen (3):
//   0  Ausgang: Seite lädt – Kopf steht, Titelbild, Überschrift und Fotos noch als Gerippe
//   1  Seite ist da: Titelbild, Überschrift, Bewertung, Knöpfe und die Fotos „Unsere Arbeiten“ blenden nacheinander ein
//   2  Finger wischt nach oben, die Seite scrollt zu „Unsere Arbeiten“ und den Bewertungen (erscheinen nacheinander)
//   3  weiter nach unten zu „Klare Preise“: Preiszeilen erscheinen nacheinander, „Preis berechnen“ pulsiert einmal
// Endzustand (ohne JS, reduzierte Bewegung, Variante „mini“) = Phase 3 (Seite nach unten gescrollt).
import SzeneRahmen from '../SzeneRahmen.astro';
import Handy from '../geraete/Handy.astro';
import { STANDARD, werte } from '../branchen';

interface Props { variante?: 'buehne' | 'mini' }
const { variante = 'buehne' } = Astro.props;

// Preise passen zu Szene 7/8/12 (netto Wände 10 €/m², Decke 9 €/m²; inkl. MwSt. knapp unter 12 bzw. 11 €/m²) → „ab 11/10 €/m²“.
const W = werte(STANDARD); // Standardbranche; data-p = Schlüssel aus branchen.ts (Personalisierung im Browser)
const PREISE = [0, 1, 2];
---

<SzeneRahmen nr={2} phasen={3} takt={1700} format="hoch" variante={variante}>
  <Handy>
    <div class="sz02-seite">
      <!-- Kopf der Website (bleibt stehen, Inhalt scrollt darunter) -->
      <div class="sz02-kopf">
        <span class="sz02-marke"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="13" height="6" rx="2" /><path d="M17 7h2.5v5H11v3" /><rect x="9.5" y="15" width="3" height="6" rx="1" /></svg></span>
        <span class="sz02-name" data-p="firma">{W.firma}</span>
        <span class="sz02-menue"><i></i><i></i><i></i></span>
      </div>

      <div class="sz02-fenster">
        <div class="sz02-inhalt">
          <!-- Titelbild: frisch gestrichenes Wohnzimmer (gezeichnet) -->
          <div class="sz02-held">
            <span class="sz02-gerippe"></span>
            <svg class="sz02-foto sz02-geladen" viewBox="0 0 268 150" preserveAspectRatio="xMidYMid slice">
              <rect width="268" height="150" fill="#cfe7e3" />
              <rect x="0" y="0" width="268" height="12" fill="#f4f1eb" />
              <rect x="0" y="112" width="268" height="38" fill="#e6d3b8" />
              <path d="M0 112h268" stroke="#d6c09f" stroke-width="2" />
              <path d="M0 126h268M0 140h268" stroke="#dcc7a8" stroke-width="1" />
              <rect x="22" y="28" width="58" height="62" rx="2" fill="#f7fbfb" stroke="#ffffff" stroke-width="4" />
              <path d="M51 28v62M22 59h58" stroke="#ffffff" stroke-width="3" />
              <rect x="22" y="28" width="58" height="62" rx="2" fill="none" stroke="#b9d6d2" stroke-width="1" />
              <rect x="122" y="34" width="44" height="32" rx="2" fill="#f6f3ee" stroke="#00807b" stroke-width="2" />
              <path d="M128 60l10-12 8 8 6-6 8 10z" fill="#9ccfc9" />
              <path d="M110 108c0-14 6-20 20-20h70c14 0 20 6 20 20z" fill="#00807b" />
              <rect x="104" y="96" width="122" height="18" rx="7" fill="#006b68" />
              <rect x="108" y="112" width="6" height="8" fill="#004f4c" /><rect x="216" y="112" width="6" height="8" fill="#004f4c" />
              <rect x="128" y="86" width="22" height="14" rx="5" fill="#f6f3ee" />
              <path d="M244 112V60" stroke="#5b6766" stroke-width="2" />
              <path d="M234 60h20l-4-14h-12z" fill="#f6f3ee" stroke="#d5e8e6" stroke-width="1" />
              <ellipse cx="38" cy="104" rx="10" ry="4" fill="#c7b08e" />
              <path d="M38 102c-8-14-2-24 0-28 2 4 8 14 0 28zM38 102c-14-6-14-14-14-18 4 2 12 6 14 18zM38 102c10-8 14-14 14-18-4 2-12 6-14 18z" fill="#3c8f6a" />
            </svg>
            <span class="sz02-bildchip sz02-geladen" data-p="bildchip">{W.bildchip}</span>
          </div>
          <div class="sz02-titel-block">
            <span class="bm-balken bm-balken--lang sz02-gerippe-zeile"></span>
            <span class="bm-balken bm-balken--mittel sz02-gerippe-zeile"></span>
            <p class="sz02-h1 sz02-geladen"><span data-p="held1">{W.held1}</span><br /><span data-p="held2">{W.held2}</span></p>
          </div>
          <p class="sz02-wertung sz02-geladen"><strong>4,9</strong> <span class="bm-sterne">★★★★★</span> <span class="bm-klein">128 Bewertungen</span></p>
          <p class="sz02-knoepfe sz02-geladen"><span class="bm-knopf sz02-knopf-s">Preis berechnen</span><span class="bm-knopf bm-knopf--hell sz02-knopf-s">Arbeiten</span></p>

          <!-- Unsere Arbeiten: vier gezeichnete „Fotos“ -->
          <p class="sz02-abschnitt">Unsere Arbeiten</p>
          <div class="sz02-raster">
            <span class="sz02-kachel sz02-kachel--1">
              <svg viewBox="0 0 130 92" preserveAspectRatio="xMidYMid slice">
                <rect width="130" height="92" fill="#f1e6d6" />
                <rect width="130" height="46" fill="#e8c9a4" />
                <path d="M0 92L0 74h22v-12h22v-12h22v-12h22v-12h22v-12h20v78z" fill="#ffffff" />
                <path d="M0 74h22v-12h22v-12h22v-12h22v-12h22v-12h20" fill="none" stroke="#c8b9a4" stroke-width="2" />
                <path d="M10 60L110 14" stroke="#6b4f36" stroke-width="3" stroke-linecap="round" />
              </svg>
              <b data-p="arbeit0">{W.arbeit0}</b>
            </span>
            <span class="sz02-kachel sz02-kachel--2">
              <svg viewBox="0 0 130 92" preserveAspectRatio="xMidYMid slice">
                <rect width="130" height="92" fill="#cfe4ee" />
                <path d="M20 92V36l45-26 45 26v56z" fill="#f6e7c8" />
                <path d="M14 38l51-30 51 30" fill="none" stroke="#b45b3e" stroke-width="5" stroke-linejoin="round" />
                <rect x="34" y="46" width="16" height="18" fill="#ffffff" stroke="#00807b" stroke-width="2" />
                <rect x="80" y="46" width="16" height="18" fill="#ffffff" stroke="#00807b" stroke-width="2" />
                <rect x="57" y="66" width="16" height="26" fill="#006b68" />
              </svg>
              <b data-p="arbeit1">{W.arbeit1}</b>
            </span>
            <span class="sz02-kachel sz02-kachel--3">
              <svg viewBox="0 0 130 92" preserveAspectRatio="xMidYMid slice">
                <rect width="130" height="92" fill="#fbf4e8" />
                <path d="M0 52c22-14 40-14 62 0s44 14 68 0v40H0z" fill="#f3c9b1" />
                <path d="M0 66c22-12 40-12 62 0s44 12 68 0v26H0z" fill="#9fd2c9" />
                <circle cx="98" cy="24" r="11" fill="#f2d16b" />
                <rect y="80" width="130" height="12" fill="#e6d3b8" />
              </svg>
              <b data-p="arbeit2">{W.arbeit2}</b>
            </span>
            <span class="sz02-kachel sz02-kachel--4">
              <svg viewBox="0 0 130 92" preserveAspectRatio="xMidYMid slice">
                <rect width="130" height="92" fill="#e5ecef" />
                <rect width="130" height="10" fill="#ffffff" />
                <path d="M0 10h130M0 14h130" stroke="#d2dade" stroke-width="2" />
                <rect x="46" y="26" width="38" height="66" fill="#ffffff" stroke="#c9d3d6" stroke-width="2" />
                <rect x="52" y="32" width="26" height="24" fill="none" stroke="#d6dee1" stroke-width="2" />
                <rect x="52" y="62" width="26" height="24" fill="none" stroke="#d6dee1" stroke-width="2" />
                <rect y="84" width="130" height="8" fill="#c7b08e" />
              </svg>
              <b data-p="arbeit3">{W.arbeit3}</b>
            </span>
          </div>

          <!-- Bewertungen -->
          <p class="sz02-abschnitt sz02-kommt">Das sagen Kunden <span class="sz02-schnitt"><strong>4,9</strong> <span class="bm-sterne">★</span></span></p>
          <div class="bm-karte sz02-stimme sz02-kommt sz02-kommt--1">
            <span class="sz02-kuerzel">AK</span>
            <span class="sz02-stimme-text"><span class="bm-sterne">★★★★★</span><span>Sauber, pünktlich und fair im Preis.</span></span>
          </div>
          <div class="bm-karte sz02-stimme sz02-kommt sz02-kommt--2">
            <span class="sz02-kuerzel sz02-kuerzel--2">MS</span>
            <span class="sz02-stimme-text"><span class="bm-sterne">★★★★★</span><span>Tolle Beratung, super Ergebnis!</span></span>
          </div>

          <!-- Klare Preise -->
          <p class="sz02-abschnitt sz02-preise-kopf">Klare Preise</p>
          <div class="bm-karte sz02-preise">
            {PREISE.map((i) => <p class="sz02-preis"><span data-p={`preisWas${i}`}>{W[`preisWas${i}`]}</span><strong data-p={`preis${i}`}>{W[`preis${i}`]}</strong></p>)}
          </div>
          <p class="bm-klein sz02-hinweis">Beispielpreise inkl. Material und MwSt.</p>
          <span class="bm-knopf sz02-rechnen">Preis berechnen</span>
        </div>
        <!-- Scroll-Leiste rechts -->
        <span class="sz02-leiste"><i></i></span>
        <!-- Finger wischt nach oben -->
        <span class="sz02-wisch"></span>
      </div>
    </div>
  </Handy>
</SzeneRahmen>

<style is:global>
  /* ===== Szene 02 „Überzeugt“ – alle Regeln mit .sz02 beginnen =====
   * GRUNDFORM = ENDZUSTAND (Phase 3, Seite nach unten gescrollt). Vorzustände NUR unter .sz02[data-phase]:not([data-erreicht~="k"]).
   * Bewegt werden nur transform/opacity. */
  .sz02-seite { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .sz02-kopf { position: relative; z-index: 2; flex: none; display: flex; align-items: center; gap: var(--bsp-a2); height: calc(46 * var(--px)); padding: 0 var(--bsp-a4);
    background: var(--bsp-weiss); box-shadow: 0 calc(1 * var(--px)) 0 var(--bsp-linie-grau), 0 calc(6 * var(--px)) calc(12 * var(--px)) calc(-8 * var(--px)) rgb(0 79 76 / 22%); }
  .sz02-marke { flex: none; display: grid; place-items: center; width: calc(26 * var(--px)); height: calc(26 * var(--px)); border-radius: calc(8 * var(--px)); background: var(--bsp-tinte); }
  .sz02-marke svg { width: 64%; height: 64%; fill: none; stroke: var(--bsp-weiss); stroke-width: 2; stroke-linejoin: round; }
  .sz02-name { flex: 1; font-family: var(--font-head); font-size: var(--bsp-schrift-m); font-weight: 700; color: var(--bsp-text); letter-spacing: -0.01em; white-space: nowrap; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .sz02-menue { display: grid; gap: calc(3.5 * var(--px)); width: calc(18 * var(--px)); }
  .sz02-menue i { display: block; height: calc(2 * var(--px)); border-radius: 99px; background: var(--bsp-text); }

  .sz02-fenster { position: relative; flex: 1; min-height: 0; overflow: hidden; }
  .sz02-inhalt { display: flex; flex-direction: column; gap: var(--bsp-a3); padding: var(--bsp-a3) var(--bsp-a4) calc(30 * var(--px)); transform: translateY(calc(-452 * var(--px))); }
  .sz02-inhalt p { margin: 0; }

  /* Titelbild */
  .sz02-held { position: relative; flex: none; height: calc(158 * var(--px)); border-radius: var(--bsp-r-l); overflow: hidden; background: var(--bsp-gerippe); }
  .sz02-foto { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .sz02-gerippe { position: absolute; inset: 0; background: var(--bsp-gerippe); opacity: 0; }
  .sz02-bildchip { position: absolute; left: var(--bsp-a2); bottom: var(--bsp-a2); padding: calc(3 * var(--px)) var(--bsp-a2); border-radius: 99px; background: rgb(255 255 255 / 92%);
    color: var(--bsp-tinte); font-size: var(--bsp-schrift-xs); font-weight: 650; }
  .sz02-titel-block { position: relative; }
  .sz02-gerippe-zeile { position: absolute; left: 0; opacity: 0; height: calc(14 * var(--px)); }
  .sz02-gerippe-zeile:first-child { top: calc(4 * var(--px)); }
  .sz02-gerippe-zeile:nth-child(2) { top: calc(30 * var(--px)); }
  .sz02-h1 { font-family: var(--font-head); font-size: var(--bsp-schrift-xl); font-weight: 750; line-height: 1.18; letter-spacing: -0.02em; color: var(--bsp-text); }
  .sz02-wertung { display: flex; align-items: center; gap: calc(5 * var(--px)); font-size: var(--bsp-schrift-s); }
  .sz02-knoepfe { display: flex; gap: var(--bsp-a2); }
  .sz02-knopf-s { min-height: calc(32 * var(--px)); padding: 0 var(--bsp-a3); font-size: var(--bsp-schrift-s); }

  /* Abschnitte */
  .sz02-abschnitt { display: flex; align-items: baseline; justify-content: space-between; margin-top: var(--bsp-a2) !important; font-family: var(--font-head); font-size: var(--bsp-schrift-m);
    font-weight: 700; color: var(--bsp-text); }
  .sz02-schnitt { font-family: var(--font-body); font-size: var(--bsp-schrift-s); font-weight: 500; color: var(--bsp-text-leise); }
  .sz02-raster { display: grid; grid-template-columns: 1fr 1fr; gap: var(--bsp-a2); }
  .sz02-kachel { position: relative; display: block; height: calc(92 * var(--px)); border-radius: var(--bsp-r-m); overflow: hidden; background: var(--bsp-gerippe); }
  .sz02-kachel svg { display: block; width: 100%; height: 100%; }
  .sz02-kachel b { position: absolute; left: calc(6 * var(--px)); bottom: calc(6 * var(--px)); padding: calc(2 * var(--px)) calc(6 * var(--px)); border-radius: 99px; background: rgb(255 255 255 / 92%);
    color: var(--bsp-tinte); font-size: calc(9 * var(--px)); font-weight: 650; }

  /* Bewertungen */
  .sz02-stimme { display: flex; align-items: center; gap: var(--bsp-a3); padding: var(--bsp-a3); }
  .sz02-kuerzel { flex: none; display: grid; place-items: center; width: calc(34 * var(--px)); height: calc(34 * var(--px)); border-radius: 50%; background: var(--bsp-flaeche);
    color: var(--bsp-tinte); font-family: var(--font-head); font-size: var(--bsp-schrift-s); font-weight: 700; }
  .sz02-kuerzel--2 { background: #f5ecdc; color: #7a5a2c; }
  .sz02-stimme-text { display: flex; flex-direction: column; gap: calc(2 * var(--px)); min-width: 0; font-size: var(--bsp-schrift-s); color: var(--bsp-text); }
  .sz02-stimme-text .bm-sterne { font-size: var(--bsp-schrift-xs); }

  /* Preise */
  .sz02-preise { display: flex; flex-direction: column; padding: calc(4 * var(--px)) var(--bsp-a3); }
  .sz02-preis { display: flex; justify-content: space-between; align-items: center; gap: var(--bsp-a2); height: calc(38 * var(--px)); font-size: var(--bsp-schrift-s); color: var(--bsp-text); }
  .sz02-preis + .sz02-preis { border-top: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .sz02-preis strong { color: var(--bsp-tinte); font-weight: 700; white-space: nowrap; }
  .sz02-hinweis { margin-top: calc(-4 * var(--px)) !important; font-size: var(--bsp-schrift-xs); }
  .sz02-rechnen { align-self: stretch; min-height: calc(40 * var(--px)); }

  /* Scroll-Leiste */
  .sz02-leiste { position: absolute; z-index: 1; right: calc(3 * var(--px)); top: calc(6 * var(--px)); bottom: calc(18 * var(--px)); width: calc(3 * var(--px)); }
  .sz02-leiste i { display: block; width: 100%; height: 36%; border-radius: 99px; background: rgb(47 58 57 / 32%); transform: translateY(178%); }
  /* Finger-Wisch: Kreis, der nach oben gleitet (nur in Phase 2/3) */
  .sz02-wisch { position: absolute; z-index: 3; left: 58%; top: 70%; width: calc(40 * var(--px)); height: calc(40 * var(--px)); border-radius: 50%; background: rgb(0 128 123 / 26%);
    border: calc(2 * var(--px)) solid rgb(0 128 123 / 55%); opacity: 0; pointer-events: none; }
  @keyframes sz02-wischen { 0% { opacity: 0; transform: translateY(calc(40 * var(--px))) scale(0.8); } 18% { opacity: 1; transform: translateY(calc(30 * var(--px))) scale(1); }
    80% { opacity: 0.9; transform: translateY(calc(-150 * var(--px))) scale(1); } 100% { opacity: 0; transform: translateY(calc(-170 * var(--px))) scale(0.9); } }

  /* Übergänge (in beide Richtungen) */
  .sz02-inhalt { transition: transform calc(1.2s * var(--bsp-t, 1)) cubic-bezier(0.45, 0.05, 0.2, 1) calc(var(--bsp-auftritt) + calc(0.35s * var(--bsp-t, 1))); }
  .sz02-leiste i { transition: transform calc(1.2s * var(--bsp-t, 1)) cubic-bezier(0.45, 0.05, 0.2, 1) calc(var(--bsp-auftritt) + calc(0.35s * var(--bsp-t, 1))); }
  .sz02-geladen, .sz02-gerippe, .sz02-gerippe-zeile { transition: opacity var(--bsp-dauer) var(--bsp-ease) var(--bsp-auftritt), transform var(--bsp-dauer) var(--bsp-ease) var(--bsp-auftritt); }
  .sz02-kachel > *, .sz02-kommt, .sz02-preise-kopf, .sz02-preise, .sz02-preis, .sz02-hinweis, .sz02-rechnen { transition: opacity var(--bsp-dauer) var(--bsp-ease), transform var(--bsp-dauer) var(--bsp-ease); }
  .sz02-kachel--1 > * { transition-delay: calc(0.75s * var(--bsp-t, 1)); } .sz02-kachel--2 > * { transition-delay: calc(0.87s * var(--bsp-t, 1)); } .sz02-kachel--3 > * { transition-delay: calc(0.99s * var(--bsp-t, 1)); } .sz02-kachel--4 > * { transition-delay: calc(1.11s * var(--bsp-t, 1)); }
  .sz02-kommt { transition-delay: calc(1.2s * var(--bsp-t, 1)); } .sz02-kommt--1 { transition-delay: calc(1.32s * var(--bsp-t, 1)); } .sz02-kommt--2 { transition-delay: calc(1.44s * var(--bsp-t, 1)); }
  .sz02-preise-kopf { transition-delay: calc(0.9s * var(--bsp-t, 1)); } .sz02-preise { transition-delay: calc(0.95s * var(--bsp-t, 1)); }
  .sz02-preis:nth-child(1) { transition-delay: calc(1.05s * var(--bsp-t, 1)); } .sz02-preis:nth-child(2) { transition-delay: calc(1.17s * var(--bsp-t, 1)); } .sz02-preis:nth-child(3) { transition-delay: calc(1.29s * var(--bsp-t, 1)); }
  .sz02-hinweis { transition-delay: calc(1.4s * var(--bsp-t, 1)); } .sz02-rechnen { transition-delay: calc(1.45s * var(--bsp-t, 1)); }

  /* ── Vorzustände (nur mit Engine) ── */
  /* vor Phase 1: Seite lädt – Gerippe statt Bild und Überschrift */
  .sz02[data-phase]:not([data-erreicht~="1"]) .sz02-geladen { opacity: 0; }
  .sz02[data-phase]:not([data-erreicht~="1"]) .sz02-h1, .sz02[data-phase]:not([data-erreicht~="1"]) .sz02-knoepfe,
  .sz02[data-phase]:not([data-erreicht~="1"]) .sz02-wertung { transform: translateY(calc(8 * var(--px))); }
  .sz02[data-phase]:not([data-erreicht~="1"]) .sz02-gerippe, .sz02[data-phase]:not([data-erreicht~="1"]) .sz02-gerippe-zeile { opacity: 1; }
  .sz02[data-phase]:not([data-erreicht~="1"]) .sz02-kachel > * { opacity: 0; }
  .sz02[data-aktiv]:not([data-erreicht~="1"]) .sz02-gerippe { animation: bm-schimmern calc(1.2s * var(--bsp-t, 1)) ease-in-out infinite; }
  /* vor Phase 2: Seite steht oben, Fotos und Bewertungen noch nicht geladen */
  .sz02[data-phase]:not([data-erreicht~="2"]) .sz02-inhalt { transform: none; }
  .sz02[data-phase]:not([data-erreicht~="2"]) .sz02-leiste i { transform: none; }
  .sz02[data-phase]:not([data-erreicht~="2"]) .sz02-kommt { opacity: 0; transform: translateY(calc(14 * var(--px))); }
  /* Phase 2: ein Stück nach unten (Arbeiten + Bewertungen) */
  .sz02[data-erreicht~="2"]:not([data-erreicht~="3"]) .sz02-inhalt { transform: translateY(calc(-300 * var(--px))); }
  .sz02[data-erreicht~="2"]:not([data-erreicht~="3"]) .sz02-leiste i { transform: translateY(118%); }
  /* vor Phase 3: Preise noch nicht da */
  .sz02[data-phase]:not([data-erreicht~="3"]) .sz02-preise-kopf, .sz02[data-phase]:not([data-erreicht~="3"]) .sz02-preise, .sz02[data-phase]:not([data-erreicht~="3"]) .sz02-preis,
  .sz02[data-phase]:not([data-erreicht~="3"]) .sz02-hinweis, .sz02[data-phase]:not([data-erreicht~="3"]) .sz02-rechnen { opacity: 0; transform: translateY(calc(14 * var(--px))); }
  /* Finger wischt in Phase 2 und 3 */
  .sz02[data-phase="2"] .sz02-wisch, .sz02[data-phase="3"] .sz02-wisch { animation: sz02-wischen calc(1.1s * var(--bsp-t, 1)) var(--bsp-ease) var(--bsp-auftritt) both; }
  /* Phase 3: „Preis berechnen“ pulsiert einmal */
  .sz02[data-phase="3"] .sz02-rechnen { animation: bm-puls calc(0.7s * var(--bsp-t, 1)) var(--bsp-ease) calc(2.1s * var(--bsp-t, 1)) 2; }
</style>
