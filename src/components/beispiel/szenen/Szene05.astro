---
// Szene 5 „Der Betrieb weiß Bescheid“ des Beispiels „So kann es laufen“ (Jamil, Talk qh87y3sj #5678/#5680, 13.11.2026).
// Drehbuch: Handy des Malermeisters vibriert „Neuer Besichtigungstermin“ + parallel Laptop/Software: neue Interessentin
// „Frau Weber“ erscheint in der Liste. Zwei Geräte → format „quer“ (Handy links vorne, Laptop rechts dahinter).
// Aufbau/Regeln wie die Referenz Szene01.astro (docs/beispiel-szenen-anleitung.md). Software neutral („Betriebs-App“), übrige
// Interessenten nur als namenlose Gerippe-Zeilen.
// Phasen (3):
//   0  Ausgang: Sperrbildschirm ohne Mitteilung, Liste in der Software ohne Frau Weber
//   1  Handy vibriert, Mitteilung „Neuer Besichtigungstermin · Frau Weber“ fällt herein
//   2  Laptop: Frau Weber gleitet oben in die Liste (Zeile leuchtet auf, die anderen rücken nach unten), Zähler „1“ im Menü
//   3  Laptop: Hinweis „Besichtigung im Kalender eingetragen“ erscheint unten rechts
// Endzustand (ohne JS, reduzierte Bewegung, Variante „mini“) = Phase 3.
import { STANDARD, werte } from '../branchen';
import SzeneRahmen from '../SzeneRahmen.astro';
import Handy from '../geraete/Handy.astro';
import Laptop from '../geraete/Laptop.astro';

interface Props { variante?: 'buehne' | 'mini' }
const { variante = 'buehne' } = Astro.props;
const W = werte(STANDARD); // Standardbranche; data-p = Schlüssel aus branchen.ts (Personalisierung im Browser)

const MENUE = ['Übersicht', 'Interessenten', 'Angebote', 'Aufträge', 'Rechnungen', 'Kalender'];
const ALTE = [
  { status: 'Angebot', b1: 'mittel', b2: 'lang' },
  { status: 'Auftrag', b1: 'lang', b2: 'mittel' },
  { status: 'Angebot', b1: 'kurz', b2: 'lang' },
  { status: 'Erledigt', b1: 'mittel', b2: 'kurz' },
  { status: 'Erledigt', b1: 'lang', b2: 'mittel' },
];
---

<SzeneRahmen nr={5} phasen={3} takt={1600} format="quer" variante={variante}>
  <div class="sz05-paar">
    <div class="sz05-buehne">
      <!-- Laptop: eigene Software des Betriebs -->
      <Laptop class="sz05-laptop">
        <div class="sz05-app">
          <div class="sz05-seite">
            <p class="sz05-logo"><span class="sz05-marke"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="13" height="6" rx="2" /><path d="M17 7h2.5v5H11v3" /><rect x="9.5" y="15" width="3" height="6" rx="1" /></svg></span><span class="sz05-logo-name" data-p="firma">{W.firma}</span></p>
            {MENUE.map((m, i) => (
              <p class:list={['sz05-punkt', { 'sz05-punkt--an': i === 1 }]}>
                <span class="sz05-symbol"></span>{m}
                {i === 1 && <span class="sz05-zaehler">1</span>}
              </p>
            ))}
          </div>

          <div class="sz05-haupt">
            <div class="sz05-oben">
              <p class="sz05-titel">Interessenten</p>
              <span class="sz05-suche"><span class="bm-balken"></span></span>
              <span class="sz05-ich" data-p="kuerzel2">{W.kuerzel2}</span>
            </div>
            <p class="sz05-filter"><span class="bm-chip">Alle</span><span class="bm-chip sz05-chip-leer">Neu</span><span class="bm-chip sz05-chip-leer">Termin vereinbart</span></p>

            <div class="sz05-tabelle">
              <p class="sz05-zeile sz05-zeile--kopf"><span>Name</span><span>Anliegen</span><span>Termin</span><span>Status</span></p>
              <div class="sz05-zeilen">
                <p class="sz05-zeile sz05-neu">
                  <span class="sz05-leuchten"></span>
                  <span class="sz05-wer"><span class="sz05-kreis">FW</span><span class="sz05-wer-text"><strong>Frau Weber</strong><small>Musterstadt</small></span></span>
                  <span data-p="anliegen">{W.anliegen}</span>
                  <span class="sz05-termin">Do 19.11. · 10:00</span>
                  <span><span class="bm-chip sz05-chip-neu">Neu</span></span>
                </p>
                {ALTE.map((z) => (
                  <p class="sz05-zeile sz05-alt">
                    <span class="sz05-wer"><span class="sz05-kreis sz05-kreis--leer"></span><span class={`bm-balken bm-balken--${z.b1}`}></span></span>
                    <span class={`bm-balken bm-balken--${z.b2}`}></span>
                    <span class="bm-balken bm-balken--mittel"></span>
                    <span><span class="bm-chip sz05-chip-alt">{z.status}</span></span>
                  </p>
                ))}
              </div>
            </div>

            <p class="sz05-hinweis"><span class="bm-ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span><span data-p="terminKalender">{W.terminKalender}</span></p>
          </div>
        </div>
      </Laptop>

      <!-- Handy des Meisters: Sperrbildschirm mit Mitteilung -->
      <Handy class="sz05-handy" status={false}>
        <div class="sz05-sperre">
          <p class="sz05-statuszeile"><span>10:26</span><span class="sz05-zeichen"><i></i><i></i></span></p>
          <p class="sz05-uhr">10:26</p>
          <p class="sz05-datum">Montag, 16. November</p>
          <div class="sz05-mitteilung">
            <span class="sz05-app-symbol"><svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="14" rx="2.5" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" /></svg></span>
            <span class="sz05-mit-text">
              <span class="sz05-mit-kopf"><span>Betriebs-App</span><span>jetzt</span></span>
              <strong data-p="terminNeu">{W.terminNeu}</strong>
              <span>Frau Weber · Do 19.11., 10:00 Uhr</span>
            </span>
          </div>
          <div class="sz05-frueher"><span class="sz05-frueher-symbol"></span><span class="sz05-frueher-text"><span class="bm-balken bm-balken--mittel"></span><span class="bm-balken bm-balken--lang"></span></span></div>
          <p class="sz05-tasten"><span><svg viewBox="0 0 24 24"><path d="M9 3h6l-1 6h-4zM10 9h4v12h-4z" /></svg></span><span><svg viewBox="0 0 24 24"><rect x="3.5" y="7" width="17" height="12" rx="2.5" /><circle cx="12" cy="13" r="3.2" /><path d="M9 7l1.5-2.5h3L15 7" /></svg></span></p>
        </div>
      </Handy>

      <!-- Vibrations-Bögen neben dem Handy -->
      <span class="sz05-welle sz05-welle--l"><svg viewBox="0 0 20 40"><path d="M16 4C8 12 8 28 16 36M9 10c-4 6-4 14 0 20" /></svg></span>
      <span class="sz05-welle sz05-welle--r"><svg viewBox="0 0 20 40"><path d="M4 4c8 8 8 24 0 32M11 10c4 6 4 14 0 20" /></svg></span>
    </div>
  </div>
</SzeneRahmen>

<style is:global>
  /* ===== Szene 05 „Der Betrieb weiß Bescheid“ – alle Regeln mit .sz05 beginnen =====
   * GRUNDFORM = ENDZUSTAND (Phase 3). Vorzustände NUR unter .sz05[data-phase]:not([data-erreicht~="k"]). Nur transform/opacity bewegt. */

  /* Anordnung: Fläche 1,8 : 1 (eigener Größen-Container), Laptop rechts oben, Handy links unten davor */
  .sz05-paar { position: relative; width: 100%; height: 100%; display: grid; place-items: center; container-type: size; }
  .sz05-buehne { position: relative; width: min(100cqw, 100cqh * 1.8); aspect-ratio: 1.8; container-type: size; }
  .sz05 .sz05-laptop { position: absolute; right: 0; top: 2cqh; --gr-breite: 80cqw; }
  .sz05 .sz05-handy { position: absolute; z-index: 2; left: 2cqw; bottom: 0; --gr-hoehe: 90cqh; }

  /* ── Laptop-Software ── */
  .sz05-app { flex: 1; min-height: 0; display: grid; grid-template-columns: calc(128 * var(--px)) minmax(0, 1fr); background: var(--bsp-papier); }
  .sz05-app p { margin: 0; }
  .sz05-seite { display: flex; flex-direction: column; gap: calc(3 * var(--px)); padding: var(--bsp-a4) var(--bsp-a2); background: #eef5f4; border-right: calc(1 * var(--px)) solid var(--bsp-linie); }
  .sz05-logo { display: flex; align-items: center; gap: calc(7 * var(--px)); margin: 0 0 var(--bsp-a3) calc(6 * var(--px)) !important; font-family: var(--font-head); font-size: var(--bsp-schrift-m);
    font-weight: 700; color: var(--bsp-text); }
  .sz05-marke { display: grid; place-items: center; width: calc(24 * var(--px)); height: calc(24 * var(--px)); border-radius: calc(7 * var(--px)); background: var(--bsp-tinte); }
  .sz05-marke svg { width: 64%; height: 64%; fill: none; stroke: var(--bsp-weiss); stroke-width: 2; stroke-linejoin: round; }
  .sz05-punkt { position: relative; display: flex; align-items: center; gap: calc(7 * var(--px)); height: calc(28 * var(--px)); padding: 0 calc(7 * var(--px)); border-radius: var(--bsp-r-s);
    font-size: var(--bsp-schrift-xs); font-weight: 600; color: var(--bsp-text-leise); white-space: nowrap; }
  .sz05-punkt--an { background: var(--bsp-weiss); color: var(--bsp-tinte); box-shadow: 0 calc(1 * var(--px)) calc(3 * var(--px)) rgb(0 79 76 / 10%); }
  .sz05-symbol { flex: none; width: calc(12 * var(--px)); height: calc(12 * var(--px)); border-radius: calc(3 * var(--px)); background: #cddcda; }
  .sz05-punkt--an .sz05-symbol { background: var(--bsp-tuerkis-dunkel); }
  .sz05-zaehler { margin-left: auto; display: grid; place-items: center; min-width: calc(16 * var(--px)); height: calc(16 * var(--px)); padding: 0 calc(4 * var(--px)); border-radius: 99px;
    background: var(--bsp-hinweis); color: var(--bsp-weiss); font-size: calc(9 * var(--px)); font-weight: 700; }

  .sz05-haupt { position: relative; display: flex; flex-direction: column; gap: var(--bsp-a3); min-width: 0; padding: var(--bsp-a4) calc(20 * var(--px)); }
  .sz05-oben { display: flex; align-items: center; gap: var(--bsp-a3); }
  .sz05-titel { flex: 1; font-family: var(--font-head); font-size: var(--bsp-schrift-xl); font-weight: 750; letter-spacing: -0.02em; color: var(--bsp-text); }
  .sz05-suche { display: flex; align-items: center; width: calc(150 * var(--px)); height: calc(28 * var(--px)); padding: 0 var(--bsp-a3); border-radius: 99px; background: var(--bsp-weiss);
    box-shadow: inset 0 0 0 calc(1 * var(--px)) var(--bsp-linie-grau); }
  .sz05-suche .bm-balken { width: 60%; height: calc(6 * var(--px)); }
  .sz05-ich { display: grid; place-items: center; width: calc(28 * var(--px)); height: calc(28 * var(--px)); border-radius: 50%; background: var(--bsp-nacht); color: var(--bsp-weiss);
    font-size: calc(9 * var(--px)); font-weight: 700; }
  .sz05-filter { display: flex; gap: calc(6 * var(--px)); }
  .sz05 .sz05-chip-leer { background: var(--bsp-weiss); color: var(--bsp-text-leise); box-shadow: inset 0 0 0 calc(1 * var(--px)) var(--bsp-linie-grau); }

  .sz05-tabelle { display: flex; flex-direction: column; border-radius: var(--bsp-r-m); background: var(--bsp-weiss); border: calc(1 * var(--px)) solid var(--bsp-linie-grau); overflow: hidden; }
  .sz05-zeilen { position: relative; overflow: hidden; height: calc(4 * 46 * var(--px)); }
  .sz05-zeile { position: relative; display: grid; grid-template-columns: 1.45fr 1.25fr 1.15fr 0.7fr; align-items: center; gap: var(--bsp-a3); height: calc(46 * var(--px)); padding: 0 var(--bsp-a3);
    border-bottom: calc(1 * var(--px)) solid var(--bsp-linie-grau); font-size: var(--bsp-schrift-s); color: var(--bsp-text); white-space: nowrap; }
  .sz05-zeile > * { position: relative; min-width: 0; }
  .sz05-zeile .bm-balken { height: calc(7 * var(--px)); }
  .sz05-zeile--kopf { height: calc(30 * var(--px)); background: #f7f9f8; font-size: calc(9 * var(--px)); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bsp-text-leise); }
  .sz05-wer { display: flex; align-items: center; gap: var(--bsp-a2); }
  .sz05-wer .bm-balken { flex: 1; }
  .sz05-kreis { flex: none; display: grid; place-items: center; width: calc(26 * var(--px)); height: calc(26 * var(--px)); border-radius: 50%; background: var(--bsp-tinte); color: var(--bsp-weiss);
    font-size: calc(9 * var(--px)); font-weight: 700; }
  .sz05-kreis--leer { background: var(--bsp-gerippe); }
  .sz05-wer-text { display: flex; flex-direction: column; line-height: 1.2; }
  .sz05-wer-text strong { font-family: var(--font-head); font-size: var(--bsp-schrift-m); font-weight: 700; }
  .sz05-wer-text small { font-size: calc(9 * var(--px)); color: var(--bsp-text-leise); }
  .sz05-termin { font-weight: 650; color: var(--bsp-tinte); }
  .sz05-neu { background: #f3faf9; }
  .sz05-neu::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: calc(3 * var(--px)); background: var(--bsp-tuerkis); }
  .sz05-leuchten { position: absolute !important; inset: 0; background: rgb(0 166 161 / 22%); opacity: 0; pointer-events: none; }
  .sz05 .sz05-chip-neu { background: var(--bsp-tinte); color: var(--bsp-weiss); }
  .sz05 .sz05-chip-alt { background: #f1f3f2; color: var(--bsp-text-leise); }

  .sz05-hinweis { position: absolute; right: calc(20 * var(--px)); bottom: var(--bsp-a3); display: flex; align-items: center; gap: var(--bsp-a2); padding: calc(7 * var(--px)) var(--bsp-a3) calc(7 * var(--px)) calc(8 * var(--px));
    border-radius: var(--bsp-r-m); background: var(--bsp-nacht); color: var(--bsp-weiss); font-size: var(--bsp-schrift-xs); font-weight: 600; white-space: nowrap;
    box-shadow: 0 calc(10 * var(--px)) calc(24 * var(--px)) calc(-10 * var(--px)) rgb(0 47 45 / 60%); }
  .sz05-hinweis .bm-ok { width: calc(18 * var(--px)); height: calc(18 * var(--px)); background: var(--bsp-tuerkis); }

  /* ── Handy: Sperrbildschirm ── */
  .sz05-sperre { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; padding: calc(10 * var(--px)) var(--bsp-a3) 0;
    background: radial-gradient(90% 55% at 20% 18%, rgb(0 166 161 / 55%), rgb(0 166 161 / 0%)), radial-gradient(80% 50% at 90% 85%, rgb(0 128 123 / 60%), rgb(0 128 123 / 0%)), #0a4a47;
    color: var(--bsp-weiss); }
  .sz05-sperre p { margin: 0; }
  .sz05-statuszeile { align-self: stretch; display: flex; justify-content: space-between; align-items: center; height: calc(30 * var(--px)); padding: 0 calc(14 * var(--px));
    font-size: var(--bsp-schrift-s); font-weight: 600; }
  .sz05-zeichen { display: flex; gap: calc(4 * var(--px)); }
  .sz05-zeichen i { display: block; width: calc(14 * var(--px)); height: calc(8 * var(--px)); border-radius: calc(2 * var(--px)); background: var(--bsp-weiss); opacity: 0.85; }
  .sz05-zeichen i:first-child { width: calc(12 * var(--px)); opacity: 0.6; }
  .sz05-uhr { margin-top: calc(34 * var(--px)) !important; font-family: var(--font-head); font-size: calc(68 * var(--px)); font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
  .sz05-datum { margin-top: calc(8 * var(--px)) !important; font-size: var(--bsp-schrift-m); font-weight: 500; opacity: 0.85; }
  .sz05-mitteilung { align-self: stretch; display: flex; align-items: center; gap: calc(11 * var(--px)); margin-top: calc(48 * var(--px)); padding: calc(13 * var(--px)) calc(12 * var(--px)); border-radius: calc(18 * var(--px));
    background: rgb(255 255 255 / 94%); color: var(--bsp-text); box-shadow: 0 calc(12 * var(--px)) calc(26 * var(--px)) calc(-10 * var(--px)) rgb(0 20 19 / 55%); }
  .sz05-app-symbol { flex: none; display: grid; place-items: center; width: calc(40 * var(--px)); height: calc(40 * var(--px)); border-radius: calc(9 * var(--px)); background: var(--bsp-tinte); }
  .sz05-app-symbol svg { width: 60%; height: 60%; fill: none; stroke: var(--bsp-weiss); stroke-width: 2; stroke-linecap: round; }
  .sz05-mit-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: calc(2 * var(--px)); font-size: var(--bsp-schrift-s); line-height: 1.3; }
  .sz05-mit-text strong { font-size: var(--bsp-schrift-m); font-weight: 700; line-height: 1.2; }
  .sz05-mit-kopf { display: flex; justify-content: space-between; color: var(--bsp-text-leise); font-size: var(--bsp-schrift-xs); text-transform: uppercase; letter-spacing: 0.05em; }
  .sz05-frueher { align-self: stretch; display: flex; align-items: center; gap: calc(11 * var(--px)); margin-top: var(--bsp-a2); padding: calc(12 * var(--px)); border-radius: calc(18 * var(--px));
    background: rgb(255 255 255 / 16%); }
  .sz05-frueher-symbol { flex: none; width: calc(32 * var(--px)); height: calc(32 * var(--px)); border-radius: calc(9 * var(--px)); background: rgb(255 255 255 / 22%); }
  .sz05-frueher-text { flex: 1; display: flex; flex-direction: column; gap: calc(6 * var(--px)); }
  .sz05-frueher .bm-balken { height: calc(7 * var(--px)); background: rgb(255 255 255 / 30%); }
  .sz05-tasten { position: absolute; left: calc(28 * var(--px)); right: calc(28 * var(--px)); bottom: calc(34 * var(--px)); display: flex; justify-content: space-between; }
  .sz05-tasten span { display: grid; place-items: center; width: calc(40 * var(--px)); height: calc(40 * var(--px)); border-radius: 50%; background: rgb(255 255 255 / 16%); }
  .sz05-tasten svg { width: 50%; height: 50%; fill: none; stroke: var(--bsp-weiss); stroke-width: 1.8; stroke-linejoin: round; }
  .sz05 .sz05-handy .gr-heim { background: var(--bsp-weiss); opacity: 0.8; }

  /* Vibrations-Bögen (Grundform unsichtbar, nur in Phase 1 kurz sichtbar) */
  .sz05-welle { position: absolute; z-index: 3; top: 28cqh; width: 2.6cqw; aspect-ratio: 1 / 2; opacity: 0; pointer-events: none; }
  .sz05-welle svg { display: block; width: 100%; height: 100%; fill: none; stroke: var(--bsp-tuerkis-dunkel); stroke-width: 2.5; stroke-linecap: round; }
  .sz05-welle--l { left: -1cqw; }
  .sz05-welle--r { left: 26.4cqw; }
  @keyframes sz05-aufleuchten { 0%, 100% { opacity: 0; } 35% { opacity: 1; } }
  @keyframes sz05-wellen { 0%, 100% { opacity: 0; transform: scale(0.8); } 20%, 70% { opacity: 1; transform: scale(1); } }

  /* Übergänge (in beide Richtungen) */
  .sz05-frueher { transition: transform var(--bsp-dauer) var(--bsp-ease) calc(var(--bsp-auftritt) + calc(0.2s * var(--bsp-t, 1))); }
  .sz05-mitteilung { transition: opacity var(--bsp-dauer) var(--bsp-ease) calc(var(--bsp-auftritt) + calc(0.2s * var(--bsp-t, 1))), transform var(--bsp-dauer) var(--bsp-ease-feder) calc(var(--bsp-auftritt) + calc(0.2s * var(--bsp-t, 1))); }
  .sz05-neu { transition: opacity var(--bsp-dauer) var(--bsp-ease) calc(0.65s * var(--bsp-t, 1)), transform var(--bsp-dauer) var(--bsp-ease) calc(0.65s * var(--bsp-t, 1)); }
  .sz05-alt { transition: transform calc(0.7s * var(--bsp-t, 1)) var(--bsp-ease) var(--bsp-auftritt); }
  .sz05-zaehler { transition: opacity var(--bsp-dauer-kurz) ease calc(1s * var(--bsp-t, 1)), transform var(--bsp-dauer) var(--bsp-ease-feder) calc(1s * var(--bsp-t, 1)); }
  .sz05-hinweis { transition: opacity var(--bsp-dauer) var(--bsp-ease) var(--bsp-auftritt), transform var(--bsp-dauer) var(--bsp-ease) var(--bsp-auftritt); }

  /* ── Vorzustände (nur mit Engine) ── */
  /* vor Phase 1: keine Mitteilung */
  .sz05[data-phase]:not([data-erreicht~="1"]) .sz05-mitteilung { opacity: 0; transform: translateY(calc(-26 * var(--px))) scale(0.94); }
  .sz05[data-phase]:not([data-erreicht~="1"]) .sz05-frueher { transform: translateY(calc(-74 * var(--px))); }
  /* Phase 1: Handy vibriert, Bögen zittern */
  .sz05[data-phase="1"] .sz05-handy { animation: bm-vibrieren calc(0.36s * var(--bsp-t, 1)) ease-in-out calc(var(--bsp-auftritt) + calc(0.1s * var(--bsp-t, 1))) 3; }
  .sz05[data-phase="1"] .sz05-welle { animation: sz05-wellen calc(1.1s * var(--bsp-t, 1)) var(--bsp-ease) calc(var(--bsp-auftritt) + calc(0.1s * var(--bsp-t, 1))) both; }
  /* vor Phase 2: Frau Weber noch nicht in der Liste, kein Zähler */
  .sz05[data-phase]:not([data-erreicht~="2"]) .sz05-neu { opacity: 0; transform: translateY(calc(-14 * var(--px))); }
  .sz05[data-phase]:not([data-erreicht~="2"]) .sz05-alt { transform: translateY(calc(-46 * var(--px))); }
  .sz05[data-phase]:not([data-erreicht~="2"]) .sz05-zaehler { opacity: 0; transform: scale(0.3); }
  /* Phase 2: die neue Zeile leuchtet kurz auf */
  .sz05[data-phase="2"] .sz05-leuchten { animation: sz05-aufleuchten calc(1.4s * var(--bsp-t, 1)) ease-in-out calc(1.1s * var(--bsp-t, 1)) both; }
  /* vor Phase 3: kein Kalender-Hinweis */
  .sz05[data-phase]:not([data-erreicht~="3"]) .sz05-hinweis { opacity: 0; transform: translateY(calc(16 * var(--px))); }
</style>
