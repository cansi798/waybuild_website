---
// Szene 12 „Fertig“ des Beispiels „So kann es laufen“ (Jamil, Talk qh87y3sj #5678/#5680, 13.11.2026).
// Drehbuch: Portal: „Abnahme bestätigen“ ✓, Rechnung kommt automatisch, „Online bezahlen“ ✓. Laptop, gleiche Portal-Kopfzeile
// wie Szene 10/11 (10-13/PortalKopf.astro). Keine Zahlungsanbieter-Logos: „Online bezahlen“ neutral. Betrag = Angebot aus Szene 10.
// Anleitung: docs/beispiel-szenen-anleitung.md, Referenz: Szene01.astro.
// Phasen (3, am Handy im Takt von 1,4 s):
//   0  Ausgang: Portal öffnet sich, nur die Kopfzeile steht
//   1  Schritte-Leiste (Ausführung ✓, Abnahme als Nächstes) und Karte „Ihr Wohnzimmer ist fertig“ gleiten herein;
//      rechts ein leerer Platz „Rechnung folgt“; Finger tippt auf „Abnahme bestätigen“
//   2  ✓ Abnahme bestätigt; die Rechnung erscheint automatisch (Hinweis „automatisch erstellt“)
//   3  Finger tippt auf „Online bezahlen“, kurz danach ✓ Bezahlt: Knopf grün, Stempel „Bezahlt“, Rechnung in der
//      Schritte-Leiste abgehakt
// Endzustand (ohne JS, reduzierte Bewegung, Variante „mini“) = Phase 3.
import { STANDARD, werte } from '../branchen';
import SzeneRahmen from '../SzeneRahmen.astro';
import Laptop from '../geraete/Laptop.astro';
import PortalKopf from './10-13/PortalKopf.astro';

interface Props { variante?: 'buehne' | 'mini' }
const { variante = 'buehne' } = Astro.props;
const W = werte(STANDARD); // Standardbranche; data-p = Schlüssel aus branchen.ts (Personalisierung im Browser)

const haken = '<path d="M5 12.5l4.2 4.2L19 7" />';
const schritte = [
  { was: W.terminArt, p: 'terminArt', mod: 'fertig' },
  { was: 'Angebot', mod: 'fertig' },
  { was: 'Ausführung', mod: 'fertig' },
  { was: W.abnahme, p: 'abnahme', mod: 'abnahme' },
  { was: 'Rechnung', mod: 'rechnung' },
];
---

<SzeneRahmen nr={12} phasen={3} takt={1400} format="quer" variante={variante}>
  <Laptop>
    <div class="sz12-app">
      <PortalKopf />
      <div class="sz12-inhalt">
        <!-- Schritte-Leiste -->
        <ol class="sz12-leiste sz12-ein sz12-ein--1">
          {schritte.map((s) => (
            <li class={`sz12-schritt sz12-schritt--${s.mod}`}>
              <span class="sz12-punkt"><i class="sz12-ring"></i><svg viewBox="0 0 24 24" set:html={haken} /></span>
              <span class="sz12-was" data-p={s.p}>{s.was}</span>
            </li>
          ))}
        </ol>

        <div class="sz12-karten">
          <!-- Abnahme -->
          <div class="bm-karte sz12-abnahme sz12-ein sz12-ein--2">
            <p class="bm-klein" data-p="abnahme">{W.abnahme}</p>
            <p class="sz12-titel" data-p="fertig">{W.fertig}</p>
            <span class="sz12-foto">
              <svg viewBox="0 0 200 100" preserveAspectRatio="xMidYMid slice">
                <rect width="200" height="100" fill="#c9d7c0" />
                <rect y="80" width="200" height="20" fill="#d9c8a9" />
                <rect x="122" y="14" width="50" height="50" rx="2" fill="#fbfaf7" />
                <rect x="127" y="19" width="18" height="40" fill="#dcebf3" />
                <rect x="149" y="19" width="18" height="40" fill="#dcebf3" />
                <rect x="118" y="64" width="58" height="4" rx="1.5" fill="#fbfaf7" />
                <rect y="76" width="200" height="4" fill="#fbfaf7" />
                <rect x="30" y="22" width="44" height="28" rx="1" fill="#fbfaf7" stroke="#e3e0da" />
                <path d="M34 46l11-12 8 8 6-5 11 9z" fill="#a9d8d2" />
                <path d="M86 80l3-14h16l3 14z" fill="#c9a27a" />
                <path d="M97 66c-8-10-3-21 0-24 3 3 8 14 0 24zM97 66c-13-2-16-13-14-17 4 0 13 6 14 17zM97 66c13-2 16-13 14-17-4 0-13 6-14 17z" fill="#5f9e7b" />
              </svg>
            </span>
            <span class="sz12-knopfbox">
              <span class="bm-knopf sz12-k-vor sz12-k-vor--abnahme" data-p="abnahmeBestaetigen">{W.abnahmeBestaetigen}</span>
              <span class="bm-knopf sz12-k-ok sz12-k-ok--abnahme"><span class="bm-ok"><svg viewBox="0 0 24 24" set:html={haken} /></span><span data-p="abnahmeBestaetigt">{W.abnahmeBestaetigt}</span></span>
              <span class="bm-tipp sz12-tipp sz12-tipp--abnahme"></span>
            </span>
          </div>

          <!-- Rechnung (Platz „folgt“ + Rechnung übereinander) -->
          <div class="sz12-rechnungsplatz sz12-ein sz12-ein--3">
            <div class="sz12-folgt">
              <svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z" /><path d="M15 3v4h4M9 12h7M9 16h5" /></svg>
              <span class="bm-klein" data-p="rechnungFolgt">{W.rechnungFolgt}</span>
            </div>
            <div class="bm-karte bm-karte--marke sz12-rechnung">
              <p class="sz12-r-kopf"><span class="bm-klein">Rechnung Nr. R-041</span><span class="bm-chip sz12-auto">automatisch erstellt</span></p>
              <p class="sz12-r-zeile"><span data-p="pName0">{W.pName0}</span><span data-p="pPreis0">{W.pPreis0}</span></p>
              <p class="sz12-r-zeile"><span data-p="pName1">{W.pName1}</span><span data-p="pPreis1">{W.pPreis1}</span></p>
              <p class="sz12-r-zeile"><span data-p="pName2">{W.pName2}</span><span data-p="pPreis2">{W.pPreis2}</span></p>
              <p class="sz12-r-zeile"><span data-p="anpName">{W.anpName}</span><span data-p="anpPreisNeu">{W.anpPreisNeu}</span></p>
              <p class="sz12-r-zeile sz12-r-mwst"><span>zzgl. 19 % MwSt.</span><span data-p="mwst">{W.mwst}</span></p>
              <p class="sz12-r-summe"><span class="bm-klein">Gesamt inkl. MwSt.</span><b data-p="summeNeu">{W.summeNeu}</b></p>
              <span class="sz12-knopfbox">
                <span class="bm-knopf sz12-k-vor sz12-k-vor--zahlen">
                  <svg class="sz12-karte-zeichen" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10h18" /></svg>Online bezahlen</span>
                <span class="bm-knopf sz12-k-ok sz12-k-ok--zahlen"><span class="bm-ok"><svg viewBox="0 0 24 24" set:html={haken} /></span>Bezahlt</span>
                <span class="bm-tipp sz12-tipp sz12-tipp--zahlen"></span>
              </span>
              <span class="sz12-stempel">Bezahlt</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Laptop>
</SzeneRahmen>

<style is:global>
  /* ===== Szene 12 „Fertig“ – alle Regeln mit .sz12 (global, eindeutig) =====
   * GRUNDFORM = ENDZUSTAND (Phase 3). Vorzustände NUR unter .sz12[data-phase]:not([data-erreicht~="k"]). Bewegt: transform/opacity. */
  .sz12-app { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .sz12-app p { margin: 0; }
  .sz12-inhalt { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: var(--bsp-a3); padding: var(--bsp-a3) var(--bsp-a4) var(--bsp-a4); }

  /* Schritte-Leiste */
  .sz12-leiste { list-style: none; margin: 0; padding: 0 var(--bsp-a2); display: flex; }
  .sz12-schritt { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: calc(4 * var(--px)); font-size: var(--bsp-schrift-xs); font-weight: 600; color: var(--bsp-text); }
  .sz12-schritt + .sz12-schritt::before { content: ''; position: absolute; z-index: 0; top: calc(9 * var(--px)); right: calc(50% + 12 * var(--px)); width: calc(100% - 24 * var(--px)); height: calc(2 * var(--px));
    border-radius: 99px; background: var(--bsp-ok); }
  .sz12-punkt { position: relative; z-index: 1; display: grid; place-items: center; width: calc(20 * var(--px)); height: calc(20 * var(--px)); border-radius: 50%; background: var(--bsp-ok); }
  .sz12-punkt svg { position: relative; width: 64%; height: 64%; fill: none; stroke: var(--bsp-weiss); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  .sz12-ring { position: absolute; inset: 0; border-radius: 50%; background: var(--bsp-weiss); box-shadow: inset 0 0 0 calc(2 * var(--px)) var(--bsp-tuerkis), 0 0 0 calc(3 * var(--px)) rgb(0 166 161 / 18%); opacity: 0; }
  .sz12-was { white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }

  /* Karten */
  .sz12-karten { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: calc(14 * var(--px)); }
  .sz12-abnahme { display: flex; flex-direction: column; gap: calc(4 * var(--px)); }
  .sz12-titel { font-family: var(--font-head); font-size: var(--bsp-schrift-l); font-weight: 700; color: var(--bsp-text); letter-spacing: -0.01em; }
  .sz12-foto { flex: 1; min-height: calc(60 * var(--px)); display: block; margin: calc(4 * var(--px)) 0; border-radius: var(--bsp-r-m); overflow: hidden; box-shadow: 0 0 0 calc(1 * var(--px)) rgb(0 79 76 / 10%); }
  .sz12-foto svg { display: block; width: 100%; height: 100%; }
  .sz12-knopfbox { position: relative; display: grid; }
  .sz12-knopfbox > .bm-knopf { grid-area: 1 / 1; min-height: calc(40 * var(--px)); font-size: var(--bsp-schrift-m); }
  .sz12-k-vor { opacity: 0; transform: scale(0.96); }
  .sz12 .sz12-k-ok { background: var(--bsp-ok-flaeche); color: var(--bsp-ok); gap: var(--bsp-a2); box-shadow: inset 0 0 0 calc(1.5 * var(--px)) rgb(23 112 73 / 35%); }
  .sz12-k-ok .bm-ok { width: calc(20 * var(--px)); height: calc(20 * var(--px)); }
  .sz12-karte-zeichen { width: calc(18 * var(--px)); height: calc(18 * var(--px)); fill: none; stroke: currentColor; stroke-width: 2; }
  .sz12-tipp { left: 50%; top: 50%; }

  /* Rechnung */
  .sz12-rechnungsplatz { display: grid; min-height: 0; }
  .sz12-rechnungsplatz > * { grid-area: 1 / 1; }
  .sz12-folgt { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--bsp-a2); border-radius: var(--bsp-r-m);
    border: calc(1.5 * var(--px)) dashed #c5cfcd; text-align: center; padding: var(--bsp-a4); opacity: 0; }
  .sz12-folgt svg { width: calc(34 * var(--px)); height: calc(34 * var(--px)); fill: none; stroke: #9fb1ae; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
  .sz12-rechnung { position: relative; display: flex; flex-direction: column; gap: calc(7 * var(--px)); overflow: hidden; }
  .sz12-r-kopf { display: flex; justify-content: space-between; align-items: center; gap: var(--bsp-a1); }
  .sz12 .sz12-auto { background: var(--bsp-flaeche); }
  .sz12-r-zeile { display: flex; justify-content: space-between; gap: var(--bsp-a2); font-size: var(--bsp-schrift-s); font-weight: 500; color: var(--bsp-text); white-space: nowrap; align-items: center; font-variant-numeric: tabular-nums; }
  .sz12-r-zeile.sz12-r-mwst { padding-top: calc(5 * var(--px)); border-top: calc(1 * var(--px)) dashed var(--bsp-linie-grau); color: var(--bsp-text-leise); font-size: var(--bsp-schrift-xs); }
  .sz12-r-zeile > span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; } /* lange Posten anderer Branchen */
  .sz12-r-zeile > span:last-child { flex: none; }
  .sz12-r-kopf + .sz12-r-zeile { margin-top: calc(4 * var(--px)) !important; }
  .sz12-r-zeile .bm-balken { flex: none; width: calc(54 * var(--px)); }
  .sz12-r-summe { margin-top: auto !important; display: flex; justify-content: space-between; align-items: baseline; padding-top: var(--bsp-a2); border-top: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .sz12-r-summe b { font-family: var(--font-head); font-size: var(--bsp-schrift-xl); font-weight: 700; color: var(--bsp-text); letter-spacing: -0.02em; }
  .sz12-stempel { position: absolute; right: 50%; bottom: calc(95 * var(--px)); padding: calc(3 * var(--px)) calc(10 * var(--px)); border: calc(2.5 * var(--px)) solid var(--bsp-ok);
    border-radius: var(--bsp-r-s); color: var(--bsp-ok); font-family: var(--font-head); font-size: var(--bsp-schrift-m); font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
    background: rgb(255 255 255 / 80%); transform: translateX(50%) rotate(-8deg); }

  /* Übergänge (in beide Richtungen) */
  .sz12-ein { transition: opacity var(--bsp-dauer) var(--bsp-ease), transform var(--bsp-dauer) var(--bsp-ease); }
  .sz12-ein--1 { transition-delay: var(--bsp-auftritt); }
  .sz12-ein--2 { transition-delay: calc(var(--bsp-auftritt) + var(--bsp-versatz)); }
  .sz12-ein--3 { transition-delay: calc(var(--bsp-auftritt) + 2 * var(--bsp-versatz)); }
  .sz12-ring, .sz12-folgt { transition: opacity var(--bsp-dauer-kurz) ease; }
  .sz12-k-vor { transition: opacity var(--bsp-dauer-kurz) ease, transform var(--bsp-dauer-kurz) ease; }
  .sz12 .sz12-k-ok { transition: opacity var(--bsp-dauer-kurz) ease, transform var(--bsp-dauer) var(--bsp-ease-feder); }
  .sz12-rechnung { transition: opacity var(--bsp-dauer) var(--bsp-ease) calc(0.5s * var(--bsp-t, 1)), transform var(--bsp-dauer) var(--bsp-ease) calc(0.5s * var(--bsp-t, 1)); }
  .sz12-stempel { transition: opacity var(--bsp-dauer-kurz) ease calc(0.35s * var(--bsp-t, 1)), transform var(--bsp-dauer) var(--bsp-ease-feder) calc(0.35s * var(--bsp-t, 1)); }

  /* ── Vorzustände (nur mit Engine) ── */
  /* vor Phase 1: nur die Kopfzeile */
  .sz12[data-phase]:not([data-erreicht~="1"]) .sz12-ein { opacity: 0; transform: translateY(calc(14 * var(--px))); }
  /* Phase 1: Finger tippt auf „Abnahme bestätigen“ (endet vor dem Takt 1,4 s am Handy) */
  .sz12[data-phase="1"] .sz12-tipp--abnahme { animation: bm-tippen calc(0.7s * var(--bsp-t, 1)) var(--bsp-ease) calc(0.65s * var(--bsp-t, 1)) both; }
  /* vor Phase 2: Abnahme offen, Rechnung noch nicht da */
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-schritt--abnahme .sz12-ring { opacity: 1; }
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-schritt--rechnung::before { background: var(--bsp-linie-grau); }
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-schritt--rechnung .sz12-punkt { background: var(--bsp-weiss); box-shadow: inset 0 0 0 calc(1.5 * var(--px)) #c5cfcd; }
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-schritt--rechnung .sz12-punkt svg { opacity: 0; }
  .sz12[data-phase]:not([data-erreicht~="3"]) .sz12-schritt--rechnung { color: var(--bsp-text-leise); }
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-k-vor--abnahme { opacity: 1; transform: none; }
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-k-ok--abnahme { opacity: 0; transform: scale(0.85); }
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-folgt { opacity: 1; }
  .sz12[data-phase]:not([data-erreicht~="2"]) .sz12-rechnung { opacity: 0; transform: translateY(calc(18 * var(--px))) scale(0.97); }
  /* vor Phase 3: Rechnung offen (Ring = „als Nächstes“) */
  .sz12[data-erreicht~="2"]:not([data-erreicht~="3"]) .sz12-schritt--rechnung .sz12-ring { opacity: 1; }
  .sz12[data-phase]:not([data-erreicht~="3"]) .sz12-k-vor--zahlen { opacity: 1; transform: none; }
  .sz12[data-phase]:not([data-erreicht~="3"]) .sz12-k-ok--zahlen { opacity: 0; transform: scale(0.85); }
  .sz12[data-phase]:not([data-erreicht~="3"]) .sz12-stempel { opacity: 0; transform: translateX(50%) rotate(-8deg) scale(1.6); }
  /* Phase 2: „Online bezahlen“ lädt sanft ein */
  .sz12[data-aktiv][data-phase="2"] .sz12-k-vor--zahlen { animation: bm-puls calc(1.6s * var(--bsp-t, 1)) var(--bsp-ease) calc(1.1s * var(--bsp-t, 1)) infinite; }
  /* Phase 3: Finger tippt, dann (verzögert) Bezahlt – Ring, Knöpfe, Stempel */
  .sz12[data-phase="3"] .sz12-tipp--zahlen { animation: bm-tippen calc(0.7s * var(--bsp-t, 1)) var(--bsp-ease) calc(0.2s * var(--bsp-t, 1)) both; }
  .sz12[data-erreicht~="3"] .sz12-schritt--rechnung .sz12-ring { transition-delay: calc(0.8s * var(--bsp-t, 1)); }
  .sz12[data-erreicht~="3"] .sz12-k-vor--zahlen { transition-delay: calc(0.55s * var(--bsp-t, 1)); }
  .sz12[data-erreicht~="3"] .sz12-k-ok--zahlen { transition-delay: calc(0.6s * var(--bsp-t, 1)); }
  .sz12[data-erreicht~="3"] .sz12-stempel { transition-delay: calc(0.95s * var(--bsp-t, 1)); }
</style>
