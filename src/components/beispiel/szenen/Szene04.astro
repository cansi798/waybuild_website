---
// Szene 4 „Termin gebucht“ des Beispiels „So kann es laufen“ (Jamil, Talk qh87y3sj #5678/#5680, 13.11.2026).
// Drehbuch: Handy, „Besichtigung buchen“, Kalender, Donnerstag 10:00 ✓.
// Aufbau/Regeln wie die Referenz Szene01.astro (docs/beispiel-szenen-anleitung.md). Kein echter Kalender-Anbieter, neutraler Kalender.
// Kalender: November, „heute“ = Mo 16. (passt zu Szene 5: Sperrbildschirm Montag), Termin Do 19.11., 10:00 Uhr.
// Phasen (3):
//   0  Ausgang: Kalender ohne Auswahl, Uhrzeiten noch nicht da, „Termin bestätigen“ blass
//   1  Finger tippt Donnerstag 19. → Tag gewählt, freie Uhrzeiten gleiten herein
//   2  Finger tippt 10:00 → Uhrzeit gewählt, Knopf wird aktiv
//   3  Finger tippt „Termin bestätigen“ → Bestätigung gleitet von unten herein, Haken federt: „Donnerstag, 19.11. · 10:00 Uhr“
// Endzustand (ohne JS, reduzierte Bewegung, Variante „mini“) = Phase 3.
import SzeneRahmen from '../SzeneRahmen.astro';
import Handy from '../geraete/Handy.astro';
import { STANDARD, werte } from '../branchen';

interface Props { variante?: 'buehne' | 'mini' }
const { variante = 'buehne' } = Astro.props;

const W = werte(STANDARD); // Standardbranche; data-p = Schlüssel aus branchen.ts (Personalisierung im Browser)
const WOCHENTAGE = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
// art: 'vorbei' (blass), 'heute' (Ring), 'frei' (Punkt), 'zu' (Wochenende/voll, blass), 'ziel' (Do 19.)
type Tag = { t: number; art: 'vorbei' | 'heute' | 'frei' | 'zu' | 'ziel' };
const WOCHEN: Tag[][] = [
  [9, 10, 11, 12, 13, 14, 15].map((t) => ({ t, art: 'vorbei' as const })),
  [{ t: 16, art: 'heute' }, { t: 17, art: 'frei' }, { t: 18, art: 'zu' }, { t: 19, art: 'ziel' }, { t: 20, art: 'frei' }, { t: 21, art: 'zu' }, { t: 22, art: 'zu' }],
  [{ t: 23, art: 'frei' }, { t: 24, art: 'frei' }, { t: 25, art: 'zu' }, { t: 26, art: 'frei' }, { t: 27, art: 'frei' }, { t: 28, art: 'zu' }, { t: 29, art: 'zu' }],
];
const ZEITEN = [
  { z: '08:00', frei: false }, { z: '10:00', frei: true, ziel: true }, { z: '11:30', frei: true },
  { z: '13:00', frei: true }, { z: '14:30', frei: false }, { z: '16:00', frei: true },
];
---

<SzeneRahmen nr={4} phasen={3} takt={1600} format="hoch" variante={variante}>
  <Handy>
    <div class="sz04-seite">
      <div class="bm-app sz04-app">
        <div class="sz04-kopf">
          <span class="sz04-zurueck"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></span>
          <span class="sz04-kopf-text">
            <span class="bm-titel" data-p="terminBuchen">{W.terminBuchen}</span>
            <span class="bm-klein" data-p="firma">{W.firma}</span>
          </span>
        </div>

        <!-- Kalender -->
        <div class="bm-karte sz04-kalender">
          <p class="sz04-monat"><span class="sz04-pfeil"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></span>November<span class="sz04-pfeil"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></span></p>
          <div class="sz04-raster">
            {WOCHENTAGE.map((w) => <span class="sz04-wt">{w}</span>)}
            {WOCHEN.flat().map((d) => (
              <span class:list={['sz04-tag', `sz04-tag--${d.art}`]}>
                {d.t}
                {d.art === 'ziel' && <span class="sz04-tag-an">{d.t}</span>}
                {d.art === 'ziel' && <span class="bm-tipp sz04-tipp sz04-tipp--tag"></span>}
              </span>
            ))}
          </div>
        </div>

        <!-- Uhrzeiten -->
        <div class="sz04-zeiten">
          <p class="sz04-zeiten-titel">Donnerstag, 19. November</p>
          <p class="sz04-slots">
            {ZEITEN.map((s, i) => (
              <span class:list={['sz04-slot', { 'sz04-slot--zu': !s.frei, 'sz04-slot--ziel': s.ziel }, `sz04-slot--${i + 1}`]}>
                {s.z}
                {s.ziel && <span class="sz04-slot-an">{s.z}</span>}
                {s.ziel && <span class="bm-tipp sz04-tipp sz04-tipp--zeit"></span>}
              </span>
            ))}
          </p>
        </div>

        <div class="bm-karte sz04-info">
          <p><span class="sz04-icon"><svg viewBox="0 0 24 24"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0113 0c0 4.8-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></svg></span><span data-p="terminOrt">{W.terminOrt}</span></p>
          <p><span class="sz04-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M12 7.5V12l3 2" /></svg></span><span data-p="terminDauer">{W.terminDauer}</span></p>
        </div>

        <span class="bm-knopf sz04-bestaetigen">Termin bestätigen<span class="bm-tipp sz04-tipp sz04-tipp--knopf"></span></span>
      </div>

      <!-- Bestätigung (Blatt von unten) -->
      <span class="sz04-schleier"></span>
      <div class="sz04-blatt">
        <span class="sz04-griff"></span>
        <span class="sz04-haken"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
        <p class="sz04-blatt-titel">Termin steht</p>
        <p class="sz04-blatt-termin">Donnerstag, 19.11. · 10:00 Uhr</p>
        <p class="bm-klein sz04-blatt-info"><span data-p="terminInfo">{W.terminInfo}</span><br />Bestätigung kommt per E-Mail</p>
        <span class="bm-chip bm-chip--ok sz04-blatt-chip">✓ Im Kalender eingetragen</span>
      </div>
    </div>
  </Handy>
</SzeneRahmen>

<style is:global>
  /* ===== Szene 04 „Termin gebucht“ – alle Regeln mit .sz04 beginnen =====
   * GRUNDFORM = ENDZUSTAND (Phase 3). Vorzustände NUR unter .sz04[data-phase]:not([data-erreicht~="k"]). Nur transform/opacity bewegt. */
  .sz04-seite { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .sz04-app { gap: var(--bsp-a3); padding-top: var(--bsp-a2); }
  .sz04-app p { margin: 0; }
  .sz04-kopf { display: flex; align-items: flex-start; gap: var(--bsp-a2); }
  .sz04-zurueck { flex: none; display: grid; place-items: center; width: calc(28 * var(--px)); height: calc(28 * var(--px)); margin-top: calc(-2 * var(--px)); border-radius: 50%; background: var(--bsp-weiss);
    box-shadow: inset 0 0 0 calc(1 * var(--px)) var(--bsp-linie-grau); }
  .sz04-zurueck svg, .sz04-pfeil svg { width: 58%; height: 58%; fill: none; stroke: var(--bsp-text); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .sz04-kopf-text { display: flex; flex-direction: column; gap: calc(2 * var(--px)); min-width: 0; }
  .sz04-kopf-text .bm-klein { font-size: var(--bsp-schrift-xs); }

  /* Kalender */
  .sz04-kalender { padding: calc(10 * var(--px)) calc(10 * var(--px)) var(--bsp-a3); }
  .sz04-monat { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--bsp-a2) !important; font-family: var(--font-head); font-size: var(--bsp-schrift-m);
    font-weight: 700; color: var(--bsp-text); }
  .sz04-pfeil { display: grid; place-items: center; width: calc(22 * var(--px)); height: calc(22 * var(--px)); border-radius: 50%; background: var(--bsp-papier); }
  .sz04-raster { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: calc(4 * var(--px)); justify-items: center; }
  .sz04-wt { padding-bottom: calc(2 * var(--px)); font-size: calc(9 * var(--px)); font-weight: 650; color: var(--bsp-text-leise); text-transform: uppercase; letter-spacing: 0.04em; }
  .sz04-tag { position: relative; display: grid; place-items: center; width: calc(32 * var(--px)); height: calc(32 * var(--px)); border-radius: 50%; font-size: var(--bsp-schrift-s); font-weight: 600; color: var(--bsp-text); }
  .sz04-tag--vorbei, .sz04-tag--zu { color: #b3bcba; font-weight: 500; }
  .sz04-tag--heute { box-shadow: inset 0 0 0 calc(1.5 * var(--px)) var(--bsp-linie); color: var(--bsp-tinte); }
  .sz04-tag--frei::after, .sz04-tag--ziel::after { content: ''; position: absolute; bottom: calc(3 * var(--px)); left: 50%; width: calc(4 * var(--px)); height: calc(4 * var(--px)); margin-left: calc(-2 * var(--px));
    border-radius: 50%; background: var(--bsp-tuerkis); }
  .sz04-tag--ziel { color: var(--bsp-text); font-weight: 700; }
  .sz04-tag-an { position: absolute; z-index: 1; inset: 0; display: grid; place-items: center; border-radius: 50%; background: var(--bsp-tinte); color: var(--bsp-weiss);
    box-shadow: 0 calc(4 * var(--px)) calc(10 * var(--px)) calc(-3 * var(--px)) rgb(0 79 76 / 55%); }
  .sz04-tipp--tag { left: 50%; top: 50%; }

  /* Uhrzeiten */
  .sz04-zeiten { display: flex; flex-direction: column; gap: var(--bsp-a2); }
  .sz04-zeiten-titel { font-size: var(--bsp-schrift-s); font-weight: 650; color: var(--bsp-text); }
  .sz04-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(6 * var(--px)); }
  .sz04-slot { position: relative; display: grid; place-items: center; height: calc(34 * var(--px)); border-radius: var(--bsp-r-s); background: var(--bsp-weiss);
    box-shadow: inset 0 0 0 calc(1 * var(--px)) var(--bsp-linie); color: var(--bsp-tinte); font-size: var(--bsp-schrift-s); font-weight: 650; }
  .sz04-slot--zu { background: transparent; box-shadow: inset 0 0 0 calc(1 * var(--px)) var(--bsp-linie-grau); color: #b3bcba; text-decoration: line-through; font-weight: 500; }
  .sz04-slot-an { position: absolute; inset: 0; display: grid; place-items: center; border-radius: inherit; background: var(--bsp-tinte); color: var(--bsp-weiss); }
  .sz04-tipp--zeit { left: 50%; top: 50%; }

  .sz04-info { display: flex; flex-direction: column; gap: calc(7 * var(--px)); padding: calc(10 * var(--px)) var(--bsp-a3); background: var(--bsp-flaeche); border-color: var(--bsp-linie); box-shadow: none; }
  .sz04-info p { display: flex; align-items: center; gap: var(--bsp-a2); font-size: var(--bsp-schrift-xs); color: var(--bsp-text); }
  .sz04-icon { flex: none; display: grid; place-items: center; width: calc(20 * var(--px)); height: calc(20 * var(--px)); border-radius: 50%; background: var(--bsp-weiss); }
  .sz04-icon svg { width: 66%; height: 66%; fill: none; stroke: var(--bsp-tinte); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sz04-bestaetigen { position: relative; align-self: stretch; margin-top: auto; min-height: calc(42 * var(--px)); }
  .sz04-tipp--knopf { left: 50%; top: 50%; }

  /* Bestätigung */
  .sz04-schleier { position: absolute; z-index: 5; inset: calc(-40 * var(--px)) 0 0; background: rgb(0 47 45 / 34%); }
  .sz04-blatt { position: absolute; z-index: 6; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; gap: calc(6 * var(--px));
    padding: calc(10 * var(--px)) var(--bsp-a4) calc(30 * var(--px)); border-radius: calc(22 * var(--px)) calc(22 * var(--px)) 0 0; background: var(--bsp-weiss); text-align: center;
    box-shadow: 0 calc(-10 * var(--px)) calc(30 * var(--px)) calc(-10 * var(--px)) rgb(0 47 45 / 40%); }
  .sz04-blatt p { margin: 0; }
  .sz04-griff { width: calc(36 * var(--px)); height: calc(4 * var(--px)); margin-bottom: calc(6 * var(--px)); border-radius: 99px; background: var(--bsp-linie-grau); }
  .sz04-haken { display: grid; place-items: center; width: calc(52 * var(--px)); height: calc(52 * var(--px)); border-radius: 50%; background: var(--bsp-ok); color: var(--bsp-weiss);
    box-shadow: 0 0 0 calc(7 * var(--px)) var(--bsp-ok-flaeche); }
  .sz04-haken svg { width: 56%; height: 56%; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .sz04-blatt-titel { margin-top: calc(8 * var(--px)) !important; font-family: var(--font-head); font-size: var(--bsp-schrift-xl); font-weight: 750; letter-spacing: -0.02em; color: var(--bsp-text); }
  .sz04-blatt-termin { font-family: var(--font-head); font-size: var(--bsp-schrift-m); font-weight: 700; color: var(--bsp-tinte); }
  .sz04-blatt-info { font-size: var(--bsp-schrift-xs); line-height: 1.5; }
  .sz04-blatt-chip { margin-top: calc(4 * var(--px)); }

  /* Übergänge (in beide Richtungen) */
  .sz04-tag-an, .sz04-slot-an { transition: opacity var(--bsp-dauer-kurz) ease calc(0.45s * var(--bsp-t, 1)), transform var(--bsp-dauer) var(--bsp-ease-feder) calc(0.45s * var(--bsp-t, 1)); }
  .sz04-zeiten-titel, .sz04-slot { transition: opacity var(--bsp-dauer) var(--bsp-ease), transform var(--bsp-dauer) var(--bsp-ease); }
  .sz04-zeiten-titel { transition-delay: calc(0.75s * var(--bsp-t, 1)); }
  .sz04-slot--1 { transition-delay: calc(0.85s * var(--bsp-t, 1)); } .sz04-slot--2 { transition-delay: calc(0.93s * var(--bsp-t, 1)); } .sz04-slot--3 { transition-delay: calc(1.01s * var(--bsp-t, 1)); }
  .sz04-slot--4 { transition-delay: calc(1.09s * var(--bsp-t, 1)); } .sz04-slot--5 { transition-delay: calc(1.17s * var(--bsp-t, 1)); } .sz04-slot--6 { transition-delay: calc(1.25s * var(--bsp-t, 1)); }
  .sz04-slot--ziel { transition: opacity var(--bsp-dauer) var(--bsp-ease) calc(0.93s * var(--bsp-t, 1)), transform var(--bsp-dauer) var(--bsp-ease) calc(0.93s * var(--bsp-t, 1)); }
  .sz04-bestaetigen { transition: opacity var(--bsp-dauer) var(--bsp-ease) calc(0.5s * var(--bsp-t, 1)); }
  .sz04-schleier { transition: opacity var(--bsp-dauer) var(--bsp-ease) calc(0.7s * var(--bsp-t, 1)); }
  .sz04-blatt { transition: transform calc(0.75s * var(--bsp-t, 1)) cubic-bezier(0.2, 0.9, 0.3, 1) calc(0.75s * var(--bsp-t, 1)); }
  .sz04-haken { transition: opacity var(--bsp-dauer-kurz) ease calc(1.2s * var(--bsp-t, 1)), transform calc(0.7s * var(--bsp-t, 1)) var(--bsp-ease-feder) calc(1.2s * var(--bsp-t, 1)); }

  /* ── Vorzustände (nur mit Engine) ── */
  /* vor Phase 1: kein Tag gewählt, keine Uhrzeiten */
  .sz04[data-phase]:not([data-erreicht~="1"]) .sz04-tag-an { opacity: 0; transform: scale(0.5); }
  .sz04[data-phase]:not([data-erreicht~="1"]) .sz04-zeiten-titel,
  .sz04[data-phase]:not([data-erreicht~="1"]) .sz04-slot { opacity: 0; transform: translateY(calc(10 * var(--px))); }
  .sz04[data-phase="1"] .sz04-tipp--tag { animation: bm-tippen calc(0.75s * var(--bsp-t, 1)) var(--bsp-ease) var(--bsp-auftritt) both; }
  /* vor Phase 2: keine Uhrzeit, Knopf blass */
  .sz04[data-phase]:not([data-erreicht~="2"]) .sz04-slot-an { opacity: 0; transform: scale(0.85); }
  .sz04[data-phase]:not([data-erreicht~="2"]) .sz04-bestaetigen { opacity: 0.35; }
  .sz04[data-phase="2"] .sz04-tipp--zeit { animation: bm-tippen calc(0.75s * var(--bsp-t, 1)) var(--bsp-ease) var(--bsp-auftritt) both; }
  /* vor Phase 3: Bestätigung noch unten verborgen */
  .sz04[data-phase]:not([data-erreicht~="3"]) .sz04-schleier { opacity: 0; }
  .sz04[data-phase]:not([data-erreicht~="3"]) .sz04-blatt { transform: translateY(105%); }
  .sz04[data-phase]:not([data-erreicht~="3"]) .sz04-haken { opacity: 0; transform: scale(0.3); }
  .sz04[data-phase="3"] .sz04-tipp--knopf { animation: bm-tippen calc(0.75s * var(--bsp-t, 1)) var(--bsp-ease) var(--bsp-auftritt) both; }
</style>
