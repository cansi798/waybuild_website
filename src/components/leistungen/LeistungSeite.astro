---
// Leistungsseite /leistungen/<slug>/: EINE Vorlage für alle 12 Leistungen. Seit 14.11.2026 im Stil der neuen Startseite
// (Jamil, Talk qh87y3sj #5892: „Die Leistungsseiten sollen alle gleich strukturiert sein“; Sicherung: Git-Verlauf).
// Aufbau, für jede Leistung gleich:
//   1 PageHeader (Kennzeile = Gruppe, H1, Lead, Knopf „Kostenlose Beratung“ wie im Startseiten-Hero)
//   2 „Kennen Sie das?“ (Markdown-Text „Worum es geht“ + drei Probleme aus `probleme`)
//   3 „Was Sie bekommen“ (`umfang`, `umfangHinweis`, verwandte Leistungen aus `verwandt`)
//   (nur wo vorher von Jamil gewünscht: Beispiel-Felder Sichtbarkeit #5363/#5634, bei „website“ Referenzen #5288)
//   4 „So läuft es ab“ (`schritte`, Stil .sn-ablauf/.sn-schritt der Startseite)
//   5 „Passendes Paket“ (`pakete` → Name, Preis aus src/config/pakete-abo.ts; leer = individuelles Angebot; `passt`, `paketText`)
//   6 „Häufige Fragen“ (`fragen`, details/summary, FAQPage-JSON-LD)
//   7 <SnAbschluss />
// Inhalte: src/content/leistungen/<slug>.md, Schema src/content.config.ts, Stil src/styles/leistung-seite.css (Präfix .ls-).
// Strukturierte Daten: Service (ohne Preise) + FAQPage; Brotkrumen über BaseLayout. Weiterleitungen: pages/leistungen/[slug].astro.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import ReferenzKarten from '../referenzen/ReferenzKarten.astro';
import Sichtbarkeit from '../sichtbarkeit/Sichtbarkeit.astro';
import SnAbschluss from '../startneu/SnAbschluss.astro';
import { LEISTUNG_FOTO } from '../../config/bilder';
import { LEISTUNG_PANELS } from '../../config/sichtbarkeit';
import { gruppeById, LEISTUNGEN_META, paketAnzeige, type LeistungNeu } from '../../config/leistungen-neu';
import { ABO_PAKETE, EINMALIG_DAZU, euro, bruttoVon, gesamtZeile, LAUFZEIT_HINWEIS, B2B_HINWEIS } from '../../config/pakete-abo';
import { ANLIEGEN, REFERENZEN } from '../../config/startseite';
import { HERO_KNOPF } from '../../config/variante';
import { href, absolute } from '../../lib/paths';
import '../../styles/start-neu.css';
import '../../styles/leistung-seite.css';

interface Props { eintrag: LeistungNeu }
const { eintrag } = Astro.props;
const d = eintrag.data;
const { Content } = await render(eintrag);
const gruppe = gruppeById(d.gruppe);
const kontakt = href(`/kontakt/?paket=${encodeURIComponent(ANLIEGEN.erstberatung.paket)}`);
const pfad = `/leistungen/${eintrag.id}/`;
const url = absolute(pfad, Astro.site);
const foto = LEISTUNG_FOTO[eintrag.id];
const panels = LEISTUNG_PANELS[eintrag.id];

/** Einfache Inline-Umwandlung für Frontmatter-Texte: HTML maskieren, dann **fett** und [Text](/pfad/) (mit Basis-Pfad). */
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const inline = (s: string) =>
  esc(s)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, t: string, u: string) => `<a href="${u.startsWith('/') ? href(u) : u}">${t}</a>`);

// Leistungsumfang nach optionaler Zwischenzeile gruppieren (Reihenfolge bleibt)
const umfang = d.umfang ?? [];
const umfangGruppen: { gruppe?: string; punkte: typeof umfang }[] = [];
for (const u of umfang) {
  const letzte = umfangGruppen.at(-1);
  if (letzte && letzte.gruppe === u.gruppe) letzte.punkte.push(u);
  else umfangGruppen.push({ gruppe: u.gruppe, punkte: [u] });
}

const verwandt = (d.verwandt ?? []).flatMap((slug) => LEISTUNGEN_META.filter((m) => m.slug === slug && slug !== eintrag.id));
const pakete = (d.pakete ?? []).map((id) => ABO_PAKETE.find((p) => p.id === id)!).filter(Boolean);
const extras = d.extras === true;
const aufAnfrage = pakete.length === 0 && !extras;
// von uns ergänzt (#5892): Standardtext, falls `paketText` fehlt
const paketText = d.paketText ?? (aufAnfrage
  ? 'Diese Leistung ist kein fester Bestandteil der Pakete. Wir besprechen Ihren Bedarf in der kostenlosen Erstberatung und machen Ihnen ein Angebot.'
  : undefined);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.title,
    serviceType: d.menuTitel,
    description: d.description,
    audience: { '@type': 'BusinessAudience', name: 'Unternehmen' },
    provider: { '@id': `${absolute('/', Astro.site)}#organization` },
    areaServed: { '@type': 'Country', name: 'Deutschland' },
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.fragen.map((f) => ({ '@type': 'Question', name: f.frage, acceptedAnswer: { '@type': 'Answer', text: f.antwort } })),
  },
];
---

<BaseLayout
  title={d.title}
  description={d.description}
  schema={schema}
  breadcrumb={[{ name: 'Leistungen', path: '/leistungen/' }, { name: d.menuTitel, path: pfad }]}
>
  <!-- 1 · Seitenkopf -->
  <PageHeader eyebrow={gruppe.titel} title={d.title} lead={d.kurz} foto={foto}>
    <div class="ls-kopf__knopf">
      <a class="btn btn--lg" href={kontakt}>{HERO_KNOPF}</a>
      <a class="ls-kopf__paket" href="#paket">{paketAnzeige(d.paket)}</a>
    </div>
  </PageHeader>

  <!-- 2 · Kennen Sie das? -->
  <section class="section sn ls-problem" aria-labelledby="ls-problem-h">
    <div class="wrap">
      <div class="sn-kopf sn-kopf--zweispaltig">
        <div>
          <p class="sn-kenn">Ausgangslage</p>
          <h2 id="ls-problem-h" class="sn-h2">Kennen Sie das?</h2>
        </div>
        <div class="ls-intro"><Content /></div>
      </div>
      {d.probleme && d.probleme.length > 0 && (
        <ol class="ls-probleme">
          {d.probleme.map((p, i) => (
            <li class="ls-problem-karte reveal">
              <span class="ls-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="sn-h4">{p.titel}</h3>
              <p set:html={inline(p.text)} />
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <!-- 3 · Was Sie bekommen -->
  {umfang.length > 0 && (
    <section class="section sn ls-umfang" aria-labelledby="ls-umfang-h">
      <div class="wrap">
        <div class="sn-kopf">
          <p class="sn-kenn">Leistungsumfang</p>
          <h2 id="ls-umfang-h" class="sn-h2">Was Sie bekommen</h2>
        </div>
        {umfangGruppen.map((g) => (
          <div class="ls-umfang__gruppe">
            {g.gruppe && <h3 class="sn-h4 ls-umfang__zwischen">{g.gruppe}</h3>}
            <ul class="ls-umfang__liste">
              {g.punkte.map((u) => (
                <li class="ls-punkt">
                  <span class="ls-punkt__zeichen" aria-hidden="true"></span>
                  <span class="ls-punkt__text">
                    {u.titel && <strong>{u.titel}</strong>}
                    <span set:html={inline(u.text)} />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        {d.umfangHinweis && <p class="sn-fein ls-umfang__hinweis" set:html={inline(d.umfangHinweis)} />}
        {verwandt.length > 0 && (
          <div class="ls-verwandt">
            <h3 class="ls-verwandt__titel">Passt gut dazu</h3>
            <ul class="ls-verwandt__liste">
              {verwandt.map((v) => (
                <li>
                  <a class="ls-verwandt__link" href={href(`/leistungen/${v.slug}/`)}>
                    <strong>{v.menuTitel}</strong>
                    <span>{v.kurz}</span>
                    <Icon name="arrow" size={18} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Beispiele, nur auf den Seiten, für die Jamil sie gewünscht hat (#5363, #5634, #5288) -->
  {eintrag.id === 'suchmaschinen-optimierung' ? <Sichtbarkeit variante="seo" /> : panels && <Sichtbarkeit arten={panels} variante="leistung" />}
  {eintrag.id === 'website' && (
    <section class="section sn ls-referenzen" id="referenzen" aria-labelledby="ls-ref-h">
      <div class="wrap">
        <div class="sn-kopf sn-kopf--zweispaltig">
          <h2 id="ls-ref-h" class="sn-h2 sn-h2--klein">{REFERENZEN.titel}</h2>
          <p class="sn-lead">{REFERENZEN.einleitung}</p>
        </div>
        <ReferenzKarten />
        <p class="ls-mehr"><a class="sn-link" href={href('/beispiele/')}>Alle Beispiele ansehen <Icon name="arrow" size={18} /></a></p>
      </div>
    </section>
  )}

  <!-- 4 · So läuft es ab -->
  {d.schritte && d.schritte.length > 0 && (
    <section class="section sn ls-ablauf" aria-labelledby="ls-ablauf-h">
      <div class="wrap">
        <div class="sn-kopf">
          <p class="sn-kenn">Ablauf</p>
          <h2 id="ls-ablauf-h" class="sn-h2">So läuft es ab</h2>
        </div>
        <ol class:list={['sn-ablauf', `ls-ablauf--${d.schritte.length}`]}>
          {d.schritte.map((s, i) => (
            <li class="sn-schritt reveal">
              <span class="sn-schritt__nr" aria-hidden="true">{i + 1}</span>
              <h3 class="sn-schritt__titel"><span class="sr-only">Schritt {i + 1}: </span>{s.titel}</h3>
              <p class="sn-schritt__text" set:html={inline(s.text)} />
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- 5 · Passendes Paket -->
  <section class="section sn ls-paket" id="paket" aria-labelledby="ls-paket-h">
    <div class="wrap ls-paket__raster">
      <div class="ls-paket__text">
        <p class="sn-kenn">Paket und Preis</p>
        <h2 id="ls-paket-h" class="sn-h2 sn-h2--klein">Passendes Paket</h2>
        {d.passt && (
          <>
            <h3 class="sn-h4 ls-paket__frage">Passt das zu Ihnen?</h3>
            <p class="ls-paket__passt" set:html={inline(d.passt)} />
          </>
        )}
      </div>
      <div class="ls-paket__karten">
        {pakete.map((p) => (
          <article class:list={['ls-paketkarte', { 'ls-paketkarte--tipp': p.empfohlen }]} aria-labelledby={`ls-pk-${p.id}`}>
            <p class="ls-paketkarte__label">Paket</p>
            <h3 id={`ls-pk-${p.id}`} class="ls-paketkarte__name">{p.name}</h3>
            <p class="ls-paketkarte__kurz">{p.kurz}</p>
            <p class="ls-paketkarte__preis"><b>{euro(p.preis)}</b> <span>netto im Monat</span></p>
            <p class="ls-paketkarte__brutto">{euro(bruttoVon(p.preis))} inkl. 19 % MwSt.</p>
            <p class="ls-paketkarte__fuer">{p.fuer}</p>
          </article>
        ))}
        {extras && (
          <article class="ls-paketkarte ls-paketkarte--extras" aria-labelledby="ls-pk-extras">
            <p class="ls-paketkarte__label">Einmalig</p>
            <h3 id="ls-pk-extras" class="ls-paketkarte__name">{EINMALIG_DAZU.titel}</h3>
            <ul class="ls-extras">
              {EINMALIG_DAZU.liste.map((e) => (
                <li><span>{e.name}</span><b>{euro(e.preis)}</b></li>
              ))}
            </ul>
            <p class="ls-paketkarte__fuer">{gesamtZeile()}. {EINMALIG_DAZU.hinweis}</p>
          </article>
        )}
        {aufAnfrage && (
          <article class="ls-paketkarte ls-paketkarte--anfrage" aria-labelledby="ls-pk-anfrage">
            <p class="ls-paketkarte__label">Auf Anfrage</p>
            <h3 id="ls-pk-anfrage" class="ls-paketkarte__name">Individuelles Angebot</h3>
            <p class="ls-paketkarte__fuer">Nach Ihrem Bedarf, besprochen in der kostenlosen Erstberatung.</p>
          </article>
        )}
        {paketText && <p class="ls-paket__hinweis" set:html={inline(paketText)} />}
        <div class="ls-paket__knoepfe">
          {aufAnfrage
            ? <a class="btn btn--lg sn-btn" href={kontakt}>{HERO_KNOPF}</a>
            : <a class="btn btn--lg sn-btn" href={href('/preise/')}>Alle Preise ansehen</a>}
          <a class="sn-link" href={aufAnfrage ? href('/preise/') : kontakt}>{aufAnfrage ? 'Feste Pakete ansehen' : HERO_KNOPF} <Icon name="arrow" size={18} /></a>
        </div>
        {pakete.length > 0 && <p class="sn-fein">{LAUFZEIT_HINWEIS} {B2B_HINWEIS}</p>}
      </div>
    </div>
  </section>

  <!-- 6 · Häufige Fragen -->
  <section class="section sn ls-fragen" aria-labelledby="ls-fragen-h">
    <div class="wrap ls-fragen__raster">
      <div>
        <p class="sn-kenn">Fragen</p>
        <h2 id="ls-fragen-h" class="sn-h2 sn-h2--klein">Häufige Fragen</h2>
        <p class="ls-fragen__mehr"><a class="sn-link" href={href('/fragen/')}>Alle Fragen ansehen <Icon name="arrow" size={18} /></a></p>
      </div>
      <div class="ls-faq">
        {d.fragen.map((f) => (
          <details class="ls-faq__item">
            <summary><h3 class="ls-faq__frage">{f.frage}</h3><span class="ls-faq__zeichen" aria-hidden="true"></span></summary>
            <p>{f.antwort}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 · Abschluss -->
  <SnAbschluss />
</BaseLayout>
