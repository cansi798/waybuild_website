---
// Neue Leistungsseite /leistungen/<slug>/ (Jamil, Talk qh87y3sj #5274 Vorschlag, #5276 „ok“, 09.11.2026).
// Inhalt aus src/content/leistungen/<slug>.md (Frontmatter + Abschnitte „Worum es geht“, „Was wir übernehmen“,
// „So läuft es ab“, „Passt das zu Ihnen?“). Aufbau: Kopf (Gruppe, Station der Kundenreise mit Link auf /#kundenreise,
// H1, kurz als Einleitung, Paket-Hinweis als kleines Etikett ohne Preis + „Preise ansehen“, Knopf „Kostenlose Erstberatung“)
// → Text → bei „website“ die Referenzen (Jamil #5288) → Häufige Fragen (Akkordeon + FAQPage) → weitere Leistungen derselben
// Gruppe (danach folgt der Kontaktkopf des Footers mit Erstgespräch, daher kein eigener dunkler Abschluss). Strukturierte Daten: Service (ohne Preise), FAQPage; Brotkrumen über BaseLayout.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import ReferenzKarten from '../referenzen/ReferenzKarten.astro';
import Foto from '../Foto.astro';
import { LEISTUNG_FOTO } from '../../config/bilder';
import { gruppeById, STATIONEN, ICONS, leistungenNeu, paketAnzeige, type LeistungNeu } from '../../config/leistungen-neu';
import { ANLIEGEN, REFERENZEN } from '../../config/startseite';
import { href, absolute } from '../../lib/paths';

interface Props { eintrag: LeistungNeu }
const { eintrag } = Astro.props;
const d = eintrag.data;
const { Content } = await render(eintrag);
const gruppe = gruppeById(d.gruppe);
const station = STATIONEN[d.station];
const aufAnfrage = paketAnzeige(d.paket) === 'Auf Anfrage';
const andere = (await leistungenNeu()).filter((l) => l.data.gruppe === d.gruppe && l.id !== eintrag.id);
// Gleiches Ziel wie der Knopf „Kostenlose Erstberatung“ der Startseite/Kopfzeile
const erstberatung = href(`/kontakt/?paket=${encodeURIComponent(ANLIEGEN.erstberatung.paket)}`);
const pfad = `/leistungen/${eintrag.id}/`;
const url = absolute(pfad, Astro.site);
// Stockfoto im Kopf (Jamil, Talk qh87y3sj #5362): PC rechts neben dem Text, Handy unter dem Text; im ersten Bildschirm, daher eager
const foto = LEISTUNG_FOTO[eintrag.id];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.title,
    serviceType: d.menuTitel,
    description: d.description,
    audience: { '@type': 'BusinessAudience', name: 'Unternehmen' },
    provider: { '@id': `${absolute('/', Astro.site)}#organization` },
    areaServed: { '@type': 'Country', name: 'Deutschland' },
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.fragen.map((f) => ({ '@type': 'Question', name: f.frage, acceptedAnswer: { '@type': 'Answer', text: f.antwort } })),
  },
];
---

<BaseLayout
  title={d.title}
  description={d.description}
  schema={schema}
  breadcrumb={[{ name: 'Leistungen', path: '/leistungen/' }, { name: d.menuTitel, path: pfad }]}
>
  <section class="lkopf">
    <div class:list={['wrap', 'lkopf__raster', { 'lkopf__raster--foto': foto }]}>
    <div class="lkopf__inner">
      <p class="lkopf__meta">
        <a class="lkopf__gruppe" href={href(`/leistungen/#${gruppe.id}`)}>{gruppe.titel}</a>
        <a class="lkopf__station" href={href('/#kundenreise')}>
          <span class="lkopf__nr" aria-hidden="true">{station.nr}</span>
          <span><span class="sr-only">Kundenreise, </span>Station {station.nr}: {station.name}</span>
        </a>
      </p>
      <h1>{d.title}</h1>
      <p class="lead lkopf__lead">{d.kurz}</p>
      <p class="lkopf__paket">
        <span class:list={['lpaket', { 'lpaket--anfrage': aufAnfrage }]}><Icon name={aufAnfrage ? 'chat' : 'layers'} size={16} /> {paketAnzeige(d.paket)}</span>
        <a href={href('/preise/')}>Preise ansehen</a>
      </p>
      <div class="lkopf__knopf">
        <a class="btn btn--primary btn--lg" href={erstberatung}>{ANLIEGEN.erstberatung.label}</a>
      </div>
    </div>
    {foto && <Foto id={foto} loading="eager" sizes="(min-width: 1200px) 480px, (min-width: 900px) 40vw, calc(100vw - 32px)" class="lkopf__foto" />}
    </div>
  </section>

  <section class="section ltext-sec">
    <div class="wrap">
      <div class="ltext"><Content /></div>
    </div>
  </section>

  {eintrag.id === 'website' && (
    <section class="section section--sand" id="referenzen" aria-labelledby="lref-h">
      <div class="wrap">
        <div class="lsec-kopf">
          <h2 id="lref-h">{REFERENZEN.titel}</h2>
          <p class="lead">{REFERENZEN.einleitung}</p>
        </div>
        <ReferenzKarten />
        <p class="lmehr"><a href={href('/beispiele/')}>Alle Beispiele ansehen</a></p>
      </div>
    </section>
  )}

  <section class:list={['section', { 'section--sand': eintrag.id !== 'website' }]} aria-labelledby="lfaq-h">
    <div class="wrap">
      <div class="lsec-kopf">
        <h2 id="lfaq-h">Häufige Fragen</h2>
      </div>
      <div class="lfaq">
        {d.fragen.map((f) => (
          <details class="lfaq__item"><summary><h3>{f.frage}</h3></summary><p>{f.antwort}</p></details>
        ))}
      </div>
    </div>
  </section>

  {andere.length > 0 && (
    <section class:list={['section', { 'section--sand': eintrag.id === 'website' }]} aria-labelledby="landere-h">
      <div class="wrap">
        <div class="lsec-kopf">
          <h2 id="landere-h">Mehr aus „{gruppe.titel}“</h2>
          <p class="lead">{gruppe.text}</p>
        </div>
        <ul class="landere">
          {andere.map((o) => (
            <li>
              <a class="card lkarte" href={href(`/leistungen/${o.id}/`)}>
                <span class="lkarte__icon"><Icon name={ICONS[o.id] ?? 'check'} size={22} /></span>
                <strong>{o.data.menuTitel}</strong>
                <span class="lkarte__kurz">{o.data.kurz}</span>
                <span class="lkarte__paket">{paketAnzeige(o.data.paket)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="lmehr"><a href={href('/leistungen/')}>Alle Leistungen im Überblick</a></p>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* Kopf: ruhig, hell, wie die übrigen Unterseiten; alles 320 px tauglich (lange Wörter dürfen umbrechen) */
  .lkopf { padding-block: clamp(32px, 6vw, 72px) clamp(32px, 5vw, 56px); border-bottom: 1px solid var(--line); }
  .lkopf__inner { display: grid; gap: 14px; justify-items: start; max-width: 760px; min-width: 0; }
  /* Mit Foto (#5362): PC zwei Spalten, Text links, Foto rechts; Handy Foto unter dem Text */
  .lkopf__raster--foto { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; }
  @media (min-width: 900px) { .lkopf__raster--foto { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .lkopf h1 { margin: 0; font-size: clamp(1.9rem, 5vw, 3.4rem); hyphens: auto; overflow-wrap: break-word; }
  .lkopf__lead { margin: 0; }
  .lkopf__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0; }
  .lkopf__gruppe { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); text-decoration: none; }
  .lkopf__gruppe:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lkopf__station { display: inline-flex; align-items: center; gap: 8px; min-height: 32px; padding: 3px 12px 3px 4px; border-radius: 999px; background: var(--white); border: 1px solid var(--line); font-size: 0.85rem; font-weight: 600; color: var(--ink); text-decoration: none; }
  .lkopf__station:hover { border-color: var(--accent-ink); }
  .lkopf__nr { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--accent-ink); color: var(--white); font-size: 0.78rem; font-weight: 700; }
  .lkopf__paket { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 4px 0 0; font-size: 0.92rem; }
  .lkopf__paket a { font-weight: 650; color: var(--accent-ink); text-underline-offset: 3px; }
  .lpaket { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; background: rgb(0 166 161 / 12%); color: var(--dark); font-weight: 650; font-size: 0.85rem; }
  .lpaket :global(.icon) { color: var(--accent-ink); }
  .lpaket--anfrage { background: var(--white); border: 1px dashed var(--line); }
  .lkopf__knopf { margin-top: 10px; }
  @media (max-width: 599px) { .lkopf__knopf { width: 100%; } .lkopf__knopf .btn { width: 100%; } }

  /* Text aus Markdown */
  .ltext-sec { padding-block: clamp(36px, 6vw, 80px); }
  .ltext { max-width: 760px; margin-inline: auto; font-size: 1.05rem; line-height: 1.75; }
  .ltext :global(h2) { font-size: clamp(1.4rem, 3vw, 1.8rem); margin: 1.9em 0 0.6em; overflow-wrap: break-word; }
  .ltext :global(h2:first-child) { margin-top: 0; }
  .ltext :global(p) { margin: 0 0 1em; }
  .ltext :global(ul) { margin: 0 0 1.2em; padding-left: 1.2em; }
  .ltext :global(li) { margin-bottom: 0.5em; }
  .ltext :global(li::marker) { color: var(--accent-ink); }
  .ltext :global(strong) { color: var(--dark); }
  .ltext :global(a) { color: var(--accent-ink); font-weight: 650; text-underline-offset: 3px; }

  .lsec-kopf { max-width: 720px; margin: 0 auto clamp(22px, 4vw, 40px); text-align: center; }
  .lsec-kopf h2 { margin-bottom: 0.4em; overflow-wrap: break-word; }
  .lsec-kopf .lead { margin-inline: auto; }
  .lmehr { margin: 26px 0 0; text-align: center; }
  .lmehr a { font-weight: 650; color: var(--accent-ink); text-underline-offset: 3px; }

  /* Häufige Fragen (Akkordeon wie auf den übrigen Unterseiten) */
  .lfaq { display: grid; gap: 12px; max-width: 820px; margin-inline: auto; }
  .lfaq__item { background: var(--white); border: 1px solid var(--line); border-radius: 14px; }
  .lfaq__item[open] { border-color: var(--dark); }
  .lfaq__item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; min-height: 48px; }
  .lfaq__item summary::-webkit-details-marker { display: none; }
  .lfaq__item summary h3 { margin: 0; font-size: 1.05rem; font-family: var(--font-body); font-weight: 650; letter-spacing: 0; overflow-wrap: break-word; min-width: 0; }
  .lfaq__item summary::after { content: '+'; flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--paper-2); font-size: 1.3rem; }
  .lfaq__item[open] summary::after { content: '–'; background: var(--accent); }
  .lfaq__item p { padding: 0 20px 18px; margin: 0; color: var(--ink-soft); line-height: 1.7; }

  /* Weitere Leistungen derselben Gruppe */
  .landere { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 700px) { .landere { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); } }
  .lkarte { display: grid; gap: 6px; align-content: start; height: 100%; text-decoration: none; color: var(--ink); transition: border-color 0.2s ease, transform 0.2s ease; }
  .lkarte:hover { border-color: var(--accent-ink); transform: translateY(-2px); }
  .lkarte strong { font-family: var(--font-head); font-size: 1.15rem; color: var(--dark); }
  .lkarte__icon { width: 42px; height: 42px; border-radius: 12px; background: var(--dark); color: var(--accent); display: inline-grid; place-items: center; margin-bottom: 4px; }
  .lkarte__kurz { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.6; }
  .lkarte__paket { margin-top: 4px; font-size: 0.82rem; font-weight: 650; color: var(--accent-ink); }
  @media (prefers-reduced-motion: reduce) { .lkarte, .lkarte:hover { transition: none; transform: none; } }

</style>
