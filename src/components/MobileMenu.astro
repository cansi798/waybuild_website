---
// Vollbild-Menü (< 960 px): aufklappbare Gruppen via <details>, scrollbar, iOS-Safe-Area.
import { href } from '../lib/paths';
import { company, phoneTel, whatsappLink, HOURS } from '../config/site';
import { NAV } from '../config/nav';
import Icon from './Icon.astro';
---

<div class="mm" id="mobileMenu">
  <nav aria-label="Mobile Navigation">
    <ul class="mm__list">
      {NAV.map((item) =>
        item.children ? (
          <li>
            <details class="mm__group">
              <summary>{item.label}<Icon name="chevron" size={18} class="mm__chev" /></summary>
              <ul class="mm__sub">
                {item.children.map((c, i) => (
                  <>
                    {c.group && c.group !== item.children![i - 1]?.group && <li class="mm__gh" aria-hidden="true">{c.group}</li>}
                    <li><a href={href(c.path)}>{c.icon && <Icon name={c.icon} size={20} class="mm__icon" />}{c.label}</a></li>
                  </>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li><a class="mm__top" href={href(item.path!)}>{item.label}</a></li>
        ),
      )}
    </ul>
  </nav>

  <div class="mm__footer">
    <a class="btn btn--primary btn--lg mm__cta" href={href('/kontakt/')}>Kostenloses Erstgespräch</a>
    <div class="mm__contact">
      <a class="btn btn--ghost" href={`tel:${phoneTel()}`}><Icon name="phone" size={20} /> {company.phone}</a>
      <a class="btn btn--ghost" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a>
    </div>
    <p class="mm__hours">{HOURS} · Antwort in einem Werktag</p>
  </div>
</div>

<style>
  .mm {
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 49; background: var(--paper);
    overflow-y: auto; -webkit-overflow-scrolling: touch;
    padding: 20px 16px calc(32px + env(safe-area-inset-bottom));
    display: none; flex-direction: column; gap: 24px;
  }
  .mm.open { display: flex; }
  @media (min-width: 960px) { .mm.open { display: none; } }
  .mm__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .mm__top, .mm__group summary {
    display: flex; align-items: center; justify-content: space-between; padding: 14px 6px;
    font-family: var(--font-head); font-weight: 650; font-size: 1.25rem; text-decoration: none;
    border-bottom: 1px solid var(--line); cursor: pointer; list-style: none;
  }
  .mm__group summary::-webkit-details-marker { display: none; }
  .mm__group summary :global(.mm__chev) { transition: transform 0.2s ease; }
  .mm__group[open] summary :global(.mm__chev) { transform: rotate(180deg); }
  .mm__sub { list-style: none; margin: 0; padding: 6px 0 8px 6px; display: grid; gap: 2px; }
  .mm__sub a { display: flex; align-items: center; gap: 12px; padding: 11px 8px; text-decoration: none; border-radius: 10px; color: var(--ink-soft); }
  .mm__sub a:active { background: var(--paper-2); }
  .mm__sub a :global(.mm__icon) { color: var(--accent-ink); flex: none; }
  .mm__gh { padding: 12px 8px 2px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); }
  .mm__footer { display: grid; gap: 14px; margin-top: auto; }
  .mm__cta { width: 100%; }
  .mm__contact { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .mm__contact .btn { font-size: 0.92rem; padding-inline: 0.8em; }
  .mm__hours { text-align: center; margin: 0; font-size: 0.85rem; color: var(--ink-soft); }
</style>
