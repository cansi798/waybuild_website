---
// Problem → Lösung (Jamil, 19.10.2026): typische Schmerzpunkte bei der Website-Erstellung
// und unsere Antwort: eine Sprachnachricht genügt, Anpassungen oft in Minuten.
import { SCHMERZPUNKTE, LOESUNG } from '../config/home';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section class="section" id="weiter" aria-labelledby="schmerz-h">
  <div class="wrap">
    <SectionHead center eyebrow="Kennen Sie das?" pre="Eine Website erstellen ist " accent="mühsam." text="Das hören wir von fast jedem Unternehmen." id="schmerz-h" />
    <ul class="schmerz">
      {SCHMERZPUNKTE.map((p, i) => (
        <li class="schmerz__item reveal" style={`--n: ${i}`}>
          <span class="schmerz__icon"><Icon name={p.icon} size={22} /></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
    <div class="loesung reveal">
      <span class="loesung__icon" aria-hidden="true"><Icon name="mic" size={30} /></span>
      <div>
        <h3 class="loesung__h">{LOESUNG.title}</h3>
        <p>{LOESUNG.text}</p>
        <ul class="loesung__punkte">{LOESUNG.punkte.map((p) => <li><Icon name="check" size={18} /> {p}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  #weiter { scroll-margin-top: var(--header-h); }
  .schmerz { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 640px) { .schmerz { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .schmerz { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; } }
  .schmerz__item { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 18px 18px 16px; transition-delay: calc(var(--n) * 70ms); }
  .schmerz__item h3 { margin: 10px 0 4px; font-size: 1.05rem; }
  .schmerz__item p { margin: 0; font-size: 0.95rem; color: var(--ink-soft); line-height: 1.5; }
  .schmerz__icon { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--paper-2); color: var(--ink-soft); }
  .loesung {
    margin-top: clamp(20px, 3vw, 28px); display: grid; gap: 16px; align-items: start;
    background: var(--dark); color: var(--paper); border-radius: 20px; padding: clamp(20px, 3.5vw, 32px);
  }
  @media (min-width: 720px) { .loesung { grid-template-columns: auto 1fr; gap: 24px; } }
  .loesung__icon { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 16px; background: var(--accent); color: var(--dark); }
  .loesung__h { color: var(--white); font-size: clamp(1.3rem, 2.6vw, 1.7rem); margin: 0 0 6px; }
  .loesung p { margin: 0 0 12px; color: var(--dark-lead); max-width: 62ch; }
  .loesung__punkte { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .loesung__punkte li { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .loesung__punkte :global(.icon) { color: var(--accent); flex: none; }
</style>
