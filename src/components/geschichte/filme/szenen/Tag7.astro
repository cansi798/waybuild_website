---
// Film „Ein Tag im Betrieb“, Szene 7 · 18:00 „Feierabend“ (Jamil, Talk qh87y3sj #5739–#5756, 13.11.2026).
// Handy-Sperrbildschirm am Abend. Phasen (3): 1 Abendstimmung, Uhr 18:00 · 2 „Heute erledigt“ – vier Punkte werden abgehakt ·
// 3 „Kein Papierkram am Abend“. Endzustand = Phase 3. Präfix .gft7.
import FilmRahmen from '../FilmRahmen.astro';
import Handy from '../../../beispiel/geraete/Handy.astro';
const HAKEN = 'M5 12.5l4.5 4.5L19 7.5';
const ERLEDIGT = ['3 Einsätze dokumentiert', '1 Termin automatisch gebucht', '1 Angebot geprüft und verschickt', '1 Rechnung gestellt'];
---

<FilmRahmen kennung="gft7">
  <Handy class="gft7-handy" status={false}>
    <div class="gft7-sperre">
      <span class="gft7-abend"></span>
      <p class="gft7-status"><span>18:00</span><span class="gft7-zeichen"><i></i><i></i></span></p>
      <p class="gft7-mond"><svg viewBox="0 0 24 24"><path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5z" /></svg></p>
      <p class="gft7-uhr">18:00</p>
      <p class="gft7-datum">Donnerstag, 19. November</p>
      <div class="gft7-karte">
        <p class="gft7-ueber">Heute erledigt</p>
        {ERLEDIGT.map((t, i) => (
          <p class={`gft7-punkt gft7-punkt--${i}`}><span class="gf-haken"><svg viewBox="0 0 24 24"><path d={HAKEN} /></svg></span>{t}</p>
        ))}
      </div>
      <p class="gft7-schluss">Kein Papierkram am Abend</p>
      <p class="gft7-tasten"><span><svg viewBox="0 0 24 24"><path d="M9 3h6l-1 6h-4zM10 9h4v12h-4z" /></svg></span><span><svg viewBox="0 0 24 24"><rect x="3.5" y="7" width="17" height="12" rx="2.5" /><circle cx="12" cy="13" r="3.2" /><path d="M9 7l1.5-2.5h3L15 7" /></svg></span></p>
    </div>
  </Handy>
</FilmRahmen>

<style is:global>
  .gft7-sperre { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; padding: calc(10 * var(--px)) var(--bsp-a3) 0; color: var(--bsp-weiss);
    background: radial-gradient(90% 50% at 80% 12%, rgb(0 166 161 / 45%), rgb(0 166 161 / 0%)), linear-gradient(180deg, #0d5a56 0%, #0a3f3d 60%, #082f2e 100%); overflow: hidden; }
  .gft7-abend { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(227 160 8 / 26%) 0%, rgb(196 70 43 / 12%) 45%, rgb(0 0 0 / 0%) 75%); opacity: 1; pointer-events: none; }
  .gft7-sperre > :not(.gft7-abend) { position: relative; }
  .gft7-status { align-self: stretch; display: flex; justify-content: space-between; align-items: center; height: calc(30 * var(--px)); padding: 0 calc(14 * var(--px)); font-size: var(--bsp-schrift-s); font-weight: 600; }
  .gft7-zeichen { display: flex; gap: calc(4 * var(--px)); }
  .gft7-zeichen i { display: block; width: calc(14 * var(--px)); height: calc(8 * var(--px)); border-radius: calc(2 * var(--px)); background: var(--bsp-weiss); opacity: 0.85; }
  .gft7-mond { margin-top: calc(14 * var(--px)) !important; }
  .gft7-mond svg { display: block; width: calc(26 * var(--px)); height: calc(26 * var(--px)); fill: #f6e7c1; }
  .gft7-uhr { margin-top: calc(6 * var(--px)) !important; font-family: var(--font-head); font-size: calc(64 * var(--px)); font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
  .gft7-datum { margin-top: calc(6 * var(--px)) !important; font-size: var(--bsp-schrift-m); opacity: 0.85; }
  .gft7-karte { align-self: stretch; display: flex; flex-direction: column; gap: calc(9 * var(--px)); margin-top: calc(28 * var(--px)); padding: calc(14 * var(--px)); border-radius: calc(18 * var(--px));
    background: rgb(255 255 255 / 95%); color: var(--bsp-text); box-shadow: 0 calc(12 * var(--px)) calc(26 * var(--px)) calc(-10 * var(--px)) rgb(0 20 19 / 55%); }
  .gft7-ueber { font-family: var(--font-head); font-size: var(--bsp-schrift-l); font-weight: 750; letter-spacing: -0.01em; }
  .gft7-punkt { display: flex; align-items: center; gap: var(--bsp-a2); font-size: var(--bsp-schrift-s); font-weight: 600; line-height: 1.3; }
  .gft7-schluss { margin-top: var(--bsp-a4) !important; padding: calc(7 * var(--px)) var(--bsp-a4); border-radius: 99px; background: rgb(255 255 255 / 16%); font-size: var(--bsp-schrift-s); font-weight: 650; }
  .gft7-sperre > .gft7-tasten { position: absolute; left: calc(26 * var(--px)); right: calc(26 * var(--px)); bottom: calc(30 * var(--px)); display: flex; justify-content: space-between; }
  .gft7-tasten span { display: grid; place-items: center; width: calc(40 * var(--px)); height: calc(40 * var(--px)); border-radius: 50%; background: rgb(255 255 255 / 16%); }
  .gft7-tasten svg { width: 50%; height: 50%; fill: none; stroke: var(--bsp-weiss); stroke-width: 1.8; stroke-linejoin: round; }
  .gft7 .gft7-handy .gr-heim { background: var(--bsp-weiss); opacity: 0.8; }

  .gft7-abend { transition: opacity 1.4s ease 0.2s; }
  .gft7-mond, .gft7-uhr, .gft7-datum { transition: opacity var(--bsp-dauer-lang) var(--bsp-ease) 0.3s, transform var(--bsp-dauer-lang) var(--bsp-ease) 0.3s; }
  .gft7-karte, .gft7-schluss { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.2s, transform var(--bsp-dauer) var(--bsp-ease) 0.2s; }
  .gft7-punkt .gf-haken { transition: opacity var(--bsp-dauer-kurz) ease, transform var(--bsp-dauer) var(--bsp-ease-feder); }
  .gft7-punkt--0 .gf-haken { transition-delay: 0.5s; } .gft7-punkt--1 .gf-haken { transition-delay: 0.75s; }
  .gft7-punkt--2 .gf-haken { transition-delay: 1s; } .gft7-punkt--3 .gf-haken { transition-delay: 1.25s; }

  .gft7[data-phase]:not([data-erreicht~="1"]) .gft7-abend { opacity: 0; }
  .gft7[data-phase]:not([data-erreicht~="1"]) :is(.gft7-mond, .gft7-uhr, .gft7-datum) { opacity: 0; transform: translateY(calc(10 * var(--px))); }
  .gft7[data-phase]:not([data-erreicht~="2"]) .gft7-karte { opacity: 0; transform: translateY(calc(20 * var(--px))); }
  .gft7[data-phase]:not([data-erreicht~="2"]) .gft7-punkt .gf-haken { opacity: 0; transform: scale(0.4); }
  .gft7[data-phase]:not([data-erreicht~="3"]) .gft7-schluss { opacity: 0; transform: translateY(calc(10 * var(--px))); }
</style>
