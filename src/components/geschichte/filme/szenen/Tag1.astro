---
// Film „Ein Tag im Betrieb“, Szene 1 · 07:30 „Der Tag ist geplant“ (Jamil, Talk qh87y3sj #5739–#5756, 13.11.2026).
// Handy: Tagesplan – wer fährt wohin. Phasen (3): 1 die drei Einsätze gleiten herein · 2 kleine Karte, Wege werden gezeichnet,
// Stecknadeln erscheinen · 3 Hinweis „Team ist informiert“. Endzustand = Phase 3. Präfix .gft1.
import FilmRahmen from '../FilmRahmen.astro';
import Handy from '../../../beispiel/geraete/Handy.astro';
import { STANDARD } from '../../../beispiel/branchen';
import { werteFilm } from '../daten';
const W = werteFilm(STANDARD);
---

<FilmRahmen kennung="gft1">
  <Handy zeit="7:30">
    <div class="bm-app gft1-app">
      <p class="gf-appkopf"><span class="gf-appkopf__titel">Tagesplan</span><span class="bm-chip">Do 19.11.</span><span class="gf-ich" data-p="kuerzel2">{W.kuerzel2}</span></p>
      <div class="gft1-karte">
        <svg class="gft1-plan" viewBox="0 0 268 120" preserveAspectRatio="xMidYMid slice">
          <rect width="268" height="120" fill="#e6f0ee" />
          <path d="M180 0h88v50c-30 6-60 2-88-12z" fill="#d8ece0" />
          <path d="M-10 84C60 68 120 94 180 72s80-28 100-22" stroke="#fff" stroke-width="8" fill="none" />
          <path d="M66 -10l30 140M184 -10l-26 140" stroke="#fff" stroke-width="5" fill="none" />
          <path class="gft1-weg gft1-weg--1" d="M40 96C70 70 90 60 120 54" stroke="#00807b" stroke-width="3" fill="none" stroke-linecap="round" pathLength="1" />
          <path class="gft1-weg gft1-weg--2" d="M40 96C110 104 170 92 214 40" stroke="#00a6a1" stroke-width="3" fill="none" stroke-linecap="round" pathLength="1" />
        </svg>
        <span class="gft1-pin gft1-pin--start"><i></i></span>
        <span class="gft1-pin gft1-pin--1"><i></i></span>
        <span class="gft1-pin gft1-pin--2"><i></i></span>
      </div>
      <div class="gft1-liste">
        <p class="gft1-zeile gft1-zeile--4"><span class="gft1-wer gft1-wer--4">AY</span><span class="gft1-was"><strong>Ayşe</strong><small>Material abholen · Großhandel</small></span><span class="gft1-zeit">7:45</span></p>
        <p class="gft1-zeile gft1-zeile--1"><span class="gft1-wer">JM</span><span class="gft1-was"><strong>Jonas, Mehmet</strong><small data-p="kundeProjekt">{W.kundeProjekt}</small></span><span class="gft1-zeit">8:00</span></p>
        <p class="gft1-zeile gft1-zeile--2"><span class="gft1-wer gft1-wer--2">LK</span><span class="gft1-was"><strong>Lena</strong><small>Familie Krüger · <span data-p="arbeit0">{W.arbeit0}</span></small></span><span class="gft1-zeit">9:30</span></p>
        <p class="gft1-zeile gft1-zeile--3"><span class="gft1-wer gft1-wer--3">Sie</span><span class="gft1-was"><strong>Sie</strong><small>Büro · Angebote und Termine</small></span><span class="gft1-zeit">13:00</span></p>
      </div>
      <p class="gf-hinweis gft1-hinweis"><span class="gf-haken"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>Team ist informiert, Wege sind auf jedem Handy</p>
    </div>
  </Handy>
</FilmRahmen>

<style is:global>
  .gft1-app { gap: var(--bsp-a3); padding-top: var(--bsp-a2); }
  .gft1-karte { position: relative; flex: none; height: calc(128 * var(--px)); border-radius: var(--bsp-r-l); overflow: hidden; box-shadow: inset 0 0 0 calc(1 * var(--px)) var(--bsp-linie); }
  .gft1-plan { display: block; width: 100%; height: 100%; }
  .gft1-weg { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .gft1-pin { position: absolute; transition: opacity var(--bsp-dauer-kurz) ease, transform var(--bsp-dauer) var(--bsp-ease-feder); }
  .gft1-pin i { display: block; width: calc(16 * var(--px)); height: calc(16 * var(--px)); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--bsp-tinte); box-shadow: 0 0 0 calc(2 * var(--px)) var(--bsp-weiss); }
  .gft1-pin--start { left: 12%; top: 70%; } .gft1-pin--start i { background: var(--bsp-nacht); border-radius: 50%; transform: none; width: calc(12 * var(--px)); height: calc(12 * var(--px)); }
  .gft1-pin--1 { left: 43%; top: 34%; transition-delay: 0.9s; }
  .gft1-pin--2 { left: 78%; top: 20%; transition-delay: 1.2s; } .gft1-pin--2 i { background: var(--bsp-tuerkis); }
  .gft1-liste { display: flex; flex-direction: column; gap: var(--bsp-a2); }
  .gft1-zeile { display: flex; align-items: center; gap: var(--bsp-a2); padding: var(--bsp-a2) var(--bsp-a3); border-radius: var(--bsp-r-m); background: var(--bsp-weiss);
    border: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gft1-wer { flex: none; display: grid; place-items: center; width: calc(32 * var(--px)); height: calc(32 * var(--px)); border-radius: 50%; background: var(--bsp-tinte); color: var(--bsp-weiss);
    font-size: calc(10 * var(--px)); font-weight: 700; }
  .gft1-wer--2 { background: var(--bsp-tuerkis-dunkel); } .gft1-wer--4 { background: #4d6f6c; } .gft1-wer--3 { background: var(--bsp-flaeche); color: var(--bsp-tinte); }
  .gft1-was { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.25; }
  .gft1-was strong { font-size: var(--bsp-schrift-m); font-weight: 700; color: var(--bsp-text); }
  .gft1-was small { font-size: var(--bsp-schrift-xs); color: var(--bsp-text-leise); }
  .gft1-zeit { flex: none; font-size: var(--bsp-schrift-s); font-weight: 700; color: var(--bsp-tinte); font-variant-numeric: tabular-nums; }

  .gft1-zeile, .gft1-hinweis { transition: opacity var(--bsp-dauer) var(--bsp-ease), transform var(--bsp-dauer) var(--bsp-ease); }
  .gft1-zeile--4 { transition-delay: var(--bsp-auftritt); }
  .gft1-zeile--1 { transition-delay: calc(var(--bsp-auftritt) + 1.5 * var(--bsp-versatz)); }
  .gft1-zeile--2 { transition-delay: calc(var(--bsp-auftritt) + 3 * var(--bsp-versatz)); }
  .gft1-zeile--3 { transition-delay: calc(var(--bsp-auftritt) + 4.5 * var(--bsp-versatz)); }
  .gft1-weg { transition: stroke-dashoffset 1.1s cubic-bezier(0.45, 0, 0.2, 1) 0.3s; }
  .gft1-weg--2 { transition-delay: 0.55s; }

  .gft1[data-phase]:not([data-erreicht~="1"]) .gft1-zeile { opacity: 0; transform: translateX(calc(24 * var(--px))); }
  .gft1[data-phase]:not([data-erreicht~="2"]) .gft1-weg { stroke-dashoffset: 1; }
  .gft1[data-phase]:not([data-erreicht~="2"]) .gft1-pin--1, .gft1[data-phase]:not([data-erreicht~="2"]) .gft1-pin--2 { opacity: 0; transform: translateY(calc(-14 * var(--px))); }
  .gft1[data-phase]:not([data-erreicht~="3"]) .gft1-hinweis { opacity: 0; transform: translateY(calc(14 * var(--px))); }
</style>
