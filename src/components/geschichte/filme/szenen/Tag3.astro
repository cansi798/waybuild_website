---
// Film „Ein Tag im Betrieb“, Szene 3 · 11:00 „Neue Anfrage“ (Jamil, Talk qh87y3sj #5739–#5756, 13.11.2026).
// Handy: Kalender der Woche. Phasen (3): 1 Mitteilung „Neue Anfrage · Familie Schneider“ fällt herein · 2 der online gebuchte
// Termin (Art je Branche) gleitet in den Kalender · 3 Hinweis „Bestätigung ist raus“. Endzustand = Phase 3. Präfix .gft3.
import FilmRahmen from '../FilmRahmen.astro';
import Handy from '../../../beispiel/geraete/Handy.astro';
import { STANDARD } from '../../../beispiel/branchen';
import { werteFilm } from '../daten';
const W = werteFilm(STANDARD);
const STUNDEN = ['8:00', '9:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00'];
---

<FilmRahmen kennung="gft3">
  <Handy zeit="11:00">
    <div class="bm-app gft3-app">
      <div class="gft3-mitteilung">
        <span class="gft3-symbol"><svg viewBox="0 0 24 24"><path d="M4 6.5h16v11H4z" /><path d="M4 7l8 6 8-6" /></svg></span>
        <span class="gft3-mtext"><small>Neue Anfrage · jetzt</small><strong>Familie Schneider</strong><span data-p="terminGebucht">{W.terminGebucht}</span></span>
      </div>
      <p class="gf-appkopf"><span class="gf-appkopf__titel">Kalender</span><span class="bm-chip">KW 48</span></p>
      <p class="gft3-tage">{['Mo 23.', 'Di 24.', 'Mi 25.'].map((t, i) => <span class:list={{ 'gft3-tag--an': i === 0 }}>{t}</span>)}</p>
      <div class="gft3-raster">
        {STUNDEN.map((s) => <p class="gft3-stunde"><span>{s}</span><i></i></p>)}
        <span class="gft3-alt gft3-alt--1"></span>
        <span class="gft3-alt gft3-alt--2"></span>
        <span class="gft3-alt gft3-alt--3"></span>
        <span class="gft3-neu"><strong data-p="terminArt">{W.terminArt}</strong><small>Familie Schneider · 10:00</small></span>
      </div>
      <p class="gf-hinweis gft3-hinweis"><span class="gf-haken"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>Termin bestätigt, Erinnerung geht automatisch raus</p>
    </div>
  </Handy>
</FilmRahmen>

<style is:global>
  .gft3-app { position: relative; gap: var(--bsp-a3); padding-top: var(--bsp-a2); }
  .gft3-mitteilung { position: relative; z-index: 3; display: flex; align-items: center; gap: var(--bsp-a3); padding: calc(11 * var(--px)) var(--bsp-a3);
    border-radius: calc(16 * var(--px)); background: rgb(255 255 255 / 97%); box-shadow: 0 calc(12 * var(--px)) calc(26 * var(--px)) calc(-10 * var(--px)) rgb(0 40 38 / 45%);
    border: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gft3-symbol { flex: none; display: grid; place-items: center; width: calc(36 * var(--px)); height: calc(36 * var(--px)); border-radius: calc(9 * var(--px)); background: var(--bsp-tinte); }
  .gft3-symbol svg { width: 60%; height: 60%; fill: none; stroke: var(--bsp-weiss); stroke-width: 2; stroke-linejoin: round; }
  .gft3-mtext { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.25; font-size: var(--bsp-schrift-s); color: var(--bsp-tinte); font-weight: 600; }
  .gft3-mtext small { font-size: var(--bsp-schrift-xs); color: var(--bsp-text-leise); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
  .gft3-mtext strong { font-size: var(--bsp-schrift-m); color: var(--bsp-text); }
  .gft3-tage { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(6 * var(--px)); }
  .gft3-tage span { display: grid; place-items: center; height: calc(30 * var(--px)); border-radius: var(--bsp-r-s); background: var(--bsp-weiss); border: calc(1 * var(--px)) solid var(--bsp-linie-grau);
    font-size: var(--bsp-schrift-s); font-weight: 650; color: var(--bsp-text-leise); }
  .gft3-tage .gft3-tag--an { background: var(--bsp-tinte); border-color: var(--bsp-tinte); color: var(--bsp-weiss); }
  .gft3-raster { position: relative; display: flex; flex-direction: column; }
  .gft3-stunde { display: flex; align-items: center; gap: var(--bsp-a2); height: calc(44 * var(--px)); font-size: var(--bsp-schrift-xs); color: var(--bsp-text-leise); font-variant-numeric: tabular-nums; }
  .gft3-stunde span { width: calc(36 * var(--px)); }
  .gft3-stunde i { flex: 1; height: calc(1 * var(--px)); background: var(--bsp-linie-grau); }
  .gft3-alt, .gft3-neu { position: absolute; left: calc(46 * var(--px)); right: 0; border-radius: var(--bsp-r-s); }
  .gft3-alt { background: var(--bsp-gerippe); }
  .gft3-alt--1 { top: calc(24 * var(--px)); height: calc(62 * var(--px)); }
  .gft3-alt--3 { top: calc(288 * var(--px)); height: calc(40 * var(--px)); }
  .gft3-alt--2 { top: calc(200 * var(--px)); height: calc(62 * var(--px)); }
  .gft3-neu { top: calc(112 * var(--px)); height: calc(62 * var(--px)); display: flex; flex-direction: column; justify-content: center; padding: 0 var(--bsp-a3); background: var(--bsp-flaeche);
    border-left: calc(4 * var(--px)) solid var(--bsp-tuerkis); box-shadow: 0 0 0 calc(2 * var(--px)) rgb(0 166 161 / 35%); line-height: 1.25; }
  .gft3-neu strong { font-size: var(--bsp-schrift-m); color: var(--bsp-text); }
  .gft3-neu small { font-size: var(--bsp-schrift-xs); color: var(--bsp-tinte); font-weight: 600; }

  .gft3-mitteilung { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.4s, transform var(--bsp-dauer) var(--bsp-ease-feder) 0.4s; }
  .gft3-neu { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.35s, transform var(--bsp-dauer) var(--bsp-ease-feder) 0.35s; }
  .gft3-hinweis { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.3s, transform var(--bsp-dauer) var(--bsp-ease) 0.3s; }

  .gft3[data-phase]:not([data-erreicht~="1"]) .gft3-mitteilung { opacity: 0; transform: translateY(calc(-30 * var(--px))) scale(0.95); }
  .gft3[data-phase]:not([data-erreicht~="2"]) .gft3-neu { opacity: 0; transform: translateY(calc(-90 * var(--px))) scale(0.9); }
  .gft3[data-phase]:not([data-erreicht~="3"]) .gft3-hinweis { opacity: 0; transform: translateY(calc(14 * var(--px))); }
</style>
