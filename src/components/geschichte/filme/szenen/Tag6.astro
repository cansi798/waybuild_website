---
// Film „Ein Tag im Betrieb“, Szene 6 · 17:00 „Fertig und abgerechnet“ (Jamil, Talk qh87y3sj #5739–#5756, 13.11.2026).
// Zwei Geräte (format „quer“, Aufbau wie components/beispiel/szenen/Szene05.astro): Handy des Betriebs links vorne, Laptop mit
// dem Kundenportal von Frau Weber rechts dahinter. Phasen (3): 1 Auftrag „Fertig“ ✓ · 2 Tipp auf „Rechnung erstellen“ →
// Rechnung erstellt · 3 im Portal erscheint die Rechnung, alle Schritte abgehakt. Endzustand = Phase 3. Präfix .gft6.
import FilmRahmen from '../FilmRahmen.astro';
import Handy from '../../../beispiel/geraete/Handy.astro';
import Laptop from '../../../beispiel/geraete/Laptop.astro';
import { STANDARD } from '../../../beispiel/branchen';
import { werteFilm } from '../daten';
const W = werteFilm(STANDARD);
const HAKEN = 'M5 12.5l4.5 4.5L19 7.5';
const SCHRITTE = ['Angebot angenommen', 'Termin', 'In Arbeit', 'Fertig', 'Rechnung'];
---

<FilmRahmen kennung="gft6" format="quer">
  <div class="gf-paar">
    <div class="gf-feld">
      <Laptop class="gft6-laptop">
        <div class="gft6-portal">
          <p class="gft6-pkopf"><span class="gft6-zeichen" data-p="kuerzel">{W.kuerzel}</span><span class="gft6-pname" data-p="portalKopf">{W.portalKopf}</span><span class="gft6-ich">FW</span></p>
          <p class="gft6-hallo">Hallo Frau Weber</p>
          <p class="bm-klein" data-p="auftrag">{W.auftrag}</p>
          <ol class="gft6-schritte">
            {SCHRITTE.map((s, i) => (
              <li class={`gft6-schritt gft6-schritt--${i}`}><span class="gft6-punkt"><svg viewBox="0 0 24 24"><path d={HAKEN} /></svg></span><span>{s}</span></li>
            ))}
          </ol>
          <p class="gft6-fotos-titel">Fotos vom Fortschritt</p>
          <p class="gft6-fotos">{['#dcebe8', '#eee3d2', '#e1e9ef', '#e6efdf'].map((f) => <span style={`background:${f}`}><i></i></span>)}</p>
          <div class="gft6-rechnung">
            <span class="gft6-doc"><i></i><i></i><i></i></span>
            <span class="gft6-rtext"><strong>Rechnung RE-1042</strong><small data-p="summeNeu">{W.summeNeu}</small></span>
            <span class="bm-knopf gft6-zahlen">Online bezahlen</span>
          </div>
        </div>
      </Laptop>
      <Handy class="gft6-handy" zeit="17:00">
        <div class="bm-app gft6-app">
          <p class="gft6-ueber">Auftrag</p>
          <p class="gft6-auftrag" data-p="kundeProjekt">{W.kundeProjekt}</p>
          <p class="gft6-fertig"><span class="gf-haken"><svg viewBox="0 0 24 24"><path d={HAKEN} /></svg></span>Fertig · 17:00</p>
          <div class="gft6-werte">
            <p><span>Arbeitszeit</span><strong data-p="tage">{W.tage}</strong></p>
            <p><span>Fotos</span><strong>12</strong></p>
            <p><span>Abnahme</span><strong>Frau Weber ✓</strong></p>
          </div>
          <div class="gft6-knopf">
            <span class="bm-knopf gft6-erstellen">Rechnung erstellen<span class="gf-tipp"></span></span>
            <span class="gft6-erstellt"><span class="gf-haken"><svg viewBox="0 0 24 24"><path d={HAKEN} /></svg></span>Rechnung erstellt und im Portal</span>
          </div>
        </div>
      </Handy>
    </div>
  </div>
</FilmRahmen>

<style is:global>
  .gft6 .gft6-laptop { position: absolute; right: 0; top: 2cqh; --gr-breite: 80cqw; }
  .gft6 .gft6-handy { position: absolute; z-index: 2; left: 2cqw; bottom: 0; --gr-hoehe: 90cqh; }

  /* schmale Fläche (Handy): Laptop oben über die ganze Breite, Handy unten links davor */
  @container (max-aspect-ratio: 1 / 1) {
    .gft6 .gf-feld { width: min(100cqw, 100cqh * 0.8); height: min(100cqh, 100cqw / 0.8); }
    .gft6 .gft6-laptop { top: 0; right: 0; --gr-breite: 100cqw; }
    .gft6 .gft6-handy { left: 6cqw; bottom: 0; --gr-hoehe: 56cqh; }
  }

  /* Portal (Laptop) */
  .gft6-portal { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: var(--bsp-a2); padding: calc(18 * var(--px)) calc(26 * var(--px)) calc(18 * var(--px)) calc(40 * var(--px)); background: var(--bsp-papier); }
  .gft6-pkopf { display: flex; align-items: center; gap: var(--bsp-a2); padding-bottom: var(--bsp-a2); border-bottom: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gft6-zeichen { flex: none; display: grid; place-items: center; width: calc(24 * var(--px)); height: calc(24 * var(--px)); border-radius: calc(7 * var(--px)); background: var(--bsp-tinte);
    color: var(--bsp-weiss); font-family: var(--font-head); font-size: var(--bsp-schrift-xs); font-weight: 750; }
  .gft6-pname { flex: 1; min-width: 0; font-family: var(--font-head); font-size: var(--bsp-schrift-s); font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gft6-ich { flex: none; display: grid; place-items: center; width: calc(24 * var(--px)); height: calc(24 * var(--px)); border-radius: 50%; background: var(--bsp-flaeche); color: var(--bsp-tinte); font-size: calc(9 * var(--px)); font-weight: 700; }
  .gft6-hallo { font-family: var(--font-head); font-size: var(--bsp-schrift-xl); font-weight: 750; letter-spacing: -0.02em; color: var(--bsp-text); }
  .gft6-schritte { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: calc(6 * var(--px)); }
  .gft6-schritt { display: flex; flex-direction: column; align-items: center; gap: calc(4 * var(--px)); text-align: center; font-size: calc(9 * var(--px)); font-weight: 650; color: var(--bsp-text-leise); line-height: 1.2; }
  .gft6-punkt { display: grid; place-items: center; width: calc(22 * var(--px)); height: calc(22 * var(--px)); border-radius: 50%; background: var(--bsp-ok); color: var(--bsp-weiss); }
  .gft6-punkt svg { width: 62%; height: 62%; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .gft6-fotos-titel { margin-top: var(--bsp-a2) !important; font-size: var(--bsp-schrift-s); font-weight: 700; color: var(--bsp-text); }
  .gft6-fotos { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--bsp-a2); }
  .gft6-fotos span { position: relative; height: calc(62 * var(--px)); border-radius: var(--bsp-r-s); overflow: hidden; }
  .gft6-fotos i { position: absolute; left: 22%; top: 22%; width: 34%; height: 40%; border-radius: calc(3 * var(--px)); background: rgb(255 255 255 / 85%); }
  .gft6-werte { display: flex; flex-direction: column; border-radius: var(--bsp-r-m); background: var(--bsp-weiss); border: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gft6-werte p { display: flex; justify-content: space-between; gap: var(--bsp-a2); padding: calc(9 * var(--px)) var(--bsp-a3); font-size: var(--bsp-schrift-s); border-bottom: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gft6-werte p:last-child { border-bottom: 0; }
  .gft6-werte span { color: var(--bsp-text-leise); }
  .gft6-werte strong { font-weight: 650; color: var(--bsp-text); text-align: right; }
  .gft6-rechnung { display: flex; align-items: center; gap: var(--bsp-a3); margin-top: auto; padding: var(--bsp-a3); border-radius: var(--bsp-r-m); background: var(--bsp-weiss);
    border: calc(1 * var(--px)) solid var(--bsp-tuerkis); box-shadow: 0 0 0 calc(3 * var(--px)) rgb(0 166 161 / 16%); }
  .gft6-doc { flex: none; display: flex; flex-direction: column; justify-content: center; gap: calc(4 * var(--px)); width: calc(30 * var(--px)); height: calc(38 * var(--px)); padding: 0 calc(6 * var(--px));
    border-radius: calc(4 * var(--px)); background: var(--bsp-flaeche); }
  .gft6-doc i { display: block; height: calc(3 * var(--px)); border-radius: 2px; background: var(--bsp-tuerkis-dunkel); opacity: 0.6; }
  .gft6-rtext { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.25; }
  .gft6-rtext strong { font-size: var(--bsp-schrift-m); color: var(--bsp-text); }
  .gft6-rtext small { font-size: var(--bsp-schrift-s); font-weight: 650; color: var(--bsp-tinte); }
  .gft6-zahlen { min-height: calc(30 * var(--px)); font-size: var(--bsp-schrift-s); }

  /* Handy des Betriebs */
  .gft6-app { gap: var(--bsp-a3); padding-top: var(--bsp-a4); }
  .gft6-ueber { font-size: var(--bsp-schrift-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bsp-text-leise); }
  .gft6-auftrag { margin-top: calc(-6 * var(--px)) !important; font-family: var(--font-head); font-size: var(--bsp-schrift-xl); font-weight: 750; line-height: 1.15; letter-spacing: -0.02em; color: var(--bsp-text); }
  .gft6-fertig { display: inline-flex; align-items: center; gap: var(--bsp-a2); align-self: flex-start; padding: calc(6 * var(--px)) var(--bsp-a3); border-radius: 99px; background: var(--bsp-ok-flaeche);
    color: var(--bsp-ok); font-weight: 700; }
  .gft6-knopf { display: grid; margin-top: var(--bsp-a2); }
  .gft6-knopf > * { grid-area: 1 / 1; }
  .gft6-erstellen { position: relative; min-height: calc(44 * var(--px)); opacity: 0; }
  .gft6-erstellt { display: flex; align-items: center; gap: var(--bsp-a2); padding: var(--bsp-a3); border-radius: var(--bsp-r-m); background: var(--bsp-nacht); color: var(--bsp-weiss);
    font-size: var(--bsp-schrift-s); font-weight: 650; line-height: 1.3; }
  .gft6-erstellt .gf-haken { background: var(--bsp-tuerkis); }

  .gft6-fertig { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.4s, transform var(--bsp-dauer) var(--bsp-ease-feder) 0.4s; }
  .gft6-erstellen, .gft6-erstellt { transition: opacity var(--bsp-dauer-kurz) ease 0.9s, transform var(--bsp-dauer) var(--bsp-ease-feder) 0.9s; }
  .gft6-rechnung { transition: opacity var(--bsp-dauer) var(--bsp-ease) 0.3s, transform var(--bsp-dauer) var(--bsp-ease) 0.3s; }
  .gft6-punkt { transition: background-color 0.3s ease, transform var(--bsp-dauer) var(--bsp-ease-feder); }
  .gft6-schritt--3 .gft6-punkt { transition-delay: 0.5s; } .gft6-schritt--4 .gft6-punkt { transition-delay: 0.5s; }

  .gft6[data-phase]:not([data-erreicht~="1"]) .gft6-fertig { opacity: 0; transform: scale(0.85); }
  .gft6[data-phase]:not([data-erreicht~="2"]) .gft6-erstellen { opacity: 1; transition-delay: 0s; }
  .gft6[data-phase]:not([data-erreicht~="2"]) .gft6-erstellt { opacity: 0; transform: translateY(calc(8 * var(--px))); transition-delay: 0s; }
  .gft6[data-aktiv][data-phase="2"] .gft6-erstellen { animation: gf-druck 0.3s ease-in-out 0.5s both; }
  .gft6[data-aktiv][data-phase="2"] .gft6-erstellen .gf-tipp { animation: gf-tippen 0.75s var(--bsp-ease) 0.5s both; }
  .gft6[data-phase]:not([data-erreicht~="1"]) .gft6-schritt--3 .gft6-punkt,
  .gft6[data-phase]:not([data-erreicht~="3"]) .gft6-schritt--4 .gft6-punkt { background: var(--bsp-gerippe); transform: scale(0.85); }
  .gft6[data-phase]:not([data-erreicht~="3"]) .gft6-rechnung { opacity: 0; transform: translateY(calc(16 * var(--px))); }
</style>
