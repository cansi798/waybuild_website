---
// Film „Ich brauche eine Website“, Szene 4 „Ein Tipp genügt“ (Jamil, Talk qh87y3sj #5739–#5756, 13.11.2026).
// Handy: unten auf der Website „Anfrage“ und „WhatsApp“. Phasen (3): 1 Tipp auf „Anfrage“ · 2 kurzes Formular gleitet hoch,
// alles schon ausgefüllt · 3 „Anfrage senden“ → „Gesendet“ mit Haken. WhatsApp nur als Wort und neutrales Sprechblasen-Zeichen
// (kein Logo). Endzustand = Phase 3. Präfix .gfw4.
import FilmRahmen from '../FilmRahmen.astro';
import Handy from '../../../beispiel/geraete/Handy.astro';
import { STANDARD } from '../../../beispiel/branchen';
import { werteFilm } from '../daten';
const W = werteFilm(STANDARD);
const HAKEN = '<path d="M5 12.5l4.5 4.5L19 7.5" />';
---

<FilmRahmen kennung="gfw4">
  <Handy zeit="10:26">
    <div class="gfw4-seite">
      <!-- Website im Hintergrund (abgedunkelt, sobald das Formular kommt) -->
      <div class="gfw4-hinten">
        <p class="gfw4-kopf"><span class="gfw4-zeichen" data-p="kuerzel">{W.kuerzel}</span><span class="gfw4-name" data-p="firma">{W.firma}</span></p>
        <p class="gfw4-h1"><span data-p="held1">{W.held1}</span><br /><span data-p="held2">{W.held2}</span></p>
        <span class="bm-balken bm-balken--lang"></span><span class="bm-balken bm-balken--mittel"></span>
        <span class="gfw4-flaeche"></span>
        <span class="bm-balken bm-balken--lang"></span><span class="bm-balken bm-balken--kurz"></span>
      </div>
      <span class="gfw4-dunkel"></span>
      <!-- feste Leiste unten -->
      <div class="gfw4-leiste">
        <span class="bm-knopf gfw4-anfrage">Anfrage<span class="gf-tipp"></span></span>
        <span class="bm-knopf bm-knopf--hell gfw4-wa"><svg viewBox="0 0 24 24"><path d="M5 18.5l1.2-3.6A7.5 7.5 0 1 1 9 18z" /></svg>WhatsApp</span>
      </div>
      <!-- Formular -->
      <div class="gfw4-blatt">
        <span class="gfw4-griff"></span>
        <p class="gfw4-blatt__titel">Ihre Anfrage</p>
        <p class="bm-klein">an <span data-p="firma">{W.firma}</span></p>
        <p class="gfw4-feld"><span>Worum geht es?</span><strong data-p="leistung">{W.leistung}</strong></p>
        <p class="gfw4-feld"><span>Name</span><strong>Frau Weber</strong></p>
        <p class="gfw4-feld gfw4-feld--text"><span>Nachricht</span><strong>Hallo, ich hätte gern ein Angebot. Wann passt es Ihnen?</strong></p>
        <p class="gfw4-senden">
          <span class="bm-knopf gfw4-senden__knopf">Anfrage senden<span class="gf-tipp"></span></span>
          <span class="gfw4-gesendet"><span class="gf-haken"><svg viewBox="0 0 24 24" set:html={HAKEN} /></span>Gesendet</span>
        </p>
      </div>
    </div>
  </Handy>
</FilmRahmen>

<style is:global>
  .gfw4-seite { position: relative; flex: 1; min-height: 0; overflow: hidden; background: var(--bsp-weiss); }
  .gfw4-hinten { display: flex; flex-direction: column; gap: var(--bsp-a2); padding: var(--bsp-a2) var(--bsp-a4); }
  .gfw4-kopf { display: flex; align-items: center; gap: var(--bsp-a2); padding-bottom: var(--bsp-a2); margin-bottom: var(--bsp-a2) !important; border-bottom: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gfw4-zeichen { flex: none; display: grid; place-items: center; width: calc(28 * var(--px)); height: calc(28 * var(--px)); border-radius: calc(8 * var(--px)); background: var(--bsp-tinte);
    color: var(--bsp-weiss); font-family: var(--font-head); font-size: var(--bsp-schrift-s); font-weight: 750; }
  .gfw4-name { font-family: var(--font-head); font-size: var(--bsp-schrift-m); font-weight: 750; line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gfw4-h1 { margin-bottom: var(--bsp-a2) !important; font-family: var(--font-head); font-size: var(--bsp-schrift-xxl); font-weight: 750; line-height: 1.08; letter-spacing: -0.02em; }
  .gfw4-flaeche { display: block; height: calc(140 * var(--px)); margin: var(--bsp-a2) 0; border-radius: var(--bsp-r-l); background: linear-gradient(160deg, #d9ece8, #efe4d3); }
  .gfw4-dunkel { position: absolute; inset: 0; z-index: 2; background: rgb(0 40 38 / 38%); opacity: 1; }
  .gfw4-leiste { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; display: flex; gap: var(--bsp-a2); padding: var(--bsp-a3) var(--bsp-a4) calc(26 * var(--px));
    background: rgb(255 255 255 / 96%); border-top: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gfw4-leiste .bm-knopf { position: relative; flex: 1; min-height: calc(42 * var(--px)); }
  .gfw4-wa svg { width: calc(16 * var(--px)); height: calc(16 * var(--px)); fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
  .gfw4-blatt { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: var(--bsp-a2); padding: var(--bsp-a2) var(--bsp-a4) calc(28 * var(--px));
    border-radius: calc(20 * var(--px)) calc(20 * var(--px)) 0 0; background: var(--bsp-papier); box-shadow: 0 calc(-12 * var(--px)) calc(30 * var(--px)) calc(-12 * var(--px)) rgb(0 40 38 / 40%); }
  .gfw4-griff { align-self: center; width: calc(40 * var(--px)); height: calc(4 * var(--px)); border-radius: 99px; background: var(--bsp-linie-grau); }
  .gfw4-blatt__titel { font-family: var(--font-head); font-size: var(--bsp-schrift-xl); font-weight: 750; letter-spacing: -0.02em; color: var(--bsp-text); }
  .gfw4-feld { display: flex; flex-direction: column; gap: calc(2 * var(--px)); padding: var(--bsp-a2) var(--bsp-a3); border-radius: var(--bsp-r-m); background: var(--bsp-weiss);
    border: calc(1 * var(--px)) solid var(--bsp-linie-grau); }
  .gfw4-feld span { font-size: var(--bsp-schrift-xs); color: var(--bsp-text-leise); }
  .gfw4-feld strong { font-size: var(--bsp-schrift-m); font-weight: 600; color: var(--bsp-text); line-height: 1.3; }
  .gfw4-feld--text strong { font-weight: 500; }
  .gfw4-senden { position: relative; display: grid; margin-top: var(--bsp-a1) !important; }
  .gfw4-senden > * { grid-area: 1 / 1; }
  .gfw4-senden__knopf { position: relative; min-height: calc(42 * var(--px)); opacity: 0; }
  .gfw4-gesendet { display: inline-flex; align-items: center; justify-content: center; gap: var(--bsp-a2); min-height: calc(42 * var(--px)); border-radius: 99px; background: var(--bsp-ok-flaeche);
    color: var(--bsp-ok); font-weight: 700; }

  .gfw4-dunkel { transition: opacity var(--bsp-dauer) var(--bsp-ease); }
  .gfw4-blatt { transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .gfw4-senden__knopf, .gfw4-gesendet { transition: opacity var(--bsp-dauer-kurz) ease 1s, transform var(--bsp-dauer) var(--bsp-ease-feder) 1s; }

  .gfw4[data-phase]:not([data-erreicht~="2"]) .gfw4-dunkel { opacity: 0; }
  .gfw4[data-phase]:not([data-erreicht~="2"]) .gfw4-blatt { transform: translateY(105%); }
  .gfw4[data-aktiv][data-phase="1"] .gfw4-anfrage { animation: gf-druck 0.3s ease-in-out 0.9s both; }
  .gfw4[data-aktiv][data-phase="1"] .gfw4-anfrage .gf-tipp { animation: gf-tippen 0.75s var(--bsp-ease) 0.9s both; }
  .gfw4[data-phase]:not([data-erreicht~="3"]) .gfw4-senden__knopf { opacity: 1; transition-delay: 0s; }
  .gfw4[data-phase]:not([data-erreicht~="3"]) .gfw4-gesendet { opacity: 0; transform: scale(0.9); transition-delay: 0s; }
  .gfw4[data-aktiv][data-phase="3"] .gfw4-senden__knopf { animation: gf-druck 0.3s ease-in-out 0.6s both; }
  .gfw4[data-aktiv][data-phase="3"] .gfw4-senden__knopf .gf-tipp { animation: gf-tippen 0.75s var(--bsp-ease) 0.6s both; }
</style>
