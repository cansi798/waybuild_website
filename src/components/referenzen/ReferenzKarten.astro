---
// Referenzen-Karten „Beispiele aus unserer Arbeit“ als gemeinsame Komponente (Jamil, Talk qh87y3sj #5288, 09.11.2026):
// Leistungsseite /leistungen/website/ und /beispiele/ (Bereich „Websites“); auf der Startseite seit 09.11.2026 entfernt (Jamil #5322).
// Daten: REFERENZEN in src/config/startseite.ts (Regeln dort: nur Belegtes, Link nur bei status 'online').
// Karte: Bild der Kunden-Website oben, darunter Name, Branche · Ort, Ausgangslage/Umsetzung/Ergebnis.
// `ebene` = Überschriftenebene der Kartentitel (Standard h3 unter einer h2-Abschnittsüberschrift).
import Bild from '../Bild.astro';
import { REFERENZEN, type Referenz } from '../../config/startseite';
import '../../styles/referenzen.css';

interface Props { liste?: Referenz[]; messung?: boolean; ebene?: 'h2' | 'h3' }
const { liste = REFERENZEN.liste, messung = true, ebene = 'h3' } = Astro.props;
const Titel = ebene;

// Symbol in der stilisierten Vorschau (nur für Karten ohne Name/Bild)
const MOTIV: Record<string, string> = {
  bad: '<rect x="0" y="34" width="86" height="34" rx="12" fill="#7fd0cc"/><path d="M14 34 V12 a10 10 0 0 1 20 0" fill="none" stroke="#004f4c" stroke-width="5" stroke-linecap="round"/><circle cx="34" cy="20" r="4" fill="#00a6a1"/>',
  lack: '<rect x="8" y="8" width="34" height="58" rx="8" fill="#004f4c"/><rect x="16" y="0" width="18" height="12" rx="3" fill="#7fd0cc"/><circle cx="62" cy="22" r="7" fill="#00a6a1"/><circle cx="74" cy="40" r="5" fill="#00a6a1" opacity="0.7"/><circle cx="62" cy="54" r="4" fill="#00a6a1" opacity="0.5"/>',
  sprache: '<rect x="0" y="6" width="54" height="36" rx="10" fill="#004f4c"/><path d="M12 42 l0 12 l12 -12" fill="#004f4c"/><rect x="34" y="30" width="54" height="36" rx="10" fill="#7fd0cc"/><path d="M76 66 l0 10 l-10 -10" fill="#7fd0cc"/>',
  film: '<rect x="0" y="14" width="62" height="46" rx="8" fill="#004f4c"/><path d="M62 30 L88 16 V58 L62 44 Z" fill="#7fd0cc"/><circle cx="22" cy="37" r="9" fill="#00a6a1"/>',
  wissen: '<circle cx="44" cy="28" r="22" fill="#00a6a1"/><rect x="34" y="50" width="20" height="12" rx="3" fill="#004f4c"/><path d="M36 28 l6 6 l10 -12" fill="none" stroke="#004f4c" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<ul class="refs4">
  {liste.map((r, i) => (
    <li class="ref4 reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
      <div class:list={['ref4__bild', `ref4__bild--${r.motiv}`]}>
        {r.name && r.bild
          ? <Bild name={r.bild} alt={`Startseite der Website von ${r.name}${r.status === 'vorschau' ? ' (Vorschau)' : ''}`} widths={[400, 800]} sizes="(min-width: 1100px) 360px, (min-width: 700px) 46vw, calc(100vw - 72px)" class="ref4__img" />
          : (
            <svg viewBox="0 0 320 200" focusable="false" aria-hidden="true">
              <rect x="0" y="0" width="320" height="200" rx="14" fill="#ffffff" />
              <rect x="0" y="0" width="320" height="24" rx="14" fill="#efebe3" /><rect x="0" y="12" width="320" height="12" fill="#efebe3" />
              <circle cx="16" cy="12" r="4" fill="#cdc6ba" /><circle cx="30" cy="12" r="4" fill="#cdc6ba" /><circle cx="44" cy="12" r="4" fill="#cdc6ba" />
              <rect x="22" y="46" width="130" height="14" rx="7" fill="#004f4c" /><rect x="22" y="70" width="110" height="9" rx="4.5" fill="#cdc6ba" /><rect x="22" y="86" width="90" height="9" rx="4.5" fill="#cdc6ba" />
              <rect x="22" y="110" width="74" height="22" rx="11" fill="#7fd0cc" />
              <rect x="22" y="152" width="80" height="30" rx="8" fill="#f7f5f0" /><rect x="112" y="152" width="80" height="30" rx="8" fill="#f7f5f0" /><rect x="202" y="152" width="96" height="30" rx="8" fill="#f7f5f0" />
              <g transform="translate(212 40)" set:html={MOTIV[r.motiv] ?? ''} />
            </svg>
          )}
        <span class:list={['ref4__etikett', `ref4__etikett--${r.status}`]}>{REFERENZEN.etikett[r.status]}</span>
      </div>
      <div class="ref4__inhalt">
        <Titel class="ref4__titel">{r.name ?? r.branche}</Titel>
        <p class="ref4__branche">{r.name ? r.branche : ''}{r.name && r.ort ? ' · ' : ''}{r.ort}</p>
        <dl class="ref4__fakten">
          <div><dt>Ausgangslage</dt><dd>{r.ausgang}</dd></div>
          <div><dt>Umsetzung</dt><dd>{r.gemacht}</dd></div>
          {r.ergebnis && <div class="ref4__ergebnis"><dt>Ergebnis</dt><dd>{r.ergebnis}</dd></div>}
        </dl>
        {r.status === 'online' && r.url && (
          <a class="ref4__link" href={r.url} target="_blank" rel="noopener">Website ansehen<span class="ref4__url">{r.urlText ?? r.url}</span><span class="sr-only"> (öffnet in neuem Tab)</span></a>
        )}
      </div>
    </li>
  ))}
</ul>
{messung && <p class="ref4__messung">{REFERENZEN.messung}</p>}
