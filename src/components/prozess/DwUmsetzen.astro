---
// waybuild Website (Jamil Talk 4487/4488, 03.11.): aus der Hauptseite übernommen, Ergebnis heißt hier „Ihre Website“.
// Szene „Umsetzen“ (Talk 4050/4091/4093/4109): Drei Erkenntnisse (Lupe, Glühbirne, Ziel) stehen in einer Reihe rechts
// neben dem Knoten, bleiben eine Weile stehen und fließen dann nacheinander hinein (das nächste zuerst). Der Knoten ist so
// groß wie die Lupe bei „Verstehen“ und trägt ein Funkeln (Erkenntnis). Danach läuft die Linie in eine allgemeine
// „Lösung“: Bausteine schieben sich zu einem fertigen Ganzen zusammen (kein Produktname). Ohne JS / reduzierte
// Bewegung: fertiges Bild.
// Talk 4326 („länger sichtbar“ + „Symbole beschreiben, damit jeder versteht“): Die drei Erkenntnisse stehen jetzt
// beschriftet untereinander rechts vom Knoten (Analyse, Ideen, Ziele), schon wenn sie unten ins Bild kommen. Ab 0.6
// fließt je eine Kopie des Symbols in den Knoten; Symbol und Wort blenden dabei aus (Talk 4465: verschwinden wie vorher). Lösung danach (bis 1.4).
import Icon from '../Icon.astro';
import { DW_UMSETZEN } from '../../config/prozess';
const W = 440, H = 460, CX = 220, KY = 124;
// Lösung: Rahmen mit vier Bausteinen (2 × 2); tiefer als vorher, damit die beschrifteten Erkenntnisse darüber Platz haben
const FX = 145, FY = 216, FS = 150, PAD = 10, GAP = 10, BS = (FS - 2 * PAD - GAP) / 2;
const f = (n: number) => n.toFixed(3);
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
// Bedeutung aus der Geschichte der Seite: Lupe = was wir beim Verstehen genau angesehen haben, Glühbirne = Ideen
// (wie bei Impuls), Zielscheibe = Ziele (wie bei Verstehen)
const SX = 300, ABST = 50, FL = 0.6, FS2 = 0.1;
const erkenntnisse = [
  { icon: 'search', wort: 'Analyse' },
  { icon: 'idee', wort: 'Ideen' },
  { icon: 'target', wort: 'Ziele' },
].map((e, k) => {
  const y = KY + (k - 1) * ABST;
  return {
    ...e, k, y, ox: f(((SX - CX) / W) * 100), oy: f(((y - KY) / W) * 100),
    an: `auf:sicht daempfen:${f(FL + k * FS2)}-${f(FL + 0.03 + k * FS2)}:0`,
    wortAn: `auf:sicht daempfen:${f(FL + k * FS2)}-${f(FL + 0.08 + k * FS2)}:0`,
    geist: `blende:${f(FL + k * FS2)}-${f(FL + 0.01 + k * FS2)} fliessen:${f(FL + k * FS2)}-${f(FL + 0.13 + k * FS2)}`,
  };
});
const VOLL = FL + 2 * FS2 + 0.13;   // alle Kopien im Knoten (0.93)
const bausteine = [
  { x: FX + PAD, y: FY + PAD, von: 'links' },
  { x: FX + PAD + BS + GAP, y: FY + PAD, von: 'rechts' },
  { x: FX + PAD, y: FY + PAD + BS + GAP, von: 'links' },
  { x: FX + PAD + BS + GAP, y: FY + PAD + BS + GAP, von: 'rechts', akzent: true },
].map((b, k) => ({ ...b, k }));
const rahmen = `M ${CX} ${FY} H ${FX + FS - 14} A 14 14 0 0 1 ${FX + FS} ${FY + 14} V ${FY + FS - 14} A 14 14 0 0 1 ${FX + FS - 14} ${FY + FS} H ${FX + 14} A 14 14 0 0 1 ${FX} ${FY + FS - 14} V ${FY + 14} A 14 14 0 0 1 ${FX + 14} ${FY} Z`;
---
<div class="dw-bild dw-umsetzen" data-szene data-bereich="-0.7 1.4" data-tempo="0.7" style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <path class="dw-s" pathLength="1" d={`M ${CX} ${KY} L ${CX} ${FY}`} data-an={`zeichnen:${f(VOLL + 0.02)}-${f(VOLL + 0.06)}`} />
    <rect class="dw-umsetzen__flaeche" x={FX} y={FY} width={FS} height={FS} rx="14" data-an={`blende:${f(VOLL + 0.05)}-${f(VOLL + 0.1)}`} />
    <path class="dw-s" pathLength="1" d={rahmen} data-an={`zeichnen:${f(VOLL + 0.05)}-${f(VOLL + 0.14)}`} />
    {bausteine.map((b) => <rect class:list={['dw-umsetzen__baustein', { 'dw-umsetzen__baustein--knopf': b.akzent }]} x={b.x} y={b.y} width={BS} height={BS} rx="8" data-an={`${b.von}:${f(VOLL + 0.09 + b.k * 0.03)}-${f(VOLL + 0.15 + b.k * 0.03)}`} />)}
    <path class="dw-s" pathLength="1" d={`M ${CX} ${FY + FS} L ${CX} ${H}`} data-an={`zeichnen:${f(VOLL + 0.2)}-${f(VOLL + 0.26)}`} />
  </svg>

  {/* Kopien der Symbole, die in den Knoten fließen: zuerst im DOM, also unter den stehenden Einträgen */}
  {erkenntnisse.map((e) => (
    <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(KY, H)}`} aria-hidden="true">
      <span class="dw-umsetzen__erkenntnis dw-geist" style={`--ox:${e.ox};--oy:${e.oy}`} data-an={e.geist}><Icon name={e.icon as any} size={16} /></span>
    </span>
  ))}
  {/* Beschriftete Erkenntnisse: Symbolmitte bei SX, Wort rechts daneben */}
  <ul class="dw-umsetzen__liste" aria-label="Erkenntnisse">
    {erkenntnisse.map((e) => (
      <li class="dw-pos dw-pos--rechts" style={`left:calc(${pc(SX, W)} - 17px);top:${pc(e.y, H)}`}>
        <span class="dw-umsetzen__eintrag"><span class="dw-umsetzen__symbol" aria-hidden="true" data-an={e.an}><Icon name={e.icon as any} size={16} /></span><span class="dw-umsetzen__wort" data-an={e.wortAn}>{e.wort}</span></span>
      </li>
    ))}
  </ul>
  {/* Knoten „Erkenntnisse“: so groß wie die Lupe bei „Verstehen“, teilt sich wie alle Kreise */}
  <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(KY, H)}`}>
    <span class="dw-verstehen__kreis">
      <svg class="dw-verstehen__ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 0 50 98.5" data-an="linear:0.16-0.26" />
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 1 50 98.5" data-an="linear:0.16-0.26" />
      </svg>
      <span class="dw-verstehen__fuell" data-an={`blende:${f(VOLL - 0.06)}-${f(VOLL + 0.02)}`}></span>
      <span class="dw-verstehen__lupe" data-an="blende:0.2-0.28"><Icon name="spark" size={22} /></span>
      <span class="dw-anker" style="left:50%;top:0" data-weg="ein"></span>
    </span>
  </span>
  {/* „aus“ steht nach dem Kreis-Anker „ein“: Wegpunkte zählen in Dokument-Reihenfolge */}
  <span class="dw-anker" style={`left:${pc(CX, W)};top:100%`} data-weg="aus"></span>
  <span class="dw-pos dw-pos--links" style={`left:calc(${pc(CX, W)} - 38px);top:${pc(KY, H)}`}>
    <span class="dw-umsetzen__notiz" data-an="auf:0.2-0.3">Erkenntnisse</span>
  </span>
  <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(FY + FS + 30, H)}`}>
    <span class="dw-umsetzen__ergebnis" data-an={`auf:${f(VOLL + 0.18)}-${f(VOLL + 0.25)}`}><Icon name="check" size={18} /> {DW_UMSETZEN.ergebnis}</span>
  </span>
</div>
