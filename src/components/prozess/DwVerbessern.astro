---
// waybuild Website (Jamil Talk 4487/4488, 03.11.2026): unverändert aus der waybuild Hauptseite übernommen (src/components/dw/).
// Szene „Verbessern“ (Jamil, Talk 3920/4094/4113): Die Linie läuft mittig auf den Kreis zu, teilt sich am oberen
// Scheitel in zwei Äste, die den Kreis zeichnen und sich unten wieder treffen – dort endet die Scroll-Linie (Talk 4083/
// 4096). Ist der Kreis geschlossen (ist-zu, per data-zu), erscheinen zwischen Feedback, Analysieren, Planen und
// Verbessern Pfeile, die seit Talk 4141 langsam im Uhrzeigersinn auf der Kreislinie wandern und hinter den Begriffen
// kurz verschwinden (nur im Bild). Kein Lichtschimmer mehr (4113).
// Ohne JS / reduzierte Bewegung: geschlossener Kreis mit Pfeilen.
import { DW_VERBESSERN as T } from '../../config/prozess';
const W = 440, H = 300, CX = 220, CY = 200, R = 84;   // Talk 4113: etwas kleiner (vorher 96, davor 120)
// Laufrichtung der Pfeile und des Lichtpunkts: +1 = im Uhrzeigersinn (Optimieren → Lernen → Feedback →
// Weiterentwickeln → Optimieren; Jamil, Talk 3932), -1 = gegen den Uhrzeigersinn.
const RICHTUNG: 1 | -1 = 1;
// Szenen-Fortschritt (Talk 3929 schneller): Zulauf 0–0.12, Teilung + beide Äste 0.12–0.42, geschlossen ab 0.42,
// Weiterlauf bis 0.6
const TEIL = 0.12, ZU = 0.42;
const oben = CY - R, unten = CY + R;
// Winkel ab 12 Uhr im Uhrzeigersinn: Optimieren 0°, Lernen 90°, Feedback 180°, Weiterentwickeln 270°
const punkt = (grad: number, r = R) => { const a = (grad * Math.PI) / 180; return { x: CX + r * Math.sin(a), y: CY - r * Math.cos(a) }; };
const punkte = [
  { t: T.kreis[0], grad: 0, an: `${(TEIL - 0.04).toFixed(2)}-${(TEIL + 0.03).toFixed(2)}` },
  { t: T.kreis[1], grad: 90, an: `${((TEIL + ZU) / 2 - 0.04).toFixed(2)}-${((TEIL + ZU) / 2 + 0.02).toFixed(2)}` },
  { t: T.kreis[2], grad: 180, an: `${(ZU - 0.04).toFixed(2)}-${(ZU + 0.01).toFixed(2)}` },
  { t: T.kreis[3], grad: 270, an: `${((TEIL + ZU) / 2 - 0.04).toFixed(2)}-${((TEIL + ZU) / 2 + 0.02).toFixed(2)}` },
].map((p) => ({ ...p, ...punkt(p.grad) }));
// Pfeile zwischen den Begriffen (45°, 135°, 225°, 315°), Spitze in Laufrichtung; gezeichnet bei 12 Uhr, dann gedreht
const pfeilD = `M ${CX - 5 * RICHTUNG} ${oben - 7} L ${CX + 3 * RICHTUNG} ${oben} L ${CX - 5 * RICHTUNG} ${oben + 7}`;
const pfeile = [45, 135, 225, 315].map((grad, i) => ({ grad, i }));
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
---
<div class="dw-bild dw-kreis" data-szene data-zu={ZU} style={`aspect-ratio: ${W} / ${H}; --dw-r: ${RICHTUNG}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <path class="dw-s" pathLength="1" d={`M ${CX} 0 L ${CX} ${oben}`} data-an={`linear:0-${TEIL}`} />
    <path class="dw-s" pathLength="1" d={`M ${CX} ${oben} A ${R} ${R} 0 0 0 ${CX} ${unten}`} data-an={`linear:${TEIL}-${ZU}`} />
    <path class="dw-s" pathLength="1" d={`M ${CX} ${oben} A ${R} ${R} 0 0 1 ${CX} ${unten}`} data-an={`linear:${TEIL}-${ZU}`} />
    {/* Talk 4083/4096: die Scroll-Linie endet hier direkt am Kreis (kein Auslauf, kein Endpunkt) */}
    <circle class="dw-kreis__ring" cx={CX} cy={CY} r={R} />
    {/* Talk 4141: die Pfeilgruppe dreht sich langsam im Uhrzeigersinn um die Kreismitte (CSS .dw-kreis__dreh) */}
    <g class="dw-kreis__dreh" style={`--kx:${CX}px;--ky:${CY}px`}>
      {pfeile.map((p) => (
        <g transform={`rotate(${p.grad} ${CX} ${CY})`}>
          <g class="dw-pfeil" style={`--i:${p.i}`}><path d={pfeilD} /></g>
        </g>
      ))}
    </g>
  </svg>
  <span class="dw-anker" style="left:50%;top:0%" data-weg="ein"></span>
  {punkte.map((p) => (
    <span class="dw-pos" style={`left:${pc(p.x, W)};top:${pc(p.y, H)}`}>
      <span class="dw-chip dw-chip--auf-linie" data-an={`auf:${p.an}`}>{p.t}</span>
    </span>
  ))}
</div>
