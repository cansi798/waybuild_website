---
// waybuild Website (Jamil Talk 4487/4488, 03.11.2026): unverändert aus der waybuild Hauptseite übernommen (src/components/dw/).
// Szene „Entscheiden“ (Jamil, Talk 4022): Die drei Wege aus dem Hinterfragen laufen nebeneinander (parallel) aus der
// Linie. Bei jedem wachsen Nutzen und Aufwand, dann bekommen sie eine Reihenfolge. Der Weg mit dem meisten Nutzen und
// dem wenigsten Aufwand (rang 1, in der Mitte) wird türkis, bekommt einen Haken und „Zuerst“; dort läuft die Linie
// weiter, die anderen beiden treten zurück. Ab data-zu (Entscheidung) setzt denkweise.ts ist-zu.
// Ohne JS / reduzierte Bewegung: fertiger Zustand.
import Icon from '../Icon.astro';
import { DW_ENTSCHEIDEN as T } from '../../config/prozess';
const W = 440, H = 440, CX = 220, TEIL = 40, KOPF = 104, ZU = 0.58, HAKEN = 296;
// Die Linie läuft hinter der gewählten Spalte (Papier-Hintergrund) weiter und tritt unter ihr wieder hervor
const WEITER = KOPF;
const SPALTEN = [76, 220, 364];
// rang 1 in die Mitte, die anderen in Config-Reihenfolge links und rechts
const erste = T.optionen.find((o) => o.rang === 1)!;
const rest = T.optionen.filter((o) => o !== erste);
const o = [rest[0], erste, rest[1]].map((x, k) => ({ ...x, k, x: SPALTEN[k], wahl: x === erste }));
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
const f = (n: number) => n.toFixed(2);
const ast = (x: number) => x === CX ? `M ${CX} ${TEIL} L ${CX} ${KOPF}` : `M ${CX} ${TEIL} C ${CX} ${TEIL + 34}, ${x} ${KOPF - 44}, ${x} ${KOPF}`;
---
<div class="dw-bild dw-wahlbild" data-szene data-zu={ZU} style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <path class="dw-s" pathLength="1" d={`M ${CX} 0 L ${CX} ${TEIL}`} data-an="linear:0-0.08" />
    {o.map((x) => <path class="dw-s" pathLength="1" d={ast(x.x)} data-an={`zeichnen:0.08-0.2${x.wahl ? '' : ` aus:${f(ZU + 0.02)}-${f(ZU + 0.12)}:0.3`}`} />)}
    <path class="dw-s" pathLength="1" d={`M ${CX} ${WEITER} L ${CX} ${H}`} data-an={`linear:${f(ZU + 0.04)}-0.94`} />
    <circle class="dw-knoten" cx={CX} cy={TEIL} r="6" data-an="erscheinen:0.06-0.12" />
  </svg>
  <span class="dw-anker" style={`left:${pc(CX, W)};top:0%`} data-weg="ein"></span>
  <span class="dw-anker" style={`left:${pc(CX, W)};top:100%`} data-weg="aus"></span>
  {o.map((x) => (
    <span class="dw-pos dw-pos--spalte" style={`left:${pc(x.x, W)};top:${pc(KOPF, H)}`}>
      <span class:list={['dw-wahl', { 'dw-wahl--gewaehlt': x.wahl }]} data-an={`auf:${f(0.14 + x.k * 0.03)}-${f(0.24 + x.k * 0.03)}${x.wahl ? '' : ` aus:${f(ZU + 0.02)}-${f(ZU + 0.14)}:0.45`}`}>
        <span class="dw-wahl__rang" data-an={`erscheinen:${f(0.46 + (x.rang - 1) * 0.04)}-${f(0.54 + (x.rang - 1) * 0.04)}`}>{x.rang}</span>
        <span class="dw-wahl__name">{x.text}</span>
        {[[T.nutzen, x.nutzen], [T.aufwand, x.aufwand]].map(([name, w], j) => (
          <span class="dw-wahl__zeile">
            <span>{name}</span>
            <span class="dw-wahl__bahn"><span class="dw-wahl__wert" style={`--w:${Math.round(+w * 100)}%`} data-an={`breit:${f(0.24 + x.k * 0.04 + j * 0.04)}-${f(0.36 + x.k * 0.04 + j * 0.04)}`}></span></span>
          </span>
        ))}
      </span>
    </span>
  ))}
  <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(HAKEN, H)}`}>
    <span class="dw-wahl__haken" data-an={`erscheinen:${f(ZU + 0.04)}-${f(ZU + 0.12)}`}><Icon name="check" size={14} /></span>
  </span>
  <span class="dw-pos dw-pos--rechts" style={`left:calc(${pc(CX, W)} + 22px);top:${pc(HAKEN, H)}`}>
    <span class="dw-wahl__zuerst" data-an={`auf:${f(ZU + 0.08)}-${f(ZU + 0.18)}`}>{T.ergebnis}</span>
  </span>
</div>
