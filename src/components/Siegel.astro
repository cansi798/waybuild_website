---
// „Unsere Service-Versprechen“ (SLAs in Alltagssprache, Jamil 19.10.2026) als digitale Siegel (Bauwelt-Muster).
// Rechtlich: eigene Zusagen, klar als solche gekennzeichnet – keine fremden Prüfzeichen.
import SectionHead from './SectionHead.astro';
import RoughSzene from './RoughSzene.astro';
import Icon from './Icon.astro';
import { VERSPRECHEN } from '../config/versprechen';

interface Props { fakten?: string[]; }
const { fakten = [] } = Astro.props;
---

<section class="section" id="versprechen" aria-labelledby="versprechen-h">
  <div class="wrap">
    <SectionHead center eyebrow="Unsere Service-Versprechen (SLAs)" pre="Darauf können Sie sich " accent="verlassen." text={fakten.length ? undefined : 'Unsere Service-Zusagen – ohne Fachchinesisch. Sie gelten für jeden Kunden.'} id="versprechen-h" />
    {fakten.length > 0 && (
      <ul class="check-row siegel__fakten">{fakten.map((f) => <li><Icon name="check" size={18} /> {f}</li>)}</ul>
    )}
    <RoughSzene szene="siegel" label={`Sechs Service-Versprechen erscheinen nacheinander: ${VERSPRECHEN.map((v) => v.title).join(', ')}.`} />
    <ul class="siegel__liste">
      {VERSPRECHEN.map((v) => (
        <li class="reveal"><h3><Icon name={v.icon} size={20} /> {v.title}</h3><p>{v.long}</p></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .siegel__fakten { justify-content: center; margin: -16px 0 24px; }
  .siegel__liste { list-style: none; margin: 0 auto; padding: 0; max-width: 980px; display: grid; gap: 10px; }
  @media (min-width: 720px) { .siegel__liste { grid-template-columns: 1fr 1fr; gap: 14px; } }
  .siegel__liste li { background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
  .siegel__liste h3 { display: flex; align-items: flex-start; gap: 10px; margin: 0 0 6px; font-size: 1.02rem; line-height: 1.35; }
  .siegel__liste h3 :global(.icon) { color: var(--accent-ink); flex: none; margin-top: 1px; }
  .siegel__liste p { margin: 0; font-size: 0.94rem; line-height: 1.55; color: var(--ink-soft); }
</style>
