---
// Die drei Pakete Basis · Plus · Komplett (Jamil, Talk qh87y3sj #5056, 08.11.2026). Daten: src/config/pakete-abo.ts.
// Genutzt auf /preise/ (voll, mit Erklärung je Leistung) und im Preisteil der Startseite (kompakt, Auswahl KOMPAKT).
// Punkt 1: Kosten PRO JAHR statt „über 24 Monate“, Laufzeit als kleiner Hinweis.
// Punkt 2: Preise auf einer Höhe (Desktop): „Empfehlung“-Etikett sitzt ÜBER der Karte (nimmt keine Zeile ein),
// Kartenzeilen per CSS subgrid ausgerichtet. Am Handy normal untereinander.
import Icon from '../Icon.astro';
import { href } from '../../lib/paths';
import BuchenDialog from './BuchenDialog.astro';
import { ABO_PAKETE, KOMPAKT, paketById, bruttoVon, jahresPreis, jahresBrutto, euro, LAUFZEIT_HINWEIS, BUCHEN, type AboPaket } from '../../config/pakete-abo';

// 08.11.2026 (Jamil #5061/#5062): `details` = Erklärsatz je Leistung (aus = Karten wie auf der Variante-Startseite, alle
// Leistungen ohne Erklärung); `idSuffix` für eine zweite Instanz auf derselben Seite (keine doppelten IDs).
interface Props { kompakt?: boolean; details?: boolean; idSuffix?: string; }
const { kompakt = false, details = true, idSuffix = '' } = Astro.props;

const liste = (p: AboPaket) => (kompakt ? KOMPAKT[p.id].map((id) => p.leistungen.find((l) => l.id === id)).filter((l) => !!l) : p.leistungen);
const weitere = (p: AboPaket) => p.leistungen.length - liste(p).length;
// „Direkt buchen“ (Jamil #5085–#5089): mit JS öffnet sich BuchenDialog (einmal pro Seite, bei der Instanz ohne idSuffix),
// ohne JS direkt zum Kontaktformular mit Paket-Vorauswahl.
const kontakt = (p: AboPaket) => `${href('/kontakt/')}?paket=${encodeURIComponent(p.name)}&buchen=1`;
---

<div class:list={['pk-grid', { 'pk-grid--kompakt': kompakt }]}>
  {ABO_PAKETE.map((p) => (
    <article class:list={['pk', { 'pk--top': p.empfohlen }]} aria-labelledby={`pk-${p.id}${idSuffix}`}>
      {p.empfohlen && <p class="pk__badge">Empfehlung</p>}
      <div class="pk__kopf">
        <h3 id={`pk-${p.id}${idSuffix}`}>{p.name}</h3>
        <p class="pk__kurz">{p.kurz}</p>
      </div>
      <div class="pk__preis">
        <p class="pk__betrag"><b>{euro(p.preis)}</b> <span>netto / Monat</span></p>
        <p class="pk__brutto">{euro(bruttoVon(p.preis))} inkl. 19 % MwSt.</p>
      </div>
      <p class="pk__jahr">Pro Jahr <strong>{euro(jahresPreis(p.preis))}</strong> netto <span>({euro(jahresBrutto(p.preis))} brutto)</span></p>
      {!kompakt && <p class="pk__fuer">{p.fuer}</p>}
      <ul class="pk__liste">
        {p.baut && <li class="pk__alles"><Icon name="check" size={18} /> <span>Alles aus „{paketById(p.baut).name}“</span></li>}
        {liste(p).map((l) => (
          <li><Icon name="check" size={18} /> <span><strong>{l.text}</strong>{!kompakt && details && <small>{l.detail}</small>}</span></li>
        ))}
        {kompakt && weitere(p) > 0 && <li class="pk__mehr"><span>und {weitere(p)} weitere {weitere(p) === 1 ? 'Leistung' : 'Leistungen'}</span></li>}
      </ul>
      <div class="pk__fuss">
        <a class:list={['btn btn--lg pk__btn', p.empfohlen ? 'btn--primary' : 'btn--dark']} href={kontakt(p)} data-buchen={p.id}>{BUCHEN.knopf}<span class="sr-only">: Paket {p.name}</span></a>
        <p class="pk__laufzeit">{LAUFZEIT_HINWEIS}</p>
      </div>
    </article>
  ))}
</div>
{!idSuffix && <BuchenDialog />}

<style>
  .pk-grid { display: grid; gap: 34px; padding-top: 14px; }
  .pk { position: relative; display: flex; flex-direction: column; gap: 14px; background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(22px, 3vw, 30px); }
  .pk > * , .pk p { margin: 0; }
  @media (min-width: 960px) {
    .pk-grid { grid-template-columns: repeat(3, 1fr); gap: 22px; }
    /* Zeilen: Kopf · Preis · Jahr · (Für wen) · Liste · Fuß – in allen drei Karten auf gleicher Höhe */
    .pk { display: grid; grid-template-rows: subgrid; grid-row: span 6; row-gap: 14px; }
    .pk-grid--kompakt .pk { grid-row: span 5; }
  }
  .pk--top { border: 2px solid var(--accent); box-shadow: 0 24px 48px -24px rgb(0 79 76 / 40%); }
  .pk__badge { position: absolute; top: 0; left: clamp(22px, 3vw, 30px); transform: translateY(-50%); padding: 4px 12px; border-radius: 99px; background: var(--accent-ink); color: var(--white); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .pk h3 { margin: 0 0 4px; font-size: clamp(1.4rem, 2.4vw, 1.65rem); }
  .pk__kurz { font-weight: 600; color: var(--accent-ink); line-height: 1.45; }
  .pk__betrag { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .pk__betrag b { font-family: var(--font-head); font-size: clamp(2.1rem, 4vw, 2.6rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); }
  .pk__betrag span { font-size: 0.95rem; font-weight: 600; color: var(--ink); }
  .pk__brutto { margin-top: 2px !important; font-size: 0.85rem; color: var(--ink-soft); }
  .pk__jahr { align-self: start; padding: 8px 12px; border-radius: 12px; background: #e9f6f5; font-size: 0.92rem; line-height: 1.5; color: var(--ink); }
  .pk__jahr strong { font-family: var(--font-head); }
  .pk__jahr span { display: block; color: var(--ink-soft); }
  .pk__fuer { font-size: 0.95rem; line-height: 1.6; color: var(--ink-soft); }
  .pk__liste { list-style: none; margin: 0; padding: 14px 0 4px; display: grid; gap: 12px; align-content: start; border-top: 1px solid var(--line); }
  .pk__liste li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.96rem; line-height: 1.5; }
  .pk__liste li > span { display: grid; gap: 2px; }
  .pk__liste strong { font-weight: 650; }
  .pk__liste small { font-size: 0.86rem; line-height: 1.6; color: var(--ink-soft); }
  .pk__liste :global(.icon) { flex: none; margin-top: 3px; color: var(--accent-ink); }
  .pk__alles { font-weight: 600; }
  .pk__mehr { padding-left: 28px; color: var(--ink-soft); font-size: 0.9rem !important; }
  .pk__fuss { display: grid; gap: 10px; align-content: end; }
  .pk__btn { width: 100%; }
  .pk .btn--primary { color: var(--on-accent); }
  .pk__laufzeit { font-size: 0.82rem; line-height: 1.5; color: var(--ink-soft); text-align: center; }
</style>
