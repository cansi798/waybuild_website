---
// STARTSEITE, Abschnitt direkt nach dem Hero (Jamil Talk qh87y3sj #5848, 14.11.2026): „Ganz gleich, wo Sie gerade stehen.“
// Zwei große, gleichwertige Karten (Website / Abläufe digitalisieren). Gleitet als zweiter Teil von .stapel-paar über den stehenden
// Hero (stapel.ts, Rundung + Schatten aus variante-start.css), braucht daher einen deckenden Hintergrund (start-wege.css).
// Texte aus config/start-wege.ts, Grafiken aus start/StartGrafik.astro (feste Maße 240 × 150).
import StartGrafik from '../start/StartGrafik.astro';
import Icon from '../Icon.astro';
import { WEGE as T } from '../../config/start-wege';
import { href } from '../../lib/paths';
import '../../styles/start-wege.css';
---

<section class="section sn sw" id="wege" aria-labelledby="sw-h">
  <div class="wrap">
    <div class="sn-kopf sn-kopf--zweispaltig">
      <h2 id="sw-h" class="sn-h2">{T.titel}</h2>
      <p class="sn-lead">{T.lead}</p>
    </div>

    <ul class="sw-liste">
      {T.karten.map((k) => (
        <li class:list={['sw-karte', `sw-karte--${k.bild}`, 'reveal']}>
          <div class="sw-bild"><StartGrafik name={k.bild} /></div>
          <div class="sw-text">
            <h3 class="sn-h3">{k.frage}</h3>
            <p class="sw-erkl">{k.text}</p>
            <p class="sw-ideal"><span class="sn-ico" aria-hidden="true"><Icon name={k.icon} size={20} /></span><span>{k.ideal}</span></p>
            <a class="sn-link sw-link" href={href(k.link.pfad)}>{k.link.text} <Icon name="arrow" size={18} /></a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
