---
// Startseite: „Warum Website und Web-App zusammen besonders stark sind“ (Jamil Talk qh87y3sj #5853, 14.11.2026;
// überarbeitet nach #5905/#5906; NEU gestaltet nach #5938, 14.11.2026). Kopf (Kennzeile, H2, zwei Sätze zum Problem),
// dann die Tafel: „Vorher“ = leicht chaotische Kärtchen der Einzellösungen (rein bildlich, aria-hidden, der Text steht im Kopf)
// → Übergang → „Mit webgold“ = Lösungssatz + Kreislauf aus sechs Stationen (<ol>) mit fein gezeichneten Linien-Illustrationen
// in Medaillons. Eine dünne Ringlinie mit goldenem Lichtpunkt verbindet alle Stationen; der Folgeauftrag führt per Pfeil zurück
// zur Website (Handy senkrecht mit Rückweg links, ab 760 px 3 × 2 als geschlossene Schleife). Danach fünf Nutzenkarten mit Haken.
// Lichtpunkt nur ohne prefers-reduced-motion. Texte: config/start-system.ts, Stil: styles/start-system.css.
import { SYSTEM as T } from '../../config/start-system';
import Icon from '../Icon.astro';
import { href } from '../../lib/paths';
import '../../styles/start-system.css';
---

<section class="section sn ss" id="system" aria-labelledby="ss-h">
  <div class="wrap">
    <div class="sn-kopf">
      <div class="ss-kopf-links">
        <p class="sn-kenn">{T.kenn}</p>
        <h2 id="ss-h" class="sn-h2">{T.titel}</h2>
      </div>
      <div class="ss-problem">
        {T.problem.map((s) => <p>{s}</p>)}
      </div>
    </div>

    <div class="ss-tafel reveal">
      <!-- Vorher: verstreute Einzellösungen (bildlich) -->
      <div class="ss-vorher">
        <p class="ss-marke ss-marke--vorher">{T.vorherLabel}</p>
        <div class="ss-chaos" aria-hidden="true">
          <svg class="ss-chaos-faden" width="320" height="220" viewBox="0 0 320 220" preserveAspectRatio="none" fill="none">
            <path d="M70 60C150 10 190 150 250 70S120 200 80 160 240 120 260 170" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 5" stroke-linecap="round" />
          </svg>
          {T.werkzeuge.map((w, i) => (
            <span class={`ss-karte ss-karte--${i + 1}`}>
              <span class="ss-karte-ico">
                {w.art === 'mail' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="6" width="18" height="13" rx="2" /><path d="M4 7.5l8 5.5 8-5.5" />
                  </svg>
                )}
                {w.art === 'excel' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="4" width="17" height="16" rx="2" /><path d="M3.5 9h17M3.5 14h17M9.5 4v16" />
                  </svg>
                )}
                {w.art === 'messenger' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z" /><path d="M8.5 9h7M8.5 12h4" />
                  </svg>
                )}
                {w.art === 'manuell' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3.5h9l3.5 3.5v13.5H6z" /><path d="M9 10h6M9 13.5h4" /><path d="M14.5 21l5.5-5.5 1.5 1.5-5.5 5.5" />
                  </svg>
                )}
              </span>
              <span class="ss-karte-name">{w.name}</span>
            </span>
          ))}
        </div>
      </div>

      <!-- Übergang -->
      <div class="ss-wende" aria-hidden="true">
        <span class="ss-wende-kreis">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 4v12M5 11l5 5 5-5" />
          </svg>
        </span>
      </div>

      <!-- Nachher: ein System, ein Kreislauf -->
      <div class="ss-nachher">
        <p class="ss-marke ss-marke--nachher">{T.nachherLabel}</p>
        <p class="ss-loesung">{T.loesung}</p>

        <div class="ss-strecke">
          <div class="ss-ring" aria-hidden="true">
            <span class="ss-licht"></span>
            <span class="ss-zurueck">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 8.5L7 4.5l4 4" />
              </svg>
            </span>
          </div>
          <ol class="ss-fluss" aria-label={T.flussLabel}>
            {T.fluss.map((f) => (
              <li class={`ss-station ss-station--${f.bild}`}>
                <span class="ss-medaillon" aria-hidden="true">
                  {f.bild === 'website' && (
                    <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="6" y="10" width="36" height="28" rx="4" />
                      <path d="M6 17h36" />
                      <circle cx="10.5" cy="13.5" r="0.6" fill="currentColor" />
                      <circle cx="13.5" cy="13.5" r="0.6" fill="currentColor" />
                      <circle cx="16.5" cy="13.5" r="0.6" fill="currentColor" />
                      <rect x="11" y="22" width="12" height="11" rx="1.6" />
                      <path d="M27 23.5h10M27 27.5h8M27 31.5h5" />
                      <path class="ss-akz" d="M13.5 29.5l3-3 2.2 2.2 2.3-2.7" />
                    </svg>
                  )}
                  {f.bild === 'anfrage' && (
                    <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="7" y="15" width="30" height="21" rx="3" />
                      <path d="M8.5 17l13.5 9.5L35.5 17" />
                      <path d="M8.5 34.5l9.5-7.5M35.5 34.5l-9.5-7.5" />
                      <circle class="ss-akz" cx="38" cy="13" r="4" />
                      <path class="ss-akz" d="M38 11.2v2.2l1.3 0.9" />
                    </svg>
                  )}
                  {f.bild === 'bearbeitung' && (
                    <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="11" y="10" width="26" height="31" rx="3.5" />
                      <rect x="18" y="7" width="12" height="6" rx="2" />
                      <path class="ss-akz" d="M16 20.5l2 2 3.6-3.8" />
                      <path d="M25 21h7" />
                      <path class="ss-akz" d="M16 28.5l2 2 3.6-3.8" />
                      <path d="M25 29h7" />
                      <circle cx="18" cy="36" r="1.4" />
                      <path d="M25 36h5" />
                    </svg>
                  )}
                  {f.bild === 'kunde' && (
                    <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="22" cy="17" r="6.5" />
                      <path d="M19.3 18.6c1.5 1.4 3.9 1.4 5.4 0" />
                      <path d="M9.5 39.5c0-7 5.6-11.5 12.5-11.5s12.5 4.5 12.5 11.5" />
                      <path class="ss-akz" d="M37 8.2c-1-1.6-3.6-1.2-3.6 0.9 0 1.9 3.6 4.1 3.6 4.1s3.6-2.2 3.6-4.1c0-2.1-2.6-2.5-3.6-0.9z" />
                    </svg>
                  )}
                  {f.bild === 'bewertung' && (
                    <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M8 12.5A3.5 3.5 0 0 1 11.5 9h25A3.5 3.5 0 0 1 40 12.5v16a3.5 3.5 0 0 1-3.5 3.5H21l-7 6v-6h-2.5A3.5 3.5 0 0 1 8 28.5z" />
                      <path class="ss-akz" d="M24 13.5l2.1 4.3 4.7 0.7-3.4 3.3 0.8 4.7-4.2-2.2-4.2 2.2 0.8-4.7-3.4-3.3 4.7-0.7z" />
                      <path d="M34 40.5l0.8 1.6 1.7 0.3-1.2 1.2 0.3 1.7-1.6-0.8-1.6 0.8 0.3-1.7-1.2-1.2 1.7-0.3z" />
                      <path d="M42 36.5l0.6 1.2 1.3 0.2-0.9 0.9 0.2 1.3-1.2-0.6-1.2 0.6 0.2-1.3-0.9-0.9 1.3-0.2z" />
                    </svg>
                  )}
                  {f.bild === 'folgeauftrag' && (
                    <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 7h16l7 7v12" />
                      <path d="M26 7v7h7" />
                      <path d="M10 7v34h13" />
                      <path d="M15 19h12M15 24h9M15 29h6" />
                      <path class="ss-akz" d="M42 35a7.5 7.5 0 1 1-2.2-5.3" />
                      <path class="ss-akz" d="M40.5 25.5v4.5H36" />
                    </svg>
                  )}
                </span>
                <span class="ss-text">
                  <span class="ss-nr" aria-hidden="true">{f.nr}</span>
                  <span class="ss-name">{f.name}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <!-- Nutzenkarten -->
      <div class="ss-ergebnis">
        <h3 id="ss-ergebnis-h" class="sn-h3 ss-ergebnis-h">{T.ergebnisTitel}</h3>
        <ul class="ss-nutzen" aria-labelledby="ss-ergebnis-h">
          {T.nutzen.map((n) => (
            <li class="ss-punkt">
              <span class="ss-haken" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3.5 8.4l2.9 2.9 6.1-6.6" />
                </svg>
              </span>
              <span class="ss-punkt-text">{n}</span>
            </li>
          ))}
        </ul>
        <!-- Film nur als Link (Jamil #6055 Fr. 34) -->
        <p class="ss-film"><a class="sn-link" href={href(T.film.pfad)}>{T.film.text} <Icon name="arrow" size={18} /></a></p>
      </div>
    </div>
  </div>
</section>
