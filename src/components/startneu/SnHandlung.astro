---
// Teil 6 „Handlung“ (Neudesign 13.11.2026, Jamil Talk qh87y3sj #5810). Überschrift = Jamils Schlusssatz der Kundenreise (#5662),
// darunter der Ablauf in sechs Schritten (VORGEHEN.schritte, vorgehen.ts, alle Zeitangaben „in der Regel“) und derselbe Knopf wie im
// Hero („Kostenlose Erstberatung“, gleiches Ziel). Ersetzt „So gehen wir vor“ (Kartenstapel) und den alten Abschluss (Claim, „Warum
// waybuild?“, zweiter Knopf „Unternehmensauftritt bewerten lassen“). Der Claim steht klein als Schlusszeile.
// Anker: #denkweise (Abschnitt), #ablauf (Liste), #erstberatung (Schritt Erstgespräch) – alte Links treffen weiter.
import Icon from '../Icon.astro';
import { KUNDENREISE } from '../../config/variante';
import { HERO_KNOPF } from '../../config/variante';
import { ANLIEGEN, CLAIM } from '../../config/startseite';
import { VORGEHEN } from '../../config/vorgehen';
import { HANDLUNG as T, nbTeile } from '../../config/startneu';
import { whatsappLink } from '../../config/site';
import { href } from '../../lib/paths';

const kontakt = href(`/kontakt/?paket=${encodeURIComponent(ANLIEGEN.erstberatung.paket)}`);
---

<section class="section sn sn-handlung" id="denkweise" aria-labelledby="sn-handlung-h">
  <div class="wrap">
    <div class="sn-handlung__kopf">
      <h2 id="sn-handlung-h" class="sn-h2 sn-h2--gross">{KUNDENREISE.schluss}</h2>
      <div class="sn-handlung__knoepfe">
        <a class="btn btn--lg sn-btn sn-btn--gross" href={kontakt}>{HERO_KNOPF}</a>
        <p class="sn-handlung__oder">{T.oder} <a href={whatsappLink(T.waText)} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> {T.whatsapp}<span class="sr-only"> (öffnet in neuem Tab)</span></a></p>
      </div>
    </div>

    <h3 class="sn-h4 sn-ablauf__titel">{T.ablaufTitel}</h3>
    <ol class="sn-ablauf" id="ablauf">
      {VORGEHEN.schritte.map((s, i) => (
        <li class="sn-schritt reveal" id={s.anker}>
          <span class="sn-schritt__nr" aria-hidden="true">{i + 1}</span>
          <p class="sn-schritt__wann">{s.wann}</p>
          <h4 class="sn-schritt__titel"><span class="sr-only">Schritt {i + 1}: </span>{s.titel}</h4>
          <p class="sn-schritt__text">{nbTeile(s.text).map((t) => (t.nb ? <span class="sn-nb">{t.s}</span> : t.s))}</p>
        </li>
      ))}
    </ol>

    <p class="sn-claim">{CLAIM}</p>
  </div>
</section>
