---
// Startseite: Abschnitt „So geht es los“ (Anker #ablauf) neu aufgebaut: acht Schritte als nummerierte Zeitleiste, Schritt 5
// „Feinschliff auf Basis Ihrer Unternehmens-DNA“ als hervorgehobene Karte mit feiner Doppelhelix (Gold nur als Zier), darunter
// „Ihr Vorteil“ als ruhige Leiste mit Haken. Jamil Talk qh87y3sj #5939, 14.11.2026. Texte: src/config/start-ablauf.ts,
// Stil: src/styles/start-ablauf.css (Präfix .sab-). Handy senkrechte Linie, ab 640 px Karten (2 Spalten), ab 1000 px Treppe 2/1/3.
// Schritt-Anker #erstberatung sitzt auf Schritt 1 (alte Links treffen weiter).
import Icon from '../Icon.astro';
import { START_ABLAUF as T } from '../../config/start-ablauf';
import '../../styles/start-ablauf.css';

// Doppelhelix als feine Linienzeichnung (rein dekorativ): zwei gegenläufige Sinusstränge + Sprossen
const B = 320, H = 72, M = H / 2, A = 24, W = 2; // Breite, Höhe, Mitte, Ausschlag, Windungen
const y = (x: number, s: number) => M + s * A * Math.sin((x / B) * Math.PI * 2 * W);
const strang = (s: number) =>
  Array.from({ length: B / 4 + 1 }, (_, i) => `${i ? 'L' : 'M'}${i * 4} ${y(i * 4, s).toFixed(1)}`).join(' ');
const sprossen = Array.from({ length: B / 16 - 1 }, (_, i) => (i + 1) * 16)
  .filter((x) => Math.abs(y(x, 1) - y(x, -1)) > 10)
  .map((x) => ({ x, y1: y(x, 1).toFixed(1), y2: y(x, -1).toFixed(1) }));
---

<section class="section sn sn-ablaufteil sab" id="ablauf" aria-labelledby="sn-ablauf-h">
  <div class="wrap">
    <div class="sn-kopf">
      <div>
        <p class="sn-kenn">{T.kenn}</p>
        <h2 id="sn-ablauf-h" class="sn-h2">{T.titel}</h2>
      </div>
      <p class="sn-lead">{T.lead}</p>
    </div>

    <ol class="sab-schritte">
      {T.schritte.map((s, i) => (
        <li class:list={['sab-schritt reveal', `sab-schritt--${i + 1}`, { 'sab-schritt--dna': s.dna }]} id={s.anker}>
          <span class="sab-nr" aria-hidden="true">{i + 1}</span>
          <div class="sab-inhalt">
            {s.dna && <p class="sab-dna-marke"><span class="sab-dna-punkt" aria-hidden="true"></span>{T.dnaMarke}</p>}
            <h3 class="sab-titel"><span class="sr-only">Schritt {i + 1}: </span>{s.titel}</h3>
            <p class="sab-text">{s.text}</p>

            {s.gruppen && (
              <div class="sab-gruppen">
                {s.gruppen.map((g) => (
                  <div class="sab-gruppe">
                    <p class="sab-stichtitel">{g.name}</p>
                    <ul class="sab-chips">{g.punkte.map((p) => <li class="sab-chip">{p}</li>)}</ul>
                  </div>
                ))}
              </div>
            )}

            {s.stichworte && !s.dna && (
              <div class="sab-stich">
                {s.stichwortTitel && <p class="sab-stichtitel">{s.stichwortTitel}</p>}
                <ul class="sab-chips">{s.stichworte.map((p) => <li class="sab-chip">{p}</li>)}</ul>
              </div>
            )}

            {s.wahl && (
              <ul class="sab-wahl" aria-label="Ihre Möglichkeiten">
                <li class="sab-wahl__punkt"><Icon name="check" size={16} />{s.wahl[0]}</li>
                <li class="sab-wahl__oder" aria-hidden="true">oder</li>
                <li class="sab-wahl__punkt"><Icon name="check" size={16} />{s.wahl[1]}</li>
              </ul>
            )}

            <p class="sab-zeit"><Icon name="clock" size={16} />{s.zeit}</p>
          </div>

          {s.dna && (
            <div class="sab-dna">
              <svg class="sab-helix" width={B} height={H} viewBox={`0 0 ${B} ${H}`} fill="none" aria-hidden="true" focusable="false">
                {sprossen.map((p) => <line class="sab-helix__sprosse" x1={p.x} y1={p.y1} x2={p.x} y2={p.y2} />)}
                <path class="sab-helix__strang sab-helix__strang--a" d={strang(1)} />
                <path class="sab-helix__strang sab-helix__strang--b" d={strang(-1)} />
              </svg>
              <ul class="sab-chips sab-chips--dna" aria-label="Grundlage des Feinschliffs">
                {s.stichworte?.map((p) => <li class="sab-chip">{p}</li>)}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ol>

    <div class="sab-vorteil reveal">
      <h3 class="sab-vorteil__titel">{T.vorteilTitel}</h3>
      <ul class="sab-vorteil__liste">
        {T.vorteile.map((v) => (
          <li class="sab-vorteil__punkt"><span class="sab-haken" aria-hidden="true"><Icon name="check" size={14} /></span><span>{v}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
