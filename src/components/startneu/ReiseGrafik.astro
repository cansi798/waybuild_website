---
// Ruhige Strichgrafiken zur Kundenreise der Startseite (Neudesign 13.11.2026, Jamil Talk qh87y3sj #5810), im Stil von
// geschichte/GGrafik.astro und start/StartGrafik.astro (flach, Papier, feine Linien, Türkis als einziger Akzent).
// Je Station eine Szene: der gute Zustand („Bestenfalls“). Nur Schmuck (aria-hidden), der Inhalt steht im Text daneben.
// SVG immer mit width/height-Attributen (WebKit-Absturz in Flex-/Grid-Karten ohne feste Maße, 13.11.2026).
// CI: Türkis #00a6a1, Tinte #006b68, Tief #004f4c, Hauch #e9f6f5, Papier #f7f5f0, Sand #efebe3, Linie #ddd6c9, Grau #cdc6ba.
interface Props { name: 'aufmerksamkeit' | 'vertrauen' | 'anfrage' | 'bearbeitung' | 'betreuung' | 'ziel' }
const { name } = Astro.props;
const stern = (x: number, y: number, r = 7) => {
  const p: string[] = [];
  for (let i = 0; i < 10; i++) {
    const w = (Math.PI / 5) * i - Math.PI / 2;
    const rr = i % 2 ? r * 0.45 : r;
    p.push(`${(x + Math.cos(w) * rr).toFixed(1)},${(y + Math.sin(w) * rr).toFixed(1)}`);
  }
  return p.join(' ');
};
