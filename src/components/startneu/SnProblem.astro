---
// Teil 2 „Problem“ (Neudesign 13.11.2026, Jamil Talk qh87y3sj #5810, erweitert #5819/#5826, Animation #5828). Seit #5833 (14.11.:
// „nimmt noch zu viel Platz ein“) kompakt: alle Probleme als Stichwort-Kacheln, daneben (PC) bzw. darunter (Handy) EINE Bildfläche
// mit Strichgrafik (geschichte/GGrafik), Titel und Text des gewählten Problems. PC: Maus/Fokus wählt, im Sichtbereich wechselt
// es von selbst, bis jemand eingreift. Handy: Tippen wählt. Ohne JS: alle Bildflächen untereinander.
// Logik: scripts/start-neu.ts ([data-pfeld]), Stil: styles/start-neu.css (.sn-pk*, .sn-pd*).
import GGrafik from '../geschichte/GGrafik.astro';
import Icon from '../Icon.astro';
import { PROBLEM as T } from '../../config/startneu';
const kurz = (t: string) => t.replace(/\.$/, '');
---

<section class="section sn sn-problem" id="problem" aria-labelledby="sn-problem-h">
  <div class="wrap">
    <div class="sn-kopf sn-kopf--zweispaltig sn-problem__kopf">
      <div>
        <p class="sn-kenn">{T.kennzeile}</p>
        <h2 id="sn-problem-h" class="sn-h2">{T.titel}</h2>
      </div>
      <p class="sn-lead">{T.lead}</p>
    </div>

    <div class="sn-pfeld" data-pfeld>
      <div class="sn-pfeld__wahl">
        <p class="sn-pfeld__hinweis" aria-hidden="true">
          <span class="sn-pfeld__maus">{T.hinweisMaus}</span><span class="sn-pfeld__tippen">{T.hinweisTippen}</span>
        </p>
        <ul class="sn-pkacheln">
          {T.punkte.map((p, i) => (
            <li>
              <button type="button" class:list={['sn-pk', { 'ist-aktiv': i === 0 }]} data-pp={i}
                aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`sn-pd-${i}`}>{kurz(p.titel)}</button>
            </li>
          ))}
        </ul>
      </div>
      <div class="sn-pbuehne">
        {T.punkte.map((p, i) => (
          <div class:list={['sn-pd', { 'ist-aktiv': i === 0 }]} id={`sn-pd-${i}`} data-pd={i}>
            <div class="sn-pd__bild"><GGrafik name={p.grafik} suche="Betrieb in der Nähe" /></div>
            <div class="sn-pd__text">
              <h3 class="sn-pd__titel">{p.titel}</h3>
              <p>{p.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <p class="sn-problem__weitere"><b>{T.weitereTitel}:</b> {T.weitere.join(' · ')}</p>

    <a class="sn-link sn-problem__weiter" href="#kundenreise">{T.ueberleitung} <Icon name="arrow" size={18} /></a>
  </div>
</section>
