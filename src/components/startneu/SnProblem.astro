---
// Teil 2 „Problem“ (Neudesign 13.11.2026, Jamil Talk qh87y3sj #5810, erweitert #5819): neun typische Schmerzpunkte mit den ruhigen
// Strichgrafiken aus /geschichte/ (geschichte/GGrafik.astro, die Jamil „sehr ansprechend“ findet, #5787) und darunter eine Liste
// weiterer Alltagsprobleme, damit sichtbar wird, wie viel wir lösen. Kopf oben, Karten im Raster (Handy 1, Tablet 2, PC 3 Spalten);
// am Handy steht die Grafik klein neben dem Text.
import GGrafik from '../geschichte/GGrafik.astro';
import Icon from '../Icon.astro';
import { PROBLEM as T } from '../../config/startneu';
---

<section class="section sn sn-problem" id="problem" aria-labelledby="sn-problem-h">
  <div class="wrap">
    <div class="sn-kopf sn-kopf--zweispaltig sn-problem__kopf">
      <div>
        <p class="sn-kenn">{T.kennzeile}</p>
        <h2 id="sn-problem-h" class="sn-h2">{T.titel}</h2>
      </div>
      <p class="sn-lead">{T.lead}</p>
    </div>

    <ul class="sn-schmerzen">
      {T.punkte.map((p) => (
        <li class="sn-schmerz reveal">
          <div class="sn-schmerz__bild"><GGrafik name={p.grafik} suche="Betrieb in der Nähe" /></div>
          <div class="sn-schmerz__text">
            <h3 class="sn-h3">{p.titel}</h3>
            <p>{p.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="sn-problem__weitere reveal">
      <h3 class="sn-problem__wtitel">{T.weitereTitel}</h3>
      <ul class="sn-problem__chips">
        {T.weitere.map((w) => <li>{w}</li>)}
      </ul>
    </div>

    <a class="sn-link sn-problem__weiter" href="#kundenreise">{T.ueberleitung} <Icon name="arrow" size={18} /></a>
  </div>
</section>
