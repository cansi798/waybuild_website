---
// Teil 5 „Angebot“ (Neudesign 13.11.2026, Jamil Talk qh87y3sj #5810). Alle Preise, Namen und Leistungen aus pakete-abo.ts, nichts fest
// im Text. Regeln: Basis „Enthalten:“ ohne Haken, Plus „Alles aus Basis, plus:“ mit Haken (#5669); Komplettpaket nur in Kombination
// und nur mit Kombipreisen (#5642, #5659/#5660), kein Kombipreis mit dem Gründerpaket (#5464); Extras einmalig (#5613/#5615).
// „Direkt buchen“ / „Kombi buchen“ öffnen das gemeinsame Buchungsfenster (pakete/BuchenDialog.astro, data-buchen/data-komplett),
// ohne JS geht es zum Kontaktformular mit Vorauswahl. Darunter: was Sicherheit gibt (nur Belegtes) und sechs häufige Fragen
// (Antworten aus site.ts/pakete-abo.ts über alleFragen()); FAQPage-JSON-LD bleibt nur auf /fragen/.
// Anker: #pakete (Abschnitt), #baukasten (alte Links), #pk-basis/#pk-plus, #komplettpaket, #einmalig.
import { hl } from '../../lib/hl';
import Icon from '../Icon.astro';
import BuchenDialog from '../pakete/BuchenDialog.astro';
import {
  ABO_PAKETE, KOMPLETTPAKET as K, EINMALIG_DAZU as E, BUCHEN, euro, euroAb, bruttoVon, kombiPreise, einmalSumme,
  paketById, LAUFZEIT_HINWEIS, B2B_HINWEIS,
} from '../../config/pakete-abo';
import { alleFragen } from '../../config/fragen';
import { ANGEBOT as T, nbTeile } from '../../config/startneu';
import { href } from '../../lib/paths';
import { VORSCHAU, vorschauText } from '../../config/vorschau';

const kontaktPaket = (name: string) => `${href('/kontakt/')}?paket=${encodeURIComponent(name)}&buchen=1`;
const kontaktKombi = (name: string) => `${href('/kontakt/')}?paket=${encodeURIComponent(name)}&komplett=1&buchen=1`;
const kontaktExtras = `${href('/kontakt/')}?dazu=${encodeURIComponent(E.gesamt.id)}&buchen=1`;
const kombis = kombiPreise();
const appText = K.text.replace(/\s*Nur zusammen mit .* buchbar\.$/, '');
// Seit Jamil #6400: Software einzeln oder kombinierbar, ohne Kombipreise → dritte Karte mit eigenem Monatspreis
const kontaktSoftware = `${href('/kontakt/')}?leistung=rundum&komplett=1`;
interface Props { zeigeFragen?: boolean; kompakt?: boolean; titel?: string; kenn?: string }
// Startseite ohne FAQ (Jamil #5967). kompakt (Startseite, Jamil #6038, Audit P6/M1): nur die drei Karten, Wahlhilfe und ein Link
// auf /preise/; Extras, Sicherheits-Kacheln und Kombi-Hinweis stehen nur auf der Preisseite.
const { zeigeFragen = true, kompakt = false, titel = T.titel, kenn = T.kennzeile } = Astro.props;
const fragen = T.fragen.map((q) => alleFragen().find((f) => f.q === q)).filter((f): f is NonNullable<typeof f> => !!f && !f.platzhalter);
---

<section class="section sn sn-angebot" id="pakete" aria-labelledby="sn-angebot-h">
  <span id="baukasten" class="sn-anker" aria-hidden="true"></span>
  <div class="wrap">
    <div class="sn-kopf sn-kopf--mitte">
      <p class="sn-kenn">{kenn}</p>
      <h2 id="sn-angebot-h" class="sn-h2" set:html={hl(titel)}></h2>
      <p class="sn-lead">{T.lead}</p>
    </div>

    <!-- Kostenlose Vorschau (Jamil #6061): hervorgehobene Zeile über den Paketen, Startseite und /preise/ -->
    <div class="sn-vorschau-band">
      <span class="sn-vorschau-band__ico"><Icon name="eye" size={22} /></span>
      <p><strong>{VORSCHAU.titel}</strong><span>{vorschauText()}</span></p>
    </div>

    <div class="sn-pakete">
      {ABO_PAKETE.map((p) => (
        <article class:list={['sn-paket', { 'sn-paket--tipp': p.empfohlen }]} id={`pk-${p.id}`} aria-labelledby={`sn-pk-${p.id}`}>
          <div class="sn-paket__kopf">
            <h3 id={`sn-pk-${p.id}`} class="sn-paket__name">{p.name}</h3>
            {p.empfohlen && <span class="sn-paket__tipp">Empfehlung</span>}
          </div>
          <p class="sn-paket__kurz">{p.kurz}</p>
          <p class="sn-paket__preis"><b>{euro(p.preis)}</b><span>netto im Monat</span></p>
          <p class="sn-paket__brutto">{euro(bruttoVon(p.preis))} inkl. 19 % MwSt.</p>
          <p class="sn-paket__jahr">{euro(p.preis * 12)} netto im Jahr</p><!-- Jamil #5912 -->
          <p class="sn-paket__fuer">{p.fuer}</p>
          <p class="sn-paket__listenkopf">{p.baut ? `Alles aus ${paketById(p.baut).name}, plus:` : 'Enthalten:'}</p>
          <ul class:list={['sn-paket__liste', { 'sn-paket__liste--haken': !!p.baut }]}>
            {p.leistungen.map((l) => <li>{p.baut ? <Icon name="check" size={18} /> : <span class="sn-punkt" aria-hidden="true"></span>}<span>{l.text}</span></li>)}
          </ul>
          <div class="sn-paket__fuss">
            <a class="btn btn--lg sn-btn sn-paket__btn" href={kontaktPaket(p.name)} data-buchen={p.id}>{BUCHEN.knopf}<span class="sr-only">: Paket {p.name}</span></a>
            <p class="sn-paket__laufzeit">{LAUFZEIT_HINWEIS}</p>
          </div>
        </article>
      ))}
      {/* Drittes Paket (Jamil #5922/#5923, 14.11.2026): Komplettpaket gleichrangig neben Profi-Website und Website + Google & KI; Preis „ab“ inkl. Website-Paket (#5911) */}
      {kombis.length === 0 && (
      <article class="sn-paket sn-paket--komplett" id="komplettpaket" aria-labelledby="sn-pk-komplett">
        <div class="sn-paket__kopf">
          <h3 id="sn-pk-komplett" class="sn-paket__name">{K.name}</h3>
          <span class="sn-paket__tipp sn-paket__tipp--gold">{K.label}</span>
        </div>
        <p class="sn-paket__kurz">Erweiterung / Maßarbeit</p>
        <p class="sn-paket__preis"><b>{euroAb(K.preis, K.ab)}</b><span>netto im Monat</span></p>
        <p class="sn-paket__brutto">{euroAb(bruttoVon(K.preis), K.ab)} inkl. 19 % MwSt.</p>
        <p class="sn-paket__jahr">{euroAb(K.preis * 12, K.ab)} netto im Jahr</p>
        <p class="sn-paket__fuer">{K.kurz}</p>
        <p class="sn-paket__listenkopf">Enthalten:</p>
        <ul class="sn-paket__liste sn-paket__liste--haken">
          {K.software.map((t) => <li><Icon name="check" size={18} /><span>{t}</span></li>)}
        </ul>
        <div class="sn-paket__fuss">
          <a class="btn btn--lg sn-btn sn-paket__btn" href={kontaktSoftware}>Software-Idee besprechen<span class="sr-only">: {K.name}</span></a>
          <p class="sn-paket__laufzeit">{LAUFZEIT_HINWEIS}</p>
        </div>
      </article>
      )}
      {kombis.length > 0 && (
      <article class="sn-paket sn-paket--komplett" id="komplettpaket" aria-labelledby="sn-pk-komplett">
        <div class="sn-paket__kopf">
          <h3 id="sn-pk-komplett" class="sn-paket__name">{K.name}</h3>
          <span class="sn-paket__tipp sn-paket__tipp--gold">Website + Web-App</span>{/* Web-App einheitlich (Jamil #5928–#5939; #6038, Audit K2) */}
        </div>
        <p class="sn-paket__kurz">{K.kurz}</p>
        <p class="sn-paket__preis"><b>{euroAb(kombis[0].preis, true)}</b><span>netto im Monat</span></p>
        <p class="sn-paket__brutto">{euroAb(bruttoVon(kombis[0].preis), true)} inkl. 19 % MwSt.</p>
        <p class="sn-paket__jahr">{euroAb(kombis[0].preis * 12, true)} netto im Jahr</p>
        {/* Beide Kombipreise direkt auf der Karte (Jamil #6011, Audit #5953 P2), Werte aus pakete-abo.ts. Im selben Element wie
            „Für wen“, damit die Karte bei 9 gemeinsamen subgrid-Zeilen bleibt (Jamil #5942). */}
        <div class="sn-paket__fuer">
          <ul class="sn-paket__kombis" aria-label={`Preise ${K.name} je Website-Paket`}>
            {kombis.map((k) => <li>mit {k.paket.name} <b>{euroAb(k.preis, K.kombiAb)}</b> netto im Monat</li>)}
          </ul>
          <p>Je nach Wahl ist Profi-Website oder Website + Google & KI enthalten. {appText}</p>
        </div>
        <p class="sn-paket__listenkopf">Alles aus Ihrem gewählten Paket, plus:</p>
        <ul class="sn-paket__liste sn-paket__liste--haken">
          {K.software.slice(0, 5).map((t) => <li><Icon name="check" size={18} /><span>{t}</span></li>)}
        </ul>
        <div class="sn-paket__fuss">
          <a class="btn btn--lg sn-btn sn-paket__btn" href={kontaktKombi(kombis[0].paket.name)} data-buchen={kombis[0].paket.id} data-komplett="1">{BUCHEN.knopf}<span class="sr-only">: {K.name}</span></a>
          <p class="sn-paket__laufzeit">{LAUFZEIT_HINWEIS}</p>
        </div>
      </article>
      )}
    </div>
    {/* Wahlhilfe unter den Karten (Jamil #6038, Audit P5) */}
    <div class="sn-wahlhilfe">
      <h3 class="sn-h4 sn-wahlhilfe__titel">{T.wahlhilfe.titel}</h3>
      <ul class="sn-wahlhilfe__liste">
        {T.wahlhilfe.zeilen.map((z) => <li><span>{z.wenn}</span> <Icon name="arrow" size={16} /> <a href={z.id === 'komplett' ? '#komplettpaket' : `#pk-${z.id}`}>{z.id === 'komplett' ? K.name : paketById(z.id).name}</a></li>)}
      </ul>
    </div>

    {/* Kombi-Regel in Alltagssprache (Jamil #6038, Audit P3), nur auf der Preisseite */}
    {!kompakt && kombis.length > 0 && !K.kombiMitGruenderpaket && <p class="sn-fein sn-fein--mitte sn-pakete__hinweis">Wenn Sie zusätzlich das Gesamtpaket „{E.gesamt.name}“ buchen, entfällt der Kombipreis von „{K.name}“. Dann gelten die Einzelpreise.</p>}

    {kompakt ? (
      <p class="sn-fein sn-fein--mitte sn-angebot__mehr"><a class="sn-link" href={href('/preise/')}>{T.alleDetails} <Icon name="arrow" size={18} /></a><br />{LAUFZEIT_HINWEIS} {B2B_HINWEIS}</p>
    ) : (<>
    <div class="sn-extras" id="einmalig" role="region" aria-labelledby="sn-extras-h">
      <div class="sn-extras__text">
        <h3 id="sn-extras-h" class="sn-h4">Neu starten oder neu aufstellen?</h3>
        <p>{E.gesamt.text.replace(/[.\s]+$/, '')} für <b>{euro(E.gesamt.preis)}</b> statt {euro(einmalSumme())}, einmalig netto. Einzeln: {E.liste.map((e) => `${e.name} ${euro(e.preis)}`).join(', ')}.</p>
      </div>
      <a class="btn sn-btn sn-btn--rand" href={kontaktExtras}>{BUCHEN.knopf}<span class="sr-only">: {E.gesamt.name}</span></a>
    </div>

    <ul class="sn-sicher">
      {T.sicherheit.map((s) => (
        <li><span class="sn-ico" aria-hidden="true"><Icon name={s.icon} size={22} /></span><p><b>{s.titel}</b> {nbTeile(s.text).map((t) => (t.nb ? <span class="sn-nb">{t.s}</span> : t.s))}</p></li>
      ))}
    </ul>

    <p class="sn-fein sn-fein--mitte"><a href={href('/preise/')}>{T.allePreise}</a> · {LAUFZEIT_HINWEIS} {B2B_HINWEIS}</p>
    </>)}

    {zeigeFragen && (
    <div class="sn-fragen">
      <div class="sn-fragen__kopf">
        <h3 class="sn-h3">{T.fragenTitel}</h3>
        <a class="sn-link" href={href('/fragen/')}>{T.alleFragen} <Icon name="arrow" size={18} /></a>
      </div>
      <dl class="sn-fragen__liste">
        {fragen.map((f) => (<div><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
      </dl>
    </div>
    )}
  </div>
  <BuchenDialog />
</section>
