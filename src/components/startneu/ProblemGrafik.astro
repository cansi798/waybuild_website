---
// Illustrationen zu den fünf Problemen der Startseite (SnProblem): 'suche', 'telefon', 'stand', 'zettel', 'abend'.
// Neu gezeichnet nach Jamil Talk qh87y3sj #5928–#5930, 14.11.2026 („schöner“, „klarer“): gleiche Aussage wie die
// Strichgrafiken aus geschichte/GGrafik (die für /geschichte/ unverändert bleiben), aber im Stil des Prozesswegs (SnSystem):
// feine Linien, runde Formen, zarte Flächen und Verläufe, leichte Schatten, gut lesbare Schrift. Nur Schmuck (aria-hidden),
// der Inhalt steht im Text daneben. Klasse "gg" bleibt, damit Größe und Einblenden aus styles/start-neu.css greifen.
// Stil: styles/problem-grafik.css. IDs je Grafik eindeutig (jeder Name kommt auf der Seite nur einmal vor).
import '../../styles/problem-grafik.css';
interface Props { name: string; suche?: string }
const { name, suche = 'Betrieb in der Nähe' } = Astro.props;
const id = (s: string) => `pg-${s}-${name}`;
const url = (s: string) => `url(#${id(s)})`;
const schrift = 'Plus Jakarta Sans Variable, sans-serif';
---

<svg class="gg pg" viewBox="0 0 320 220" width="320" height="220" aria-hidden="true" focusable="false">
  <defs>
    <filter id={id('schatten')} x="-20%" y="-20%" width="140%" height="160%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#084E4C" flood-opacity="0.12" />
    </filter>
    <radialGradient id={id('hof')} cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#0B6D6B" stop-opacity="0.09" />
      <stop offset="1" stop-color="#0B6D6B" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={id('zart')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0B6D6B" stop-opacity="0.16" />
      <stop offset="1" stop-color="#0B6D6B" stop-opacity="0.05" />
    </linearGradient>
    <linearGradient id={id('nacht')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#084E4C" />
      <stop offset="1" stop-color="#0B6D6B" />
    </linearGradient>
    <radialGradient id={id('licht')} cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#D8A74F" stop-opacity="0.2" />
      <stop offset="1" stop-color="#D8A74F" stop-opacity="0" />
    </radialGradient>
  </defs>

  {name === 'suche' && (<>
    <ellipse cx="160" cy="116" rx="168" ry="108" fill={url('hof')} />
    {/* Suchfeld */}
    <rect x="16" y="14" width="288" height="46" rx="23" fill="#fff" stroke="#CFC8BB" stroke-width="1.5" filter={url('schatten')} />
    <circle cx="42" cy="36" r="8" fill="none" stroke="#0B6D6B" stroke-width="2" />
    <path d="M48 42l5.5 5.5" stroke="#0B6D6B" stroke-width="2" stroke-linecap="round" />
    <text x="64" y="42" font-size="16" font-weight="500" font-family={schrift} fill="#2C3135" data-g="suchNaehe">{suche}</text>
    {/* Zwei Treffer (Wettbewerber) */}
    {[72, 120].map((y, i) => (<>
      <rect x="16" y={y} width="288" height="40" rx="12" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
      <circle cx="40" cy={y + 20} r="12" fill={url('zart')} />
      <path d={`M40 ${y + 27}c-4-4.5-6-7.5-6-10a6 6 0 0 1 12 0c0 2.5-2 5.5-6 10z`} fill="none" stroke="#0B6D6B" stroke-width="1.5" stroke-linejoin="round" />
      <circle cx="40" cy={y + 17} r="2" fill="#0B6D6B" />
      <rect x="62" y={y + 12} width={i === 0 ? 96 : 112} height="7" rx="3.5" fill="#CFC8BB" />
      <rect x="62" y={y + 24} width={i === 0 ? 64 : 80} height="5" rx="2.5" fill="#E6E0D4" />
      {[252, 261, 270, 279, 288].map((cx, k) => (
        <circle cx={cx} cy={y + 20} r="2.6" fill={k < 4 ? '#D8A74F' : '#E6E0D4'} />
      ))}
    </>))}
    {/* Leerer Platz: der eigene Betrieb fehlt */}
    <rect x="16" y="168" width="288" height="40" rx="12" fill="#C2410C" fill-opacity="0.05" stroke="#C2410C" stroke-width="1.5" stroke-dasharray="5 5" />
    <circle cx="40" cy="188" r="10" fill="none" stroke="#C2410C" stroke-width="1.5" />
    <path d="M40 183v6" stroke="#C2410C" stroke-width="1.8" stroke-linecap="round" />
    <circle cx="40" cy="193" r="1.2" fill="#C2410C" />
    <text x="60" y="194" font-size="16" font-weight="600" font-family={schrift} fill="#C2410C">Ihr Betrieb? Fehlt.</text>
  </>)}

  {name === 'telefon' && (<>
    <ellipse cx="160" cy="110" rx="160" ry="104" fill={url('hof')} />
    {/* Wellen: Nachrichten kommen von allen Seiten */}
    <path d="M90 84q-10 26 0 52M78 72q-17 38 0 76" fill="none" stroke="#0B6D6B" stroke-width="1.5" stroke-linecap="round" opacity="0.3" />
    <path d="M230 84q10 26 0 52M242 72q17 38 0 76" fill="none" stroke="#0B6D6B" stroke-width="1.5" stroke-linecap="round" opacity="0.3" />
    {/* Kanäle als Medaillons: E-Mail, Anruf, WhatsApp, Kontaktformular */}
    <circle cx="44" cy="58" r="20" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
    <rect x="34" y="51" width="20" height="14" rx="2.5" fill="none" stroke="#0B6D6B" stroke-width="1.5" />
    <path d="M35.5 53l8.5 6.2 8.5-6.2" fill="none" stroke="#0B6D6B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="44" cy="162" r="20" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
    <path d="M37.5 153.5l4 0.5 1.8 4.5-2.4 1.8c1.2 2.6 3.2 4.6 5.8 5.8l1.8-2.4 4.5 1.8 0.5 4c-0.2 1.3-1.3 2.2-2.6 2.1-8.2-0.6-14.5-6.9-15.1-15.1-0.1-1.3 0.8-2.4 2.1-2.6z" fill="none" stroke="#0B6D6B" stroke-width="1.5" stroke-linejoin="round" />
    <circle cx="276" cy="58" r="20" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
    <path d="M267 54a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v7a4 4 0 0 1-4 4h-6l-5 4v-4a4 4 0 0 1-3-4z" fill="none" stroke="#2C9A7A" stroke-width="1.5" stroke-linejoin="round" />
    <circle cx="276" cy="162" r="20" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
    <rect x="267" y="152" width="18" height="20" rx="2.5" fill="none" stroke="#0B6D6B" stroke-width="1.5" />
    <path d="M271 158h10M271 162.5h10M271 167h6" stroke="#0B6D6B" stroke-width="1.5" stroke-linecap="round" />
    {/* Telefon mit ungelesenen Nachrichten */}
    <rect x="112" y="12" width="96" height="196" rx="20" fill="#fff" stroke="#084E4C" stroke-width="2" filter={url('schatten')} />
    <rect x="120" y="32" width="80" height="162" rx="10" fill={url('zart')} />
    <rect x="146" y="19" width="28" height="6" rx="3" fill="#E6E0D4" />
    {[42, 86, 130].map((y, i) => (<>
      <rect x="126" y={y} width="68" height="36" rx="9" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" />
      <circle cx="139" cy={y + 18} r="6" fill="none" stroke={i === 1 ? '#2C9A7A' : '#0B6D6B'} stroke-width="1.5" />
      <rect x="150" y={y + 12} width={[34, 28, 36][i]} height="5" rx="2.5" fill="#CFC8BB" />
      <rect x="150" y={y + 21} width={[22, 30, 18][i]} height="4" rx="2" fill="#E6E0D4" />
      <circle cx="188" cy={y + 9} r="3" fill="#0B6D6B" />
    </>))}
    <rect x="132" y="174" width="56" height="12" rx="6" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" opacity="0.7" />
    <rect x="145" y="200" width="30" height="3" rx="1.5" fill="#CFC8BB" />
    <circle cx="206" cy="16" r="14" fill="#C2410C" stroke="#fff" stroke-width="3" />
    <text x="206" y="21.5" font-size="15" font-weight="700" text-anchor="middle" font-family={schrift} fill="#fff">3</text>
  </>)}

  {name === 'stand' && (<>
    <ellipse cx="160" cy="112" rx="166" ry="106" fill={url('hof')} />
    {/* Kunde 1 */}
    <circle cx="36" cy="62" r="20" fill={url('zart')} stroke="#0B6D6B" stroke-width="1.5" />
    <circle cx="36" cy="56" r="6" fill="none" stroke="#0B6D6B" stroke-width="1.5" />
    <path d="M25.5 74c1.6-5.6 5.8-8.6 10.5-8.6s8.9 3 10.5 8.6" fill="none" stroke="#0B6D6B" stroke-width="1.5" stroke-linecap="round" />
    <path d="M86 22H252A20 20 0 0 1 272 42V54A20 20 0 0 1 252 74H92L72 86L76 70.5A20 20 0 0 1 66 54V42A20 20 0 0 1 86 22Z" fill="#fff" stroke="#CFC8BB" stroke-width="1.5" stroke-linejoin="round" filter={url('schatten')} />
    <text x="169" y="54" font-size="17" font-weight="600" text-anchor="middle" font-family={schrift} fill="#2C3135">Wann geht es los?</text>
    <circle cx="270" cy="24" r="14" fill="#C2410C" stroke="#fff" stroke-width="3" />
    <text x="270" y="29.5" font-size="15" font-weight="700" text-anchor="middle" font-family={schrift} fill="#fff">5</text>
    {/* Kunde 2 */}
    <circle cx="286" cy="146" r="20" fill="#D8A74F" fill-opacity="0.14" stroke="#B8862F" stroke-width="1.5" />
    <circle cx="286" cy="140" r="6" fill="none" stroke="#B8862F" stroke-width="1.5" />
    <path d="M275.5 158c1.6-5.6 5.8-8.6 10.5-8.6s8.9 3 10.5 8.6" fill="none" stroke="#B8862F" stroke-width="1.5" stroke-linecap="round" />
    <path d="M68 104H234A20 20 0 0 1 254 124V136A20 20 0 0 1 244 152.5L248 168L228 156H68A20 20 0 0 1 48 136V124A20 20 0 0 1 68 104Z" fill="#fff" stroke="#CFC8BB" stroke-width="1.5" stroke-linejoin="round" filter={url('schatten')} />
    <text x="151" y="136" font-size="17" font-weight="600" text-anchor="middle" font-family={schrift} fill="#2C3135">Gibt es was Neues?</text>
    {/* Die nächste Frage wird schon getippt */}
    <rect x="66" y="180" width="64" height="30" rx="15" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
    <circle cx="84" cy="195" r="3.5" fill="#8A8F94" />
    <circle cx="98" cy="195" r="3.5" fill="#8A8F94" opacity="0.6" />
    <circle cx="112" cy="195" r="3.5" fill="#8A8F94" opacity="0.35" />
  </>)}

  {name === 'zettel' && (<>
    <ellipse cx="160" cy="112" rx="166" ry="106" fill={url('hof')} />
    {/* Verbindungen, die ins Leere laufen */}
    <path d="M120 40C150 22 172 24 190 40M104 168C96 196 112 206 128 196M258 170C270 190 262 204 244 206" fill="none" stroke="#8A8F94" stroke-width="1.2" stroke-dasharray="3 4" stroke-linecap="round" opacity="0.55" />
    {/* Notizzettel (Papier) */}
    <g transform="rotate(-9 88 120)">
      <rect x="40" y="72" width="96" height="96" rx="6" fill="#fff" filter={url('schatten')} />
      <rect x="40" y="72" width="96" height="96" rx="6" fill="#D8A74F" fill-opacity="0.18" stroke="#D8A74F" stroke-width="1.5" />
      <path d="M56 102h52M56 118h60M56 134h40" stroke="#B8862F" stroke-width="2" stroke-linecap="round" opacity="0.7" />
    </g>
    <circle cx="86" cy="76" r="4" fill="#084E4C" />
    {/* Tabelle (Excel) */}
    <g transform="rotate(6 214 100)">
      <rect x="160" y="40" width="110" height="120" rx="8" fill="#fff" stroke="#CFC8BB" stroke-width="1.5" filter={url('schatten')} />
      <path d="M160 64h110M160 88h110M160 112h110M160 136h110M196 40v120M233 40v120" stroke="#E6E0D4" stroke-width="1.5" />
      <rect x="166" y="49" width="24" height="7" rx="3.5" fill="#CFC8BB" /><rect x="203" y="49" width="24" height="7" rx="3.5" fill="#CFC8BB" /><rect x="240" y="49" width="24" height="7" rx="3.5" fill="#CFC8BB" />
      <rect x="166" y="73" width="18" height="6" rx="3" fill="#E6E0D4" /><rect x="203" y="73" width="22" height="6" rx="3" fill="#E6E0D4" />
      <rect x="166" y="97" width="22" height="6" rx="3" fill="#E6E0D4" /><rect x="240" y="97" width="16" height="6" rx="3" fill="#E6E0D4" />
      <rect x="203" y="121" width="18" height="6" rx="3" fill="#E6E0D4" />
    </g>
    <circle cx="214" cy="40" r="4" fill="#0B6D6B" />
    {/* Chat (WhatsApp) */}
    <g transform="rotate(-4 70 48)">
      <rect x="22" y="16" width="96" height="64" rx="12" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
      <rect x="32" y="27" width="54" height="15" rx="7.5" fill="#2C9A7A" fill-opacity="0.2" />
      <rect x="52" y="50" width="56" height="15" rx="7.5" fill="#E6E0D4" />
    </g>
    {/* Und wo steht es jetzt? */}
    <g transform="rotate(-3 168 168)">
      <rect x="124" y="128" width="88" height="80" rx="12" fill="#fff" filter={url('schatten')} />
      <rect x="124" y="128" width="88" height="80" rx="12" fill={url('zart')} stroke="#0B6D6B" stroke-width="1.5" />
      <text x="168" y="186" font-size="52" font-weight="700" text-anchor="middle" font-family={schrift} fill="#084E4C">?</text>
    </g>
  </>)}

  {name === 'abend' && (<>
    <ellipse cx="110" cy="122" rx="112" ry="96" fill={url('licht')} />
    {/* Nachthimmel als Medaillon */}
    <circle cx="252" cy="64" r="50" fill={url('nacht')} filter={url('schatten')} />
    <path d="M262 40a24 24 0 1 0 14 40a19 19 0 0 1-14-40z" fill="#fff" fill-opacity="0.95" />
    <path d="M226 62l1.4 4.1 4.1 1.4-4.1 1.4-1.4 4.1-1.4-4.1-4.1-1.4 4.1-1.4z" fill="#D8A74F" />
    <circle cx="238" cy="38" r="1.8" fill="#D8A74F" />
    <circle cx="240" cy="92" r="1.4" fill="#fff" fill-opacity="0.7" />
    <circle cx="284" cy="96" r="1.4" fill="#fff" fill-opacity="0.7" />
    {/* Angebot, noch nicht fertig */}
    <rect x="40" y="34" width="136" height="170" rx="10" fill="#fff" stroke="#CFC8BB" stroke-width="1.5" filter={url('schatten')} />
    <text x="56" y="63" font-size="15" font-weight="700" font-family={schrift} fill="#084E4C">Angebot</text>
    <path d="M56 74h104" stroke="#E6E0D4" stroke-width="1.5" stroke-linecap="round" />
    {[[86, 60], [102, 72], [118, 52], [134, 66]].map(([y, w]) => (<>
      <rect x="56" y={y} width={w} height="6" rx="3" fill="#CFC8BB" />
      <rect x="136" y={y} width="24" height="6" rx="3" fill="#CFC8BB" />
    </>))}
    <rect x="56" y="150" width="40" height="6" rx="3" fill="#CFC8BB" />
    <path class="pg-marke" d="M101 146v14" stroke="#0B6D6B" stroke-width="1.5" stroke-linecap="round" />
    <path d="M56 172h104" stroke="#E6E0D4" stroke-width="1.5" stroke-linecap="round" />
    <rect x="124" y="182" width="36" height="8" rx="4" fill="#E6E0D4" />
    {/* Uhrzeit */}
    <rect x="194" y="142" width="108" height="44" rx="22" fill="#fff" stroke="#E6E0D4" stroke-width="1.5" filter={url('schatten')} />
    <circle cx="217" cy="164" r="9" fill="none" stroke="#C2410C" stroke-width="1.5" />
    <path d="M217 159v5l3.5 2.5" fill="none" stroke="#C2410C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    <text x="234" y="171" font-size="20" font-weight="700" font-family={schrift} fill="#C2410C">22:47</text>
  </>)}
</svg>
