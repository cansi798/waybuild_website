---
// Ablauf „In 14 Tagen live“ als animierte Szene (digitaler Stil) in vier Stationen (Bauwelt-Muster).
import { href } from '../lib/paths';
import SectionHead from './SectionHead.astro';
import RoughSzene from './RoughSzene.astro';
---

<section class="section" id="ablauf" aria-labelledby="ablauf-h">
  <div class="wrap">
    <SectionHead center eyebrow="So läuft Ihr Projekt" pre="Vom Erstgespräch bis zur Website in " accent="14 Tagen" id="ablauf-h" />
    <RoughSzene
      szene="weg"
      label="Animierter Ablauf in vier Stationen: 1. Erstgespräch – 20 Minuten, kostenlos. 2. Entwurf – Ihr individuelles Design. 3. Livegang – in 14 Tagen online. 4. Betreuung – wir kümmern uns dauerhaft um alles."
    />
    <div class="weg__actions nur-desktop">
      <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Mit Schritt 1 starten</a>
      <a class="btn btn--lg btn--ghost" href={href('/leistungen/')}>Leistungen ansehen</a>
    </div>
  </div>
</section>

<style>
  .weg__actions { display: flex; flex-wrap: wrap; gap: 12px 16px; justify-content: center; margin-top: 8px; }
</style>
