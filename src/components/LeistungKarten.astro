---
// Startseite „Unsere Leistungen – Wobei wir Sie unterstützen“ (Bauwelt-Muster), seit 11.10.2026 nach
// vier Säulen: je Karte Grafik, Icon, Säule, Kurztext, Unterleistungen als Links und Preis-Teaser.
import { href } from '../lib/paths';
import { leistungenNach } from '../config/leistungen';
import { SAEULEN } from '../config/angebot';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import LeistungGrafik from './LeistungGrafik.astro';

const grafik = { websites: 'seite', software: 'software', cloud: 'cloud', beratung: 'analyse' } as const;
---

<section class="section section--sand" id="leistungen" aria-labelledby="leistungen-h">
  <div class="wrap">
    <SectionHead center eyebrow="Unsere Leistungen" pre="Wobei wir Ihr Unternehmen " accent="unterstützen" id="leistungen-h" text="Website, Software, Cloud und IT – aus einer Hand, mit einem Ansprechpartner." />
    <div class="lk">
      {SAEULEN.map((s) => (
        <article class="card lk__card reveal">
          <a class="lk__media" href={href(`/leistungen/#${s.id}`)} tabindex="-1" aria-hidden="true">
            <LeistungGrafik art={grafik[s.id]} />
            <span class="lk__icon"><Icon name={s.icon} size={22} /></span>
          </a>
          <div class="lk__body">
            <h3><a href={href(`/leistungen/#${s.id}`)}>{s.title}</a></h3>
            <p>{s.claim}</p>
            <ul class="lk__links">
              {leistungenNach(s.id).map((l) => <li><a href={href(`/leistungen/${l.slug}/`)}>{l.title}</a></li>)}
            </ul>
            <span class="lk__ab">{s.ab}</span>
          </div>
        </article>
      ))}
    </div>
    <p class="lk__all"><a class="btn btn--dark" href={href('/leistungen/')}>Alle Leistungen ansehen</a></p>
  </div>
</section>

<style>
  .lk { display: grid; gap: 20px; }
  @media (min-width: 720px) { .lk { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1160px) { .lk { grid-template-columns: repeat(4, 1fr); } }
  .lk__card { padding: 0; overflow: hidden; display: grid; grid-template-rows: auto 1fr; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .lk__card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--dark); }
  .lk__media { position: relative; display: block; aspect-ratio: 16 / 9; background: var(--paper-2); overflow: hidden; }
  .lk__icon {
    position: absolute; z-index: 2; left: 16px; bottom: 12px; width: 46px; height: 46px; border-radius: 12px;
    background: var(--dark); color: var(--accent); display: grid; place-items: center; box-shadow: var(--shadow);
  }
  .lk__body { padding: 20px 22px 22px; display: grid; gap: 8px; align-content: start; }
  .lk__body h3 { margin: 0; font-size: 1.3rem; }
  .lk__body h3 a { text-decoration: none; }
  .lk__body h3 a:hover { color: var(--accent-ink); }
  .lk__body p { margin: 0; color: var(--ink-soft); font-size: 0.93rem; }
  .lk__links { list-style: none; margin: 6px 0 0; padding: 10px 0 0; border-top: 1px solid var(--line); display: grid; gap: 2px; }
  .lk__links a { display: flex; align-items: center; gap: 6px; padding: 4px 0; font-weight: 600; font-size: 0.92rem; text-decoration: none; }
  .lk__links a::before { content: '→'; color: var(--accent-ink); }
  .lk__links a:hover { color: var(--accent-ink); }
  .lk__ab { margin-top: 6px; font-size: 0.82rem; font-weight: 700; color: var(--accent-ink); }
  .lk__all { margin: 28px 0 0; text-align: center; }
  @media (max-width: 599px) {
    .lk { gap: 12px; }
    .lk__media { aspect-ratio: 16 / 6; }
    .lk__icon { width: 38px; height: 38px; bottom: 8px; left: 12px; }
    .lk__body { padding: 14px 16px 16px; gap: 6px; }
    .lk__body h3 { font-size: 1.15rem; }
    .lk__links { grid-template-columns: 1fr 1fr; column-gap: 12px; }
    .lk__links a { font-size: 0.86rem; }
  }
</style>
