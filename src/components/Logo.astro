---
// waybuild-IT-Logo (WB-Marke + Schriftzug), Quelle: public/logo-waybuild-it.png (Wunsch 10.10.2026).
// Auf dunklem Grund (Footer) liegt es auf einer weißen Kachel – nicht umfärben.
import { href } from '../lib/paths';
---

<span class="logo">
  <img src={href('/logo-waybuild-it.png')} alt="waybuild IT" width="233" height="120" decoding="async" />
</span>

<style>
  .logo { display: inline-flex; align-items: center; }
  .logo img { display: block; height: 32px; width: auto; }
  @media (min-width: 720px) { .logo img { height: 40px; } }
</style>
