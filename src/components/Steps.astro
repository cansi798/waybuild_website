---
import { steps } from '../config/site';
import Icon from './Icon.astro';
import More from './More.astro';
import { href } from '../lib/paths';
---

<section class="section" id="ablauf" aria-labelledby="ablauf-h">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Ablauf</span>
      <h2 id="ablauf-h">In 4 Schritten online.</h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__icon"><Icon name={s.icon} /></span>
          <span class="step__no">Schritt {i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.short}</p>
          <More label="Details"><p>{s.text}</p></More>
        </li>
      ))}
    </ol>
    <p class="next"><a class="btn btn--primary" href={href('/kontakt/')}>Mit Schritt 1 starten</a></p>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 20px; }
  @media (min-width: 1000px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .step { position: relative; }
  .next { margin: 36px 0 0; text-align: center; }
  .step__icon {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; margin-bottom: 16px;
    background: var(--white); border: 1.5px solid var(--ink); color: var(--ink); position: relative; z-index: 1;
  }
  @media (min-width: 1000px) {
    .step:not(:last-child)::after {
      content: ''; position: absolute; top: 26px; left: 64px; right: 4px; height: 1.5px;
      background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 12px);
    }
  }
  .step__no { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); }
  .step h3 { margin: 2px 0 2px; }
  .step > p { color: var(--ink-soft); margin: 0; }
  @media (max-width: 599px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .step { display: grid; grid-template-columns: 44px 1fr; gap: 0 14px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); }
    .step__icon { width: 44px; height: 44px; margin: 0; grid-row: span 3; }
    .step__no { font-size: 0.7rem; }
    .step h3 { font-size: 1.02rem; margin: 0; }
    .step > p { font-size: 0.9rem; }
    .step :global(.more) { display: none; }
    .next { margin-top: 20px; }
  }
</style>
