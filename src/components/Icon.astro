  rocket: 'M12 15l-3-3c1.5-4.5 4.5-7.5 10-8-.5 5.5-3.5 8.5-8 10z M9 12l-4 1 2-4h4 M12 15l-1 4 4-2v-4 M6 18c-1 1-1.5 2.5-1.5 2.5S6 20 7 19',
