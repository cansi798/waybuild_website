---
// Abschnitt 2 „Problem“ der Startseite (Jamil, Talk qh87y3sj #5787–#5791, 13.11.2026): drei typische Schmerzpunkte mit den ruhigen
// Strichgrafiken aus /geschichte/ (geschichte/GGrafik.astro), die Jamil „sehr ansprechend“ findet.
import GGrafik from '../geschichte/GGrafik.astro';
import '../../styles/start-sechs.css';

const PUNKTE = [
  { grafik: 'suche', titel: 'Kunden suchen Sie. Und finden andere.', text: 'Wer bei Google nicht weit oben steht oder eine veraltete Seite hat, bekommt die Anfrage nicht.' },
  { grafik: 'abend', titel: 'Angebote schreiben Sie abends.', text: 'Nach dem Arbeitstag noch Preise ausrechnen und Texte tippen. Bis das Angebot raus ist, vergehen Tage.' },
  { grafik: 'rechnung', titel: 'Rechnungen gehen spät raus.', text: 'Zeiten, Material und Notizen liegen verteilt. Bis alles beisammen ist, kommt Ihr Geld später als nötig.' },
];
---

<section class="section s6-problem" id="problem" aria-labelledby="s6-problem-h">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">Kennen Sie das?</span>
      <h2 id="s6-problem-h" class="rule">Gute Arbeit allein reicht heute nicht.</h2>
    </div>
    <ul class="s6-schmerzen">
      {PUNKTE.map((p) => (
        <li class="s6-schmerz reveal">
          <div class="s6-schmerz__bild"><GGrafik name={p.grafik} suche="Betrieb in der Nähe" /></div>
          <h3 class="s6-schmerz__titel">{p.titel}</h3>
          <p class="s6-schmerz__text">{p.text}</p>
        </li>
      ))}
    </ul>
    <p class="s6-ueberleitung">Genau das lösen wir. So sieht das aus:</p>
  </div>
</section>
