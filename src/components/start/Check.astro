---
// Kundenreise-Check (Jamil, Talk qh87y3sj 4835): eine Frage pro Karte, große Antwort-Kacheln; nach dem Antippen
// gleitet die nächste Frage herein. Oben wandert die Figur aus dem Hero über die Schritte. Zurück-Knopf, per Tastatur
// und Screenreader bedienbar (Knöpfe mit aria-pressed, Fortschritt als Live-Region, Fokus auf die neue Frage).
// Ergebnis: Ampel je Station mit „Das bedeutet für Sie“ und Tipp, ohne Punktzahl; Weg je nach Ergebnis
// (Analyse / passendes Paket / gut aufgestellt). Alles nur im Browser. „Ergebnis mitschicken“ (aktiv anhaken) legt eine
// Kurzfassung in den sessionStorage; die Kontaktseite zeigt sie sichtbar und abwählbar und sendet sie mit der Anfrage.
import { href } from '../../lib/paths';
import { CHECK as C, ANLIEGEN } from '../../config/startseite';
import { PAKETE, formatEuro } from '../../config/site';
const N = C.fragen.length;
const stationen = C.fragen.filter((f) => C.texte[f.id]);
const daten = {
  fragen: C.fragen.map((f) => ({ id: f.id, schritt: f.schritt, antworten: f.antworten })),
  texte: C.texte, ampel: C.ampel, zielStation: C.zielStation, ergebnis: C.ergebnis,
  pakete: Object.fromEntries(PAKETE.map((p) => [p.id, `${p.name}, ${formatEuro(p.preis)} im Monat netto zzgl. MwSt.`])),
  kontakt: href('/kontakt/'), preise: href('/preise/'),
  analyse: `${ANLIEGEN.analyse.paket} (Kundenreise-Check)`, beratung: ANLIEGEN.erstberatung.paket,
};
const ICON: Record<string, string> = {
  aufmerksamkeit: '<rect x="15" y="7" width="18" height="30" rx="4" fill="#1f3140"/><rect x="18" y="11" width="12" height="20" rx="1.5" fill="#f8f7f4"/><circle cx="33" cy="9" r="5.5" fill="#7e9b8a"/>',
  vertrauen: '<path d="M24 8 l4.8 9.8 10.8 1.6 -7.8 7.6 1.8 10.7 -9.6 -5 -9.6 5 1.8 -10.7 -7.8 -7.6 10.8 -1.6 Z" fill="#7e9b8a"/>',
  anfrage: '<rect x="9" y="14" width="30" height="21" rx="3" fill="#fff" stroke="#1f3140" stroke-width="2.4"/><path d="M9 16 L24 27 L39 16" fill="none" stroke="#1f3140" stroke-width="2.4" stroke-linejoin="round"/>',
  bearbeitung: '<circle cx="22" cy="24" r="10" fill="none" stroke="#1f3140" stroke-width="5" stroke-dasharray="3.4 2.7"/><circle cx="22" cy="24" r="7" fill="#1f3140"/><circle cx="22" cy="24" r="2.7" fill="#f8f7f4"/>',
  zufrieden: '<path d="M24 39 c-2 -2 -15 -9 -15 -19 c0 -6 5 -9 9.5 -9 c3 0 4.6 1.6 5.5 3.6 c0.9 -2 2.5 -3.6 5.5 -3.6 c4.5 0 9.5 3 9.5 9 c0 10 -13 17 -15 19 Z" fill="#7e9b8a"/>',
};
---
<section class="bs bs--alt" id="check" aria-labelledby="bs-check">
  <div class="wrap">
    <div class="bs-kopf bs-kopf--mitte">
      <p class="eyebrow">{C.eyebrow}</p>
      <h2 id="bs-check">{C.titel}</h2>
      <p class="bs-lead">{C.einleitung}</p>
      <p class="kc__daten"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 2 3.5 4.6v4.6c0 4 2.8 7.6 6.5 8.8 3.7-1.2 6.5-4.8 6.5-8.8V4.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m7 10 2.2 2.2L13.4 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{C.datenschutz}</p>
    </div>

    <div class="kc" id="kc" data-check={JSON.stringify(daten)} style={`--n:${N}`}>
      <!-- Fortschritt: die Figur wandert über die Schritte -->
      <div class="kc__weg" aria-hidden="true">
        <ol class="kc__schritte">
          {C.fragen.map((f, i) => (
            <li class:list={['kc__schritt', { 'kc__schritt--station': !!ICON[f.id] }]} style={`--i:${i}`}>
              {ICON[f.id] ? <svg viewBox="0 0 48 48" set:html={ICON[f.id]} /> : <span class="kc__punkt"></span>}
            </li>
          ))}
        </ol>
        <span class="kc__spur"><span class="kc__gefuellt"></span></span>
        <span class="kc__laeufer"><span class="kc__figur">
          <svg viewBox="0 0 40 52"><path d="M6 51 C6 36 11 30 20 30 C29 30 34 36 34 51 Z" fill="#7e9b8a"/><circle cx="20" cy="17" r="10.5" fill="#f8f7f4" stroke="#1f3140" stroke-width="2.2"/><path d="M9.6 15 C9 7 15 4 20.5 5 C26.5 5.5 30.5 9.5 30 15 C27 11 22 10 18 11 C14.5 12 12 13 9.6 15 Z" fill="#1f3140"/><circle cx="16.5" cy="17" r="1.3" fill="#1f3140"/><circle cx="23.5" cy="17" r="1.3" fill="#1f3140"/><path d="M16 21 Q20 24.5 24 21" fill="none" stroke="#1f3140" stroke-width="1.6" stroke-linecap="round"/></svg>
        </span></span>
      </div>
      <p class="kc__stand" id="kc-stand" aria-live="polite">Frage 1 von {N} · {C.fragen[0].schritt}</p>

      <div class="kc__fenster">
        {C.fragen.map((f, i) => (
          <fieldset class:list={['kc__karte', { 'ist-aktiv': i === 0 }]} data-i={i} aria-labelledby={`kc-f${i}`}>
            <p class="kc__schrittname">{f.schritt}</p>
            <h3 class="kc__frage" id={`kc-f${i}`} tabindex="-1">{f.frage}</h3>
            {f.hinweis && <p class="kc__hinweis">{f.hinweis}</p>}
            <div class="kc__kacheln">
              {f.antworten.map(([label], k) => (
                <button type="button" class="kc__kachel" data-k={k} aria-pressed="false">{label}</button>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
      <div class="kc__nav">
        <button type="button" class="kc__zurueck" id="kc-zurueck" disabled>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Zurück
        </button>
      </div>
    </div>

    <noscript>
      <p class="kc__noscript">Der Check läuft direkt in Ihrem Browser und braucht dafür JavaScript. Gern schauen wir uns Ihren Auftritt auch persönlich an: <a href={href(`/kontakt/?paket=${encodeURIComponent(ANLIEGEN.analyse.paket)}`)}>{ANLIEGEN.analyse.label}</a></p>
    </noscript>

    <div class="kc-erg" id="kc-erg" hidden tabindex="-1" aria-labelledby="kc-erg-titel">
      <p class="eyebrow">Ihre Kundenreise</p>
      <h3 class="kc-erg__titel" id="kc-erg-titel"></h3>
      <ol class="kc-reise">
        {stationen.map((f) => (
          <li class="kc-reise__station" data-station={f.id}>
            <span class="kc-reise__icon" aria-hidden="true"><svg viewBox="0 0 48 48" set:html={ICON[f.id]} /></span>
            <div class="kc-reise__inhalt">
              <p class="kc-reise__kopf"><strong>{f.schritt}</strong><span class="kc-ampel"></span><span class="kc-reise__ziel" hidden>Ihr Ziel</span></p>
              <p class="kc-reise__bedeutet"></p>
              <p class="kc-reise__tipp"></p>
            </div>
          </li>
        ))}
      </ol>
      <p class="kc-erg__hinweis">{C.hinweis}</p>
      <div class="kc-erg__weiter">
        <p class="kc-erg__botschaft" id="kc-botschaft"></p>
        <label class="kc-erg__mit"><input type="checkbox" id="kc-mit" /> <span>{C.mitschicken}</span></label>
        <div class="kc-erg__knoepfe">
          <a class="btn btn--gold btn--lg" id="kc-cta1" href="#"></a>
          <a class="btn btn--umriss btn--lg" id="kc-cta2" href="#"></a>
          <button type="button" class="btn btn--umriss btn--lg" id="kc-druck" hidden>Ergebnis drucken</button>
        </div>
        <p class="kc-erg__textlink" id="kc-textlink" hidden><a href="#" id="kc-textlink-a">Wenn Sie es genau wissen wollen: kostenlose Analyse</a></p>
      </div>
      <button type="button" class="kc-erg__neu" id="kc-neu">Antworten ändern</button>
    </div>
  </div>
</section>

<script>
  type Ampel = 'g' | 'y' | 'r';
  const kc = document.getElementById('kc');
  const erg = document.getElementById('kc-erg');
  if (kc && erg) {
    const D = JSON.parse(kc.dataset.check || '{}');
    const karten = [...kc.querySelectorAll<HTMLFieldSetElement>('.kc__karte')];
    const stand = document.getElementById('kc-stand')!;
    const zurueck = document.getElementById('kc-zurueck') as HTMLButtonElement;
    const wahl: (number | undefined)[] = [];
    const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let akt = 0;

    const geheZu = (n: number, fokus = true) => {
      karten.forEach((k, i) => { k.classList.toggle('ist-aktiv', i === n); k.classList.toggle('ist-vorbei', i < n); });
      kc.style.setProperty('--schritt', String(n));
      stand.textContent = `Frage ${n + 1} von ${karten.length} · ${D.fragen[n].schritt}`;
      zurueck.disabled = n === 0;
      akt = n;
      if (fokus) setTimeout(() => karten[n].querySelector<HTMLElement>('.kc__frage')?.focus({ preventScroll: true }), ruhig ? 0 : 380);
    };

    karten.forEach((karte, i) => karte.querySelectorAll<HTMLButtonElement>('.kc__kachel').forEach((b) => b.addEventListener('click', () => {
      wahl[i] = Number(b.dataset.k);
      karte.querySelectorAll('.kc__kachel').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      setTimeout(() => (i < karten.length - 1 ? geheZu(i + 1) : zeigeErgebnis()), ruhig ? 60 : 320);
    })));
    zurueck.addEventListener('click', () => { if (akt > 0) geheZu(akt - 1); });

    const antwort = (id: string) => { const i = D.fragen.findIndex((f: { id: string }) => f.id === id); const k = wahl[i]; return k === undefined ? ['', null] : D.fragen[i].antworten[k]; };

    const zeigeErgebnis = (): void => {
      const stationen: { id: string; schritt: string; a: Ampel }[] = D.fragen.filter((f: { id: string }) => D.texte[f.id]).map((f: { id: string; schritt: string }) => ({ id: f.id, schritt: f.schritt, a: (antwort(f.id)[1] || 'y') as Ampel }));
      const gut = stationen.filter((s) => s.a === 'g').length;
      const rot = stationen.filter((s) => s.a === 'r').length;
      const gelb = stationen.filter((s) => s.a === 'y').length;
      const ziel = String(antwort('ziel')[0]);
      const groesse = Number(wahl[D.fragen.findIndex((f: { id: string }) => f.id === 'groesse')] ?? 0);
      document.getElementById('kc-erg-titel')!.textContent = `${gut} von ${stationen.length} Stationen laufen gut.`;
      stationen.forEach((s) => {
        const li = erg.querySelector<HTMLElement>(`[data-station="${s.id}"]`)!;
        li.dataset.ampel = s.a;
        li.querySelector('.kc-ampel')!.textContent = D.ampel[s.a];
        const [bedeutet, tipp] = D.texte[s.id][s.a];
        li.querySelector('.kc-reise__bedeutet')!.textContent = `Das bedeutet für Sie: ${bedeutet}`;
        li.querySelector('.kc-reise__tipp')!.textContent = `Tipp: ${tipp}`;
        (li.querySelector('.kc-reise__ziel') as HTMLElement).hidden = D.zielStation[ziel] !== s.id;
      });

      const stufe = rot >= 2 ? 'viel' : rot === 1 || gelb >= 2 ? 'mittel' : 'wenig';
      const kontakt = (paket: string) => `${D.kontakt}?paket=${encodeURIComponent(paket)}`;
      const cta1 = document.getElementById('kc-cta1') as HTMLAnchorElement;
      const cta2 = document.getElementById('kc-cta2') as HTMLAnchorElement;
      const druck = document.getElementById('kc-druck') as HTMLButtonElement;
      const textlink = document.getElementById('kc-textlink') as HTMLElement;
      const mit = document.getElementById('kc-mit')!.closest('label') as HTMLElement;
      const botschaft = document.getElementById('kc-botschaft')!;
      cta1.hidden = cta2.hidden = false; druck.hidden = true; textlink.hidden = true; mit.hidden = false;
      if (stufe === 'viel') {
        botschaft.textContent = D.ergebnis.viel;
        cta1.textContent = 'Kostenlose Analyse anfordern'; cta1.href = kontakt(D.analyse);
        cta2.textContent = 'Pakete ansehen'; cta2.href = D.preise;
      } else if (stufe === 'mittel') {
        const hinten = ['anfrage', 'bearbeitung', 'zufrieden'].some((id) => stationen.find((s) => s.id === id)?.a === 'r');
        const keinProfil = String(antwort('vertrauen')[0]).includes('kein Google-Profil');
        let paket = '';
        if (hinten && (groesse >= 2 || ziel === 'Weniger Büroarbeit')) paket = 'individuell';
        else if (ziel === 'Ein einheitlicher Auftritt') paket = 'wahrzeichen';
        else if (stationen[0].a !== 'g' || stationen[1].a !== 'g' || keinProfil || ziel === 'Mehr Anfragen') paket = 'wegweiser';
        else paket = 'fundament';
        if (paket === 'individuell') {
          botschaft.textContent = `${D.ergebnis.mittel} ${D.ergebnis.individuell}`;
          cta1.textContent = 'Erstgespräch zu Abläufen'; cta1.href = kontakt('Erstgespräch Abläufe (Kundenreise-Check)');
        } else {
          botschaft.textContent = `${D.ergebnis.mittel} Unser Vorschlag: Paket ${D.pakete[paket]}`;
          cta1.textContent = 'Paket ansehen'; cta1.href = D.preise;
        }
        cta2.textContent = 'Kurz beraten lassen'; cta2.href = kontakt(D.beratung);
      } else {
        const gelbe = stationen.find((s) => s.a === 'y');
        botschaft.textContent = `${D.ergebnis.wenig} ${gelbe ? D.texte[gelbe.id].y[1] : 'Bewertungen weiter pflegen.'}`;
        cta1.hidden = cta2.hidden = true; druck.hidden = false; textlink.hidden = false;
        (document.getElementById('kc-textlink-a') as HTMLAnchorElement).href = kontakt(D.analyse);
      }

      // Kurzfassung für die Kontaktseite (nur wenn aktiv angehakt)
      const g0 = String(antwort('groesse')[0]);
      const kurz = [`Betrieb: ${g0} ${g0 === '1' ? 'Person' : 'Personen'}`, `Ziel: ${ziel}`, ...stationen.map((s) => `${s.schritt}: ${D.ampel[s.a]} („${antwort(s.id)[0]}“)`)].join('\n');
      const merken = () => {
        try {
          if ((document.getElementById('kc-mit') as HTMLInputElement).checked) sessionStorage.setItem('wb-kundenreise-check', kurz);
          else sessionStorage.removeItem('wb-kundenreise-check');
        } catch { /* Speicher gesperrt: dann eben ohne Übergabe */ }
      };
      [cta1, cta2, document.getElementById('kc-textlink-a')!].forEach((a) => { a.onclick = merken; });
      druck.onclick = () => window.print();

      kc.hidden = true;
      erg.hidden = false;
      erg.focus({ preventScroll: true });
      erg.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' });
    };

    document.getElementById('kc-neu')?.addEventListener('click', () => {
      erg.hidden = true; kc.hidden = false; geheZu(0);
      kc.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'center' });
    });
    geheZu(0, false);
  }
</script>

<style>
  .kc__daten { display: inline-flex; align-items: center; gap: 8px; margin: 6px 0 0; padding: 8px 14px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); font-size: 0.9rem; font-weight: 600; line-height: 1.4; color: var(--accent-ink); text-align: left; }
  .kc__daten svg { flex: none; }

  .kc { --schritt: 0; max-width: 760px; margin: clamp(28px, 4vw, 44px) auto 0; padding: clamp(18px, 3.5vw, 36px); border-radius: 28px; background: var(--paper); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .kc[hidden] { display: none; }
  :global(html:not(.js)) .kc { display: none; }

  /* Fortschritt: Weg mit Schritten, die Figur wandert mit */
  .kc__weg { position: relative; height: 66px; margin: 0 15px; }
  .kc__schritte { position: absolute; inset: auto 0 0; height: 30px; margin: 0; padding: 0; list-style: none; z-index: 1; }
  .kc__schritt { position: absolute; top: 0; left: calc(var(--i) / (var(--n) - 1) * 100%); display: grid; place-items: center; width: 30px; height: 30px; margin-left: -15px; border-radius: 50%; background: var(--paper-2); }
  .kc__schritt svg { width: 22px; height: 22px; opacity: clamp(0.4, calc(var(--schritt) - var(--i) + 1), 1); transition: opacity 0.3s ease; }
  .kc__punkt { width: 8px; height: 8px; border-radius: 50%; background: #b7beb9; }
  .kc__spur { position: absolute; left: 0; right: 0; bottom: 13.5px; height: 3px; border-radius: 3px; background: var(--paper-2); }
  .kc__gefuellt { position: absolute; inset: 0; border-radius: 3px; background: linear-gradient(90deg, var(--salbei), var(--dark)); transform-origin: left; transform: scaleX(calc(var(--schritt) / (var(--n) - 1))); transition: transform 0.5s cubic-bezier(0.45, 0, 0.25, 1); }
  .kc__laeufer { position: absolute; left: 0; right: 0; top: 0; height: 34px; transform: translateX(calc(var(--schritt) / (var(--n) - 1) * 100%)); transition: transform 0.5s cubic-bezier(0.45, 0, 0.25, 1); pointer-events: none; }
  .kc__figur { position: absolute; left: 0; top: 0; width: 26px; margin-left: -13px; }
  .kc__figur svg { display: block; width: 100%; height: auto; }

  .kc__stand { margin: 12px 0 0; font-size: 0.85rem; font-weight: 600; color: var(--ink-soft); text-align: center; }

  /* Karten: alle in derselben Zelle, nur die aktive ist sichtbar; Wechsel = sanftes Gleiten */
  .kc__fenster { display: grid; margin-top: clamp(16px, 3vw, 26px); overflow: hidden; }
  .kc__karte { grid-area: 1 / 1; margin: 0; padding: 0; border: 0; min-width: 0;
    opacity: 0; visibility: hidden; transform: translateX(14%);
    transition: transform 0.45s cubic-bezier(0.3, 0.9, 0.3, 1), opacity 0.35s ease, visibility 0s linear 0.45s; }
  .kc__karte.ist-vorbei { transform: translateX(-14%); }
  .kc__karte.ist-aktiv { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .kc__schrittname { margin: 0 0 6px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); }
  .kc__frage { margin: 0 0 8px; font-size: clamp(1.3rem, 3.2vw, 1.75rem) !important; line-height: 1.3; outline: none; }
  .kc__hinweis { margin: 0 0 4px; font-size: 0.95rem; line-height: 1.55; color: var(--ink-soft); }
  .kc__kacheln { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
  @media (min-width: 640px) { .kc__kacheln { grid-template-columns: repeat(3, 1fr); } }
  .kc__kachel { min-height: 72px; padding: 14px 14px; border-radius: 16px; border: 1.5px solid var(--line); background: var(--white); font: inherit; font-family: var(--font-head); font-weight: 600; font-size: clamp(0.95rem, 2.4vw, 1.02rem); line-height: 1.3; color: var(--dark); text-align: left; cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease; }
  .kc__kachel:hover { border-color: var(--dark); transform: translateY(-2px); }
  .kc__kachel[aria-pressed='true'] { background: var(--dark); border-color: var(--dark); color: var(--white); }
  .kc__kachel:focus-visible { outline: 3px solid var(--salbei); outline-offset: 2px; }
  .kc__nav { display: flex; justify-content: space-between; margin-top: 18px; }
  .kc__zurueck { display: inline-flex; align-items: center; gap: 4px; padding: 8px 12px 8px 6px; border: 0; border-radius: 10px; background: none; font: inherit; font-weight: 650; color: var(--dark); cursor: pointer; }
  .kc__zurueck:disabled { opacity: 0.35; cursor: default; }
  .kc__zurueck:focus-visible { outline: 3px solid var(--salbei); }
  .kc__noscript { max-width: 760px; margin: 20px auto 0; text-align: center; }

  /* Ergebnis: Kundenreise mit Ampel je Station */
  .kc-erg { max-width: 860px; margin: clamp(28px, 4vw, 44px) auto 0; padding: clamp(22px, 4vw, 40px); border-radius: 28px; background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow); scroll-margin-top: 90px; outline: none; }
  .kc-erg__titel { margin: 0 0 18px; font-size: clamp(1.4rem, 3vw, 1.9rem) !important; }
  .kc-reise { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .kc-reise__station { display: grid; grid-template-columns: 48px 1fr; gap: 14px; padding: 16px; border-radius: 16px; background: var(--paper); border-left: 4px solid #b7beb9; }
  .kc-reise__station[data-ampel='g'] { border-left-color: #5f8a6f; }
  .kc-reise__station[data-ampel='y'] { border-left-color: #c2a56a; }
  .kc-reise__station[data-ampel='r'] { border-left-color: #b5654a; }
  .kc-reise__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--white); }
  .kc-reise__icon svg { width: 30px; height: 30px; }
  .kc-reise__kopf { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 2px 0 6px; color: var(--dark); }
  .kc-ampel { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 8px; border-radius: 999px; font-size: 0.82rem; font-weight: 700; }
  .kc-ampel::before { content: ''; width: 10px; height: 10px; border-radius: 50%; }
  [data-ampel='g'] .kc-ampel { background: rgb(95 138 111 / 14%); color: #3f6550; }
  [data-ampel='g'] .kc-ampel::before { background: #5f8a6f; }
  [data-ampel='y'] .kc-ampel { background: rgb(194 165 106 / 18%); color: #6d5627; }
  [data-ampel='y'] .kc-ampel::before { background: transparent; border: 2.5px solid #c2a56a; box-sizing: border-box; }
