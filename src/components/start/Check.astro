---
// Abschnitt 13: Unternehmensauftritt-Check (Jamil, Talk 4768). 10 Fragen in 5 Bereichen, Ja / Teilweise / Nein,
// Punkte werden NUR im Browser berechnet (kein Server, kein Speichern, kein Senden). Ergebnis gesamt (0–100) plus
// Einordnung je Bereich (0–20). Der Knopf „Kostenlose Analyse anfordern“ öffnet die Kontaktseite mit vorbelegtem
// Anliegen inkl. Punktzahl (?paket=…, max. 60 Zeichen) – abgeschickt wird erst, wenn der Besucher selbst sendet.
import { href } from '../../lib/paths';
import { CHECK as C, ANLIEGEN } from '../../config/startseite';
let nr = 0;
const kontaktBasis = href('/kontakt/');
const urteile = Object.fromEntries(C.bereiche.map((b) => [b.id, b.urteil]));
---
<section class="bs bs--alt chk-abschnitt" id="check" aria-labelledby="bs-check">
  <div class="wrap">
    <div class="bs-kopf bs-kopf--mitte">
      <p class="eyebrow">{C.eyebrow}</p>
      <h2 id="bs-check">{C.titel}</h2>
      <p class="bs-lead">{C.einleitung}</p>
      <p class="chk__daten"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 2 3.5 4.6v4.6c0 4 2.8 7.6 6.5 8.8 3.7-1.2 6.5-4.8 6.5-8.8V4.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m7 10 2.2 2.2L13.4 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{C.datenschutz}</p>
    </div>

    <form class="chk" id="chk-form" data-kontakt={kontaktBasis} data-paket={ANLIEGEN.analyse.paket} data-urteile={JSON.stringify(urteile)} data-gesamt={JSON.stringify(C.gesamt)} novalidate>
      <ol class="chk__fragen">
        {C.bereiche.map((b) => b.fragen.map((f) => {
          const i = nr++;
          return (
            <li class="chk__frage">
              <fieldset data-bereich={b.id}>
                <legend><span class="chk__nr">{i + 1}</span><span class="chk__text">{f}<small>{b.name}</small></span></legend>
                <div class="chk__wahl">
                  {C.antworten.map(([label, wert]) => (
                    <label class="chk__opt"><input type="radio" name={`f${i}`} value={wert} /><span>{label}</span></label>
                  ))}
                </div>
              </fieldset>
            </li>
          );
        }))}
      </ol>
      <div class="chk__fuss">
        <p class="chk__stand" id="chk-stand" aria-live="polite">0 von 10 Fragen beantwortet</p>
        <button class="btn btn--marke btn--lg" type="submit">Ergebnis anzeigen</button>
      </div>
      <p class="chk__fehlt" id="chk-fehlt" role="alert"></p>
    </form>

    <noscript>
      <p class="chk__noscript">Der Check rechnet direkt in Ihrem Browser und braucht dafür JavaScript. Gern schauen wir uns Ihren Auftritt auch persönlich an: <a href={href(`/kontakt/?paket=${encodeURIComponent(ANLIEGEN.analyse.paket)}`)}>{C.cta}</a></p>
    </noscript>

    <div class="chk-erg" id="chk-erg" hidden tabindex="-1" aria-labelledby="chk-erg-titel">
      <div class="chk-erg__kopf">
        <div class="chk-ring" aria-hidden="true">
          <svg viewBox="0 0 120 120"><circle class="chk-ring__spur" cx="60" cy="60" r="52" /><circle class="chk-ring__wert" cx="60" cy="60" r="52" pathLength="100" /></svg>
          <span class="chk-ring__zahl" id="chk-zahl">0</span>
        </div>
        <div>
          <h3 id="chk-erg-titel" class="chk-erg__titel"><span id="chk-punkte">0</span> von 100 Punkten</h3>
          <p class="chk-erg__urteil" id="chk-urteil"></p>
        </div>
      </div>
      <ul class="chk-erg__bereiche">
        {C.bereiche.map((b) => (
          <li data-erg={b.id}>
            <p class="chk-erg__name"><strong>{b.name}</strong><span class="chk-erg__pkt">0 von 20</span></p>
            <span class="chk-erg__balken" aria-hidden="true"><span></span></span>
            <p class="chk-erg__text"></p>
          </li>
        ))}
      </ul>
      <p class="chk-erg__hinweis">{C.hinweis}</p>
      <div class="chk-erg__cta">
        <a class="btn btn--marke btn--lg" id="chk-cta" href={href(`/kontakt/?paket=${encodeURIComponent(ANLIEGEN.analyse.paket)}`)}>{C.cta}</a>
        <button class="btn btn--umriss btn--lg" type="button" id="chk-neu">Antworten ändern</button>
      </div>
      <p class="chk-erg__klein">{C.ctaHinweis}</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('chk-form') as HTMLFormElement | null;
  const erg = document.getElementById('chk-erg');
  if (form && erg) {
    const urteile: Record<string, [string, string, string]> = JSON.parse(form.dataset.urteile || '{}');
    const gesamt: [number, string][] = JSON.parse(form.dataset.gesamt || '[]');
    const sets = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset')];
    const stand = document.getElementById('chk-stand')!;
    const fehlt = document.getElementById('chk-fehlt')!;
    const wert = (fs: HTMLFieldSetElement) => fs.querySelector<HTMLInputElement>('input:checked')?.value;
    const zaehle = () => {
      const n = sets.filter((fs) => wert(fs) !== undefined).length;
      stand.textContent = `${n} von ${sets.length} Fragen beantwortet`;
      return n;
    };
    form.addEventListener('change', (e) => {
      zaehle();
      (e.target as HTMLElement).closest('.chk__frage')?.classList.add('ist-beantwortet');
      if (fehlt.textContent) fehlt.textContent = '';
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const offen = sets.map((fs, i) => (wert(fs) === undefined ? i + 1 : 0)).filter(Boolean);
      if (offen.length) {
        fehlt.textContent = `Bitte beantworten Sie noch ${offen.length === 1 ? 'Frage' : 'die Fragen'} ${offen.join(', ')}.`;
        sets[offen[0] - 1].querySelector<HTMLInputElement>('input')?.focus();
        return;
      }
      const proBereich: Record<string, number> = {};
      let summe = 0;
      sets.forEach((fs) => { const v = Number(wert(fs)); summe += v; proBereich[fs.dataset.bereich!] = (proBereich[fs.dataset.bereich!] || 0) + v; });
      document.getElementById('chk-punkte')!.textContent = String(summe);
      document.getElementById('chk-zahl')!.textContent = String(summe);
      document.getElementById('chk-urteil')!.textContent = (gesamt.find(([ab]) => summe >= ab) || gesamt[gesamt.length - 1])[1];
      erg.querySelectorAll<HTMLElement>('[data-erg]').forEach((li) => {
        const p = proBereich[li.dataset.erg!] || 0;
        li.querySelector('.chk-erg__pkt')!.textContent = `${p} von 20`;
        li.querySelector('.chk-erg__text')!.textContent = urteile[li.dataset.erg!][p >= 16 ? 2 : p >= 8 ? 1 : 0];
        li.style.setProperty('--w', String(p / 20));
        li.dataset.stufe = p >= 16 ? 'stark' : p >= 8 ? 'mittel' : 'schwach';
      });
      erg.style.setProperty('--off', String(100 - summe));
      const paket = `${form.dataset.paket} (Check: ${summe} von 100 Punkten)`.slice(0, 60);
      (document.getElementById('chk-cta') as HTMLAnchorElement).href = `${form.dataset.kontakt}?paket=${encodeURIComponent(paket)}`;
      erg.classList.remove('ist-da');
      erg.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => erg.classList.add('ist-da')));
      erg.focus({ preventScroll: true });
      erg.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });
    document.getElementById('chk-neu')?.addEventListener('click', () => {
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      sets[0].querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .chk__daten { display: inline-flex; align-items: center; gap: 8px; margin: 6px 0 0; padding: 8px 14px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); font-size: 0.92rem; font-weight: 600; color: var(--accent-ink); }
  .chk__daten svg { flex: none; }
  .chk { max-width: 860px; margin: clamp(28px, 4vw, 44px) auto 0; }
  .chk__fragen { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .chk__frage fieldset { margin: 0; padding: 16px 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); display: grid; gap: 12px; transition: border-color 0.2s ease; }
  .chk__frage.ist-beantwortet fieldset { border-color: #b9c7bd; }
  .chk__frage legend { float: left; width: 100%; padding: 0; display: flex; gap: 12px; align-items: flex-start; }
  .chk__frage legend + * { clear: both; }
  .chk__nr { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--paper-2); font-family: var(--font-head); font-weight: 700; font-size: 0.88rem; color: var(--dark); }
  .chk__frage.ist-beantwortet .chk__nr { background: var(--dark); color: var(--white); }
  .chk__text { font-family: var(--font-head); font-weight: 600; font-size: clamp(1rem, 1.8vw, 1.1rem); line-height: 1.4; color: var(--dark); }
  .chk__text small { display: block; margin-top: 2px; font-family: var(--font-body, inherit); font-weight: 600; font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); }
  .chk__wahl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .chk__opt { position: relative; }
  .chk__opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .chk__opt span { display: block; padding: 10px 6px; border-radius: 10px; border: 1.5px solid var(--line); background: var(--white); text-align: center; font-weight: 650; font-size: 0.95rem; color: var(--dark); transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
  .chk__opt input:hover + span { border-color: var(--dark); }
  .chk__opt input:checked + span { background: var(--dark); border-color: var(--dark); color: var(--white); }
  .chk__opt input:focus-visible + span { outline: 3px solid var(--gold); outline-offset: 2px; }
  @media (min-width: 760px) {
    .chk__frage fieldset { grid-template-columns: 1fr 300px; align-items: center; }
    .chk__frage legend { float: none; grid-column: 1; }
    .chk__wahl { grid-column: 2; }
  }
  .chk__fuss { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: 22px; }
  .chk__stand { margin: 0; font-weight: 600; color: var(--ink-soft); }
  .chk__fehlt { margin: 12px 0 0; font-weight: 650; color: #8a3b2e; }
  .chk__fehlt:empty { display: none; }
  @media (max-width: 599px) { .chk__fuss .btn { width: 100%; } }
  .chk__noscript { max-width: 760px; margin: 20px auto 0; text-align: center; }

  .chk-erg { max-width: 860px; margin: clamp(32px, 5vw, 52px) auto 0; padding: clamp(22px, 4vw, 40px); border-radius: var(--radius); background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow); scroll-margin-top: 90px; outline: none; }
  .chk-erg__kopf { display: grid; grid-template-columns: auto 1fr; gap: clamp(16px, 3vw, 32px); align-items: center; }
  .chk-ring { position: relative; width: clamp(104px, 22vw, 140px); aspect-ratio: 1; }
  .chk-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .chk-ring circle { fill: none; stroke-width: 10; }
  .chk-ring__spur { stroke: var(--paper-2); }
  .chk-ring__wert { stroke: var(--gold); stroke-linecap: round; stroke-dasharray: 100 100; stroke-dashoffset: 100; }
  .chk-erg.ist-da .chk-ring__wert { stroke-dashoffset: var(--off); transition: stroke-dashoffset 1.2s cubic-bezier(0.45, 0, 0.25, 1); }
  .chk-ring__zahl { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; font-size: clamp(1.7rem, 4.6vw, 2.3rem); color: var(--dark); }
  .chk-erg__titel { margin: 0 0 6px; font-size: clamp(1.3rem, 2.6vw, 1.7rem); }
  .chk-erg__urteil { margin: 0; font-size: 1.05rem; line-height: 1.6; color: var(--ink-soft); }
  .chk-erg__bereiche { list-style: none; margin: clamp(22px, 3vw, 32px) 0 0; padding: 0; display: grid; gap: 16px; }
  .chk-erg__name { display: flex; justify-content: space-between; gap: 10px; margin: 0 0 6px; color: var(--dark); }
  .chk-erg__pkt { font-weight: 650; color: var(--ink-soft); white-space: nowrap; }
  .chk-erg__balken { display: block; height: 8px; border-radius: 8px; background: var(--paper-2); overflow: hidden; }
  .chk-erg__balken span { display: block; height: 100%; border-radius: 8px; background: var(--salbei); transform-origin: left; transform: scaleX(0); }
  [data-stufe='stark'] .chk-erg__balken span { background: var(--gold); }
  [data-stufe='schwach'] .chk-erg__balken span { background: #b7beb9; }
  .chk-erg.ist-da .chk-erg__balken span { transform: scaleX(var(--w)); transition: transform 0.9s cubic-bezier(0.45, 0, 0.25, 1) 0.3s; }
  .chk-erg__text { margin: 6px 0 0; font-size: 0.95rem; line-height: 1.55; color: var(--ink-soft); }
  .chk-erg__hinweis { margin: 22px 0 0; font-size: 0.92rem; color: var(--ink-soft); }
  .chk-erg__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  @media (max-width: 599px) { .chk-erg__cta .btn { width: 100%; } }
  .chk-erg__klein { margin: 12px 0 0; font-size: 0.85rem; line-height: 1.55; color: var(--ink-soft); }
  @media (prefers-reduced-motion: reduce) {
    .chk-erg.ist-da .chk-ring__wert, .chk-erg.ist-da .chk-erg__balken span { transition: none; }
  }
</style>
