---
// Abschnitt 1 „Aufmerksamkeit“, Teil 2 der Startseite (Jamil, Talk qh87y3sj #5787–#5791, 13.11.2026): direkt unter dem Hero zwei
// Produkte – „Ihre Website“ (Basis / Plus) und „Ihre Betriebs-App“ (Komplettpaket, nur in Kombination). Gleitet als zweiter Teil
// von .stapel-paar über den stehenden Hero. Preise und Leistungen kommen aus config/pakete-abo.ts (nichts fest im Text).
import StartGrafik from './StartGrafik.astro';
import Icon from '../Icon.astro';
import { ABO_PAKETE, KOMPLETTPAKET, euro, komplettPreis, B2B_HINWEIS } from '../../config/pakete-abo';
import { href } from '../../lib/paths';
import '../../styles/start-sechs.css';

const basis = ABO_PAKETE.find((p) => p.id === 'basis')!;
const plus = ABO_PAKETE.find((p) => p.id === 'plus')!;
const appPunkte = KOMPLETTPAKET.vorteile.map((v) => v.text);
---

<section class="section s6-produkte" id="leistungen" aria-labelledby="s6-produkte-h">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">Was wir für Sie machen</span>
      <h2 id="s6-produkte-h" class="rule">Eine Website, die Kunden bringt. Und eine App, die Ihnen Arbeit abnimmt.</h2>
      <p class="lead">Sie starten mit der Website. Die Betriebs-App kommt dazu, wenn Sie so weit sind.</p>
    </div>

    <ul class="s6-karten">
      <li class="s6-karte reveal">
        <div class="s6-karte__bild"><StartGrafik name="website" /></div>
        <h3 class="s6-karte__titel">Ihre Website</h3>
        <p class="s6-karte__kurz">Professionell online, von uns betreut. Änderungen jederzeit per Chat oder Sprachnachricht.</p>
        <div class="s6-stufen">
          <div class="s6-stufe">
            <p class="s6-stufe__name">{basis.name}</p>
            <p class="s6-stufe__was">{basis.kurz}</p>
            <p class="s6-stufe__preis">{euro(basis.preis)} <span>im Monat</span></p>
          </div>
          <div class="s6-stufe s6-stufe--plus">
            <p class="s6-stufe__name">{plus.name} <span class="s6-stufe__tipp">Empfohlen</span></p>
            <p class="s6-stufe__was">Mit ständiger Optimierung, damit Sie gefunden werden</p>
            <p class="s6-stufe__preis">{euro(plus.preis)} <span>im Monat</span></p>
          </div>
        </div>
        <a class="s6-link" href="#pakete">Pakete vergleichen <Icon name="arrow" size={18} /></a>
      </li>

      <li class="s6-karte s6-karte--app reveal">
        <div class="s6-karte__bild"><StartGrafik name="app" /></div>
        <h3 class="s6-karte__titel">Ihre Betriebs-App</h3>
        <p class="s6-karte__kurz">{KOMPLETTPAKET.text.replace(' Nur zusammen mit Basis oder Plus buchbar.', '')}</p>
        <ul class="s6-punkte">
          {appPunkte.map((t) => <li><Icon name="check" size={18} /><span>{t}</span></li>)}
        </ul>
        <p class="s6-karte__preis">Zur Website dazu: <strong>{komplettPreis()}</strong> im Monat</p>
        <a class="s6-link" href={href('/so-kann-es-laufen/')}>So kann es bei Ihnen laufen <Icon name="arrow" size={18} /></a>
      </li>
    </ul>

    <p class="s6-hinweis">{B2B_HINWEIS}</p>
  </div>
</section>
