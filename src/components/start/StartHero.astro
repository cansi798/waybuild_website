---
// Hero der Startseite (Texte Jamil, Talk qh87y3sj 4771 + 4783). Text steht beim Laden sofort (kein Einblenden, gut für
// LCP). Rechts bzw. darunter die kleine Kundengeschichte in fünf Stationen (Jamil 4784, KundenGeschichte.astro).
// Knöpfe springen zum Check (#check) und zum Abschnitt Verständnis (#denkweise).
// 08.11.2026 (Jamil 4927/4929, Rethinking „einladender“): der Claim (Jamil 4793) steht als Botschaftszeile über der
// Überschrift (vorher nur ganz unten), die Zielgruppe rückt unter die Knöpfe. Knöpfe am PC nebeneinander.
// 08.11.2026 (Jamil #4934 Punkt 4): Preis früh nennen, Zeile unter den Knöpfen; Betrag seit #5056 aus pakete-abo.ts (ab-Preis).
// 08.11.2026 (Jamil #4983–#4985): Botschaftszeile (Claim) über der H1 und Zielgruppenzeile unter den Knöpfen ENTFERNT
// („zu ähnlich wie die Headline“, „Alles aus einer Hand stimmt inhaltlich nicht“, „entfernen … im Hero-Bereich“).
// Sicherung des Stands davor: Branch vor-hero-bausteine-20261108.
import { HERO as H, PREIS_FRUEH as P } from '../../config/startseite';
import { aboPreisAb, euro } from '../../config/pakete-abo';
import KundenGeschichte from './KundenGeschichte.astro';
---
<section class="sh" aria-labelledby="sh-titel">
  <div class="wrap sh__raster">
    <div class="sh__text">
      <h1 id="sh-titel" class="sh__titel">{H.titel}</h1>
      {H.unter.map((u) => <p class="sh__unter">{u}</p>)}
      <div class="sh__knoepfe">
        <a class="btn btn--marke btn--lg" href="#check">{H.cta}</a>
        <a class="btn btn--umriss btn--lg" href="#denkweise">{H.cta2}</a>
      </div>
      <p class="sh__preis">{P.vor} <strong>{euro(aboPreisAb())}</strong> {P.nach} <span class="sh__preis-zeile"><span class="sh__preis-zusatz">{P.zusatz}</span> <a href="#pakete">{P.link}</a></span></p>
    </div>
    <figure class="sh__bild">
      <KundenGeschichte />
    </figure>
  </div>
</section>

<style>
  .sh { padding-block: clamp(24px, 4vw, 56px) clamp(40px, 6vw, 80px); background: var(--paper); overflow: hidden; }
  .sh__raster { display: grid; gap: clamp(20px, 4vw, 40px); align-items: center; }
  .sh__preis { margin: 18px 0 0; font-size: 1.05rem; line-height: 1.6; color: var(--ink); }
  .sh__preis strong { font-family: var(--font-head); font-size: 1.2em; font-weight: 700; color: var(--dark); }
  .sh__preis-zeile { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .sh__preis-zusatz { font-size: 0.85rem; color: var(--ink-soft); }
  .sh__preis a { font-weight: 650; color: var(--dark); text-underline-offset: 3px; white-space: nowrap; }
  .sh__titel { margin: 0; font-size: clamp(2rem, 4.4vw, 3.25rem); font-weight: 700; line-height: 1.07; letter-spacing: -0.03em; color: var(--ink); max-width: 18ch; }
  .sh__unter + .sh__unter { margin-top: 0.7em; }
  .sh__unter { margin: 0.8em 0 0; font-size: clamp(1.1rem, 2vw, 1.32rem); line-height: 1.55; color: var(--ink-soft); max-width: 36ch; }
  .sh__knoepfe { display: flex; flex-wrap: wrap; gap: 12px; margin-top: clamp(22px, 3vw, 32px); }
  .sh__knoepfe .btn { padding-inline: 1.3em; }
  @media (max-width: 599px) { .sh__knoepfe .btn { width: 100%; } }
  .sh__bild { margin: 0; }
  .sh__botschaft { max-width: 460px; margin: 10px auto 0; text-align: center; font-size: 1rem; line-height: 1.6; color: var(--ink-soft); }
  .sh__botschaft strong { display: block; color: var(--dark); font-weight: 650; }
  @media (min-width: 960px) {
    .sh__raster { grid-template-columns: 1.25fr 1fr; column-gap: clamp(32px, 5vw, 72px); }
  }
</style>
