---
// „Was Sie davon haben.“ (#vorteile, Jamil, Talk qh87y3sj #5381, 10.11.2026; Sicherung Branch vor-vorteile-20261110):
// sechs Vorteile aus Sicht des Besuchers, direkt nach der Kundenreise und vor „So gehen wir vor“. Texte: VORTEILE in
// src/config/startseite.ts, Stil: src/styles/startseite.css (.vt-*). PC drei Spalten, Tablet zwei, Handy eine.
// Bewegung: die Karten blenden mit der vorhandenen .reveal-Klasse (BaseLayout) nacheinander ein (--i = Verzögerung);
// ohne JS oder bei reduzierter Bewegung stehen sie sofort da.
import Icon from '../Icon.astro';
import { VORTEILE } from '../../config/startseite';
---

<section class="section vt" id="vorteile" aria-labelledby="vt-h">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">{VORTEILE.eyebrow}</span>
      <h2 id="vt-h" class="rule">{VORTEILE.titel}</h2>
      <p class="lead">{VORTEILE.intro}</p>
    </div>
    <ul class="vt-liste">
      {VORTEILE.liste.map((v, i) => (
        <li class="vt-karte reveal" style={`--i:${i}`}>
          <span class="vt-icon"><Icon name={v.icon} size={24} /></span>
          <h3 class="vt-titel">{v.titel}</h3>
          <p class="vt-text">{v.text}</p>
          {v.paket && <p class="vt-paket">{v.paket}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
