---
// Karten-Abschnitt der Startseite (Jamil, Talk qh87y3sj #5664–#5666, „ok“ #5670/#5672, 12.11.2026): Kennzeile, Überschrift (h2),
// Einleitung, Karten mit großem Symbol (Stil der Kundenreise-Symbole, ohne Kreis), Titel (h3) und Text, keine Paket-Etiketten.
// Genutzt für „So machen wir aus Besuchern Kunden.“ (#umsetzung) und „Ganz entspannt. Das ist unser Motto.“ (#entspannt).
// Hereingleiten nacheinander über das vorhandene .reveal (BaseLayout: IntersectionObserver, nur transform/opacity; reduzierte
// Bewegung oder ohne JS sofort sichtbar). Daten: src/config/startseite.ts (UMSETZUNG, ENTSPANNT), Stil: karten-abschnitt.css.
import Icon from '../Icon.astro';
import type { KartenAbschnitt } from '../../config/startseite';
import '../../styles/karten-abschnitt.css';

interface Props { daten: KartenAbschnitt; flaeche?: 'weiss' | 'tuerkis' }
const { daten, flaeche = 'weiss' } = Astro.props;
const hid = `${daten.id}-h`;
---

<section class:list={['section', 'ka', `ka--${flaeche}`]} id={daten.id} aria-labelledby={hid}>
  <div class="wrap">
    <div class="section-head center ka-kopf">
      <span class="eyebrow">{daten.kennzeile}</span>
      <h2 id={hid} class="rule">{daten.titel}</h2>
      <p class="lead">{daten.intro}</p>
    </div>
    <ul class:list={['ka-liste', `ka-liste--${daten.karten.length}`]}>
      {daten.karten.map((k) => (
        <li class="ka-karte reveal">
          <span class="ka-symbol" aria-hidden="true"><Icon name={k.icon} size={48} /></span>
          <h3 class="ka-titel">{k.titel}</h3>
          <p class="ka-text">{k.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
