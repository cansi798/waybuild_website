---
// „So arbeiten wir.“ (Jamil, Talk qh87y3sj #5192, „ok“ #5194, 09.11.2026): Verantwortung, Einfachheit, Verlässlichkeit.
// Keine Animation („keine Animation notwendig, schön dargestellt passend zum Stil“). PC drei Spalten, Handy untereinander.
// Je Prinzip: Wort groß in Türkis, darunter Jamils Leitsatz, dann sein Text mit seinen Zeilenumbrüchen, Schlusssatz hervorgehoben.
// Texte: src/config/vorgehen.ts (PRINZIPIEN), Stil: src/styles/vorgehen.css (.pz-*).
import { PRINZIPIEN } from '../../config/vorgehen';
import '../../styles/vorgehen.css';
---

<section class="section pz" id="arbeitsweise" aria-labelledby="pz-h">
  <div class="wrap">
    <div class="section-head center">
      <h2 id="pz-h" class="rule">{PRINZIPIEN.titel}</h2>
    </div>
    <ul class="pz-liste">
      {PRINZIPIEN.liste.map((p) => (
        <li class="pz-karte">
          <h3 class="pz-wort">{p.wort}</h3>
          <p class="pz-leit">{p.leit}</p>
          <div class="pz-text">
            {p.zeilen.map((z) => <p>{z}</p>)}
          </div>
          <p class="pz-schluss">{p.schluss.map((s, i) => <>{i > 0 && <br />}{s}</>)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
