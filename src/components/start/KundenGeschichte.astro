---
// Hero-Animation (Jamil, Talk qh87y3sj 4784 + 4837, 06.11.2026): die Kundengeschichte als KREISLAUF.
// Alle fünf Momente sind gleichzeitig zu sehen (Aufmerksamkeit, Vertrauen, Anfrage, Bearbeitung, Zufriedener Kunde).
// Eine kleine Figur geht ruhig von Station zu Station; dort, wo sie steht, leuchtet die Station kurz auf. Nach dem
// zufriedenen Kunden geht sie weiter zur Aufmerksamkeit: Zufriedene Kunden empfehlen weiter, die Geschichte beginnt
// von vorn. Kein Stillstand, kein Karussell, kein Prozess-Diagramm.
// Technik: nur CSS-Keyframes auf HTML-Ebenen (transform/opacity, läuft auf dem Compositor), ein Umlauf 15 s.
// Läuft nur im Sichtbereich (IntersectionObserver → .ist-sichtbar). Reduzierte Bewegung / ohne JS: ruhiges Gesamtbild.
import { HERO } from '../../config/startseite';
const S = HERO.stationen;
const R = 37; // Abstand der Stationen vom Mittelpunkt in % der Bühne
const pos = S.map((_, i) => { const a = ((-90 + i * 72) * Math.PI) / 180; return { x: 50 + R * Math.cos(a), y: 50 + R * Math.sin(a) }; });
const stern = (x: number, y: number, r: number) => {
  const p: string[] = [];
  for (let k = 0; k < 10; k++) { const a = -Math.PI / 2 + (k * Math.PI) / 5; const rr = k % 2 ? r * 0.45 : r; p.push(`${(x + rr * Math.cos(a)).toFixed(1)},${(y + rr * Math.sin(a)).toFixed(1)}`); }
  return p.join(' ');
};
const ICON = [
  // Aufmerksamkeit: Handy mit Benachrichtigung
  `<rect x="15" y="7" width="18" height="30" rx="4" fill="#1f3140"/><rect x="18" y="11" width="12" height="20" rx="1.5" fill="#f8f7f4"/><rect x="20" y="14" width="8" height="2.4" rx="1.2" fill="#7e9b8a"/><rect x="20" y="19" width="6" height="2.4" rx="1.2" fill="#cdc6ba"/><circle class="ks-pop" cx="33" cy="9" r="5.5" fill="#d6a85a"/>`,
  // Vertrauen: Sterne
  `<polygon points="${stern(12, 24, 7)}" fill="#d6a85a"/><polygon class="ks-pop" points="${stern(24, 16, 8.5)}" fill="#d6a85a"/><polygon points="${stern(36, 24, 7)}" fill="#d6a85a"/><rect x="12" y="33" width="24" height="3" rx="1.5" fill="#cdc6ba"/>`,
  // Anfrage: Brief
  `<g class="ks-pop"><rect x="9" y="14" width="30" height="21" rx="3" fill="#fff" stroke="#1f3140" stroke-width="2.2"/><path d="M9 16 L24 27 L39 16" fill="none" stroke="#1f3140" stroke-width="2.2" stroke-linejoin="round"/></g><circle cx="38" cy="14" r="4" fill="#d6a85a"/>`,
  // Bearbeitung: Zahnräder
  `<g class="ks-dreh"><circle cx="20" cy="22" r="9.5" fill="none" stroke="#1f3140" stroke-width="5" stroke-dasharray="3.3 2.6"/><circle cx="20" cy="22" r="6.5" fill="#1f3140"/><circle cx="20" cy="22" r="2.6" fill="#f8f7f4"/></g><circle cx="34" cy="33" r="6.5" fill="none" stroke="#7e9b8a" stroke-width="4" stroke-dasharray="2.6 2"/><circle cx="34" cy="33" r="4.5" fill="#7e9b8a"/><circle cx="34" cy="33" r="1.8" fill="#f8f7f4"/>`,
  // Zufriedener Kunde: Herz
  `<path class="ks-pop" d="M24 39 c-2 -2 -15 -9 -15 -19 c0 -6 5 -9 9.5 -9 c3 0 4.6 1.6 5.5 3.6 c0.9 -2 2.5 -3.6 5.5 -3.6 c4.5 0 9.5 3 9.5 9 c0 10 -13 17 -15 19 Z" fill="#d6a85a"/>`,
];
---
<div class="ks" role="img" aria-label={`Die Geschichte eines Kunden als Kreislauf: ${S.join(', ')}. Zufriedene Kunden empfehlen weiter, und alles beginnt von vorn.`}>
  <div class="ks__buehne">
    <span class="ks__weg" aria-hidden="true"></span>
    <span class="ks__mitte" aria-hidden="true">
      <svg viewBox="0 0 48 48" width="34" height="34"><path d="M10 26 a14 14 0 1 1 6 11" fill="none" stroke="#7e9b8a" stroke-width="3" stroke-linecap="round"/><path d="M10 33 l0 -7 l7 1" fill="none" stroke="#7e9b8a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    {S.map((label, i) => (
      <div class:list={['ks__station', `ks__station--${i + 1}`]} style={`left:${pos[i].x.toFixed(2)}%;top:${pos[i].y.toFixed(2)}%;--i:${i}`} aria-hidden="true">
        <span class="ks__scheibe">
          <span class="ks__glanz"></span>
          <svg class="ks__icon" viewBox="0 0 48 48" set:html={ICON[i]} />
        </span>
        <span class="ks__label">{label}</span>
      </div>
    ))}
    <div class="ks__bahn" aria-hidden="true">
      <div class="ks__figur">
        <svg class="ks__person" viewBox="0 0 40 52">
          <path d="M6 51 C6 36 11 30 20 30 C29 30 34 36 34 51 Z" fill="#7e9b8a" />
          <path d="M15 30 L20 36 L25 30" fill="none" stroke="#f8f7f4" stroke-width="2" stroke-linejoin="round" />
          <circle cx="20" cy="17" r="10.5" fill="#f8f7f4" stroke="#1f3140" stroke-width="2" />
          <path d="M9.6 15 C9 7 15 4 20.5 5 C26.5 5.5 30.5 9.5 30 15 C27 11 22 10 18 11 C14.5 12 12 13 9.6 15 Z" fill="#1f3140" />
          <circle cx="16.5" cy="17" r="1.3" fill="#1f3140" /><circle cx="23.5" cy="17" r="1.3" fill="#1f3140" />
          <path d="M16 21 Q20 24.5 24 21" fill="none" stroke="#1f3140" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  const ks = document.querySelector<HTMLElement>('.ks');
  if (ks && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver((es) => es.forEach((e) => ks.classList.toggle('ist-sichtbar', e.isIntersecting))).observe(ks);
  }
</script>

<style>
  .ks { --dauer: 15s; width: 100%; max-width: 500px; margin-inline: auto; }
  .ks__buehne { position: relative; width: 100%; aspect-ratio: 1; border-radius: 28px; background: var(--paper-2); overflow: hidden; }
  .ks__weg { position: absolute; left: 50%; top: 50%; width: 52%; aspect-ratio: 1; margin: -26% 0 0 -26%; border-radius: 50%; border: 2px dashed #cdc6ba; }
  .ks__mitte { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: grid; place-items: center; width: 17%; aspect-ratio: 1; border-radius: 50%; background: var(--paper); }
  .ks__mitte svg { width: 62%; height: auto; }

  .ks__station { position: absolute; width: 30%; transform: translate(-50%, -38%); display: grid; justify-items: center; gap: 6px; text-align: center; }
  .ks__scheibe { position: relative; display: grid; place-items: center; width: 52%; aspect-ratio: 1; border-radius: 50%; background: var(--white); border: 1.5px solid var(--line); box-shadow: 0 1px 2px rgb(31 49 64 / 6%), 0 6px 16px rgb(31 49 64 / 7%); }
  .ks__glanz { position: absolute; inset: -9%; border-radius: 50%; background: radial-gradient(circle, rgb(214 168 90 / 30%) 55%, rgb(214 168 90 / 0) 72%); opacity: 0; }
  .ks__icon { position: relative; width: 72%; height: auto; overflow: visible; }
  .ks__label { font-family: var(--font-head); font-weight: 650; font-size: clamp(0.72rem, 2.6vw, 0.92rem); line-height: 1.2; color: var(--dark); }
  .ks__station--5 .ks__label { color: var(--accent-ink); }

  /* Die Figur geht auf dem inneren Weg im Kreis: Ebene dreht sich, Figur dreht sich gegen (bleibt aufrecht) */
  .ks__bahn { position: absolute; inset: 0; }
  .ks__figur { position: absolute; left: 50%; top: 31%; width: 10%; transform: translate(-50%, -50%); }
  .ks__person { display: block; width: 100%; height: auto; }

  /* Bewegung nur im Sichtbereich und nicht bei reduzierter Bewegung */
  @media (prefers-reduced-motion: no-preference) {
    .ks__bahn { animation: ks-umlauf var(--dauer) cubic-bezier(0.45, 0, 0.3, 1) infinite; animation-play-state: paused; }
    .ks__figur { animation: ks-gegen var(--dauer) cubic-bezier(0.45, 0, 0.3, 1) infinite; animation-play-state: paused; }
    .ks__person { animation: ks-schritt 0.42s ease-in-out infinite alternate; animation-play-state: paused; }
    .ks__glanz { animation: ks-glanz var(--dauer) ease infinite; animation-delay: calc(var(--i) * var(--dauer) / 5); animation-play-state: paused; }
    .ks__scheibe { animation: ks-aktiv var(--dauer) ease infinite; animation-delay: calc(var(--i) * var(--dauer) / 5); animation-play-state: paused; }
    .ks.ist-sichtbar .ks__bahn, .ks.ist-sichtbar .ks__figur, .ks.ist-sichtbar .ks__person,
    .ks.ist-sichtbar .ks__glanz, .ks.ist-sichtbar .ks__scheibe { animation-play-state: running; }
  }
  /* 5 Stationen je 20 %: 14 % stehen, 6 % gehen */
  @keyframes ks-umlauf {
    0%, 14% { transform: rotate(0deg); } 20%, 34% { transform: rotate(72deg); } 40%, 54% { transform: rotate(144deg); }
    60%, 74% { transform: rotate(216deg); } 80%, 94% { transform: rotate(288deg); } 100% { transform: rotate(360deg); }
  }
  @keyframes ks-gegen {
    0%, 14% { transform: translate(-50%, -50%) rotate(0deg); } 20%, 34% { transform: translate(-50%, -50%) rotate(-72deg); }
    40%, 54% { transform: translate(-50%, -50%) rotate(-144deg); } 60%, 74% { transform: translate(-50%, -50%) rotate(-216deg); }
    80%, 94% { transform: translate(-50%, -50%) rotate(-288deg); } 100% { transform: translate(-50%, -50%) rotate(-360deg); }
  }
  @keyframes ks-schritt { from { transform: translateY(0); } to { transform: translateY(-4%); } }
  @keyframes ks-glanz { 0% { opacity: 0; } 3%, 13% { opacity: 1; } 18%, 100% { opacity: 0; } }
  @keyframes ks-aktiv { 0% { transform: scale(1); } 3%, 13% { transform: scale(1.12); } 18%, 100% { transform: scale(1); } }
</style>
