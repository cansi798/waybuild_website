---
// Hero-Animation (Jamil, Talk qh87y3sj 4784 + 4837, 06.11.2026): die Kundengeschichte als KREISLAUF.
// Alle fünf Momente sind gleichzeitig zu sehen (Aufmerksamkeit, Vertrauen, Anfrage, Bearbeitung, Zufriedener Kunde).
// 08.11.2026 (Jamil #4994/#4995): graue Fläche, Figur und Kreispfeil in der Mitte ENTFERNT, Ablauf seriöser:
// die Stationen werden der Reihe nach ruhig hervorgehoben (feiner Goldring), auf dem gestrichelten Kreis zeichnet sich
// die Verbindung als durchgehende Salbei-Linie von Station zu Station; nach „Zufriedener Kunde“ schließt sie sich zur
// „Aufmerksamkeit“ (Empfehlung), blendet aus und beginnt von vorn. Gleiche Formensprache wie die Bausteine-Grafik.
// Technik: SVG-Kreis (stroke-dashoffset, pathLength 1) + CSS opacity/transform, ein Umlauf 15 s, läuft nur im
// Sichtbereich (.ist-sichtbar). Ohne JS / reduzierte Bewegung: vollständiger Kreislauf als Standbild.
// Sicherung des Stands davor: Branch vor-hero-bausteine-20261108.
import { HERO } from '../../config/startseite';
const S = HERO.stationen;
const R = 35; // Radius des Kreises (Mittelpunkte der Stationen) in % der Bühne
const winkel = (i: number) => ((-90 + i * 72) * Math.PI) / 180;
const pos = S.map((_, i) => ({ x: 50 + R * Math.cos(winkel(i)), y: 50 + R * Math.sin(winkel(i)) }));
// Bogen von Station i zur nächsten (die letzte schließt den Kreis zurück zur ersten)
const bogen = S.map((_, i) => { const a = pos[i], b = pos[(i + 1) % S.length]; return `M${a.x.toFixed(2)} ${a.y.toFixed(2)} A${R} ${R} 0 0 1 ${b.x.toFixed(2)} ${b.y.toFixed(2)}`; });
const stern = (x: number, y: number, r: number) => {
  const p: string[] = [];
  for (let k = 0; k < 10; k++) { const a = -Math.PI / 2 + (k * Math.PI) / 5; const rr = k % 2 ? r * 0.45 : r; p.push(`${(x + rr * Math.cos(a)).toFixed(1)},${(y + rr * Math.sin(a)).toFixed(1)}`); }
  return p.join(' ');
};
const ICON = [
  // Aufmerksamkeit: Handy mit Benachrichtigung
  `<rect x="15" y="7" width="18" height="30" rx="4" fill="#004f4c"/><rect x="18" y="11" width="12" height="20" rx="1.5" fill="#f7f5f0"/><rect x="20" y="14" width="8" height="2.4" rx="1.2" fill="#7fd0cc"/><rect x="20" y="19" width="6" height="2.4" rx="1.2" fill="#cdc6ba"/><circle cx="33" cy="9" r="5.5" fill="#00a6a1"/>`,
  // Vertrauen: Sterne
  `<polygon points="${stern(12, 24, 7)}" fill="#00a6a1"/><polygon points="${stern(24, 16, 8.5)}" fill="#00a6a1"/><polygon points="${stern(36, 24, 7)}" fill="#00a6a1"/><rect x="12" y="33" width="24" height="3" rx="1.5" fill="#cdc6ba"/>`,
  // Anfrage: Brief
  `<g><rect x="9" y="14" width="30" height="21" rx="3" fill="#fff" stroke="#004f4c" stroke-width="2.2"/><path d="M9 16 L24 27 L39 16" fill="none" stroke="#004f4c" stroke-width="2.2" stroke-linejoin="round"/></g><circle cx="38" cy="14" r="4" fill="#00a6a1"/>`,
  // Bearbeitung: Zahnräder
  `<g><circle cx="20" cy="22" r="9.5" fill="none" stroke="#004f4c" stroke-width="5" stroke-dasharray="3.3 2.6"/><circle cx="20" cy="22" r="6.5" fill="#004f4c"/><circle cx="20" cy="22" r="2.6" fill="#f7f5f0"/></g><circle cx="34" cy="33" r="6.5" fill="none" stroke="#7fd0cc" stroke-width="4" stroke-dasharray="2.6 2"/><circle cx="34" cy="33" r="4.5" fill="#7fd0cc"/><circle cx="34" cy="33" r="1.8" fill="#f7f5f0"/>`,
  // Zufriedener Kunde: Herz
  `<path d="M24 39 c-2 -2 -15 -9 -15 -19 c0 -6 5 -9 9.5 -9 c3 0 4.6 1.6 5.5 3.6 c0.9 -2 2.5 -3.6 5.5 -3.6 c4.5 0 9.5 3 9.5 9 c0 10 -13 17 -15 19 Z" fill="#00a6a1"/>`,
];

---
<div class="ks" role="img" aria-label={`Die Geschichte eines Kunden als Kreislauf: ${S.join(', ')}. Zufriedene Kunden empfehlen weiter, und alles beginnt von vorn.`}>
  <div class="ks__buehne">
    <svg class="ks__kreis" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <circle cx="50" cy="50" r={R} fill="none" stroke="#9fcfcc" stroke-width="1.5" stroke-dasharray="3 4" vector-effect="non-scaling-stroke" />
      {bogen.map((d, i) => <path class={`ks__bogen ks__bogen--${i + 1}`} d={d} pathLength="1" fill="none" stroke="#00a6a1" stroke-width="0.7" stroke-linecap="round" />)}
    </svg>
    {S.map((label, i) => (
      <div class:list={['ks__station', `ks__station--${i + 1}`]} style={`left:${pos[i].x.toFixed(2)}%;top:${pos[i].y.toFixed(2)}%;--i:${i}`} aria-hidden="true">
        <span class="ks__scheibe">
          <span class="ks__ring"></span>
          <svg class="ks__icon" viewBox="0 0 48 48" set:html={ICON[i]} />
        </span>
        <span class="ks__label">{label}</span>
      </div>
    ))}
  </div>
</div>

<script>
  const ks = document.querySelector<HTMLElement>('.ks');
  if (ks && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver((es) => es.forEach((e) => ks.classList.toggle('ist-sichtbar', e.isIntersecting))).observe(ks);
  }
</script>

<style>
  .ks { --dauer: 15s; width: 100%; max-width: 500px; margin-inline: auto; }
  .ks__buehne { position: relative; width: 100%; aspect-ratio: 1; }
  .ks__kreis { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* Standbild (ohne JS / reduzierte Bewegung): der Kreislauf ist vollständig gezeichnet */
  .ks__bogen { stroke-dasharray: 1 1; stroke-dashoffset: 0; }

  /* Station: Mittelpunkt der Scheibe liegt genau auf dem Kreis, Beschriftung darunter (mit Seitenfarbe hinterlegt,
     damit die Linie dahinter verschwindet; Breite begrenzt, damit am Handy nichts über den Rand läuft) */
  .ks__station { position: absolute; width: 17%; transform: translate(-50%, -50%); }
  .ks__scheibe { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 1; border-radius: 50%; background: var(--white); border: 1.5px solid var(--line); box-shadow: 0 1px 2px rgb(0 79 76 / 6%), 0 6px 16px rgb(0 79 76 / 7%); }
  .ks__ring { position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--gold); opacity: 0; }
  .ks__icon { position: relative; width: 66%; height: auto; overflow: visible; }
  .ks__label { position: absolute; left: 50%; top: calc(100% + 6px); width: 176%; transform: translateX(-50%); text-align: center; }
  .ks__label { font-family: var(--font-head); font-weight: 650; font-size: clamp(0.7rem, 2.4vw, 0.92rem); line-height: 1.2; color: var(--dark); }
  .ks__station--5 .ks__label { color: var(--accent-ink); }
  .ks__station--1 .ks__label { width: 300%; } /* oben mittig: viel Platz, „Aufmerksamkeit“ bleibt einzeilig */
  .ks__label::before { content: ''; position: absolute; inset: -2px 8% -3px; z-index: -1; border-radius: 6px; background: var(--paper); }

  /* Ablauf: 5 Abschnitte je 20 % von --dauer. Station i leuchtet in ihrem Abschnitt (Türkisring, minimal größer),
     danach zeichnet sich der Bogen zur nächsten Station; alle Bögen bleiben bis 94 % stehen und blenden dann aus. */
  @media (prefers-reduced-motion: no-preference) {
    html.js .ks__bogen { stroke-dashoffset: 1; animation: ks-bogen1 var(--dauer) linear infinite both; animation-play-state: paused; }
    html.js .ks__bogen--2 { animation-name: ks-bogen2; }
    html.js .ks__bogen--3 { animation-name: ks-bogen3; }
    html.js .ks__bogen--4 { animation-name: ks-bogen4; }
    html.js .ks__bogen--5 { animation-name: ks-bogen5; }
    html.js .ks__ring { animation: ks-ring var(--dauer) ease infinite both; animation-delay: calc(var(--i) * var(--dauer) / 5); animation-play-state: paused; }
    html.js .ks__scheibe { animation: ks-aktiv var(--dauer) ease infinite both; animation-delay: calc(var(--i) * var(--dauer) / 5); animation-play-state: paused; }
    .ks.ist-sichtbar :is(.ks__bogen, .ks__ring, .ks__scheibe) { animation-play-state: running; }
  }
  @keyframes ks-ring { 0% { opacity: 0; } 4%, 16% { opacity: 1; } 21%, 100% { opacity: 0; } }
  @keyframes ks-aktiv { 0% { transform: scale(1); } 4%, 16% { transform: scale(1.05); } 21%, 100% { transform: scale(1); } }
  @keyframes ks-bogen1 { 0%, 9% { stroke-dashoffset: 1; opacity: 1; } 19%, 94% { stroke-dashoffset: 0; opacity: 1; } 99%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes ks-bogen2 { 0%, 29% { stroke-dashoffset: 1; opacity: 1; } 39%, 94% { stroke-dashoffset: 0; opacity: 1; } 99%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes ks-bogen3 { 0%, 49% { stroke-dashoffset: 1; opacity: 1; } 59%, 94% { stroke-dashoffset: 0; opacity: 1; } 99%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes ks-bogen4 { 0%, 69% { stroke-dashoffset: 1; opacity: 1; } 79%, 94% { stroke-dashoffset: 0; opacity: 1; } 99%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes ks-bogen5 { 0%, 85% { stroke-dashoffset: 1; opacity: 1; } 93%, 94% { stroke-dashoffset: 0; opacity: 1; } 99%, 100% { stroke-dashoffset: 0; opacity: 0; } }
</style>
