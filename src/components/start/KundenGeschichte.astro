---
// Hero-Animation (Jamil, Talk qh87y3sj 4784, 06.11.2026): kleine Geschichte EINES Kunden in fünf Stationen
// Aufmerksamkeit → Vertrauen → Anfrage → Bearbeitung → Zufriedener Kunde. Ausdrücklich keine Linie, kein Prozessbild:
// dieselbe Figur erlebt fünf Szenen, die nacheinander wechseln (eigene SVG-Zeichnungen statt Emojis, Jamils Farben).
// Ablauf: läuft einmal automatisch durch (≈ 6 s, startet erst, sobald die Bühne sichtbar ist; vorher ruht Szene 1 ohne Bewegung) und bleibt auf
// „Zufriedener Kunde“ stehen; Punkte zum Durchklicken. Nur transform / opacity / stroke-dashoffset.
// Ohne JS bzw. bei reduzierter Bewegung: alle fünf Szenen klein nebeneinander als Bildleiste (Endzustand).
import { HERO } from '../../config/startseite';
const S = HERO.stationen;
const D = '#1f3140', SALBEI = '#7e9b8a', GOLD = '#d6a85a', PAPIER = '#f8f7f4';
const stern = (x: number, y: number, r: number) => {
  const p: string[] = [];
  for (let k = 0; k < 10; k++) { const a = -Math.PI / 2 + (k * Math.PI) / 5; const rr = k % 2 ? r * 0.45 : r; p.push(`${(x + rr * Math.cos(a)).toFixed(1)},${(y + rr * Math.sin(a)).toFixed(1)}`); }
  return p.join(' ');
};
const mund = ['M90 87 Q96 89 102 87', 'M89 85 Q96 91 103 85', 'M89 85 Q96 91 103 85', 'M90 86 Q96 89 102 86', 'M87 83 Q96 97 105 83 Z'];
const KONFETTI = [
  [-46, -30, GOLD, 0], [-30, -52, SALBEI, 30], [-8, -62, D, 60], [16, -58, GOLD, 15], [38, -40, SALBEI, 70],
  [50, -14, GOLD, 40], [-54, -6, D, 20], [30, -66, SALBEI, 80], [-22, -70, GOLD, 50],
];
---
<div class="ks" role="group" aria-label={`Die Geschichte eines Kunden in fünf Momenten: ${S.join(', ')}.`}>
  <ol class="ks__szenen">
    {S.map((label, i) => (
      <li class:list={['ks__szene', `ks__szene--${i + 1}`, { 'ist-aktiv': i === 0 }]} aria-label={`${i + 1}. ${label}`}>
        <svg class="ks__bild" viewBox="0 0 240 200" aria-hidden="true" focusable="false">
          <ellipse cx="98" cy="176" rx="50" ry="6" fill={D} opacity="0.08" />
          {/* Figur: dieselbe Person in allen Szenen */}
          <g class="ks-figur">
            <path d="M60 172 C60 130 75 112 97 112 C119 112 134 130 134 172 Z" fill={SALBEI} />
            <path d="M84 112 L97 128 L110 112" fill="none" stroke={PAPIER} stroke-width="3" stroke-linejoin="round" />
            <circle cx="97" cy="78" r="21" fill={PAPIER} stroke={D} stroke-width="2.5" />
            <path d="M76 74 C75 58 88 52 99 54 C111 55 119 63 118 74 C112 66 102 63 94 65 C87 67 81 70 76 74 Z" fill={D} />
            <circle class="ks-auge" cx={i === 0 ? 92 : 90} cy="77" r="2.3" fill={D} />
            <circle class="ks-auge" cx={i === 0 ? 106 : 104} cy="77" r="2.3" fill={D} />
            {i === 4 && <><circle cx="84" cy="86" r="4" fill={GOLD} opacity="0.45" /><circle cx="110" cy="86" r="4" fill={GOLD} opacity="0.45" /></>}
            <path d={mund[i]} fill={i === 4 ? D : 'none'} stroke={D} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            {i !== 4 && <path d="M122 132 Q134 128 140 118" fill="none" stroke="#5f7d6c" stroke-width="9" stroke-linecap="round" />}
            {i === 4 && <path d="M124 128 Q140 112 146 94" fill="none" stroke="#5f7d6c" stroke-width="9" stroke-linecap="round" />}
          </g>

          {/* Handy (Szenen 1–4) */}
          {i !== 4 && (
            <g class="ks-handy">
              <rect x="134" y="90" width="28" height="44" rx="5" fill={D} />
              <rect x="137.5" y="95" width="21" height="32" rx="2" fill={PAPIER} />
              {i === 0 && <><rect x="140" y="100" width="15" height="3" rx="1.5" fill={SALBEI} /><rect x="140" y="106" width="11" height="3" rx="1.5" fill="#cdc6ba" /><rect x="140" y="112" width="13" height="3" rx="1.5" fill="#cdc6ba" /></>}
              {i === 1 && <polygon points={stern(148, 110, 6)} fill={GOLD} />}
              {i === 2 && <path d="M141 104 h15 v12 h-15 Z M141 104 l7.5 6 l7.5 -6" fill="none" stroke={D} stroke-width="1.5" stroke-linejoin="round" />}
              {i === 3 && <path class="ks-ring" d="M148 104 a7 7 0 1 1 -0.1 0" fill="none" stroke={SALBEI} stroke-width="2.4" stroke-linecap="round" pathLength="1" />}
            </g>
          )}

          {/* 1 · Aufmerksamkeit: Benachrichtigung + Glanz */}
          {i === 0 && (
            <g>
              <g class="ks-pop ks-pop--1"><circle cx="163" cy="90" r="9" fill={GOLD} /><text x="163" y="94" text-anchor="middle" font-size="11" font-weight="700" fill={D}>1</text></g>
              <g class="ks-glanz" stroke={GOLD} stroke-width="3" stroke-linecap="round">
                <path d="M176 76 l8 -8" /><path d="M182 92 h11" /><path d="M176 108 l8 7" />
              </g>
              <g class="ks-glanz ks-glanz--2" fill={GOLD}><polygon points={stern(122, 52, 6)} /></g>
            </g>
          )}

          {/* 2 · Vertrauen: Bewertungskarte mit Sternen + Vertrauens-Siegel */}
          {i === 1 && (
            <g>
              <g class="ks-schweb">
                <rect x="150" y="34" width="82" height="50" rx="9" fill="#ffffff" stroke="#ddd7cc" stroke-width="1.5" />
                {[0, 1, 2, 3, 4].map((k) => <polygon class="ks-stern" style={`--k:${k}`} points={stern(162 + k * 14.5, 52, 6.2)} fill={GOLD} />)}
                <rect x="159" y="66" width="48" height="4" rx="2" fill="#cdc6ba" /><rect x="159" y="74" width="34" height="4" rx="2" fill="#e2ddd3" />
              </g>
              <g class="ks-pop ks-pop--2">
                <path d="M200 102 l18 7 v14 c0 12 -8 20 -18 24 c-10 -4 -18 -12 -18 -24 v-14 Z" fill={D} />
                <path d="M191 124 l6 6 l12 -13" fill="none" stroke={GOLD} stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
              </g>
            </g>
          )}

          {/* 3 · Anfrage: Brief fliegt los */}
          {i === 2 && (
            <g>
              <g class="ks-spur" fill={SALBEI}><circle cx="160" cy="88" r="2.5" /><circle cx="170" cy="76" r="3" /><circle cx="181" cy="66" r="3.5" /></g>
              <g class="ks-brief">
                <rect x="180" y="34" width="46" height="32" rx="4" fill="#ffffff" stroke={D} stroke-width="2.2" />
                <path d="M180 36 L203 54 L226 36" fill="none" stroke={D} stroke-width="2.2" stroke-linejoin="round" />
                <circle cx="222" cy="36" r="6" fill={GOLD} />
              </g>
            </g>
          )}

          {/* 4 · Bearbeitung: Zahnräder + Häkchen im Hintergrund */}
          {i === 3 && (
            <g>
              <g class="ks-rad ks-rad--gross"><circle cx="188" cy="56" r="15" fill="none" stroke={D} stroke-width="7" stroke-dasharray="4.6 3.25" /><circle cx="188" cy="56" r="11" fill={D} /><circle cx="188" cy="56" r="4.5" fill={PAPIER} /></g>
              <g class="ks-rad ks-rad--klein"><circle cx="214" cy="82" r="9.5" fill="none" stroke={SALBEI} stroke-width="5.5" stroke-dasharray="3.6 2.6" /><circle cx="214" cy="82" r="7" fill={SALBEI} /><circle cx="214" cy="82" r="2.8" fill={PAPIER} /></g>
              <rect x="164" y="104" width="64" height="58" rx="8" fill="#ffffff" stroke="#ddd7cc" stroke-width="1.5" />
              {[0, 1, 2].map((k) => (
                <g>
                  <path class="ks-haken" style={`--k:${k}`} d={`M173 ${120 + k * 15} l4 4 l7 -8`} fill="none" stroke={k === 2 ? GOLD : SALBEI} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
                  <rect x="190" y={117 + k * 15} width={k === 1 ? 22 : 28} height="4" rx="2" fill="#cdc6ba" />
                </g>
              ))}
            </g>
          )}

          {/* 5 · Zufriedener Kunde: Lächeln, Herz, Konfetti */}
          {i === 4 && (
            <g>
              <path class="ks-pop ks-pop--herz" d="M150 64 c-6 -10 -22 -6 -18 6 c3 8 18 16 18 16 c0 0 15 -8 18 -16 c4 -12 -12 -16 -18 -6 Z" fill={GOLD} />
              {KONFETTI.map(([dx, dy, c, r], k) => (
                <rect class="ks-konfetti" style={`--dx:${dx};--dy:${dy};--r:${r};--k:${k}`} x={97 + (dx as number) - 3} y={66 + (dy as number) - 2} width="6" height="4" rx="1" fill={c as string} />
              ))}
            </g>
          )}
        </svg>
        <p class="ks__label"><span class="ks__nr">{i + 1}</span>{label}</p>
      </li>
    ))}
  </ol>
  <div class="ks__punkte" hidden>
    {S.map((label, i) => (
      <button type="button" class:list={['ks__punkt', { 'ist-aktiv': i === 0 }]} data-zu={i} aria-label={`Station ${i + 1}: ${label}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>
    ))}
  </div>
</div>

<script>
  const ks = document.querySelector<HTMLElement>('.ks');
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (ks && !ruhig) {
    const szenen = [...ks.querySelectorAll<HTMLElement>('.ks__szene')];
    const punkte = [...ks.querySelectorAll<HTMLButtonElement>('.ks__punkt')];
    const leiste = ks.querySelector<HTMLElement>('.ks__punkte');
    if (leiste) leiste.hidden = false;
    let timer = 0;
    const zeige = (n: number) => {
      szenen.forEach((s, i) => s.classList.toggle('ist-aktiv', i === n));
      punkte.forEach((p, i) => { p.classList.toggle('ist-aktiv', i === n); p.setAttribute('aria-pressed', String(i === n)); });
    };
    const DAUER = [1500, 1400, 1300, 1500];
    const weiter = (n: number) => { zeige(n); if (n < szenen.length - 1) timer = window.setTimeout(() => weiter(n + 1), DAUER[n]); };
    punkte.forEach((p) => p.addEventListener('click', () => { clearTimeout(timer); timer = -1; ks.classList.add('laeuft'); zeige(Number(p.dataset.zu)); }));
    const start = () => { if (timer === 0) { ks.classList.add('laeuft'); weiter(0); } };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); } }, { threshold: 0.45 });
      io.observe(ks);
    } else start();
  }
</script>

<style>
  .ks { width: 100%; max-width: 520px; margin-inline: auto; }
  .ks__szenen { list-style: none; margin: 0; padding: 0; }
  .ks__bild { display: block; width: 100%; height: auto; overflow: visible; }
  .ks__label { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 6px 0 0; font-family: var(--font-head); font-weight: 650; color: var(--dark); text-align: center; line-height: 1.25; }
  .ks__nr { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--dark); color: var(--white); font-size: 0.78rem; }
  .ks__szene--5 .ks__nr { background: var(--gold); color: #222; }

  /* Bildleiste (ohne JS / reduzierte Bewegung): alle fünf Szenen klein nebeneinander */
  .ks__szenen { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .ks__szene { flex: 0 1 calc(33.33% - 10px); padding: 8px 6px 10px; border-radius: 14px; background: var(--paper-2); }
  .ks__szene .ks__label { font-size: 0.78rem; flex-direction: column; gap: 4px; }
  @media (min-width: 600px) { .ks__szene { flex-basis: calc(20% - 10px); } }

  /* Bühne (mit JS, normale Bewegung): eine Szene nach der anderen */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ks__szenen { position: relative; display: block; aspect-ratio: 240 / 232; border-radius: 22px; background: var(--paper-2); }
    :global(html.js) .ks__szene { position: absolute; inset: 0; padding: 4% 6% 5%; background: none; display: flex; flex-direction: column; justify-content: center;
      opacity: 0; transform: scale(0.96); transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.3, 1.3, 0.5, 1); pointer-events: none; }
    :global(html.js) .ks__szene.ist-aktiv { opacity: 1; transform: none; }
    :global(html.js) .ks__szene .ks__label { flex-direction: row; font-size: clamp(1rem, 2.4vw, 1.15rem); gap: 10px; margin-top: 4px; }
    :global(html.js) .ks__szene .ks__nr { width: 28px; height: 28px; font-size: 0.86rem; }

    /* Bewegung innerhalb der aktiven Szene (Ausgangspunkt = fertiges Bild, Animation kommt „von“) */
    .ks-pop, .ks-glanz, .ks-stern, .ks-brief, .ks-spur, .ks-rad, .ks-konfetti, .ks-schweb { transform-box: fill-box; transform-origin: center; }
    .ks.laeuft .ist-aktiv .ks-pop { animation: ks-pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) 0.25s both; }
    .ks.laeuft .ist-aktiv .ks-glanz { animation: ks-glanz 0.9s ease 0.35s both; }
    .ks.laeuft .ist-aktiv .ks-glanz--2 { animation-delay: 0.55s; }
    .ks.laeuft .ist-aktiv .ks-schweb { animation: ks-hoch 0.5s ease 0.1s both; }
    .ks.laeuft .ist-aktiv .ks-stern { animation: ks-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) both; animation-delay: calc(0.35s + var(--k) * 0.12s); }
    .ks.laeuft .ist-aktiv .ks-pop--2 { animation-delay: 1s; }
    .ks.laeuft .ist-aktiv .ks-brief { animation: ks-flug 0.9s cubic-bezier(0.4, 0, 0.2, 1) 0.15s both; }
    .ks.laeuft .ist-aktiv .ks-spur { animation: ks-spur 1.1s ease 0.2s both; }
    .ks.laeuft .ist-aktiv .ks-rad--gross { animation: ks-dreh 1.6s cubic-bezier(0.45, 0, 0.3, 1) both; }
    .ks.laeuft .ist-aktiv .ks-rad--klein { animation: ks-dreh-zurueck 1.6s cubic-bezier(0.45, 0, 0.3, 1) both; }
    .ks-haken, .ks-ring { stroke-dasharray: 1 1; }
    .ks.laeuft .ist-aktiv .ks-haken { animation: ks-zeichne 0.4s ease both; animation-delay: calc(0.35s + var(--k) * 0.3s); }
    .ks.laeuft .ist-aktiv .ks-ring { animation: ks-zeichne 0.9s ease 0.1s both; }
    .ks.laeuft .ist-aktiv .ks-konfetti { animation: ks-konfetti 0.9s cubic-bezier(0.2, 0.8, 0.3, 1) both; animation-delay: calc(0.35s + var(--k) * 0.03s); }
    .ks.laeuft .ist-aktiv .ks-pop--herz { animation-delay: 0.15s; }
    .ks.laeuft .ist-aktiv .ks-auge { animation: ks-blinzeln 0.25s ease 0.9s both; transform-box: fill-box; transform-origin: center; }
  }
  @keyframes ks-pop { from { opacity: 0; transform: scale(0.2); } }
  @keyframes ks-glanz { from { opacity: 0; transform: scale(0.5); } 60% { opacity: 1; } }
  @keyframes ks-hoch { from { opacity: 0; transform: translateY(12px); } }
  @keyframes ks-flug { from { opacity: 0; transform: translate(-44px, 52px) scale(0.35) rotate(-14deg); } 40% { opacity: 1; } }
  @keyframes ks-spur { from { opacity: 0; } 50% { opacity: 1; } }
  @keyframes ks-dreh { from { transform: rotate(-240deg); } }
  @keyframes ks-dreh-zurueck { from { transform: rotate(300deg); } }
  @keyframes ks-zeichne { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ks-konfetti { from { opacity: 0; transform: translate(calc(var(--dx) * -1px), calc(var(--dy) * -1px)) rotate(0deg) scale(0.3); } to { transform: rotate(calc(var(--r) * 1deg)); } }
  @keyframes ks-blinzeln { 50% { transform: scaleY(0.15); } }
  .ks-konfetti { transform-box: fill-box; transform-origin: center; transform: rotate(calc(var(--r) * 1deg)); }

  .ks__punkte[hidden] { display: none; }
  .ks__punkte { display: flex; justify-content: center; gap: 10px; margin-top: 14px; }
  .ks__punkt { width: 28px; height: 28px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; display: grid; place-items: center; }
  .ks__punkt::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: #cdc6ba; transition: transform 0.2s ease, background-color 0.2s ease; }
  .ks__punkt.ist-aktiv::before { background: var(--dark); transform: scale(1.3); }
  .ks__punkt:last-child.ist-aktiv::before { background: var(--gold); }
  .ks__punkt:focus-visible { outline: 3px solid var(--gold); outline-offset: 1px; }
</style>
