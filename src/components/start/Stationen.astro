---
// Wiederkehrendes Element der Startseite (Jamil, Talk 4753): kleine Stationen-Leiste
// „Komplexität → Verständnis → Klarheit → Fortschritt“ am Anfang jeder Etappe der Besucherreise.
// Bisher erreichte Stationen gefüllt, die aktuelle in Gold. Die Linie bis zur aktuellen Station zeichnet sich einmal
// beim Sichtkontakt (nur transform). Ohne JS bzw. bei reduzierter Bewegung: fertig gezeichnet.
import { STUFEN, type Stufe } from '../../config/startseite';
interface Props { aktiv: Stufe; dunkel?: boolean; class?: string }
const { aktiv, dunkel = false, class: cls } = Astro.props;
---
<ol class:list={['stn', { 'stn--dunkel': dunkel }, cls]} style={`--aktiv:${aktiv}`} data-zeichne aria-label={`Etappe: ${STUFEN[aktiv]}`}>
  {STUFEN.map((s, i) => (
    <li class:list={['stn__p', { 'ist-erreicht': i < aktiv, 'ist-aktiv': i === aktiv }]} aria-current={i === aktiv ? 'step' : undefined}>{s}</li>
  ))}
</ol>

<style>
  .stn {
    --spur: #d6d0c4; --erreicht: #7e9b8a; --text: #5d625f; --grund: var(--paper);
    position: relative; display: grid; grid-template-columns: repeat(4, 1fr);
    max-width: 480px; margin: 0 0 clamp(22px, 3vw, 32px); padding: 0; list-style: none;
  }
  .stn--dunkel { --spur: rgb(255 255 255 / 22%); --erreicht: #9fb7a9; --text: #b9c4cc; --grund: var(--dark); }
  .stn::before, .stn::after { content: ''; position: absolute; left: 12.5%; top: 6px; height: 2px; border-radius: 2px; }
  .stn::before { right: 12.5%; background: var(--spur); }
  .stn::after { width: calc(25% * var(--aktiv)); background: var(--erreicht); transform-origin: left; z-index: 1; }
  .stn__p { position: relative; z-index: 2; padding-top: 22px; text-align: center; font-size: 0.76rem; font-weight: 600; letter-spacing: 0.02em; color: var(--text); white-space: nowrap; }
  .stn__p::before {
    content: ''; position: absolute; top: 0; left: 50%; width: 14px; height: 14px; margin-left: -7px; box-sizing: border-box;
    border-radius: 50%; border: 2px solid var(--spur); background: var(--grund);
  }
  .stn__p.ist-erreicht::before { border-color: var(--erreicht); background: var(--erreicht); }
  .stn__p.ist-aktiv { color: var(--dark); font-weight: 700; }
  .stn--dunkel .stn__p.ist-aktiv { color: var(--white); }
  .stn__p.ist-aktiv::before { border-color: #d6a85a; background: #d6a85a; box-shadow: 0 0 0 4px rgb(214 168 90 / 22%); }
  @media (min-width: 720px) { .stn__p { font-size: 0.8rem; } }

  :global(html.js) .stn:not(.ist-los)::after { transform: scaleX(0); }
  :global(html.js) .stn:not(.ist-los) .stn__p.ist-aktiv::before { transform: scale(0.4); opacity: 0; }
  .stn.ist-los::after { transition: transform 0.9s cubic-bezier(0.45, 0, 0.25, 1) 0.1s; }
  .stn.ist-los .stn__p.ist-aktiv::before { transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1) 0.9s, opacity 0.3s ease 0.9s; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .stn::after, :global(html.js) .stn .stn__p.ist-aktiv::before { transform: none !important; opacity: 1 !important; }
  }
</style>
