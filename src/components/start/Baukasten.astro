---
// Abo-Baukasten (Jamil, Talk qh87y3sj 4879, 07.11.2026): statt Preisschildern eine Art Warenkorb. Basis „Ihre Website“
// plus zubuchbare Bausteine. Seit 08.11.2026 (Jamil 4924/4925) zwei Arten: Monatspreis (`preis`) oder einmaliger
// Festpreis (`einmalig`); daneben „auf Anfrage“. Zwei Summen (monatlich + einmalig, netto, darunter inkl. MwSt.), live.
// Optionen mit `zu` (Google-Profil pflegen, Monatlicher KI-Check) stehen unter ihrem Hauptbaustein und sind erst wählbar,
// wenn er gewählt ist. Kein Kauf, keine Zahlung: „Paket anfragen“ legt die Auswahl (JSON, monatlich/einmalig getrennt) in den
// sessionStorage und öffnet das Kontaktformular, dort sichtbar und abwählbar.
// Ohne JS: alle Bausteine mit Preis sichtbar und wählbar, Knopf führt zum Kontaktformular. TESTANGEBOT (siehe startseite.ts).
import { href } from '../../lib/paths';
import { BAUKASTEN as B, type Baustein } from '../../config/startseite';
import { formatEuro, brutto, WAAS } from '../../config/site';
const MWST = brutto(100) / 100;
const haupt = B.bausteine.filter((b) => !b.zu);
const optionen = (id: string) => B.bausteine.filter((o) => o.zu === id);
const preisText = (b: Baustein) =>
  b.preis !== undefined ? `+ ${formatEuro(b.preis)} / Monat` : b.einmalig !== undefined ? `${formatEuro(b.einmalig)} ${B.einmaligLabel}` : 'auf Anfrage';
const anfrage = (b: Baustein) => b.preis === undefined && b.einmalig === undefined;
---
<div class="bk" id="baukasten" data-basis={B.basis.preis} data-basis-name={B.basis.name} data-mwst={MWST} data-kontakt={href('/kontakt/')}>
  <div class="bs-kopf bs-kopf--mitte">
    <h3 class="bk__titel">{B.titel}</h3>
    <p class="bs-lead">{B.einleitung}</p>
  </div>

  <div class="bk__raster">
    <div class="bk__auswahl">
      <div class="bk__basis">
        <div class="bk__basis-kopf">
          <p class="bk__basis-name">{B.basis.name}</p>
          <p class="bk__basis-preis">{formatEuro(B.basis.preis)} <small>netto / Monat</small></p>
        </div>
        <ul class="bk__basis-liste">
          {B.basis.teile.map((t) => <li>{t.text}{t.hinweis && <small>{t.hinweis}</small>}</li>)}
        </ul>
      </div>

      <fieldset class="bk__bausteine">
        <legend>Dazubuchen</legend>
        <div class="bk__gitter">
        {haupt.map((b) => (
          <div class="bk__karte">
            <label class:list={['bk__baustein', { 'bk__baustein--anfrage': anfrage(b), 'bk__baustein--einmalig': b.einmalig !== undefined }]}>
              <input type="checkbox" value={b.id} data-name={b.name} data-preis={b.preis ?? ''} data-einmalig={b.einmalig ?? ''} />
              <span class="bk__haken" aria-hidden="true"><svg viewBox="0 0 20 20" width="16" height="16"><path d="m5 10.5 3.2 3.2L15 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span class="bk__info">
                <span class="bk__name">{b.name}</span>
                <span class="bk__text">{b.text}</span>
              </span>
              <span class="bk__preis">{preisText(b)}{b.hinweis && <small class="bk__hinweis">{b.hinweis}</small>}</span>
            </label>
            {optionen(b.id).map((o) => (
              <label class="bk__baustein bk__option">
                <input type="checkbox" value={o.id} data-name={o.name} data-preis={o.preis ?? ''} data-einmalig={o.einmalig ?? ''} data-zu={b.id} />
                <span class="bk__haken" aria-hidden="true"><svg viewBox="0 0 20 20" width="14" height="14"><path d="m5 10.5 3.2 3.2L15 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <span class="bk__info">
                  <span class="bk__optional">Optional dazu</span>
                  <span class="bk__name">{o.name}</span>
                  <span class="bk__text">{o.text}</span>
                  <span class="bk__gesperrt">Erst „{b.name}“ wählen.</span>
                </span>
                <span class="bk__preis">{preisText(o)}</span>
              </label>
            ))}
          </div>
        ))}
        </div>
      </fieldset>
    </div>

    <aside class="bk__summe" aria-labelledby="bk-summe-kopf">
      <p class="bk__summe-kopf" id="bk-summe-kopf">{B.summeKopf}</p>
      <ul class="bk__posten" id="bk-posten">
        <li><span>{B.basis.name}</span><span>{formatEuro(B.basis.preis)} / Monat</span></li>
      </ul>
      <div class="bk__gesamt" aria-live="polite">
        <div class="bk__betrag">
          <p class="bk__gesamt-label">Monatlich</p>
          <p class="bk__gesamt-netto"><span id="bk-netto">{formatEuro(B.basis.preis)}</span> <small>netto zzgl. MwSt.</small></p>
          <p class="bk__gesamt-brutto"><span id="bk-brutto">{formatEuro(brutto(B.basis.preis))}</span> inkl. MwSt.</p>
        </div>
        <div class="bk__betrag bk__betrag--einmalig">
          <p class="bk__gesamt-label">Einmalig <small>(Festpreis)</small></p>
          <p class="bk__gesamt-netto"><span id="bk-e-netto">{formatEuro(0)}</span> <small>netto zzgl. MwSt.</small></p>
          <p class="bk__gesamt-brutto"><span id="bk-e-brutto">{formatEuro(0)}</span> inkl. MwSt.</p>
        </div>
        <p class="bk__anfrage-hinweis" id="bk-anfrage" hidden>Dazu Bausteine mit Preis auf Anfrage.</p>
      </div>
      <a class="btn btn--gold btn--lg bk__cta" id="bk-cta" href={href(`/kontakt/?paket=${encodeURIComponent('Abo-Baukasten')}`)}>{B.cta}</a>
      <p class="bk__klein">{B.ctaHinweis}</p>
      <p class="bk__klein">{B.laufzeit}{WAAS.einrichtung === 0 && ` ${B.einrichtung}`}</p>
      <p class="bk__test">{B.test}</p>
    </aside>
  </div>

  <!-- Handy: kleine Summenleiste, die beim Auswählen mitläuft (monatlich, einmalig nur wenn > 0) -->
  <div class="bk__mobil" aria-hidden="true">
    <span>Monatlich <strong id="bk-mobil">{formatEuro(B.basis.preis)}</strong></span>
    <span class="bk__mobil-e" id="bk-mobil-e-wrap" hidden>Einmalig <strong id="bk-mobil-e">{formatEuro(0)}</strong></span>
    <small>netto</small>
  </div>
</div>

<script>
  const bk = document.getElementById('baukasten');
  if (bk) {
    const basis = Number(bk.dataset.basis);
    const basisName = bk.dataset.basisName || 'Ihre Website';
    const mwst = Number(bk.dataset.mwst);
    const fmt = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmt0 = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 2 });
    /** wie formatEuro: ganze Beträge ohne Cent */
    const eur = (n: number) => (Math.round(n * 100) % 100 ? fmt : fmt0).format(n);
    const rund = (n: number) => Math.round(n * 100) / 100;
    const brutto = (n: number) => rund(n * mwst);
    const boxen = [...bk.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    const el = (id: string) => document.getElementById(id)!;
    const posten = el('bk-posten');
    const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Zähler-Animation je Betrag (netto, brutto, Handy-Leiste)
    const zaehler = (ziele: HTMLElement[], bruttoEl: HTMLElement, start: number) => {
      let angezeigt = start, rahmen = 0;
      const setze = (n: number) => { ziele.forEach((z) => { z.textContent = eur(n); }); bruttoEl.textContent = eur(brutto(n)); };
      return (ziel: number) => {
        cancelAnimationFrame(rahmen);
        const von = angezeigt, t0 = performance.now(), dauer = ruhig ? 0 : 380;
        const schritt = (t: number) => {
          const f = dauer ? Math.min(1, (t - t0) / dauer) : 1;
          angezeigt = von + (ziel - von) * (1 - Math.pow(1 - f, 3));
          if (f < 1) { setze(rund(angezeigt)); rahmen = requestAnimationFrame(schritt); }
          else { angezeigt = ziel; setze(ziel); }
        };
        rahmen = requestAnimationFrame(schritt);
      };
    };
    const monat = zaehler([el('bk-netto'), el('bk-mobil')], el('bk-brutto'), basis);
    const einmal = zaehler([el('bk-e-netto'), el('bk-mobil-e')], el('bk-e-brutto'), 0);

    // Optionen erst wählbar, wenn der Hauptbaustein gewählt ist
    const sperre = () => {
      boxen.filter((o) => o.dataset.zu).forEach((o) => {
        const h = boxen.find((b) => b.value === o.dataset.zu);
        const frei = !!h?.checked;
        if (!frei) o.checked = false;
        o.disabled = !frei;
        o.closest('label')?.classList.toggle('ist-gesperrt', !frei);
      });
    };

    const rechne = () => {
      sperre();
      const gewaehlt = boxen.filter((b) => b.checked);
      const mon = gewaehlt.filter((b) => b.dataset.preis);
      const ein = gewaehlt.filter((b) => b.dataset.einmalig);
      const anf = gewaehlt.filter((b) => !b.dataset.preis && !b.dataset.einmalig);
      const summeMonat = rund(basis + mon.reduce((s, b) => s + Number(b.dataset.preis), 0));
      const summeEinmalig = rund(ein.reduce((s, b) => s + Number(b.dataset.einmalig), 0));
      posten.innerHTML = '';
      const zeile = (a: string, b: string) => { const li = document.createElement('li'); const x = document.createElement('span'); x.textContent = a; const y = document.createElement('span'); y.textContent = b; li.append(x, y); posten.append(li); };
      zeile(basisName, `${eur(basis)} / Monat`);
      gewaehlt.forEach((b) => zeile(b.dataset.name || '', b.dataset.preis ? `+ ${eur(Number(b.dataset.preis))} / Monat` : b.dataset.einmalig ? `${eur(Number(b.dataset.einmalig))} einmalig` : 'auf Anfrage'));
      el('bk-anfrage').hidden = anf.length === 0;
      el('bk-mobil-e-wrap').hidden = summeEinmalig === 0;
      bk.classList.toggle('hat-auswahl', gewaehlt.length > 0);
      bk.classList.toggle('hat-einmalig', summeEinmalig > 0);
      monat(summeMonat); einmal(summeEinmalig);
      return { mon, ein, anf, summeMonat, summeEinmalig };
    };
    boxen.forEach((b) => b.addEventListener('change', rechne));
    rechne();

    el('bk-cta').addEventListener('click', () => {
      const { mon, ein, anf, summeMonat, summeEinmalig } = rechne();
      // Übergabe an die Kontaktseite: monatlich und einmalig getrennt (Format v2, kontakt.astro liest auch den alten Text)
      const daten = {
        v: 2,
        monatlich: [[basisName, basis], ...mon.map((b) => [b.dataset.name || '', Number(b.dataset.preis)])],
        einmalig: ein.map((b) => [b.dataset.name || '', Number(b.dataset.einmalig)]),
        anfrage: anf.map((b) => b.dataset.name || ''),
        summeMonat, bruttoMonat: brutto(summeMonat), summeEinmalig, bruttoEinmalig: brutto(summeEinmalig),
      };
      try { sessionStorage.setItem('wb-abo-baukasten', JSON.stringify(daten)); } catch { /* ohne Speicher: Anfrage ohne Auswahl */ }
      const paket = `Abo-Baukasten (${eur(summeMonat)}/Monat${summeEinmalig ? ` + ${eur(summeEinmalig)} einmalig` : ''})`;
      (el('bk-cta') as HTMLAnchorElement).href = `${bk.dataset.kontakt}?paket=${encodeURIComponent(paket)}`;
    });
  }
</script>

<style>
  .bk { margin-top: clamp(44px, 6vw, 72px); }
  .bk__titel { margin: 0 0 6px; font-size: clamp(1.5rem, 3vw, 2rem) !important; }
  .bk__raster { display: grid; gap: 20px; margin-top: clamp(20px, 3vw, 32px); }
  @media (min-width: 980px) { .bk__raster { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; gap: 28px; } }

  .bk__basis { padding: clamp(18px, 2.6vw, 24px); border-radius: var(--radius); background: var(--white); border: 2px solid var(--dark); }
  .bk__basis-kopf { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin-bottom: 10px; }
  .bk__basis-name { margin: 0; font-family: var(--font-head); font-weight: 700; font-size: 1.3rem; color: var(--dark); }
  .bk__basis-preis { margin: 0; font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; color: var(--dark); }
  .bk__basis-preis span, .bk__basis-preis small { font-weight: 500; font-size: 0.85rem; color: var(--ink-soft); }
  .bk__basis-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .bk__basis-liste li { position: relative; padding-left: 24px; line-height: 1.5; color: var(--ink); }
  .bk__basis-liste li::before { content: ''; position: absolute; left: 2px; top: 0.45em; width: 12px; height: 7px; border-left: 2.5px solid var(--salbei); border-bottom: 2.5px solid var(--salbei); transform: rotate(-45deg); }
  .bk__basis-liste small { display: block; font-size: 0.86rem; color: var(--ink-soft); }

  .bk__bausteine { margin: 18px 0 0; padding: 0; border: 0; min-width: 0; }
  .bk__gitter { display: grid; gap: 10px; }
  @media (min-width: 640px) { .bk__gitter { grid-template-columns: 1fr 1fr; } }
  .bk__bausteine legend { margin: 0 0 10px; padding: 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); }
  .bk__baustein { position: relative; display: grid; grid-template-columns: 26px 1fr; gap: 4px 12px; padding: 12px 14px; border-radius: 16px; background: var(--white); border: 1.5px solid var(--line); cursor: pointer; transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease; }
  .bk__baustein:hover { border-color: var(--dark); }
  .bk__baustein input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .bk__haken { grid-row: 1 / span 2; display: grid; place-items: center; width: 24px; height: 24px; margin-top: 1px; border-radius: 7px; border: 2px solid #b7beb9; color: transparent; transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
  .bk__info { display: grid; gap: 3px; }
  .bk__name { font-family: var(--font-head); font-weight: 650; color: var(--dark); line-height: 1.3; }
  .bk__text { font-size: 0.9rem; line-height: 1.5; color: var(--ink-soft); }
  .bk__station { justify-self: start; margin-top: 2px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #6b736e; }
  .bk__preis { grid-column: 2; font-weight: 700; color: var(--dark); }
  .bk__baustein--anfrage { border-style: dashed; }
  .bk__hinweis { display: block; margin-top: 2px; font-size: 0.84rem; font-weight: 500; color: var(--ink-soft); }
  .bk__baustein--einmalig .bk__preis { color: var(--dark); }

  /* Karte = Hauptbaustein + optionale Ergänzung direkt darunter (eingerückt, angedockt) */
  .bk__karte { display: grid; align-content: start; min-width: 0; }
  .bk__option { margin: -1px 0 0 22px; border-top-left-radius: 0; border-top-right-radius: 0; border-style: dashed; padding-top: 10px; padding-bottom: 10px; background: #fbfaf7; }
  .bk__karte:has(> .bk__baustein:first-child input:checked) .bk__option:not(.ist-gesperrt) { border-style: solid; }
  .bk__optional { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); }
  .bk__option .bk__name { font-size: 0.95rem; }
  .bk__option .bk__text { font-size: 0.86rem; }
  .bk__gesperrt { display: none; font-size: 0.82rem; font-style: italic; color: var(--ink-soft); }
  .bk__option.ist-gesperrt { cursor: not-allowed; }
  .bk__option.ist-gesperrt:hover { border-color: var(--line); }
  .bk__option.ist-gesperrt .bk__name, .bk__option.ist-gesperrt .bk__text, .bk__option.ist-gesperrt .bk__preis, .bk__option.ist-gesperrt .bk__haken { opacity: 0.55; }
  .bk__option.ist-gesperrt .bk__gesperrt { display: block; }
  .bk__baustein--anfrage .bk__preis { font-weight: 600; color: var(--ink-soft); }
  .bk__baustein:has(input:checked) { border-color: var(--dark); box-shadow: 0 0 0 1px var(--dark), var(--shadow); }
  .bk__baustein:has(input:checked) .bk__haken { background: var(--dark); border-color: var(--dark); color: var(--white); }
  .bk__baustein:has(input:focus-visible) { outline: 3px solid var(--salbei); outline-offset: 2px; }

  .bk__summe { padding: clamp(20px, 2.6vw, 26px); border-radius: var(--radius); background: var(--dark); color: var(--dark-lead); }
  @media (min-width: 980px) { .bk__summe { position: sticky; top: 96px; } }
  .bk__summe-kopf { margin: 0 0 10px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); }
  .bk__posten { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 0.93rem; }
  .bk__posten :global(li) { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 6px; border-bottom: 1px solid var(--dark-line); }
  .bk__posten :global(li span:last-child) { white-space: nowrap; color: var(--white); font-weight: 600; }
  .bk__gesamt { margin: 14px 0 16px; display: grid; gap: 12px; }
  .bk__betrag--einmalig { padding-top: 12px; border-top: 1px solid var(--dark-line); }
  .bk__betrag--einmalig .bk__gesamt-netto { font-size: clamp(1.45rem, 3vw, 1.7rem); }
  .bk__gesamt-label small { font-size: 0.82rem; }
  .bk__gesamt p { margin: 0; }
  .bk__gesamt-label { font-size: 0.9rem; color: var(--dark-soft); }
  .bk__gesamt-netto { font-family: var(--font-head); font-size: clamp(1.9rem, 4vw, 2.3rem); font-weight: 700; color: var(--white); font-variant-numeric: tabular-nums; }
  .bk__gesamt-netto { line-height: 1.15; }
  .bk__gesamt-netto small { display: block; margin-top: 2px; font-family: var(--font-body, inherit); font-size: 0.9rem; font-weight: 500; line-height: 1.4; color: var(--dark-soft); }
  .bk__gesamt-brutto { font-size: 0.92rem; color: var(--dark-soft); font-variant-numeric: tabular-nums; }
  .bk__anfrage-hinweis { margin-top: 6px !important; font-size: 0.88rem; color: var(--dark-lead); }
  .bk__anfrage-hinweis[hidden] { display: none; }
  .btn--gold { background: var(--gold); color: #222; }
  .btn--gold:hover { background: #c9984a; }
  .bk__cta { width: 100%; justify-content: center; }
  .bk__klein { margin: 10px 0 0; font-size: 0.85rem; line-height: 1.5; color: var(--dark-soft); }
  .bk__test { margin: 12px 0 0; padding-top: 10px; border-top: 1px solid var(--dark-line); font-size: 0.82rem; color: var(--dark-soft); }

  .bk__mobil { display: none; }
  @media (max-width: 979px) {
    :global(html.js) .bk__mobil { position: sticky; bottom: calc(var(--stickybar-h, 64px) + 10px); z-index: 5; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 4px 10px; width: fit-content; max-width: calc(100% - 8px); margin: 14px auto 0; padding: 10px 16px; font-size: 0.86rem; border-radius: 999px; background: var(--dark); color: var(--dark-soft); box-shadow: 0 8px 24px rgb(31 49 64 / 25%); font-size: 0.9rem; opacity: 0; transform: translateY(8px); transition: opacity 0.25s ease, transform 0.25s ease; pointer-events: none; }
    :global(html.js) .bk.hat-auswahl .bk__mobil { opacity: 1; transform: none; }
    .bk__mobil strong { font-family: var(--font-head); font-size: 1.02rem; color: var(--white); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .bk__mobil span { white-space: nowrap; }
    .bk__mobil small { font-size: 0.78rem; }
    .bk__mobil-e { padding-left: 10px; border-left: 1px solid rgb(255 255 255 / 25%); }
    .bk__mobil-e[hidden] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .bk__baustein, .bk__haken, .bk__mobil { transition: none !important; } }
</style>
