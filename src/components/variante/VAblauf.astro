---
// Zeitleiste „Von der Anfrage bis online“ (firma.de Punkt 8).
// Aus archiv/variante-firma-20261108/components/VAblauf.astro zurückgeholt (Jamil #5061/#5062, 08.11.2026), Teil der
// Startseite oben. „Was Sie beitragen“ (#beitrag, BEITRAG) samt Rechtshinweis am 09.11.2026 entfernt (Jamil, Talk qh87y3sj
// #5211–#5213); der Rechtshinweis RECHT (pakete-abo.ts) steht weiter auf /preise/ unter den Paketen.
// Kartenstapel (Jamil, Talk qh87y3sj #5214, 09.11.2026), echter Stapel seit #5287 (09.11.2026, Sicherung
// vor-ablauf-stapel2-20261109): zuerst ist nur Tag 1 zu sehen; beim Scrollen schiebt sich Tag 2 genau darüber und deckt Tag 1
// ganz zu, dann Tag 3 und so weiter. Alle Karten stehen an derselben Stelle (position: sticky, gleiches top, gleiche Höhe,
// deckend weiß), kein Einrasten, kein Scroll-Kapern. Ohne JS (html.js fehlt) oder bei reduzierter Bewegung: normale Liste.
import { ZEITLEISTE, ZEITLEISTE_UNTERTITEL } from '../../config/variante';
---

<section class="section" id="ablauf" aria-labelledby="ablauf-h">
  <div class="wrap vzeit-raster">
    <div class="section-head vzeit-kopf">
      <span class="eyebrow">Ablauf</span>
      <h2 id="ablauf-h" class="rule">Von der Anfrage bis online</h2>
      <p class="lead">{ZEITLEISTE_UNTERTITEL}</p>
    </div>
    <ol class="vzeit">
      {ZEITLEISTE.map((z, i) => (
        <li class="vzeit__karte" style={`--i: ${i}`}>
          <span class="vzeit__nr" aria-hidden="true">{i + 1}</span>
          <div class="vzeit__inhalt"><span class="vzeit__wann">{z.wann}</span><h3>{z.titel}</h3><p>{z.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Grundform (ohne JS, reduzierte Bewegung): Karten untereinander, normale Liste. */
  .vzeit { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; max-width: 760px; }
  .vzeit__karte {
    display: grid; grid-template-columns: 40px 1fr; column-gap: 18px; align-items: start;
    background: var(--white); border: 1px solid var(--line); border-radius: 18px; padding: clamp(18px, 2.6vw, 28px);
  }
  .vzeit__nr { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--dark); color: var(--white);
    font-family: var(--font-head); font-weight: 700; font-size: 1.05rem; }
  .vzeit__wann { display: block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 4px; }
  .vzeit h3 { margin: 0 0 4px; font-size: 1.15rem; }
  .vzeit p { margin: 0; line-height: 1.7; color: var(--ink-soft); }

  /* Stapel (nur mit JS und ohne reduzierte Bewegung, Jamil #5287):
     - Alle Karten gleich hoch (--karte-h misst das Skript unten: höchste Karte, mindestens 40 % des sichtbaren Bereichs
       zwischen Kopfzeile und Handy-Leiste --stapel-unten, damit nie zwei Karten ganz zu sehen sind) und mit demselben top,
       etwas über der Mitte des sichtbaren Bereichs.
       Die nächste Karte (höherer z-index, deckend weiß) liegt damit genau auf der vorigen: von Tag 1 bleibt nichts sichtbar.
     - Scrollweg je Karte = Kartenhöhe + Abstand darüber (margin-top, nicht unten: ein unterer Rand würde die Karten zu früh
       lösen) = rund 78 % der Bildschirmhöhe. Der leere Block am Listenende hält die letzte Karte kurz stehen.
     - Breite Bildschirme: Überschrift links bleibt auf Höhe der Karte stehen. Handy: Überschrift oben, Stapel darunter. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .vzeit-raster {
      --sichtbar: calc(100svh - var(--kopf-gesamt, 73px) - var(--stapel-unten, 0px));
      --karte-min: max(11rem, calc(var(--sichtbar) * 0.4));
      --karte-oben: calc(var(--kopf-gesamt, 73px) + max(16px, (var(--sichtbar) - var(--karte-h, var(--karte-min))) * 0.42));
    }
    :global(html.js) .vzeit { gap: 0; }
    :global(html.js) .vzeit::after { content: ''; display: block; height: clamp(60px, 22svh, 220px); }
    :global(html.js) .vzeit__karte {
      position: sticky; top: var(--karte-oben); z-index: calc(var(--i) + 1);
      box-sizing: border-box; min-height: var(--karte-h, var(--karte-min)); align-content: center;
      grid-template-columns: 48px 1fr; column-gap: clamp(16px, 2.4vw, 26px); padding: clamp(22px, 3.4vw, 40px);
      margin-top: max(48px, calc(78svh - var(--karte-h, var(--karte-min))));
      box-shadow: 0 16px 36px -26px rgb(0 47 45 / 22%), 0 1px 2px rgb(0 47 45 / 4%);
    }
    :global(html.js) .vzeit__karte:first-child { margin-top: 0; }
    :global(html.js) .vzeit__nr { width: 48px; height: 48px; font-size: 1.2rem; }
    :global(html.js) .vzeit h3 { font-size: clamp(1.3rem, 2.2vw, 1.6rem); margin-bottom: 6px; }
    :global(html.js) .vzeit p { font-size: clamp(1rem, 1.3vw, 1.1rem); }
    @media (min-width: 960px) {
      :global(html.js) .vzeit-raster { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(32px, 5vw, 80px); align-items: start; }
      :global(html.js) .vzeit-kopf { position: sticky; top: var(--karte-oben); margin-bottom: 0; }
    }
  }
</style>

<script>
  // Gleiche Höhe für alle Karten (höchste Karte zählt), damit keine frühere Karte unten hervorschaut. Bei Größenänderung und nach dem Laden der Schriften neu gemessen.
  const messen = () => {
    document.querySelectorAll<HTMLElement>('.vzeit-raster').forEach((raster) => {
      raster.style.removeProperty('--karte-h');
      const karten = Array.from(raster.querySelectorAll<HTMLElement>('.vzeit__karte'));
      const h = Math.ceil(Math.max(0, ...karten.map((k) => k.getBoundingClientRect().height)));
      if (h > 0) raster.style.setProperty('--karte-h', `${h}px`);
    });
  };
  messen();
  let wartet = false;
  window.addEventListener('resize', () => { if (!wartet) { wartet = true; requestAnimationFrame(() => { wartet = false; messen(); }); } }, { passive: true });
  document.fonts?.ready.then(messen);
</script>
