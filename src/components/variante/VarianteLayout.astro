---
// Rahmen für die Variante „an firma.de orientiert“ (Jamil #5016/#5017, 08.11.2026): immer noindex, nicht in der Sitemap,
// oben das Vergleichs-Banner mit Link zur normalen Startseite. Stile nur für diese Seiten (wird nur hier geladen).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BANNER } from '../../config/variante';
import { href } from '../../lib/paths';

interface Props { title: string; description: string; aktiv: 'start' | 'pakete' | 'gruender'; }
const { title, description, aktiv } = Astro.props;
const NAV = [
  { id: 'start', name: 'Übersicht', path: '/variante/' },
  { id: 'pakete', name: 'Pakete', path: '/variante/pakete/' },
  { id: 'gruender', name: 'Gründung', path: '/variante/gruender/' },
];
---

<BaseLayout title={title} description={description} noindex>
  <div class="vbanner" role="note">
    <div class="wrap vbanner__in">
      <p><strong>{BANNER.text}</strong></p>
      <a class="vbanner__link" href={href('/')}>{BANNER.link}</a>
    </div>
    <nav class="wrap vnav" aria-label="Seiten der Variante">
      {NAV.map((n) => <a href={href(n.path)} aria-current={n.id === aktiv ? 'page' : undefined}>{n.name}</a>)}
    </nav>
  </div>
  <slot />
</BaseLayout>

<style is:global>
  /* Knopfschrift auf Türkis mit ausreichendem Kontrast (5,1 : 1 statt 3,8 : 1), nur auf den Variante-Seiten */
  .btn--primary { color: var(--on-accent); }
  /* Türkis-Unterzeile im Footer-Kontaktblock auf Dunkel lesbarer (axe), nur hier */
  .fkontakt__sub { color: var(--accent-light) !important; }
  .vbanner { background: #fff4c2; border-bottom: 2px dashed #a37b00; color: #3d2f00; }
  .vbanner__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 18px; padding-block: 12px 6px; }
  .vbanner__in p { margin: 0; font-size: 0.95rem; line-height: 1.5; }
  .vbanner__link { font-weight: 700; color: #3d2f00; text-underline-offset: 3px; }
  .vnav { display: flex; gap: 6px; flex-wrap: wrap; padding-block: 4px 12px; }
  .vnav a { padding: 6px 14px; border-radius: 99px; border: 1px solid #a37b00; color: #3d2f00; text-decoration: none; font-size: 0.9rem; font-weight: 650; }
  .vnav a[aria-current='page'] { background: #3d2f00; color: #fff4c2; border-color: #3d2f00; }

  /* Gemeinsame Bausteine der Variante */
  .v-hero { padding-block: clamp(40px, 7vw, 88px) clamp(32px, 5vw, 56px); }
  .v-hero h1 { max-width: 18ch; }
  .v-hero .lead { margin-bottom: 26px; }
  .v-knopfe { display: flex; flex-wrap: wrap; gap: 12px; }
  .v-knopfe .btn { flex: 1 1 220px; max-width: 320px; }
  @media (max-width: 599px) { .v-knopfe .btn { max-width: none; } }
  .btn--umriss { border-color: var(--accent-ink); color: var(--accent-ink); background: var(--white); }
  .v-zusatz { margin: 18px 0 0; font-size: 0.95rem; color: var(--ink-soft); }
  .v-zusatz a { color: var(--accent-ink); font-weight: 650; text-underline-offset: 3px; }
  .v-vertrauen { background: var(--white); border-block: 1px solid var(--line); }
  .v-vertrauen ul { list-style: none; margin: 0; padding: 16px 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; }
  .v-vertrauen li { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.95rem; }
  .v-vertrauen .icon { color: var(--accent-ink); }
  .v-vertrauen a { color: inherit; text-underline-offset: 3px; }
  .v-text { line-height: 1.7; }
  .v-text p { margin-bottom: 20px; }
  .v-hinweis { max-width: 820px; margin: 22px auto 0; text-align: center; font-size: 0.88rem; line-height: 1.7; color: var(--ink-soft); }
  .v-platzhalter { position: relative; border: 2px dashed #b3261e !important; background: #fffafa !important; }
  .v-platzhalter__etikett { display: inline-block; margin-bottom: 8px; padding: 1px 10px; border-radius: 999px; background: #b3261e; color: #fff; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; }
  .v-grid3 { display: grid; gap: 18px; }
  @media (min-width: 980px) { .v-grid3 { grid-template-columns: repeat(3, 1fr); gap: 22px; } }
  .v-cta { text-align: center; }
  .v-cta .v-knopfe { justify-content: center; }
</style>
