---
// Kasten „Für Gründer und alle, die neu starten: einmalig dazubuchen“ (Jamil, Talk qh87y3sj #5041/#5042).
// Steht unter den Paketen (/variante/pakete/) und auf /variante/gruender/. Daten: EINMALIG in src/config/variante.ts.
import { formatEuro } from '../../config/site';
import { EINMALIG } from '../../config/variante';
// Block ohne eigenen Abschnitt: wird in den Paket-Abschnitt der Seite eingebettet (gleicher Hintergrund).
interface Props { id?: string }
const { id = 'einmalig' } = Astro.props;
---

<div class="veinb" id={id} role="region" aria-labelledby={`${id}-h`}>
    <div class="section-head">
      <span class="eyebrow">Einmalig dazu</span>
      <h2 id={`${id}-h`} class="rule">{EINMALIG.titel}</h2>
    </div>
    <ul class="vein">
      {EINMALIG.liste.map((e) => (
        <li class="card">
          <h3>{e.name}</h3>
          <p>{e.text}</p>
          <p class="vein__preis">{e.preis ? <><b>{formatEuro(e.preis)}</b> einmalig, netto</> : <b>Festpreis auf Anfrage</b>}</p>
        </li>
      ))}
    </ul>
    <p class="vein__hinweis">{EINMALIG.hinweis}</p>
</div>

<style>
  .veinb { margin-top: clamp(48px, 7vw, 80px); padding-top: clamp(32px, 5vw, 48px); border-top: 1px solid var(--line); scroll-margin-top: 120px; }
  .vein { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 720px) { .vein { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .vein { grid-template-columns: repeat(4, 1fr); } }
  .vein li { display: flex; flex-direction: column; gap: 6px; }
  .vein h3, .vein p { margin: 0; }
  .vein h3 { font-size: 1.1rem; }
  .vein p { line-height: 1.7; color: var(--ink-soft); }
  .vein .vein__preis { margin-top: auto; padding-top: 8px; color: var(--ink); }
  .vein__preis b { font-family: var(--font-head); font-size: 1.15rem; }
  .vein__hinweis { max-width: 820px; margin: 20px 0 0; padding: 14px 18px; border-radius: 14px; background: var(--white); border: 1px solid var(--line); font-weight: 600; line-height: 1.6; }
</style>
