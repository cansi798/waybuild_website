---
// Vergleich nach Anbieter-Art als vier Karten statt Tabelle (Jamil, Talk qh87y3sj #5210 „das anschaulicher designen“).
// Texte ausschließlich aus VERGLEICH (config/variante.ts). UWG § 6: keine Namen, sachlich, neutrale Zeichen statt
// roter Kreuze; Häkchen nur bei waybuild (letzte Spalte).
// Aufbau für Screenreader: Liste mit einer Karte je Anbieter-Art (h3) und darin <dl> Frage → Antwort.
// Die Fragen-Spalte links (nur Desktop) ist reine Optik und deshalb aria-hidden.
// Desktop: CSS-Subgrid, damit die Zeilen aller Karten auf einer Höhe liegen. Handy: Karten wischbar innerhalb des
// Abschnitts (scroll-snap), per Tastatur scrollbar (tabindex=0), nie Querscrollen der Seite.
import Icon from '../Icon.astro';
import type { IconName } from '../../config/site';
import { VERGLEICH } from '../../config/variante';

// Linien-Icon je Frage (Reihenfolge wie VERGLEICH.zeilen: Texte, Google, Updates/Sicherungen, Ansprechpartner, Kosten)
const ICONS: IconName[] = ['pen', 'search', 'shield', 'phone', 'euro'];
const icon = (i: number): IconName => ICONS[i] ?? 'check';
const WIR = VERGLEICH.spalten.length - 1;
const n = VERGLEICH.zeilen.length;
// Anzahl im Wisch-Hinweis als Wort (Stil: „alle vier“)
const ZAHLWORT = ['null', 'eins', 'zwei', 'drei', 'vier', 'fünf', 'sechs', 'sieben', 'acht', 'neun', 'zehn'];
const spaltenWort = ZAHLWORT[VERGLEICH.spalten.length] ?? String(VERGLEICH.spalten.length);
---

<div class="vk__scroll" role="region" aria-label="Vergleich nach Anbieter-Art" tabindex="0">
  <div class="vk" style={`--vk-zeilen:${n}`}>
    <div class="vk__fragen" aria-hidden="true">
      <span class="vk__ecke"></span>
      {VERGLEICH.zeilen.map((z, i) => (
        <span class="vk__frage"><span class="vk__ic"><Icon name={icon(i)} size={20} /></span>{z.frage}</span>
      ))}
    </div>
    <ul class="vk__karten" role="list">
      {VERGLEICH.spalten.map((sp, s) => (
        <li class:list={['vk__karte', { 'vk__karte--wir': s === WIR }]}>
          <div class="vk__kopf">
            {s === WIR && <span class="vk__etikett">Unser Weg</span>}
            <h3 class="vk__name">{sp}</h3>
          </div>
          <dl class="vk__liste">
            {VERGLEICH.zeilen.map((z, i) => (
              <div class="vk__zeile">
                <dt class="vk__dt"><span class="vk__ic"><Icon name={icon(i)} size={18} /></span>{z.frage}</dt>
                <dd class="vk__dd">
                  {s === WIR
                    ? <span class="vk__zeichen vk__zeichen--ja" aria-hidden="true"><Icon name="check" size={16} /></span>
                    : <span class="vk__zeichen" aria-hidden="true"></span>}
                  <span>{z.werte[s]}</span>
                </dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
  </div>
</div>
<p class="vk__wischen" aria-hidden="true">Seitlich wischen, um alle {spaltenWort} zu sehen</p>

<style>
  .vk__scroll { --vk-tuerkis: #00807b; --vk-hell: #e9f6f5; position: relative; }
  .vk__scroll:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 4px; border-radius: 18px; }

  /* ---------- Desktop: Fragen-Spalte + vier Karten, Zeilen per Subgrid ausgerichtet ---------- */
  .vk {
    display: grid;
    grid-template-columns: minmax(170px, 1.05fr) repeat(4, minmax(0, 1fr));
    grid-template-rows: auto repeat(var(--vk-zeilen), auto);
    column-gap: 14px;
    padding-top: 12px; /* Platz für die angehobene waybuild-Karte */
  }
  .vk__fragen, .vk__karten, .vk__karte, .vk__liste {
    display: grid; grid-row: 1 / -1; grid-template-rows: subgrid;
  }
  .vk__fragen { grid-column: 1; }
  .vk__karten { grid-column: 2 / -1; grid-template-columns: subgrid; margin: 0; padding: 0; list-style: none; }
  .vk__karte {
    grid-row: 1 / -1; margin: 0; padding: 0 18px 8px;
    background: var(--white); border: 1px solid var(--line); border-radius: 16px;
  }
  .vk__liste { grid-row: 2 / -1; margin: 0; }
  .vk__zeile { display: grid; align-content: start; padding: 14px 0; border-top: 1px solid var(--line); }
  .vk__kopf { display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 20px 0 14px; }
  .vk__name { margin: 0; font-family: var(--font-head); font-size: 1.12rem; line-height: 1.3; color: var(--ink); }
  .vk__ecke { display: block; }
  .vk__frage {
    display: flex; align-items: flex-start; gap: 10px; padding: 14px 4px 14px 0;
    border-top: 1px solid var(--line); font-weight: 650; line-height: 1.45; color: var(--ink);
  }
  .vk__ecke + .vk__frage { border-top: 0; }
  .vk__ic {
    flex: none; display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 10px;
    background: var(--vk-hell); color: var(--accent-ink);
  }
  /* Desktop: Frage steht sichtbar in der linken Spalte, in jeder Karte nur für Screenreader */
  .vk__dt {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .vk__dd { display: flex; align-items: flex-start; gap: 10px; margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--ink-soft); }
  .vk__dd > span:last-child, .vk__frage { min-width: 0; hyphens: auto; overflow-wrap: anywhere; }

  /* Zeichen: neutraler Ring bei den anderen, Häkchen im Türkis-Kreis bei waybuild */
  .vk__zeichen {
    flex: none; display: inline-grid; place-items: center; width: 22px; height: 22px; margin-top: 1px;
    border-radius: 50%; border: 2px solid #b9b1a3; background: var(--white);
  }
  .vk__zeichen--ja { border: 0; background: var(--vk-tuerkis); color: var(--white); }

  /* waybuild-Karte hervorgehoben: leicht angehoben, Rand #00807B */
  .vk__karte--wir {
    position: relative; z-index: 1; transform: translateY(-10px);
    border: 2px solid var(--vk-tuerkis); box-shadow: 0 2px 4px rgb(0 79 76 / 8%), 0 18px 40px rgb(0 79 76 / 14%);
  }
  .vk__karte--wir .vk__name { color: var(--vk-tuerkis); font-size: 1.25rem; }
  .vk__karte--wir .vk__dd { color: var(--ink); font-weight: 600; }
  .vk__karte--wir .vk__zeile { border-top-color: #cfe7e5; }
  .vk__etikett {
    align-self: flex-start; padding: 2px 10px; border-radius: 999px; background: var(--vk-tuerkis);
    color: var(--white); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .vk__wischen { display: none; }
  /* schmaler Desktop (900–1199 px): etwas enger, damit lange Wörter wie „Einrichtungskosten“ in die Karte passen */
  @media (min-width: 900px) and (max-width: 1199px) {
    .vk { grid-template-columns: minmax(150px, 0.9fr) repeat(4, minmax(0, 1fr)); column-gap: 10px; }
    .vk__karte { padding-inline: 14px; }
    .vk__dd { gap: 8px; font-size: 0.92rem; }
    .vk__karte--wir .vk__name { font-size: 1.15rem; }
  }

  /* ---------- Tablet/Handy: Fragen stehen in jeder Karte, Karten wischbar im Abschnitt ---------- */
  @media (max-width: 899px) {
    .vk__scroll {
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px; margin-inline: -16px; padding: 0 16px 6px; scrollbar-width: thin;
    }
    .vk { display: block; padding-top: 12px; }
    .vk__fragen { display: none; }
    .vk__karten { display: flex; gap: 14px; width: max-content; }
    .vk__karte {
      display: block; width: min(80vw, 330px); scroll-snap-align: start; padding: 0 18px 10px;
    }
    .vk__karte--wir { transform: none; }
    .vk__karten::after { content: ''; flex: none; width: 2px; } /* rechter Rand nach der letzten Karte */
    .vk__liste { display: block; }
    .vk__zeile { display: block; padding: 12px 0; }
    .vk__kopf { padding: 18px 0 12px; }
    .vk__dt {
      position: static; width: auto; height: auto; margin: 0 0 6px; overflow: visible; clip: auto; white-space: normal;
      display: flex; align-items: center; gap: 8px;
      font-size: 0.84rem; font-weight: 650; line-height: 1.4; color: var(--ink);
    }
    .vk__dt .vk__ic { width: 28px; height: 28px; border-radius: 8px; }
    .vk__dd { font-size: 0.95rem; }
    .vk__wischen { display: block; margin: 10px 0 0; text-align: center; font-size: 0.85rem; color: var(--ink-soft); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .vk__scroll { scroll-behavior: smooth; }
  }
</style>
