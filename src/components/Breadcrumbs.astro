---
// Sichtbarer Brotkrumenpfad – passend zum BreadcrumbList-JSON-LD im Layout.
import { href } from '../lib/paths';

interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
const all = [{ name: 'Start', path: '/' }, ...items];
---

<nav class="crumbs" aria-label="Brotkrumen">
  <ol class="wrap">
    {all.map((c, i) => (
      <li>
        {i < all.length - 1 ? <a href={href(c.path)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { border-bottom: 1px solid var(--line); font-size: 0.85rem; }
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 12px 0; margin-block: 0; }
  .crumbs li { display: flex; align-items: center; gap: 6px; color: var(--ink-soft); }
  .crumbs li + li::before { content: '/'; color: var(--line); }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--accent-ink); text-decoration: underline; }
  .crumbs [aria-current] { color: var(--ink); font-weight: 600; }
</style>
