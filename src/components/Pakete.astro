---
// Drei Pakete von „Website as a Service“ (Jamil #5056, 08.11.2026): Basis, Plus, Komplett (Daten aus pakete-abo.ts).
// Preise netto zzgl. MwSt. (B2B), brutto klein darunter. Daten ausschließlich aus config/site.ts → PAKETE.
// Wird auf Startseite und Preisseite genutzt.
import { href } from '../lib/paths';
import { PAKETE, IN_ALLEN, WAAS, PREIS_HINWEIS, formatEuro, brutto } from '../config/site';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props { head?: boolean; }
const { head = true } = Astro.props;
---

<section class="section section--alt pakete" id="preise" aria-labelledby="pakete-h">
  <div class="wrap">
    {head ? (
      <SectionHead center eyebrow="Preise · Website as a Service" pre="Drei Pakete. " accent="Fester Monatspreis." text="Website, E-Mail und Betreuung zum festen Monatspreis, ohne Einrichtungskosten." id="pakete-h" />
    ) : <h2 class="sr-only" id="pakete-h">Die drei Pakete</h2>}
    <div class="pakete__grid">
      {PAKETE.map((p) => (
        <article class:list={['paket', { 'paket--top': p.empfohlen }]} aria-labelledby={`paket-${p.id}`}>
          {p.empfohlen && <span class="paket__badge">Empfehlung</span>}
          <h3 id={`paket-${p.id}`}>{p.name}</h3>
          <p class="paket__kurz">{p.kurz}</p>
          <p class="paket__preis"><b>{formatEuro(p.preis)}</b> <span>netto / Monat zzgl. 19 % MwSt.<br />{formatEuro(brutto(p.preis))} inkl. MwSt.</span></p>
          <p class="paket__fuer">{p.fuer}</p>
          {p.extras.length > 0 && <ul class="paket__extras">{p.extras.map((e) => <li><Icon name="doc" size={16} /> {e}</li>)}</ul>}
          <ul class="paket__liste">{p.features.map((f) => <li><Icon name="check" size={18} /> {f}</li>)}</ul>
          <a class:list={['btn btn--lg paket__btn', p.empfohlen ? 'btn--primary' : 'btn--dark']} href={`${href('/kontakt/')}?paket=${encodeURIComponent(`${p.name} (${formatEuro(p.preis)} / Monat)`)}`}>Erstgespräch vereinbaren<span class="sr-only">: {p.name}</span></a>
        </article>
      ))}
    </div>
    <div class="pakete__alle">
      <p class="pakete__alle-t"><Icon name="check" size={18} /> In allen Paketen</p>
      <ul class="check-row pakete__modell">{IN_ALLEN.map((m) => <li><Icon name="check" size={18} /> {m}</li>)}</ul>
    </div>
    <p class="pakete__hinweis">{WAAS.laufzeit} · {PREIS_HINWEIS} Impressum und Datenschutzerklärung binden wir nach aktuellem Stand ein; das ersetzt keine Rechtsberatung.</p>
  </div>
</section>

<style>
  .pakete { scroll-margin-top: var(--header-h); }
  .pakete__grid { display: grid; gap: 18px; max-width: 1180px; margin-inline: auto; }
  @media (min-width: 980px) { .pakete__grid { grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; } }
  .paket {
    position: relative; display: flex; flex-direction: column; gap: 10px;
    background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(22px, 3vw, 30px);
  }
  .paket > * { margin: 0; }
  .paket--top { background: var(--dark); color: var(--paper); border-color: var(--dark); box-shadow: 0 24px 48px -20px rgb(0 79 76 / 45%); }
  .paket--top h3 { color: var(--white); }
  .paket h3 { font-size: clamp(1.4rem, 2.4vw, 1.65rem); }
  .paket__badge { align-self: flex-start; margin-bottom: -2px !important; padding: 4px 12px; border-radius: 99px; background: var(--accent); color: var(--dark); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .paket__kurz { font-weight: 600; color: var(--accent-ink); }
  .paket--top .paket__kurz { color: var(--accent); }
  .paket__preis { display: flex; align-items: center; gap: 10px; padding-block: 6px; flex-wrap: wrap; }
  .paket__preis b { font-family: var(--font-head); font-size: clamp(2.1rem, 4vw, 2.6rem); line-height: 1; letter-spacing: -0.02em; color: var(--ink); }
  .paket--top .paket__preis b { color: var(--white); }
  .paket__preis span { font-size: 0.85rem; line-height: 1.35; color: var(--ink-soft); }
  .paket--top .paket__preis span, .paket--top .paket__fuer { color: var(--dark-lead); }
  .paket__fuer { font-size: 0.95rem; color: var(--ink-soft); }
  .paket__extras { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .paket__extras li { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 99px; border: 1px solid var(--accent); color: var(--accent-ink); font-size: 0.82rem; font-weight: 650; }
  .paket--top .paket__extras li { color: var(--accent); }
  .paket__liste { list-style: none; padding: 14px 0 6px; display: grid; gap: 9px; border-top: 1px solid var(--line); }
  .paket--top .paket__liste { border-color: var(--dark-line); }
  .paket__liste li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.95rem; line-height: 1.45; }
  .paket__liste :global(.icon) { flex: none; margin-top: 2px; color: var(--accent-ink); }
  .paket--top .paket__liste :global(.icon) { color: var(--accent); }
  .paket__btn { margin-top: auto !important; width: 100%; text-align: center; }
  .pakete__alle { max-width: 1180px; margin: 26px auto 0; padding: 18px 20px; border-radius: 16px; background: var(--white); border: 1px dashed var(--accent); }
  .pakete__alle-t { margin: 0 0 10px; text-align: center; font-weight: 700; color: var(--accent-ink); }
  .pakete__alle-t :global(.icon) { vertical-align: -3px; }
  .pakete__modell { justify-content: center; margin: 0; }
  .pakete__hinweis { max-width: 900px; margin: 18px auto 0; text-align: center; font-size: 0.85rem; line-height: 1.6; color: var(--ink-soft); }
</style>
