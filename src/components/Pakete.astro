---
// Zwei Varianten von „Website as a Service“ (Jamil, 19.10.2026): 79 € und 139 € netto im Monat.
// Preise ausschließlich aus config/site.ts → PAKETE. Wird auf Startseite und Preisseite genutzt.
import { href } from '../lib/paths';
import { PAKETE, MODELL, formatEuro } from '../config/site';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props { head?: boolean; }
const { head = true } = Astro.props;
---

<section class="section section--alt pakete" id="preise" aria-labelledby="pakete-h">
  <div class="wrap">
    {head ? (
      <SectionHead center eyebrow="Preise · Website as a Service" pre="Zwei Varianten. " accent="Alles drin." text="Wählen Sie, wie viel Ihre Website für Sie arbeiten soll." id="pakete-h" />
    ) : <h2 class="sr-only" id="pakete-h">Die zwei Varianten</h2>}
    <div class="pakete__grid">
      {PAKETE.map((p) => (
        <article class:list={['paket', { 'paket--top': p.empfohlen }]} aria-labelledby={`paket-${p.id}`}>
          {p.empfohlen && <span class="paket__badge">Empfehlung</span>}
          <h3 id={`paket-${p.id}`}>{p.name}</h3>
          <p class="paket__kurz">{p.kurz}</p>
          <p class="paket__preis"><b>{formatEuro(p.preis)}</b> <span>/ Monat<br />netto, zzgl. MwSt.</span></p>
          <p class="paket__fuer">{p.fuer}</p>
          <ul class="paket__liste">{p.features.map((f) => <li><Icon name="check" size={18} /> {f}</li>)}</ul>
          <a class:list={['btn btn--lg paket__btn', p.empfohlen ? 'btn--primary' : 'btn--dark']} href={`${href('/kontakt/')}?paket=${encodeURIComponent(`${p.name} (${formatEuro(p.preis)} / Monat)`)}`}>Erstgespräch vereinbaren<span class="sr-only"> – {p.name}</span></a>
        </article>
      ))}
    </div>
    <div class="pakete__unterschied">
      <p><Icon name="compass" size={20} /> <strong>Der Unterschied in einem Satz:</strong> Die Website für {formatEuro(PAKETE[0].preis)} pflegen wir für Sie – die intelligente Website für {formatEuro(PAKETE[1].preis)} lernt zusätzlich aus Ihren Besuchern und verbessert sich laufend selbst.</p>
    </div>
    <ul class="check-row pakete__modell">{MODELL.map((m) => <li><Icon name="check" size={18} /> {m}</li>)}</ul>
  </div>
</section>

<style>
  .pakete { scroll-margin-top: var(--header-h); }
  .pakete__grid { display: grid; gap: 18px; max-width: 920px; margin-inline: auto; }
  @media (min-width: 800px) { .pakete__grid { grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; } }
  .paket {
    position: relative; display: flex; flex-direction: column; gap: 10px;
    background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(22px, 3.5vw, 32px);
  }
  .paket > * { margin: 0; }
  .paket--top { background: var(--dark); color: var(--paper); border-color: var(--dark); box-shadow: 0 24px 48px -20px rgb(0 79 76 / 45%); }
  .paket--top h3 { color: var(--white); }
  .paket h3 { font-size: clamp(1.4rem, 2.6vw, 1.7rem); }
  .paket__badge { align-self: flex-start; margin-bottom: -2px !important; padding: 4px 12px; border-radius: 99px; background: var(--accent); color: var(--dark); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .paket__kurz { font-weight: 600; color: var(--accent-ink); }
  .paket--top .paket__kurz { color: var(--accent); }
  .paket__preis { display: flex; align-items: center; gap: 10px; padding-block: 6px; }
  .paket__preis b { font-family: var(--font-head); font-size: clamp(2.4rem, 5vw, 3rem); line-height: 1; letter-spacing: -0.02em; color: var(--ink); }
  .paket--top .paket__preis b { color: var(--white); }
  .paket__preis span { font-size: 0.85rem; line-height: 1.3; color: var(--ink-soft); }
  .paket--top .paket__preis span, .paket--top .paket__fuer { color: var(--dark-lead); }
  .paket__fuer { font-size: 0.95rem; color: var(--ink-soft); }
  .paket__liste { list-style: none; padding: 14px 0 6px; display: grid; gap: 9px; border-top: 1px solid var(--line); }
  .paket--top .paket__liste { border-color: var(--dark-line); }
  .paket__liste li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.97rem; line-height: 1.45; }
  .paket__liste :global(.icon) { flex: none; margin-top: 2px; color: var(--accent-ink); }
  .paket--top .paket__liste :global(.icon) { color: var(--accent); }
  .paket__btn { margin-top: auto !important; width: 100%; text-align: center; }
  .pakete__unterschied { max-width: 920px; margin: 22px auto 0; padding: 16px 20px; border-radius: 14px; background: var(--white); border: 1px dashed var(--accent); }
  .pakete__unterschied p { margin: 0; line-height: 1.55; }
  .pakete__unterschied :global(.icon) { color: var(--accent-ink); vertical-align: -4px; margin-right: 4px; }
  .pakete__modell { justify-content: center; margin-top: 20px; }
</style>
