---
// „Ein Ansprechpartner. Alles im Blick.“ – Betreuungs-Sektion (entspricht der Kundenportal-Sektion bei Bauwelt).
import { BETREUUNG } from '../config/home';
import SectionHead from './SectionHead.astro';
import RoughSzene from './RoughSzene.astro';
---

<section class="section section--sand" id="betreuung" aria-labelledby="betreuung-h">
  <div class="wrap">
    <SectionHead center eyebrow="Betreuung" pre="Ein Ansprechpartner. Alles im " accent="Blick." text={BETREUUNG.sub} id="betreuung-h" />
    <RoughSzene
      szene="betreuung"
      label="Animiertes Handy mit dem Status Ihrer Website, dazu vier Vorteile: Änderungen per E-Mail – wir setzen um; Rechnungen und Verträge an einem Ort; Zahlen im Blick – Besucher, Anfragen, Tempo; immer aktuell – Updates, Backups, Sicherheit."
    />
  </div>
</section>
