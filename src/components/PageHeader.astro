---
// Seitenkopf der Unterseiten. Seit 20.11.2026 hell wie der Startseiten-Hero (Jamil #6521). Vorher seit 14.11.2026 im Stil des Startseiten-Heros (Jamil Talk qh87y3sj #5892: „Unterseiten im selben Stil
// wie die Hauptseite“): türkiser Verlauf mit weichen Farbflächen, weiße Schrift, links ausgerichtet. Optional ein Stockfoto (Jamil, Talk qh87y3sj #5362): PC Text links, Foto rechts;
// Handy Foto unter dem Text. Ohne `foto` bleibt der Kopf wie bisher.
import Foto from './Foto.astro';
import { hl } from '../lib/hl';
import type { FotoId } from '../config/bilder';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Unterzeile direkt unter der H1 (vor dem Lead) */
  unter?: string;
  foto?: FotoId;
}
const { eyebrow, title, lead, foto, unter } = Astro.props;
---

<section class="ph">
  <div class="ph__flaechen" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class:list={['wrap', { 'ph__raster': foto }]}>
    <div class="ph__text">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={hl(title)} />{/* ==Wort== = goldener Marker (Jamil #7016, lib/hl.ts) */}
      {unter && <p class="ph__unter">{unter}</p>}{/* Jamil #7120/#7126 b: Unterzeile direkt unter der H1 */}
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {foto && <Foto id={foto} loading="eager" sizes="(min-width: 1200px) 460px, (min-width: 900px) 38vw, calc(100vw - 32px)" class="ph__foto" />}
  </div>
</section>

<style>
  /* Seit 20.11.2026 hell wie der Startseiten-Hero (Jamil Talk qh87y3sj #6521: „Passe alle Unterseiten an Design und Stil der Hauptseite an“,
     Sicherung Tag vor-unterseiten-20261120): Goldstich #FFFEFB mit zartem Gold-Schimmer oben rechts, Schrift Anthrazit, Eyebrow in Text-Gold,
     feine Goldlinie unter der Eyebrow. Vorher dunkler Verlauf #EFBF04 → #111827 mit treibenden Farbflächen (Markup .ph__flaechen bleibt, ausgeblendet).
     Einblenden wie im Hero: Überschrift sofort sichtbar (nur 8 px Gleiten), Text und Knöpfe weich nach; reduced-motion = keine Bewegung. */
  .ph {
    position: relative; overflow: hidden; overflow: clip; contain: paint; isolation: isolate; color: #111827;
    padding-block: clamp(48px, 8vw, 104px) clamp(44px, 6vw, 80px);
    background: radial-gradient(90% 80% at 90% 0%, rgb(212 175 55 / 10%) 0%, rgb(212 175 55 / 0) 60%), #FFFEFB;
    border-bottom: 1px solid #F1ECE0;
  }
  .ph__flaechen { display: none; }
  .ph .wrap { position: relative; }
  .ph .eyebrow { color: #111827; display: inline-flex; align-items: center; gap: 10px; }
  .ph .eyebrow::before { content: ''; width: 28px; height: 2px; border-radius: 2px; background: #EFBF04; }
  .ph h1 { color: #111827; font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3.8rem); line-height: 1.06; letter-spacing: -0.035em; max-width: 18ch; text-wrap: balance; }
  .ph .lead { color: #374151; max-width: 56ch; text-wrap: pretty; }
  /* Jamil #7120/#7126 b: Unterzeile direkt unter der H1, kräftiger als der Lead */
  .ph .ph__unter { margin: 10px 0 0; font-size: var(--fs-lead); font-weight: 700; line-height: 1.4; color: #111827; }
  .ph :global(a:not(.btn)) { color: #111827; text-decoration-color: #EFBF04; text-underline-offset: 4px; }
  .ph :global(a:not(.btn):hover) { color: #111827; }
  .ph :global(.btn) { background: #EFBF04; color: #111827; border-color: #EFBF04; box-shadow: 0 16px 32px -18px rgb(140 109 18 / 60%); }
  .ph :global(.btn:hover) { background: #EFBF04; border-color: #EFBF04; color: #111827; }
  .ph :global(.btn--ghost) { background: transparent; border-color: #111827; color: #111827; box-shadow: none; }
  .ph :global(.btn--ghost:hover) { background: #FBF3D5; border-color: #111827; }
  .ph :global(:focus-visible) { outline-color: #EFBF04; }
  .ph__text { min-width: 0; }
  .ph__raster { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .ph__raster :global(.ph__foto) { border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -36px rgb(17 24 39 / 35%); }
  @media (min-width: 900px) { .ph__raster { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); } }
  @media (prefers-reduced-motion: no-preference) {
    .ph h1 { animation: ph-titel 600ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .ph__text > :not(h1), .ph__raster :global(.ph__foto) { animation: ph-ein 1100ms cubic-bezier(0.22, 1, 0.36, 1) 280ms both; }
  }
  @keyframes ph-titel { from { transform: translateY(8px); } to { transform: none; } }
  @keyframes ph-ein { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
</style>
