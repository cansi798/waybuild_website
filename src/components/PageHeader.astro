---
// Seitenkopf der Unterseiten. Optional ein Stockfoto (Jamil, Talk qh87y3sj #5362): PC Text links, Foto rechts;
// Handy Foto unter dem Text. Ohne `foto` bleibt der Kopf wie bisher.
import Foto from './Foto.astro';
import type { FotoId } from '../config/bilder';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  foto?: FotoId;
}
const { eyebrow, title, lead, foto } = Astro.props;
---

<section class="ph">
  <div class:list={['wrap', { 'ph__raster': foto }]}>
    <div class="ph__text">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {foto && <Foto id={foto} loading="eager" sizes="(min-width: 1200px) 460px, (min-width: 900px) 38vw, calc(100vw - 32px)" class="ph__foto" />}
  </div>
</section>

<style>
  .ph {
    position: relative; overflow: hidden;
    padding-block: clamp(48px, 8vw, 96px) clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .ph::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgb(0 79 76 / 5%) 1px, transparent 1px), linear-gradient(90deg, rgb(0 79 76 / 5%) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 85% 30%, #000 10%, transparent 60%);
  }
  .ph .wrap { position: relative; }
  .ph h1 { font-size: clamp(2.2rem, 5.5vw, 3.8rem); max-width: 18ch; }
  .ph__text { min-width: 0; }
  .ph__raster { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; }
  @media (min-width: 900px) { .ph__raster { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); } }
</style>
