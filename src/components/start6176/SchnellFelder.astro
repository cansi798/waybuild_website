---
// Gemeinsame Felder des Schnellstart-Formulars (E-Mail, Rückweg, Telefon, Honeypot, Datenschutz). Genutzt vom großen Formular (J6Start)
// und vom Hero-Formular (J6Hero, Jamil #6927); die Absende-Logik liegt einmal im Skript von J6Start.
import { J_START as T } from '../../config/start-6176';
import { href } from '../../lib/paths';
const S = T.schnell;
const ds = href('/datenschutz/');
---
<label class="js7-feld"><span>{S.email}* <small>{S.emailZusatz}</small></span><input name="email" type="email" inputmode="email" autocomplete="email" required /></label>
        <fieldset class="js7-chips" data-rueckweg>
          <legend>{S.rueckweg.legende}</legend>
          {S.rueckweg.optionen.map((o, n) => <label class="js7-chip"><input type="radio" name="informiert_per" value={o} checked={n === 0} /><span>{o}</span></label>)}
        </fieldset>
        <label class="js7-feld"><span>{S.telefon}<em data-tel-pflicht hidden>*</em> <small data-tel-opt>{S.optional}</small></span><input name="telefon" type="tel" inputmode="tel" autocomplete="tel" data-art="telefon" data-fehler={S.telefonFehler} data-pruefen={S.telefonPruefen} /></label>
        <input type="text" name="website" class="js7-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="paket" value="" />
        <label class="js7-check"><input type="checkbox" name="datenschutz" required /><span>Ich habe die <a href={ds}>Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage einverstanden.*</span></label>
