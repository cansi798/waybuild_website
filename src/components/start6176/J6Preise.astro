---
import "../../styles/preise-6400.css";
// 6. „Klare Monatspreise. Keine bösen Überraschungen.“ (Jamil, Talk qh87y3sj #6400, 19.11.2026). Texte wörtlich aus J_PREISE;
// Preise, Namen, „Ideal für“ und ✓-Listen aus config/pakete-abo.ts (dieselbe Quelle wie /preise/, Schema und llms.txt).
// Drei Karten nebeneinander (Handy untereinander), Fokus auf Karte 2 (Rahmen Hauptfarbe + Badge „Unsere Empfehlung“),
// Karte 3 als Baustein (Badge „+ Kombinierbar oder einzeln“). Kein Foto, keine Animation. Knöpfe führen zu Abschnitt 7.
// data-paket: J6Start übernimmt das gewählte Paket als verstecktes Feld ins Ziel-Formular (Loop 22.11.2026, MKT-002).
import { J_PREISE as T } from '../../config/start-6176';
import { ABO_PAKETE, KOMPLETTPAKET as K, euro } from '../../config/pakete-abo';
const [basis, plus] = ABO_PAKETE;
const karten = [
  { id: 'basis', rolle: T.rolle.basis, name: basis.name, preis: basis.preis, zusatz: '', fuer: basis.fuer,
    liste: basis.leistungen.map((l) => l.text), knopf: T.knopf.basis, ziel: '#start-schnell' },
  { id: 'plus', rolle: T.rolle.plus, badge: T.badge.plus, name: plus.name, preis: plus.preis, zusatz: '', fuer: plus.fuer,
    liste: [T.alles, ...plus.leistungen.map((l) => l.text)], knopf: T.knopf.plus, ziel: '#start-schnell', tipp: true },
  { id: 'software', rolle: T.rolle.software, badge: T.badge.software, name: K.name, preis: K.preis, zusatz: T.kombinierbar, fuer: K.kurz,
    liste: [...K.software], knopf: T.knopf.software, ziel: '#start-gespraech', plus: true },
];
const Haken = '<path d="M20 6 9 17l-5-5" />';
---

<section class="section sn jpr" id="preise-start" aria-labelledby="jpr-h">
  <div class="wrap">
    <div class="sn-kopf jpr__kopf">
      <h2 id="jpr-h" class="sn-h2 sn-h2--klein">{T.titel}</h2>
      <p class="sn-lead">{T.unter}</p>
    </div>
    <ul class="jpr-karten">
      {karten.map((k) => (
        <li class:list={['jpr-karte', { 'jpr-karte--tipp': k.tipp, 'jpr-karte--plus': k.plus }]} aria-labelledby={`jpr-${k.id}`}>
          {/* Kicker + Badge in EINER Zeile (Jamil #6415), damit Name und Preis in allen Karten auf gleicher Höhe stehen */}
          <div class="jpr-karte__kopf">
            <span class="jpr-karte__rolle">{k.rolle}</span>
            {k.badge && <span class:list={['jpr-badge', { 'jpr-badge--plus': k.plus }]}>{k.badge}</span>}
          </div>
          <h3 id={`jpr-${k.id}`} class="jpr-karte__name">{k.name}</h3>
          <p class="jpr-karte__preis"><b>{euro(k.preis)}</b> <span>{T.monat}{k.zusatz && <> {k.zusatz}</>}</span></p>
          <p class="jpr-karte__fuer">{k.fuer}</p>
          <ul class="jpr-liste">
            {k.liste.map((t) => (
              <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={Haken} /><span>{t}</span></li>
            ))}
          </ul>
          <a class:list={['btn btn--lg jpr-btn', { 'jpr-btn--voll': k.tipp }]} href={k.ziel} data-paket={k.name}>{k.knopf}<span class="sr-only">: {k.name}</span></a>
        </li>
      ))}
    </ul>
    <p class="jpr-hinweis">{T.hinweis}</p>
  </div>
</section>
