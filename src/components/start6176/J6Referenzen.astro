---
// 7. Referenzen (Jamil, Talk qh87y3sj #6179, 16.11.2026). Überschrift + vier Kategorien wörtlich (config/start-6176.ts, J_REFERENZEN),
// Emojis als eigene SVG-Icons. Je Beispiel Ausgangssituation / Lösung / Ergebnis = ausgang / gemacht / ergebnis aus REFERENZEN
// (startseite.ts, dieselben echten Daten wie /beispiele/). Nichts erfunden: keine Zitate, keine neuen Zahlen. Online/Vorschau ehrlich
// gekennzeichnet, Link nur bei „online“. Kategorie ohne echtes Projekt nur in der Vorschau mit „Beispiel folgt“. Stil: start-6176.css (.jr-*).
import J6Icon from './J6Icon.astro';
import { J_REFERENZEN as T } from '../../config/start-6176';
import { ALT_ZEIGEN } from '../../config/start-6176'; // doppelte Anker vermeiden, wenn der alte Abschnitt wieder an ist
import { REFERENZEN } from '../../config/startseite';
import { IS_PREVIEW } from '../../lib/env';
import { SHOW_HINTS } from '../../config/site';
import { href } from '../../lib/paths';
const VORSCHAU_HINWEISE = SHOW_HINTS && IS_PREVIEW;
const kategorien = T.kategorien
  .map((k) => ({ ...k, refs: k.projekte.map((n) => REFERENZEN.liste.find((r) => r.name === n)).filter((r): r is NonNullable<typeof r> => !!r) }))
  .filter((k) => k.refs.length > 0 || VORSCHAU_HINWEISE);
---

<section class="section sn jr" id={ALT_ZEIGEN.beweisAlt ? undefined : "referenzen"} aria-labelledby="jr-h">
  <div class="wrap">
    <div class="sn-kopf">
      <h2 id="jr-h" class="sn-h2 sn-h2--klein">{T.titel}</h2>
    </div>
    <div class="jr-kategorien">
      {kategorien.map((k) => (
        <div class="jr-kat j6-ein">
          <h3 class="jr-kat__titel"><span class="jr-kat__ico"><J6Icon name={k.icon as any} size={22} /></span>{k.name}</h3>
          {k.refs.length === 0 ? (
            <p class="jr-folgt">{T.folgt}</p>
          ) : (
            <ul class="jr-refs">
              {k.refs.map((r) => (
                <li class="jr-ref">
                  <p class="jr-ref__kopf">
                    <span class="jr-ref__name">{r.name}</span>
                    <span class:list={['jr-ref__status', `jr-ref__status--${r.status}`]}>{REFERENZEN.etikett[r.status]}</span>
                  </p>
                  <p class="jr-ref__branche">{r.branche}{r.ort ? `, ${r.ort}` : ''}</p>
                  <dl class="jr-ref__felder">
                    <div><dt>{T.felder.ausgang}</dt><dd>{r.ausgang}</dd></div>
                    <div><dt>{T.felder.gemacht}</dt><dd>{r.gemacht}</dd></div>
                    <div><dt>{T.felder.ergebnis}</dt><dd>{r.ergebnis}</dd></div>
                  </dl>
                  {r.status === 'online' && r.url && (
                    <a class="jr-ref__link" href={r.url} target="_blank" rel="noopener">{r.urlText ?? r.url}<span class="sr-only"> (öffnet in neuem Tab)</span></a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
    <p class="jr__alle"><a class="btn sn-btn sn-btn--rand" href={href('/beispiele/')}>{T.alle}</a></p>
  </div>
</section>
