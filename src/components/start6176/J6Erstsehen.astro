---
import "../../styles/erst-6388.css";
// 4. „Kein Lastenheft. Kein Risiko. Erst sehen, dann entscheiden.“ (Jamil, Talk qh87y3sj #6388, 19.11.2026). Texte wörtlich aus
// src/config/start-6176.ts (J_ERST). Drei Karten 01/02/03 (Desktop nebeneinander, Handy untereinander), je ein kleines UI-Badge:
// 01 zwei Auswahl-Pills (nur Optik), 02 zwei grüne Zeit-Badges mit Blitz-Icon (SVG), 03 Sprachnachrichten-Blase (Play, Wellenform, 0:12;
// sanfte Wellen-Animation, bei prefers-reduced-motion statisch). Badges sind Deko (aria-hidden), der Kartentext sagt dasselbe.
// Seit Jamil #6428: ab 900 px als Kartenstapel (position: sticky, jede Karte schiebt sich über die vorige), links Kopf, rechts Text.
// Stil: styles/erst-6388.css.
import { J_ERST as T } from '../../config/start-6176';
const [k1, k2, k3] = T.karten;
// Wellenform: feste Balkenhöhen (in %), wie eine kurze Sprachnachricht
const WELLE = [30, 55, 80, 45, 65, 95, 60, 35, 70, 50, 85, 40, 60, 75, 45, 30, 55, 70, 40, 25, 45, 30];
const Blitz = '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2Z" />';
---

<section class="section sn je" id="erst-sehen" aria-labelledby="je-h">
  <div class="wrap">
    <div class="sn-kopf je__kopf">
      <h2 id="je-h" class="sn-h2 sn-h2--klein">{T.titel}</h2>
      <p class="sn-lead">{T.unter}</p>
    </div>

    <ol class="je-karten">
      <li class="je-karte j6-ein">
        <div class="je-karte__links">
        <span class="je-karte__nr" aria-hidden="true">{k1.nr}</span>
        <h3 class="je-karte__titel">{k1.titel}</h3>
        <div class="je-badge je-pills" aria-hidden="true">
          <span class="je-pill je-pill--an">{k1.pills[0]}</span>
          <span class="je-oder">{k1.oder}</span>
          <span class="je-pill">{k1.pills[1]}</span>
        </div>
        </div>
        <div class="je-karte__rechts">
        {k1.varianten.map((v) => (
          <p class="je-karte__text"><b>{v.name}</b> {v.text}</p>
        ))}
        </div>
      </li>

      <li class="je-karte j6-ein">
        <div class="je-karte__links">
        <span class="je-karte__nr" aria-hidden="true">{k2.nr}</span>
        <h3 class="je-karte__titel">{k2.titel}</h3>
        <div class="je-badge je-zeiten" aria-hidden="true">
          {k2.zeiten.map((z) => (
            <span class="je-zeit"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" focusable="false" set:html={Blitz} />{z}</span>
          ))}
        </div>
        </div>
        <div class="je-karte__rechts">
        <p class="je-karte__text">{k2.einleitung}</p>
        <ul class="je-punkte">
          {k2.punkte.map((p) => (<li><b>{p.name}</b> {p.text}</li>))}
        </ul>
        <p class="je-karte__text">{k2.schluss}</p>
        </div>
      </li>

      <li class="je-karte j6-ein">
        <div class="je-karte__links">
        <span class="je-karte__nr" aria-hidden="true">{k3.nr}</span>
        <h3 class="je-karte__titel">{k3.titel}</h3>
        <div class="je-badge" aria-hidden="true">
          <span class="je-sprache">
            <span class="je-sprache__play"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" focusable="false"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" /></svg></span>
            <span class="je-sprache__welle">{WELLE.map((h, i) => <i style={`--h:${h}%;--i:${i}`}></i>)}</span>
            <span class="je-sprache__zeit">{k3.sprache}</span>
          </span>
        </div>
        </div>
        <div class="je-karte__rechts">
        <p class="je-karte__text">{k3.text}</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<script>
  // Kartenstapel (Jamil #6428/#6440): gleiche Höhe aller Karten (--je-min) und top je Karte (--je-top), damit jede Karte vollständig
  // lesbar ist, bevor die nächste sie abdeckt. Rechnet bei Größenänderung neu; nur Breitenänderungen zählen (iOS-Leisten sollen nichts springen lassen).
  const liste = document.querySelector<HTMLElement>('.je-karten');
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)');
  if (liste && !ruhig.matches) {
    const karten = [...liste.querySelectorAll<HTMLElement>('.je-karte')];
    let breite = 0;
    const rechnen = () => {
      if (innerWidth === breite) return;
      breite = innerWidth;
      karten.forEach((k) => { k.style.removeProperty('--je-min'); k.style.removeProperty('--je-top'); });
      const hoch = Math.max(...karten.map((k) => k.getBoundingClientRect().height));
      const kopf = document.querySelector('header')?.getBoundingClientRect().height ?? 72;
      const leiste = document.querySelector<HTMLElement>('.sticky-bar');
      const unten = leiste && getComputedStyle(leiste).display !== 'none' ? leiste.getBoundingClientRect().height : 0;
      const sicht = document.documentElement.clientHeight; // Layout-Viewport (wie svh), ändert sich nicht mit der iOS-Adressleiste
      const handy = innerWidth < 900;
      karten.forEach((k, n) => {
        if (handy) k.style.setProperty('--je-min', `${Math.ceil(hoch)}px`);
        const top = Math.min(kopf + 12 + n * 10, sicht - unten - (handy ? hoch : k.getBoundingClientRect().height) - 12);
        k.style.setProperty('--je-top', `${Math.round(top)}px`);
      });
    };
    rechnen();
    addEventListener('resize', rechnen, { passive: true });
    document.fonts?.ready.then(() => { breite = 0; rechnen(); });
  }
</script>
