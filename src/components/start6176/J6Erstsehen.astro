---
import { hl } from '../../lib/hl';
import "../../styles/erst-6388.css";
// 4. „Kein Aufwand vorab. Kein Risiko. Erst sehen, dann entscheiden.“ (Jamil, Talk qh87y3sj #6388, 19.11.2026).
// Seit Jamil #7145/#7150 (24.11.2026): die vier Schritte sind EIN Prozess auf einer Linie, die sich beim Scrollen füllt.
// Jeder Schritt (01–04, J_ERST.karten) ist eine Station auf der Linie; Titel und Text bleiben wörtlich erhalten. Das frühere
// Kreis-Diagramm in Schritt 04 entfällt (ersetzt durch die Station); die Mitte-Info „ganz einfach – per Sprachnachricht …“ steht
// als Zeile darunter. Grundform (ohne JS / reduzierte Bewegung): senkrechte Liste, Linie voll, alle Stationen sichtbar und lesbar.
// Mit Bewegung füllt das Skript unten die Gold-Linie beim Scrollen und schaltet die Punkte nacheinander aktiv. Ab 900 px waagerecht.
// Stil: styles/erst-6388.css.
import { J_ERST as T } from '../../config/start-6176';
const [k1, k2, k3, k4] = T.karten;
const mitte = k4.kreis.mitte.join(' '); // „ganz einfach – per Sprachnachricht, Text oder Screenshot“
---

<section class="section sn je" id="erst-sehen" aria-labelledby="je-h">
  <div class="wrap">
    <div class="sn-kopf je__kopf">
      <h2 id="je-h" class="sn-h2 sn-h2--klein"><Fragment set:html={hl(T.titel)} /></h2>
      <p class="sn-lead">{T.unter}</p>
    </div>

    <ol class="je-prozess" data-je-prozess>
      {/* Station 01 */}
      <li class="je-prozess__station" data-je-station style="--i:0">
        <span class="je-prozess__strich" aria-hidden="true"><span class="je-prozess__fill"></span></span>
        <div class="je-prozess__kopf"><span class="je-prozess__punkt" aria-hidden="true">{k1.nr}</span></div>
        <div class="je-prozess__inhalt">
          <h3 class="je-prozess__titel">{k1.titel}</h3>
          {k1.varianten.map((v) => (
            <p class="je-prozess__text">{v.name && <><b>{v.name}</b> </>}{v.text}</p>
          ))}
          {/* Seit Jamil #6500: zwei echte Knöpfe, Sprung zu den Formularen in Abschnitt 7 (Fokus aufs erste Feld) */}
          <div class="je-ctas">
            <a class="btn je-btn je-btn--voll" href="#start-gespraech" data-je-ziel="start-gespraech">{k1.knoepfe[0]}</a>
            <a class="btn je-btn je-btn--rand" href="#start-schnell" data-je-ziel="start-schnell">{k1.knoepfe[1]}</a>
          </div>
        </div>
      </li>

      {/* Station 02 */}
      <li class="je-prozess__station" data-je-station style="--i:1">
        <span class="je-prozess__strich" aria-hidden="true"><span class="je-prozess__fill"></span></span>
        <div class="je-prozess__kopf"><span class="je-prozess__punkt" aria-hidden="true">{k2.nr}</span></div>
        <div class="je-prozess__inhalt">
          <h3 class="je-prozess__titel">{k2.titel}</h3>
          <p class="je-prozess__text">{k2.einleitung}</p>
          <ul class="je-kennzahlen">
            {k2.kennzahlen.map((z) => (
              <li><span class="je-kennzahl__wert">{z.wert}</span><span class="je-kennzahl__text">{z.text}</span></li>
            ))}
          </ul>
          <p class="je-prozess__text">{k2.schluss}</p>
        </div>
      </li>

      {/* Station 03 */}
      <li class="je-prozess__station" data-je-station style="--i:2">
        <span class="je-prozess__strich" aria-hidden="true"><span class="je-prozess__fill"></span></span>
        <div class="je-prozess__kopf"><span class="je-prozess__punkt" aria-hidden="true">{k3.nr}</span></div>
        <div class="je-prozess__inhalt">
          <h3 class="je-prozess__titel">{k3.titel}</h3>
          <p class="je-prozess__text">{k3.text}</p>
        </div>
      </li>

      {/* Station 04 – letzte Station, kein Strich; dezenter Hinweis auf den laufenden Kreislauf (Jamil #7150: kein Kreis mehr) */}
      <li class="je-prozess__station je-prozess__station--letzte" data-je-station style="--i:3">
        <div class="je-prozess__kopf"><span class="je-prozess__punkt" aria-hidden="true">{k4.nr}</span></div>
        <div class="je-prozess__inhalt">
          <h3 class="je-prozess__titel">{k4.titel}</h3>
          <p class="je-prozess__text">{k4.text}</p>
          <p class="je-prozess__mitte">{mitte}</p>
          <span class="je-prozess__wieder" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 10a7 7 0 1 1 2 5" /><path d="M3 5v5h5" /></svg>
            … und von vorn
          </span>
        </div>
      </li>
    </ol>
  </div>
</section>

<script>
  // Prozess-Linie (Jamil #7145/#7150): die Gold-Linie füllt sich beim Scrollen, die Punkte werden nacheinander aktiv. Nur mit Bewegung;
  // ohne JS oder bei reduzierter Bewegung bleibt die Grundform (Linie voll, alle Stationen sichtbar) aus dem CSS stehen.
  const bahn = document.querySelector<HTMLElement>('[data-je-prozess]');
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)');
  if (bahn && !ruhig.matches) {
    const stationen = [...bahn.querySelectorAll<HTMLElement>('[data-je-station]')];
    const n = stationen.length;
    const fuellungen = stationen.map((s) => s.querySelector<HTMLElement>('.je-prozess__fill'));
    const punkte = stationen.map((s) => s.querySelector<HTMLElement>('.je-prozess__punkt'));
    bahn.classList.add('je-prozess--anim');
    let geplant = false;
    const zeichne = () => {
      geplant = false;
      const r = bahn.getBoundingClientRect();
      const vh = innerHeight || document.documentElement.clientHeight;
      // Fortlaufender Scroll-Fortschritt (Jamil #7187): die Gold-Linie wächst kontinuierlich, je weiter man scrollt – nicht pro Station.
      // Fenster so gewählt, dass die Füllung über die gesamte sichtbare Höhe des Abschnitts läuft; der Fortschritt treibt --seg direkt
      // (CSS ohne Transition = exakt am Scroll, kein Nachziehen).
      const start = vh * 0.82, ende = vh * 0.3;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - ende)));
      const voll = p * (n - 1); // Fortschritt über alle Teilstücke (0 … n−1)
      fuellungen.forEach((f, i) => { if (f) f.style.setProperty('--seg', (Math.min(1, Math.max(0, voll - i))).toFixed(4)); });
      // Punkt wird aktiv (gold), sobald die Linie ihn erreicht; der gerade anlaufende Punkt bekommt zusätzlich den Ring (.is-jetzt).
      const front = p >= 0.999 ? -1 : Math.min(n - 1, Math.ceil(voll - 0.001));
      punkte.forEach((pt, i) => {
        if (!pt) return;
        pt.classList.toggle('is-an', i === 0 ? p > 0.02 : voll >= i - 0.001);
        pt.classList.toggle('is-jetzt', i === front && (i > 0 ? voll < i : p > 0.02 && p < 1));
      });
      bahn.classList.toggle('is-fertig', p > 0.995);
    };
    const planen = () => { if (!geplant) { geplant = true; requestAnimationFrame(zeichne); } };
    zeichne();
    addEventListener('scroll', planen, { passive: true });
    addEventListener('resize', planen, { passive: true });
    document.fonts?.ready.then(planen);
  }
</script>

<script>
  // Knöpfe in Station 01 (Jamil #6500): weich zum Formular scrollen und das erste Feld fokussieren
  document.querySelectorAll<HTMLAnchorElement>('[data-je-ziel]').forEach((a) => a.addEventListener('click', (e) => {
    const form = document.getElementById(a.dataset.jeZiel ?? '');
    const feld = form?.querySelector<HTMLInputElement>('input:not([type=hidden]):not(.js7-hp)');
    if (!form || !feld) return;
    e.preventDefault();
    const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
    form.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' });
    history.replaceState(null, '', `#${form.id}`);
    setTimeout(() => feld.focus({ preventScroll: true }), ruhig ? 0 : 650);
  }));
</script>
