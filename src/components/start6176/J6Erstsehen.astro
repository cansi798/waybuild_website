---
import "../../styles/erst-6388.css";
// 4. „Kein Lastenheft. Kein Risiko. Erst sehen, dann entscheiden.“ (Jamil, Talk qh87y3sj #6388, 19.11.2026). Texte wörtlich aus
// src/config/start-6176.ts (J_ERST). Drei Karten 01/02/03 (Desktop nebeneinander, Handy untereinander), je ein kleines UI-Badge:
// 01 zwei Auswahl-Pills (nur Optik), 02 zwei grüne Zeit-Badges mit Blitz-Icon (SVG), 03 Sprachnachrichten-Blase (Play, Wellenform, 0:12;
// sanfte Wellen-Animation, bei prefers-reduced-motion statisch). Badges sind Deko (aria-hidden), der Kartentext sagt dasselbe.
// Seit Jamil #6428: ab 900 px als Kartenstapel (position: sticky, jede Karte schiebt sich über die vorige), links Kopf, rechts Text.
// Stil: styles/erst-6388.css.
import { J_ERST as T } from '../../config/start-6176';
const [k1, k2, k3, k4] = T.karten;
// Wellenform: feste Balkenhöhen (in %), wie eine kurze Sprachnachricht
const WELLE = [30, 55, 80, 45, 65, 95, 60, 35, 70, 50, 85, 40, 60, 75, 45, 30, 55, 70, 40, 25, 45, 30];
const Blitz = '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2Z" />';
// Kreislauf-Grafik (Jamil #6913): vier Stationen auf einer Ellipse, Pfeilbögen dazwischen (Winkel in Grad, 0 = rechts, Uhrzeigersinn)
const PT = (w: number): [number, number] => [200 + 140 * Math.cos((w * Math.PI) / 180), 150 + 100 * Math.sin((w * Math.PI) / 180)];
const ST = [PT(-90), PT(0), PT(90), PT(180)].map(([x, y]) => [Math.round(x), Math.round(y)]);
const BOGEN = [[-60, -24], [24, 60], [120, 156], [204, 240]].map(([a, b]) => {
  const [x1, y1] = PT(a), [x2, y2] = PT(b);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} A140 100 0 0 1 ${x2.toFixed(1)} ${y2.toFixed(1)}`;
});
---

<section class="section sn je" id="erst-sehen" aria-labelledby="je-h">
  <div class="wrap">
    <div class="sn-kopf je__kopf">
      <h2 id="je-h" class="sn-h2 sn-h2--klein">{T.titel}</h2>
      <p class="sn-lead">{T.unter}</p>
    </div>

    <ol class="je-karten">
      <li class="je-karte j6-ein">
        <div class="je-karte__links">
        <span class="je-karte__nr" aria-hidden="true">{k1.nr}</span>
        <h3 class="je-karte__titel">{k1.titel}</h3>
        {/* Seit Jamil #6500: zwei echte Knöpfe statt Auswahl-Pills, Sprung zu den Formularen in Abschnitt 7 (Fokus aufs erste Feld) */}
        <div class="je-ctas">
          <a class="btn je-btn je-btn--voll" href="#start-gespraech" data-je-ziel="start-gespraech">{k1.knoepfe[0]}</a>
          <a class="btn je-btn je-btn--rand" href="#start-schnell" data-je-ziel="start-schnell">{k1.knoepfe[1]}</a>
        </div>
        </div>
        <div class="je-karte__rechts">
        {k1.varianten.map((v) => (
          <p class="je-karte__text">{v.name && <><b>{v.name}</b> </>}{v.text}</p>
        ))}
        </div>
      </li>

      <li class="je-karte j6-ein">
        <div class="je-karte__links">
        <span class="je-karte__nr" aria-hidden="true">{k2.nr}</span>
        <h3 class="je-karte__titel">{k2.titel}</h3>
        </div>
        <div class="je-karte__rechts">
        <p class="je-karte__text">{k2.einleitung}</p>
        {/* Kennzahl-Leiste (Jamil #6502) statt Zeit-Badges und Aufzählung */}
        <ul class="je-kennzahlen">
          {k2.kennzahlen.map((z) => (
            <li><span class="je-kennzahl__wert">{z.wert}</span><span class="je-kennzahl__text">{z.text}</span></li>
          ))}
        </ul>
        <p class="je-karte__text">{k2.schluss}</p>
        </div>
      </li>

      <li class="je-karte j6-ein">
        <div class="je-karte__links">
        <span class="je-karte__nr" aria-hidden="true">{k3.nr}</span>
        <h3 class="je-karte__titel">{k3.titel}</h3>
        {/* Chat-Grafik (Jamil #6503): Sprachnachricht, Screenshot, Textnachricht → „Umgesetzt“; nur Deko */}
        <div class="je-chat" aria-hidden="true">
          <span class="je-msg je-msg--sprache"><span class="je-sprache__play"><svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" focusable="false"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" /></svg></span><span class="je-sprache__welle">{WELLE.slice(0, 16).map((h, i) => <i style={`--h:${h}%;--i:${i}`}></i>)}</span><span class="je-sprache__zeit">{k3.sprache}</span></span>
          <span class="je-msg je-msg--bild"><span class="je-shot"><i></i><i></i><i></i></span><small>Screenshot</small></span>
          <span class="je-msg je-msg--text">{k3.chat.text}</span>
          <span class="je-status"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 6 9 17l-5-5" /></svg>{k3.chat.status}</span>
        </div>
        </div>
        <div class="je-karte__rechts">
        <p class="je-karte__text">{k3.text}</p>
        </div>
      </li>

      {/* 4. Karte (Jamil #6518): Verlauf der Weiterentwicklung */}
      <li class="je-karte j6-ein">
        <div class="je-karte__links">
        <span class="je-karte__nr" aria-hidden="true">{k4.nr}</span>
        <h3 class="je-karte__titel">{k4.titel}</h3>
        <figure class="je-kreis">
          <svg viewBox="0 0 400 300" aria-hidden="true" focusable="false">
            <defs>
              <marker id="je-kreis-pfeil" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M1 1 9 5 1 9" fill="none" stroke="#8C6D12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></marker>
            </defs>
            {BOGEN.map((d) => <path class="je-kreis__bogen" d={d} marker-end="url(#je-kreis-pfeil)" />)}
            {k4.kreis.stationen.map((t, n) => (
              <g class="je-kreis__station">
                <rect x={ST[n][0] - 58} y={ST[n][1] - 18} width="116" height="36" rx="18" />
                <text x={ST[n][0]} y={ST[n][1] + 5} text-anchor="middle">{t}</text>
              </g>
            ))}
            <text class="je-kreis__mitte" text-anchor="middle">
              {k4.kreis.mitte.map((z, n) => <tspan x="200" y={146 + n * 17}>{z}</tspan>)}
            </text>
          </svg>
          <figcaption class="sr-only">{k4.kreis.beschreibung}</figcaption>
        </figure>
        </div>
        <div class="je-karte__rechts">
        <p class="je-karte__text">{k4.text}</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<script>
  // Kartenstapel (Jamil #6428/#6440): gleiche Höhe aller Karten (--je-min) und top je Karte (--je-top), damit jede Karte vollständig
  // lesbar ist, bevor die nächste sie abdeckt. Rechnet bei Größenänderung neu; nur Breitenänderungen zählen (iOS-Leisten sollen nichts springen lassen).
  const liste = document.querySelector<HTMLElement>('.je-karten');
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)');
  if (liste && !ruhig.matches) {
    const karten = [...liste.querySelectorAll<HTMLElement>('.je-karte')];
    let breite = 0;
    const rechnen = () => {
      if (innerWidth === breite) return;
      breite = innerWidth;
      karten.forEach((k) => { k.style.removeProperty('--je-min'); k.style.removeProperty('--je-top'); });
      const hoch = Math.max(...karten.map((k) => k.getBoundingClientRect().height));
      const kopf = document.querySelector('header')?.getBoundingClientRect().height ?? 72;
      const leiste = document.querySelector<HTMLElement>('.sticky-bar');
      const unten = leiste && getComputedStyle(leiste).display !== 'none' ? leiste.getBoundingClientRect().height : 0;
      const sicht = document.documentElement.clientHeight; // Layout-Viewport (wie svh), ändert sich nicht mit der iOS-Adressleiste
      const handy = innerWidth < 900;
      karten.forEach((k, n) => {
        k.style.setProperty('--je-min', `${Math.ceil(hoch)}px`); // #6505: auch am PC gleich hoch nach der längsten Karte
        const top = Math.min(kopf + 12 + n * 10, sicht - unten - hoch - 12);
        k.style.setProperty('--je-top', `${Math.round(top)}px`);
      });
    };
    rechnen();
    addEventListener('resize', rechnen, { passive: true });
    document.fonts?.ready.then(() => { breite = 0; rechnen(); });
  }
</script>

<script>
  // Knöpfe in Karte 01 (Jamil #6500): weich zum Formular scrollen und das erste Feld fokussieren
  document.querySelectorAll<HTMLAnchorElement>('[data-je-ziel]').forEach((a) => a.addEventListener('click', (e) => {
    const form = document.getElementById(a.dataset.jeZiel ?? '');
    const feld = form?.querySelector<HTMLInputElement>('input:not([type=hidden]):not(.js7-hp)');
    if (!form || !feld) return;
    e.preventDefault();
    const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
    form.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' });
    history.replaceState(null, '', `#${form.id}`);
    setTimeout(() => feld.focus({ preventScroll: true }), ruhig ? 0 : 650);
  }));
</script>
