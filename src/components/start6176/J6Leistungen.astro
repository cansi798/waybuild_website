---
// Leistungs-Gegenüberstellung direkt nach dem Hero (Jamil #7250/#7251, 24.11.2026): zwei grafische Karten „Website“ und
// „Web-App“. Je Karte: kurz was es ist, die wichtigsten Vorteile samt gelöstem Problem, ein Weiterführungs-Link.
// Bei der Web-App wird die Anbindung an bestehende Systeme (DATEV, Lexware, sevDesk u.v.m.) als Chip-Reihe gezeigt.
// Marketing/Customer-Journey-Rahmen: Website bringt Anfragen, Web-App verarbeitet sie – beides aus einer Hand.
import Icon from '../Icon.astro';
import { href } from '../../lib/paths';

const karten = [
  {
    id: 'website',
    icon: 'layout' as const,
    marke: 'Website',
    einzeiler: 'Ihr professioneller Auftritt im Netz.',
    wasEsIst: 'Ihr erster Eindruck und Ihre digitale Visitenkarte – damit Kunden Sie finden und aus Besuchern Anfragen werden.',
    vorteile: [
      'Gefunden werden – bei Google und auf dem Handy',
      'Anfragen kommen geordnet bei Ihnen an, statt im Postfach unterzugehen',
      'Hosting, Updates und Sicherungen übernehmen wir',
      'Wird betreut und laufend weiterentwickelt',
    ],
    link: { text: 'Mehr zur Website', pfad: '/leistungen/website/' },
  },
  {
    id: 'webapp',
    icon: 'code' as const,
    marke: 'Web-App',
    einzeiler: 'Individuelle Software, die im Browser läuft.',
    wasEsIst: 'Eine Web-App ist Ihre eigene Software im Browser – ohne Installation, auf PC, Tablet und Handy. Genau die Funktionen, die Ihr Betrieb braucht: von der Kundenverwaltung bis zur Terminbuchung.',
    vorteile: [
      'Genau Ihre Abläufe – keine überladenen Standard-Programme',
      'Alles an einem Ort, statt verstreut in vielen Tools',
      'Ihr Team arbeitet sofort los, ganz ohne Installation',
      'Anbindung an Ihre bestehenden Systeme',
      'Auf Wunsch mit KI-Anbindung – z. B. um Anfragen vorzusortieren',
    ],
    integrationen: ['DATEV', 'Lexware', 'sevDesk', 'u.v.m.'],
    link: { text: 'Mehr zur Web-App', pfad: '/leistungen/software/' },
  },
];
---

<section class="section sn jl" id="leistungen-ueberblick" aria-labelledby="jl-h">
  <div class="wrap">
    <div class="sn-kopf jl__kopf">
      <h2 id="jl-h" class="sn-h2 sn-h2--klein">Website und Web-App – beides aus einer Hand</h2>
      <p class="sn-lead">Die Website bringt Anfragen. Die Web-App verarbeitet sie. So wird aus dem ersten Klick ein reibungsloser Ablauf – perfekt aufeinander abgestimmt.</p>
    </div>

    <div class="jl__karten">
      {karten.map((k) => (
        <article class="jl-karte" data-leistung={k.id}>
          <div class="jl-karte__kopf">
            <span class="jl-karte__ico" aria-hidden="true"><Icon name={k.icon} size={24} /></span>
            <div>
              <h3 class="jl-karte__marke">{k.marke}</h3>
              <p class="jl-karte__einzeiler">{k.einzeiler}</p>
            </div>
          </div>

          <p class="jl-karte__was">{k.wasEsIst}</p>

          <ul class="jl-karte__vorteile">
            {k.vorteile.map((v) => (
              <li>
                <svg viewBox="0 0 20 20" class="jl-karte__check" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>{v}</span>
              </li>
            ))}
          </ul>

          {k.integrationen && (
            <div class="jl-karte__int">
              <p class="jl-karte__int-titel">Anbindung an Ihre bestehenden Systeme</p>
              <ul class="jl-chips">
                {k.integrationen.map((i) => <li class="jl-chip">{i}</li>)}
              </ul>
            </div>
          )}

          <a class="jl-karte__link" href={href(k.link.pfad)}>{k.link.text}<Icon name="arrow" size={18} /></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .jl { background: var(--paper, #f7f5f0); }
  .jl__kopf { text-align: center; max-width: 60ch; margin-inline: auto; }
  .jl__karten { display: grid; gap: 20px; margin-top: clamp(28px, 4vw, 44px); }
  @media (min-width: 760px) { .jl__karten { grid-template-columns: 1fr 1fr; align-items: start; } }

  .jl-karte { position: relative; display: flex; flex-direction: column; gap: 16px; background: var(--white, #fff);
    border: 1px solid rgb(17 24 39 / 8%); border-radius: 20px; padding: clamp(22px, 3vw, 30px);
    box-shadow: 0 18px 44px -30px rgb(17 24 39 / 30%); transition: transform 0.2s ease, box-shadow 0.2s ease; overflow: hidden; }
  .jl-karte::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: linear-gradient(90deg, #EFBF04, #FBE38A); }
  .jl-karte:hover { transform: translateY(-3px); box-shadow: 0 26px 54px -30px rgb(17 24 39 / 36%); }

  .jl-karte__kopf { display: flex; align-items: center; gap: 14px; }
  .jl-karte__ico { flex: none; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 14px;
    background: rgb(239 191 4 / 14%); color: #111827; }
  .jl-karte__marke { margin: 0; font-family: var(--font-head); font-weight: 800; font-size: var(--fs-h3); line-height: 1.1; color: var(--ink, #111827); }
  .jl-karte__einzeiler { margin: 2px 0 0; color: var(--ink-soft); font-size: var(--fs-small); }

  .jl-karte__was { margin: 0; color: var(--ink, #111827); line-height: 1.6; }

  .jl-karte__vorteile { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .jl-karte__vorteile li { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: start; color: var(--ink-soft); line-height: 1.5; }
  .jl-karte__check { width: 20px; height: 20px; margin-top: 1px; color: #0a7d2e; flex: none; }

  .jl-karte__int { margin-top: 2px; padding-top: 16px; border-top: 1px solid rgb(17 24 39 / 8%); }
  .jl-karte__int-titel { margin: 0 0 10px; font-family: var(--font-head); font-weight: 700; font-size: var(--fs-small); color: var(--ink, #111827); }
  .jl-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .jl-chip { padding: 5px 12px; border-radius: 999px; background: rgb(17 24 39 / 5%); border: 1px solid rgb(17 24 39 / 8%);
    font-weight: 600; font-size: var(--fs-small); color: var(--ink, #111827); }

  .jl-karte__link { margin-top: auto; align-self: start; display: inline-flex; align-items: center; gap: 7px;
    font-weight: 700; color: #111827; text-decoration: underline; text-decoration-color: #EFBF04; text-underline-offset: 4px; }
  .jl-karte__link:hover { text-decoration-color: #111827; }
</style>
