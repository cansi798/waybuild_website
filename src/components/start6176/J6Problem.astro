---
// 2. Problem-Section nach Jamils Konzept (Talk qh87y3sj #6176, 16.11.2026). Texte wörtlich aus src/config/start-6176.ts.
// Seit Jamil #6372–#6374 + #6377 (19.11.2026): neue Überschrift, vier Textblöcke (J_PROBLEM_NEU) ohne Mockups, je ein schlichtes,
// einfarbiges Linien-Icon (überfüllter Briefumschlag, verbogenes Puzzleteil, zwei kreuzende Pfeile, Lupe), viel Weißraum; ohne
// Subheadline und Abschlusszeile.
// Seit Jamil #6954–#6958 (22.11.2026): Weg Karte für Karte. Jede Karte hat zwei Seiten (Problem, webgold-Lösung aus J_MASS über J_PROBLEM_WEG).
// Am PC (≥ 900 × 700, ohne reduzierte Bewegung, mit JS) bleibt der Abschnitt stehen; pro Scroll-Schritt dreht genau EINE Karte (1 → 4),
// erst danach geht es weiter (gemeinsamer Kern scripts/buehne-kern.ts). Sonst (Handy, reduzierte Bewegung, ohne JS): Problem und Lösung
// je Karte untereinander. Beide Seiten bleiben immer im DOM und für Screenreader lesbar. Die Fassung #6198 (J_PROBLEM) bleibt über ALT_ZEIGEN.problem6198Alt abrufbar. Stil: start-6176.css (.jp-*).
import { hl } from '../../lib/hl';
import { J_PROBLEM as T, J_PROBLEM_NEU as N, J_PROBLEM_WEG as W } from '../../config/start-6176';
import ProblemIcon from './ProblemIcon.astro';
import { ALT_ZEIGEN } from '../../config/start-6176'; // doppelte Anker vermeiden, wenn der alte Abschnitt wieder an ist
---

<section class={`section sn jp${ALT_ZEIGEN.problem6198Alt ? '' : ' jp--neu'}`} id={ALT_ZEIGEN.problemAlt ? undefined : "problem"} aria-labelledby="jp-h">
  <div class="wrap">
    {ALT_ZEIGEN.problem6198Alt ? (
      <>
        <div class="sn-kopf jp__kopf">
          <h2 id="jp-h" class="sn-h2 sn-h2--klein">{T.titel}</h2>
          <p class="sn-lead">{T.unter}</p>
        </div>
        <ul class="jp-karten">
          {T.karten.map((k, i) => (
            <li class="jp-karte j6-ein">
              <span class="jp-karte__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="jp-karte__titel">{k.titel}</h3>
              <p class="jp-karte__text">{k.text}</p>
            </li>
          ))}
        </ul>
        <p class="jp__abschluss">{T.abschluss}</p>
      </>
    ) : (
      <>
        <div class="jp__fest" data-jp-buehne>
          <div class="sn-kopf jp__kopf">
            <h2 id="jp-h" class="sn-h2 sn-h2--klein"><Fragment set:html={hl(N.titel)} /></h2>
          </div>
          <ul class="jp-bloecke jp-bloecke--weg">
            {N.karten.map((k, i) => {
              const l = W.loesungen[i];
              return (
                <li class="jp-block jp-wandel j6-ein" data-jp-karte>
                  <div class="jp-dreh">
                  <div class="jp-seite jp-seite--problem" data-jp-vorne>
                    <span class="jp-kreis" aria-hidden="true"><ProblemIcon icon={k.icon} size={28} class="jp-block__ico" /></span>
                    <h3 class="jp-block__titel">{k.titel}</h3>
                    <p class="jp-block__text">{k.text}</p>
                  </div>
                  <div class="jp-seite jp-seite--loesung" data-jp-hinten>
                    {/* Jamil #7030: kein Haken-Kreis, kein Etikett mehr; dasselbe Symbol wie auf der Problemkarte */}
                    <span class="jp-kreis" aria-hidden="true"><ProblemIcon icon={k.icon} size={28} class="jp-block__ico" /></span>
                    <h3 class="jp-block__titel">{l.titel}</h3>{/* h3 statt h4 (Jamil #7006): nach dem Flip ist nur diese Seite sichtbar, axe heading-order */}
                    <p class="jp-block__text">{l.inhalt}</p>
                  </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </>
    )}
  </div>
</section>


<script>
  // Jamil #6954–#6958: Weg Karte für Karte über den gemeinsamen Bühnen-Kern. 5 Scroll-Stücke: 0 = alle Probleme, 1–4 = so viele Karten gelöst
  // (das letzte Stück hält den fertigen Zustand, dann scrollt die Seite weiter). Nur Klassen umschalten, Bewegung macht CSS (opacity/transform).
  import { erstelleBuehne } from '../../scripts/buehne-kern';
  const bereich = document.querySelector<HTMLElement>('section.jp--neu');
  const buehne = bereich?.querySelector<HTMLElement>('[data-jp-buehne]');
  const karten = buehne ? [...buehne.querySelectorAll<HTMLElement>('[data-jp-karte]')] : [];
  if (bereich && buehne && karten.length) {
    let stand = -1;
    const setze = (n: number) => {
      if (n === stand) return;
      stand = n;
      karten.forEach((k, i) => {
        const geloest = i < n;
        k.classList.toggle('ist-geloest', geloest);
        // Jamil #7006: nur die sichtbare Seite ist für Screenreader da (beide bleiben im DOM)
        k.querySelector('[data-jp-vorne]')?.setAttribute('aria-hidden', String(geloest));
        k.querySelector('[data-jp-hinten]')?.setAttribute('aria-hidden', String(!geloest));
      });
    };
    erstelleBuehne({
      bereich, buehne, schritte: karten, stuecke: karten.length + 1,
      klassen: { buehne: 'jp--weg', gleiten: 'jp--gleiten' },
      // Jamil #7000: 4 Spalten ab 1100 px; 2 × 2 nur als Bühne, wenn genug Höhe da ist (sonst normale Liste, nichts wird abgeschnitten)
      mqBuehne: '(min-width: 1100px) and (min-height: 700px), (min-width: 900px) and (min-height: 900px)',
      aufModus: () => { stand = -1; karten.forEach((k) => { k.classList.remove('ist-geloest'); k.querySelectorAll('[data-jp-vorne], [data-jp-hinten]').forEach((e) => e.removeAttribute('aria-hidden')); }); },
      aufStueck: (stueck) => setze(stueck),
    });
  }
</script>
