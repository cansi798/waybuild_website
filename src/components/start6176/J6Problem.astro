---
// 2. Problem-Section nach Jamils Konzept (Talk qh87y3sj #6176, 16.11.2026). Texte wörtlich aus src/config/start-6176.ts.
// Seit Jamil #6372–#6374 + #6377 (19.11.2026): neue Überschrift, vier Textblöcke (J_PROBLEM_NEU) ohne Mockups, je ein schlichtes,
// einfarbiges Linien-Icon (überfüllter Briefumschlag, verbogenes Puzzleteil, zwei kreuzende Pfeile, Lupe), viel Weißraum; ohne
// Subheadline und Abschlusszeile. Die Fassung #6198 (J_PROBLEM) bleibt über ALT_ZEIGEN.problem6198Alt abrufbar. Stil: start-6176.css (.jp-*).
import { J_PROBLEM as T, J_PROBLEM_NEU as N } from '../../config/start-6176';
import ProblemIcon from './ProblemIcon.astro';
import { ALT_ZEIGEN } from '../../config/start-6176'; // doppelte Anker vermeiden, wenn der alte Abschnitt wieder an ist
---

<section class={`section sn jp${ALT_ZEIGEN.problem6198Alt ? '' : ' jp--neu'}`} id={ALT_ZEIGEN.problemAlt ? undefined : "problem"} aria-labelledby="jp-h">
  <div class="wrap">
    {ALT_ZEIGEN.problem6198Alt ? (
      <>
        <div class="sn-kopf jp__kopf">
          <h2 id="jp-h" class="sn-h2 sn-h2--klein">{T.titel}</h2>
          <p class="sn-lead">{T.unter}</p>
        </div>
        <ul class="jp-karten">
          {T.karten.map((k, i) => (
            <li class="jp-karte j6-ein">
              <span class="jp-karte__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="jp-karte__titel">{k.titel}</h3>
              <p class="jp-karte__text">{k.text}</p>
            </li>
          ))}
        </ul>
        <p class="jp__abschluss">{T.abschluss}</p>
      </>
    ) : (
      <>
        <div class="sn-kopf jp__kopf">
          <h2 id="jp-h" class="sn-h2 sn-h2--klein">{N.titel}</h2>
        </div>
        <ul class="jp-bloecke">
          {N.karten.map((k) => (
            <li class="jp-block j6-ein">
              <ProblemIcon icon={k.icon} class="jp-block__ico" />
              <h3 class="jp-block__titel">{k.titel}</h3>
              <p class="jp-block__text">{k.text}</p>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

