---
// Linien-Icons der vier Schmerzpunkte (Jamil #6374): überfüllter Briefumschlag, verbogenes Puzzleteil, zwei kreuzende Pfeile, Lupe.
// Von J6Problem (Abschnitt „Wo Betriebe heute …“) und den Chips im Hero (#6916) gemeinsam genutzt; Farbe = currentColor (Gold per CSS).
const { icon, size = 44, class: klasse = '' } = Astro.props as { icon: string; size?: number; class?: string };
---
<svg class={klasse} viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">

                {icon === 'brief' && (<>
                  {/* überfüllter Briefumschlag: Umschlag + herausquellende Blätter */}
                  <path d="M15 21V9.5h14l4 4V21" /><path d="M29 9.5v4h4" /><path d="M19 15h7M19 18.5h9" />
                  <path d="M11.5 16.5 9 8.5l7.5-2" />
                  <rect x="6" y="21" width="36" height="21" rx="3" /><path d="m6.8 22.5 17.2 11 17.2-11" />
                </>)}
                {icon === 'puzzle' && (<>
                  {/* starre Schablone (gestrichelt) und ein Puzzleteil, das schief danebensitzt und nicht hineinpasst */}
                  <rect x="5" y="19" width="24" height="24" rx="3" stroke-dasharray="3 3.2" />
                  <path transform="translate(17 3) rotate(14 12 12) scale(1.15)" vector-effect="non-scaling-stroke" d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.706 1.087.706 1.704s-.235 1.233-.706 1.704l-1.611 1.611a.98.98 0 0 1-.837.276c-.47-.07-.802-.48-.968-.925a2.501 2.501 0 1 0-3.214 3.214c.446.166.855.497.925.968a.979.979 0 0 1-.276.837l-1.61 1.61a2.404 2.404 0 0 1-1.705.707 2.402 2.402 0 0 1-1.704-.706l-1.568-1.568a1.026 1.026 0 0 0-.877-.29c-.493.074-.84.504-1.02.968a2.5 2.5 0 1 1-3.237-3.237c.464-.18.894-.527.967-1.02a1.026 1.026 0 0 0-.289-.877l-1.568-1.568A2.402 2.402 0 0 1 1.998 12c0-.617.236-1.234.706-1.704L4.23 8.77c.24-.24.581-.353.917-.303.515.077.877.528 1.073 1.01a2.5 2.5 0 1 0 3.259-3.259c-.482-.196-.933-.558-1.01-1.073-.05-.336.062-.676.303-.917l1.525-1.525A2.402 2.402 0 0 1 12 1.998c.617 0 1.234.236 1.704.706l1.568 1.568c.23.23.556.338.877.29.493-.074.84-.504 1.02-.968a2.5 2.5 0 1 1 3.237 3.237c-.464.18-.894.527-.967 1.02Z" />
                </>)}
                {icon === 'pfeile' && (<>
                  {/* zwei kreuzende Pfeile: dieselben Daten hin und her */}
                  <path d="M7 34h8c6 0 10-20 18-20h8" /><path d="m36 9 5 5-5 5" />
                  <path d="M7 14h8c6 0 10 20 18 20h8" /><path d="m36 29 5 5-5 5" />
                </>)}
                {icon === 'lupe' && (<>
                  <circle cx="21" cy="21" r="12" /><path d="m30 30 11 11" /><path d="M16 18h10M16 23h6" />
                </>)}
              
</svg>
