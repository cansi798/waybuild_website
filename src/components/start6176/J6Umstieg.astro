---
import { hl } from '../../lib/hl';
import "../../styles/umstieg-6391.css";
// 5. „Keine Angst vor dem Umstieg – wir nehmen Ihr Team mit“ (Jamil, Talk qh87y3sj #6391, 19.11.2026). Texte wörtlich aus
// src/config/start-6176.ts (J_UMSTIEG).
// Seit Jamil #7152/#7156 (24.11.2026): als Dialog. Beim Scrollen erscheint je ein Einwand als Sprechblase (Kundenseite, links),
// danach die webgold-Antwort (rechts, dezent gold). Nach dem 4. Paar erscheinen kleine „?“-Blasen (Deko) und ein Abschluss-Satz
// mit dem Link zu den häufigen Fragen. Grundform (ohne JS / reduzierte Bewegung): alle Paare ruhig untereinander lesbar, ohne die
// „?“-Deko. Mobil: Blasen untereinander, abwechselnd eingerückt. Stil: styles/umstieg-6391.css.
import { J_UMSTIEG as T } from '../../config/start-6176';
import { href } from '../../lib/paths';
---

<section class="section sn ju" id="umstieg" aria-labelledby="ju-h">
  <div class="wrap">
    <div class="sn-kopf ju__kopf">
      <h2 id="ju-h" class="sn-h2 sn-h2--klein"><Fragment set:html={hl(T.titel)} /></h2>
      <p class="sn-lead">{T.unter}</p>
    </div>

    <div class="ju-chat" data-ju-chat>
      {T.karten.map((k) => (
        <Fragment>
          <p class="ju-blase ju-blase--kunde" data-ju-blase>{k.frage}</p>
          <div class="ju-blase ju-blase--web" data-ju-blase>
            <span class="ju-blase__marke" aria-hidden="true">webgold</span>
            <span class="ju-blase__text">{k.antwort}</span>
          </div>
        </Fragment>
      ))}

      {/* Nach dem 4. Paar (Jamil #7152/#7156): „?“-Blasen (Deko) + selbstbewusster Abschluss + Link zu den häufigen Fragen */}
      <div class="ju-schluss" data-ju-blase>
        <span class="ju-fragen" aria-hidden="true">
          {[0, 1, 2, 3, 4, 5, 6].map((i) => <span class="ju-fragen__blase" style={`--q:${i}`}>?</span>)}
        </span>
        <p class="ju-schluss__satz">Fragen gehören dazu. Antworten auch.</p>
        <p class="ju-mehr">{T.mehr} <a class="ju-mehr__link" href={href(T.mehrLink.pfad)}>{T.mehrLink.text}</a></p>
      </div>
    </div>
  </div>
</section>

<script>
  // Dialog beim Scrollen (Jamil #7152): je Blase einblenden, sobald sie ins Bild kommt (der Reihe nach). Nur mit Bewegung und
  // IntersectionObserver; ohne JS oder bei reduzierter Bewegung bleibt die Grundform (alles sichtbar, keine „?“-Deko) stehen.
  const chat = document.querySelector<HTMLElement>('[data-ju-chat]');
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)');
  if (chat && !ruhig.matches && 'IntersectionObserver' in window) {
    chat.classList.add('ju-chat--anim');
    const blasen = [...chat.querySelectorAll<HTMLElement>('[data-ju-blase]')];
    const io = new IntersectionObserver((eintraege) => {
      eintraege.forEach((e) => {
        if (e.isIntersecting || e.boundingClientRect.top < 0) { e.target.classList.add('ist-da'); io.unobserve(e.target); }
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -12% 0px' });
    blasen.forEach((b) => io.observe(b));
  }
</script>
