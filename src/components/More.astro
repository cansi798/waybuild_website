---
// "Mehr erfahren": kurzer sichtbarer Text, Details aufklappbar. Inhalt bleibt im HTML → Google liest alles.
interface Props {
  label?: string;
  dark?: boolean;
}
const { label = 'Mehr erfahren', dark = false } = Astro.props;
---

<details class:list={['more', { 'more--dark': dark }]}>
  <summary>{label}</summary>
  <div class="more__body"><slot /></div>
</details>

<style>
  .more { margin-top: 10px; }
  .more summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.88rem; font-weight: 650; color: var(--accent-ink); min-height: 32px;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::after { content: '+'; font-size: 1.1em; line-height: 1; transition: transform 0.2s ease; }
  .more[open] summary::after { transform: rotate(45deg); }
  .more summary:hover { text-decoration: underline; text-underline-offset: 3px; }
  .more__body { padding-top: 6px; color: var(--ink-soft); font-size: 0.95rem; }
  .more__body :global(p) { margin: 0 0 0.6em; }
  .more--dark summary { color: var(--accent); }
  .more--dark .more__body { color: #aab5c3; }
</style>
