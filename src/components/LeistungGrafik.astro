---
// Abstrakte Website-Grafik je Leistungstyp (kein Foto nötig): stilisiertes Browserfenster in Türkis.
interface Props { art: 'seite' | 'shop' | 'landing' | 'relaunch' | 'pflege' | 'software' | 'code' | 'cloud' | 'it' | 'analyse' | 'abo'; }
const { art } = Astro.props;

// Arten, die im Browserfenster (.lg__win mit Leiste) dargestellt werden; cloud/it/abo haben eigene Kompositionen.
const winArts: Props['art'][] = ['seite', 'shop', 'landing', 'relaunch', 'pflege', 'software', 'code', 'analyse'];

// code: Zeilen mit Einrückung und farbigen Segmenten [Farbe, Breite in %]
const codeLines: { in: number; segs: [number, number][] }[] = [
  { in: 0, segs: [[1, 18], [2, 30]] },
  { in: 1, segs: [[3, 14], [2, 22], [4, 16]] },
  { in: 2, segs: [[2, 26], [1, 20]] },
  { in: 2, segs: [[4, 12], [3, 34]] },
  { in: 1, segs: [[1, 10]] },
  { in: 1, segs: [[3, 16], [2, 28], [4, 10]] },
  { in: 2, segs: [[2, 40]] },
  { in: 0, segs: [[1, 8]] },
];

// analyse: Punkte in der 2×2-Matrix (x/y in %), einer hervorgehoben
const dots = [
  { x: 18, y: 30 }, { x: 30, y: 62 }, { x: 42, y: 20 }, { x: 62, y: 38 },
  { x: 24, y: 82 }, { x: 56, y: 66 }, { x: 84, y: 26 }, { x: 77, y: 76, hl: true },
];
---

<div class:list={['lg', `lg--${art}`]} aria-hidden="true">
  {winArts.includes(art) && (
  <div class:list={['lg__win', art === 'code' && 'lg__win--dark']}>
    <div class="lg__bar"><i></i><i></i><i></i></div>
    {art === 'seite' && <div class="lg__body"><div class="lg__nav"><b></b><s></s><s></s><s></s></div><div class="lg__hero"><div><u></u><u class="w60"></u><em></em></div><div class="lg__img"></div></div><div class="lg__cols"><s></s><s></s><s></s></div></div>}
    {art === 'shop' && <div class="lg__body"><div class="lg__nav"><b></b><s></s><em class="lg__cart"></em></div><div class="lg__grid">{[1,2,3,4,5,6].map(() => <div class="lg__prod"><div class="lg__img"></div><u class="w60"></u><em></em></div>)}</div></div>}
    {art === 'landing' && <div class="lg__body lg__body--center"><u class="w70 tall"></u><u class="w50"></u><em class="big"></em><div class="lg__cols"><s></s><s></s><s></s></div></div>}
    {art === 'relaunch' && <div class="lg__body lg__split"><div class="lg__old"><u></u><u></u><u class="w60"></u><s></s><s></s></div><div class="lg__arrow">→</div><div class="lg__new"><div class="lg__img"></div><u class="w60"></u><em></em></div></div>}
    {art === 'pflege' && <div class="lg__body"><div class="lg__nav"><b></b><s></s><s></s></div><div class="lg__rows"><div class="lg__row ok"><i></i><u class="w70"></u></div><div class="lg__row ok"><i></i><u class="w50"></u></div><div class="lg__row ok"><i></i><u class="w60"></u></div><div class="lg__row"><i class="spin"></i><u class="w40"></u></div></div></div>}
    {art === 'software' && (
      <div class="lg__app">
        <div class="lg__side"><b></b><s class="lg__on"></s><s></s><s></s><s></s></div>
        <div class="lg__main">
          <div class="lg__head"><u class="tall w40"></u><em></em></div>
          <div class="lg__chart">{[45, 70, 55, 92, 62, 80, 38].map((h) => <i style={`--h:${h}%`}></i>)}</div>
          <div class="lg__table">
            <div class="lg__tr lg__tr--h"><s></s><s></s><s></s></div>
            {[1, 2, 3].map((n) => <div class="lg__tr"><s></s><s></s><s class:list={[n === 2 && 'lg__ok']}></s></div>)}
          </div>
        </div>
      </div>
    )}
    {art === 'code' && (
      <div class="lg__code">
        {codeLines.map((l, idx) => (
          <div class="lg__ln" style={`--in:${l.in}`}>
            {l.segs.map(([c, w]) => <i class={`lg__c${c}`} style={`width:${w}%`}></i>)}
            {idx === codeLines.length - 1 && <b class="lg__cur"></b>}
          </div>
        ))}
        <span class="lg__badge">&lt;/&gt;</span>
      </div>
    )}
    {art === 'analyse' && (
      <div class="lg__body lg__ana">
        <div class="lg__head"><u class="tall w40"></u><span class="lg__legend"><i></i><i></i></span></div>
        <div class="lg__matrix">
          {dots.map((d) => <i class:list={['lg__dot', d.hl && 'lg__dot--hl']} style={`--x:${d.x}%;--y:${d.y}%`}></i>)}
        </div>
      </div>
    )}
  </div>
  )}

  {art === 'cloud' && (
    <>
      <div class="lg__cloud"><i class="lg__cbase"></i><span class="lg__sync"></span><span class="lg__drip"></span></div>
      <div class="lg__win">
        <div class="lg__bar"><i></i><i></i><i></i></div>
        <div class="lg__body">
          <div class="lg__nav"><b></b><span class="lg__state"><i></i><s></s></span></div>
          <div class="lg__files">
            <i class="lg__fold"></i><i class="lg__fold"></i><i class="lg__doc lg__ok"></i>
            <i class="lg__doc"></i><i class="lg__fold"></i><i class="lg__doc lg__ok"></i>
          </div>
        </div>
      </div>
    </>
  )}

  {art === 'it' && (
    <div class="lg__it">
      <div class="lg__rack">
        {[0, 1, 2, 3, 4].map((n) => <div class="lg__unit"><i class:list={[n === 1 && 'lg__led--pulse']}></i><i class:list={[n !== 3 && 'lg__led--on']}></i><s></s></div>)}
      </div>
      <div class="lg__mon">
        <div class="lg__screen">
          <u class="w50"></u>
          <div class="lg__stat"><i></i><s></s></div>
          <div class="lg__stat"><i></i><s class="lg__s2"></s></div>
          <div class="lg__stat"><i></i><s class="lg__s3"></s></div>
        </div>
        <span class="lg__neck"></span><span class="lg__foot"></span>
      </div>
    </div>
  )}

  {art === 'abo' && (
    <div class="lg__abo">
      <div class="lg__cal">
        <div class="lg__calhead"><span class="lg__rings"><i></i><i></i></span><u class="w50"></u></div>
        <div class="lg__days">{Array.from({ length: 14 }, (_, i) => <i class:list={[i < 9 && 'lg__d--done', i === 9 && 'lg__d--on']}></i>)}</div>
        <div class="lg__checks">
          {[70, 52, 62].map((w) => <div class="lg__chkrow"><i></i><s style={`width:${w}%`}></s></div>)}
        </div>
      </div>
      <span class="lg__cycle"><i></i></span>
    </div>
  )}
</div>

<style>
  .lg { position: absolute; inset: 0; display: grid; place-items: end center; padding: 18px 22px 0; background: linear-gradient(160deg, #e3f5f4, #cfeeec 60%, #bdeeec); }
  .lg--shop { background: linear-gradient(160deg, #d9f1ef, #a9dedb); }
  .lg--landing { background: linear-gradient(160deg, #e6f3f2, #b7e4e2); }
  .lg--relaunch { background: linear-gradient(160deg, #e9e9e9, #cfeeec); }
  .lg--pflege { background: linear-gradient(160deg, #d8efee, #bfe9e7); }
  .lg__win { width: 100%; max-width: 300px; height: 100%; background: var(--white); border-radius: 10px 10px 0 0; box-shadow: 0 10px 30px -10px rgb(0 79 76 / 35%); overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .lg__bar { display: flex; gap: 4px; padding: 7px 9px; border-bottom: 1px solid var(--line); background: #faf8f4; }
  .lg__bar i { width: 6px; height: 6px; border-radius: 50%; background: var(--line); }
  .lg__body { padding: 10px 12px; display: grid; gap: 9px; align-content: start; }
  .lg__body--center { justify-items: center; padding-top: 16px; }
  .lg__nav { display: flex; align-items: center; gap: 6px; }
  .lg__nav b { width: 30px; height: 7px; border-radius: 3px; background: var(--dark); margin-right: auto; }
  .lg__nav s, .lg__cols s { display: block; width: 16px; height: 4px; border-radius: 2px; background: var(--paper-2); }
  .lg__nav em, em { display: block; width: 26px; height: 9px; border-radius: 99px; background: var(--accent); }
  em.big { width: 44px; height: 12px; }
  .lg__cart { width: 12px !important; height: 9px !important; border-radius: 2px !important; }
  .lg__hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 8px; align-items: center; }
  .lg__hero > div:first-child { display: grid; gap: 5px; }
  u { display: block; height: 5px; border-radius: 3px; background: var(--paper-2); width: 100%; text-decoration: none; }
  u.tall { height: 8px; background: var(--dark); }
  .lg__hero u:first-child { height: 8px; background: var(--dark); }
  .w70 { width: 70%; } .w60 { width: 60%; } .w50 { width: 50%; } .w40 { width: 40%; }
  .lg__img { aspect-ratio: 4 / 3; border-radius: 6px; background: linear-gradient(160deg, #4fd1cb, #00a6a1 55%, #006b68); }
  .lg__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; width: 100%; }
  .lg__cols s { width: 100%; height: 22px; border-radius: 5px; }
  .lg__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .lg__prod { display: grid; gap: 3px; }
  .lg__prod .lg__img { aspect-ratio: 1; }
  .lg__prod em { width: 16px; height: 5px; }
  .lg__split { grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; }
  .lg__old { display: grid; gap: 5px; opacity: 0.55; filter: grayscale(1); }
  .lg__old s { display: block; height: 14px; border-radius: 3px; background: var(--paper-2); }
  .lg__arrow { font-weight: 800; color: var(--accent-ink); font-size: 1.1rem; }
  .lg__new { display: grid; gap: 5px; }
  .lg__rows { display: grid; gap: 7px; }
  .lg__row { display: flex; align-items: center; gap: 8px; }
  .lg__row i { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--line); flex: none; }
  .lg__row.ok i { background: var(--accent); border-color: var(--accent); }
  .lg__row i.spin { border-top-color: var(--accent); animation: spin 1.2s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ---------- Neue Arten (Software, Code, Cloud, IT, Analyse, Abo) ---------- */
  .lg--software, .lg--code, .lg--cloud, .lg--it, .lg--analyse, .lg--abo { container-type: size; }
  .lg--software { background: linear-gradient(160deg, #e3f5f4, #a9dedb); }
  .lg--code { background: linear-gradient(160deg, #d9f1ef, #a9dedb); }
  .lg--cloud { background: linear-gradient(180deg, #e3f5f4, #bdeeec); }
  .lg--it { background: linear-gradient(160deg, #d8efee, #a9dedb); }
  .lg--analyse { background: linear-gradient(160deg, #e6f3f2, #b7e4e2); }
  .lg--abo { background: linear-gradient(160deg, #d9f1ef, #bfe9e7); }

  .lg__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }

  /* Software: Business-Tool mit Seitenleiste, Diagramm, Tabelle */
  .lg__app { display: grid; grid-template-columns: 22% minmax(0, 1fr); min-height: 0; }
  .lg__side { display: flex; flex-direction: column; gap: 6px; padding: 9px 14%; background: var(--dark); }
  .lg__side b { display: block; width: 80%; height: 6px; margin-bottom: 4px; border-radius: 3px; background: #4fd1cb; }
  .lg__side s { display: block; height: 4px; border-radius: 2px; background: rgb(255 255 255 / 22%); }
  .lg__side s.lg__on { background: rgb(255 255 255 / 75%); }
  .lg__main { display: grid; grid-template-rows: auto minmax(14px, 1fr) auto; gap: 8px; padding: 9px 10px; min-width: 0; min-height: 0; }
  .lg__chart { display: flex; align-items: flex-end; gap: 5%; border-bottom: 1px solid var(--line); min-height: 0; }
  .lg__chart i { flex: 1; height: var(--h); border-radius: 2px 2px 0 0; background: linear-gradient(#4fd1cb, #00a6a1); }
  .lg__chart i:nth-child(4) { background: linear-gradient(#00a6a1, #006b68); }
  .lg__table { display: grid; gap: 4px; }
  .lg__tr { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 6px; padding-bottom: 4px; border-bottom: 1px solid var(--line); }
  .lg__tr:last-child { border-bottom: 0; }
  .lg__tr s { display: block; height: 4px; border-radius: 2px; background: var(--paper-2); }
  .lg__tr--h s { background: #bdeeec; }
  .lg__tr s.lg__ok { width: 70%; background: #4fd1cb; }

  /* Code: dunkler Editor mit farbigen Zeilen */
  .lg__win--dark { background: var(--dark); }
  .lg__win--dark .lg__bar { background: rgb(0 0 0 / 18%); border-bottom-color: rgb(255 255 255 / 8%); }
  .lg__win--dark .lg__bar i { background: rgb(255 255 255 / 22%); }
  .lg__code { position: relative; display: grid; gap: 6px; align-content: start; min-height: 0; padding: 10px 12px 10px 18px; background: linear-gradient(90deg, rgb(0 0 0 / 14%) 0 9px, transparent 9px); }
  .lg__ln { display: flex; align-items: center; gap: 4%; padding-left: calc(var(--in) * 8%); }
  .lg__ln i { flex: none; height: 4px; border-radius: 2px; }
  .lg__c1 { background: #4fd1cb; }
  .lg__c2 { background: rgb(189 238 236 / 55%); }
  .lg__c3 { background: #00a6a1; }
  .lg__c4 { background: var(--paper-2); opacity: 0.8; }
  .lg__cur { display: block; flex: none; width: 2px; height: 8px; background: #4fd1cb; animation: lg-blink 1.1s steps(1) infinite; }
  .lg__badge { position: absolute; right: 8%; bottom: 10%; padding: 0.35em 0.55em; border-radius: 6px; background: var(--accent); color: var(--white); font: 800 10px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: clamp(7px, 5cqw, 15px); letter-spacing: -0.02em; box-shadow: 0 6px 16px -6px rgb(0 0 0 / 45%); }
  @keyframes lg-blink { 50% { opacity: 0; } }

  /* Cloud: Wolke über Dateifenster mit Sync-Anzeige */
  .lg--cloud .lg__win { position: relative; z-index: 1; height: 64%; }
  .lg__cloud { position: absolute; top: 7%; left: 50%; z-index: 0; width: 34%; width: min(50cqw, 64cqh, 150px); aspect-ratio: 2 / 1; transform: translateX(-50%); filter: drop-shadow(0 8px 12px rgb(0 79 76 / 28%)); }
  .lg__cbase, .lg__cloud::before, .lg__cloud::after { position: absolute; border-radius: 999px; background: #00a6a1; }
  .lg__cbase { left: 0; right: 0; bottom: 0; height: 50%; }
  .lg__cloud::before { content: ''; left: 14%; bottom: 24%; width: 32%; aspect-ratio: 1; }
  .lg__cloud::after { content: ''; left: 40%; bottom: 10%; width: 44%; aspect-ratio: 1; }
  .lg__sync { position: absolute; z-index: 2; top: 28%; left: 37%; width: 26%; aspect-ratio: 1; box-sizing: border-box; border: 2px solid var(--white); border-left-color: transparent; border-right-color: transparent; border-radius: 50%; animation: spin 3s linear infinite; }
  .lg__drip { position: absolute; z-index: -1; top: 90%; left: calc(50% - 1px); width: 2px; height: 40cqh; background: repeating-linear-gradient(#00a6a1 0 4px, transparent 4px 8px); animation: lg-flow 0.9s linear infinite; }
  @keyframes lg-flow { to { background-position: 0 8px; } }
  .lg__state { display: flex; align-items: center; gap: 4px; }
  .lg__state i { width: 6px; height: 6px; border-radius: 50%; background: #4fd1cb; animation: lg-pulse 1.8s ease-out infinite; }
  .lg__files { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px 7px; padding-top: 3px; }
  .lg__fold, .lg__doc { position: relative; display: block; aspect-ratio: 4 / 3; }
  .lg__fold { border-radius: 2px 5px 5px 5px; background: linear-gradient(160deg, #4fd1cb, #00a6a1); }
  .lg__fold::before { content: ''; position: absolute; left: 0; bottom: 100%; width: 45%; height: 4px; border-radius: 3px 3px 0 0; background: #4fd1cb; }
  .lg__doc { box-sizing: border-box; border: 1px solid var(--line); border-radius: 4px; background: linear-gradient(225deg, #bdeeec 0 16%, transparent 16%), var(--white); }
  .lg__doc.lg__ok::after { content: ''; position: absolute; right: -3px; bottom: -3px; width: 30%; max-width: 10px; aspect-ratio: 1; border: 1.5px solid var(--white); border-radius: 50%; background: var(--accent); }

  /* IT: Server-Rack neben Monitor */
  .lg__it { display: grid; grid-template-columns: 34% minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); gap: 8%; align-items: end; width: 100%; max-width: 340px; height: 100%; padding-bottom: clamp(4px, 6cqh, 22px); box-sizing: border-box; }
  .lg__rack { display: grid; grid-template-rows: repeat(5, 1fr); gap: clamp(2px, 1.4cqh, 6px); height: 90%; padding: clamp(3px, 3cqh, 10px) 10%; box-sizing: border-box; border-radius: 7px; background: linear-gradient(160deg, #006b68, #004f4c); box-shadow: 0 10px 30px -10px rgb(0 79 76 / 45%); }
  .lg__unit { display: flex; align-items: center; gap: 8%; min-height: 0; padding: 0 10%; border-radius: 3px; background: rgb(255 255 255 / 9%); }
  .lg__unit i { flex: none; width: clamp(3px, 1.6cqw, 7px); aspect-ratio: 1; border-radius: 50%; background: rgb(255 255 255 / 28%); }
  .lg__unit i.lg__led--on { background: #4fd1cb; opacity: 0.75; }
  .lg__unit i.lg__led--pulse { background: #4fd1cb; animation: lg-pulse 1.8s ease-out infinite; }
  .lg__unit s { display: block; width: 34%; height: clamp(2px, 0.9cqh, 4px); margin-left: auto; border-radius: 2px; background: rgb(255 255 255 / 22%); }
  .lg__mon { display: grid; justify-items: center; }
  .lg__screen { display: grid; gap: clamp(2px, 2cqh, 8px); align-content: start; width: 100%; width: min(100%, 85cqh); aspect-ratio: 16 / 11; padding: 9%; box-sizing: border-box; overflow: hidden; border: clamp(2px, 1cqw, 5px) solid var(--dark); border-radius: 6px; background: var(--white); box-shadow: 0 10px 30px -10px rgb(0 79 76 / 35%); }
  .lg__screen u { height: clamp(3px, 1.8cqh, 7px); background: var(--dark); }
  .lg__stat { display: flex; align-items: center; gap: 6%; }
  .lg__stat i { flex: none; width: clamp(3px, 1.5cqw, 7px); aspect-ratio: 1; border-radius: 50%; background: #4fd1cb; }
  .lg__stat s { display: block; width: 70%; height: clamp(2px, 1cqh, 5px); border-radius: 2px; background: var(--paper-2); }
  .lg__stat s.lg__s2 { width: 52%; }
  .lg__stat s.lg__s3 { width: 62%; }
  .lg__neck { display: block; width: 12%; height: clamp(3px, 5cqh, 18px); background: #006b68; }
  .lg__foot { display: block; width: 44%; height: clamp(2px, 1.2cqh, 5px); border-radius: 3px 3px 0 0; background: var(--dark); }
  @keyframes lg-pulse {
    0% { box-shadow: 0 0 0 0 rgb(79 209 203 / 70%); opacity: 1; }
    60% { opacity: 0.7; }
    100% { box-shadow: 0 0 0 5px rgb(79 209 203 / 0%); opacity: 1; }
  }

  /* Analyse: 2×2-Positionierungsmatrix */
  .lg__ana { grid-template-rows: auto minmax(0, 1fr); align-content: stretch; min-height: 0; }
  .lg__legend { display: flex; gap: 4px; }
  .lg__legend i { width: 6px; height: 6px; border-radius: 50%; background: #4fd1cb; }
  .lg__legend i:first-child { background: var(--accent); }
  .lg__matrix {
    position: relative; min-height: 18px; margin: 0 4px 6px 2px;
    border-left: 2px solid var(--line); border-bottom: 2px solid var(--line);
    background:
      linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--line), var(--line)) 0 50% / 100% 1px no-repeat,
      linear-gradient(#cfeeec, #cfeeec) 100% 0 / 50% 50% no-repeat;
  }
  .lg__dot { position: absolute; left: var(--x); bottom: var(--y); width: clamp(4px, 2.2cqw, 10px); aspect-ratio: 1; border-radius: 50%; background: #4fd1cb; opacity: 0.6; transform: translate(-50%, 50%); }
  .lg__dot:nth-child(even) { background: #006b68; opacity: 0.35; }
  .lg__dot.lg__dot--hl { width: clamp(6px, 3.6cqw, 16px); background: var(--accent); opacity: 1; box-shadow: 0 0 0 2px var(--white); animation: lg-ring 2.4s ease-out infinite; }
  @keyframes lg-ring {
    0% { box-shadow: 0 0 0 2px var(--white), 0 0 0 2px rgb(0 166 161 / 45%); }
    100% { box-shadow: 0 0 0 2px var(--white), 0 0 0 8px rgb(0 166 161 / 0%); }
  }

  /* Abo: Kalenderkarte mit Zyklus-Pfeil und abgehakten Zeilen */
  .lg__abo { position: relative; width: 100%; max-width: 280px; height: 100%; }
  .lg__cal { display: grid; grid-template-rows: auto auto minmax(0, 1fr); height: 100%; overflow: hidden; border-radius: 10px 10px 0 0; background: var(--white); box-shadow: 0 10px 30px -10px rgb(0 79 76 / 35%); }
  .lg__calhead { display: flex; align-items: center; gap: 8px; padding: clamp(5px, 3cqh, 11px) 8%; background: linear-gradient(160deg, #00a6a1, #006b68); }
  .lg__calhead u { height: clamp(3px, 1.6cqh, 6px); background: rgb(255 255 255 / 70%); }
  .lg__rings { display: flex; gap: 4px; flex: none; }
  .lg__rings i { width: clamp(3px, 1.3cqw, 5px); height: clamp(5px, 3cqh, 10px); border-radius: 3px; background: rgb(255 255 255 / 85%); }
  .lg__days { display: grid; grid-template-columns: repeat(7, 1fr); gap: clamp(2px, 1.2cqw, 5px); padding: clamp(4px, 3cqh, 10px) 8% clamp(2px, 1.5cqh, 6px); }
  .lg__days i { aspect-ratio: 1.4; border-radius: 2px; background: var(--paper-2); }
  .lg__days i.lg__d--done { background: #cfeeec; }
  .lg__days i.lg__d--on { background: var(--accent); }
  .lg__checks { display: grid; gap: clamp(3px, 2.4cqh, 8px); align-content: start; padding: clamp(3px, 2cqh, 8px) 8%; }
  .lg__chkrow { display: flex; align-items: center; gap: 7%; }
  .lg__chkrow i { position: relative; flex: none; width: clamp(6px, 3.4cqw, 14px); aspect-ratio: 1; border-radius: 50%; background: var(--accent); }
