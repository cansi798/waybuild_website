---
// Vollbild-Hero nach Bauwelt-Muster: Eyebrow, Headline mit rotierendem Begriff (CSS-Wortwalze),
// Statement + Unterzeile, Trust-Häkchen, zwei CTAs. Statt Foto: dunkler Türkis-Verlauf + Website-Mockup.
import { href } from '../lib/paths';
import { HERO } from '../config/home';
import Icon from './Icon.astro';

const WORTE = HERO.begriffe;
const WALZE = [...WORTE, WORTE[0]];
---

<section class="fhero">
  <div class="fhero__bg" aria-hidden="true"></div>
  <div class="wrap fhero__grid">
    <div class="fhero__content">
      <span class="eyebrow fhero__in" style="--d: 0ms">{HERO.eyebrow}</span>
      <h1 class="fhero__in" style="--d: 120ms">
        <span class="sr-only">{HERO.vor} {WORTE[0]}</span>
        <span aria-hidden="true">
          {HERO.vor}
          <span class="fhero__walze">
            <span class="fhero__band" style={`--n: ${WORTE.length}`}>
              {WALZE.map((w) => <span class="fhero__wort">{w}</span>)}
            </span>
          </span>
        </span>
      </h1>
      <div class="fhero__claim fhero__in" style="--d: 220ms">
        <p class="fhero__statement">{HERO.statement}</p>
        <p class="fhero__unterzeile">{HERO.unterzeile}</p>
      </div>
      <ul class="check-row fhero__checks fhero__in" style="--d: 300ms">
        {HERO.checks.map((c) => <li><Icon name="check" size={18} /> {c}</li>)}
      </ul>
      <div class="fhero__actions fhero__in nur-desktop" style="--d: 380ms">
        <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Kostenloses Erstgespräch</a>
        <a class="btn btn--lg fhero__ghost" href={href('/preise/')}>Tarife ansehen</a>
      </div>
    </div>

    <div class="fhero__visual fhero__in" style="--d: 300ms" aria-hidden="true">
      <div class="mock">
        <div class="mock__bar"><i></i><i></i><i></i><span>🔒 ihre-firma.de</span></div>
        <div class="mock__body">
          <div class="mock__nav"><b></b><span></span><span></span><span></span><em></em></div>
          <div class="mock__hero">
            <div>
              <div class="mock__line mock__line--lg"></div>
              <div class="mock__line mock__line--lg mock__line--short"></div>
              <div class="mock__line"></div>
              <div class="mock__line mock__line--sm"></div>
              <div class="mock__btn"></div>
            </div>
            <div class="mock__img"></div>
          </div>
          <div class="mock__blocks"><span></span><span></span><span></span></div>
        </div>
      </div>
      <div class="score">
        <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.5" /><circle class="score__ring" cx="18" cy="18" r="15.5" /></svg>
        <div><b>100</b><small>PageSpeed mobil</small></div>
      </div>
      <div class="toast">
        <span class="toast__icon"><Icon name="mail" size={18} /></span>
        <span><b>Neue Anfrage</b><small>an info@ihre-firma.de</small></span>
      </div>
    </div>
  </div>
  <a class="fhero__scroll" href="#weiter" aria-label="Nach unten scrollen"><Icon name="chevron" size={26} /></a>
</section>

<style>
  .fhero {
    position: relative; min-height: calc(100svh - var(--header-h)); display: flex; align-items: center; overflow: hidden;
    background: var(--dark); color: var(--white);
  }
  .fhero__bg { position: absolute; inset: 0; }
  .fhero__bg::before {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 85% 15%, rgb(0 166 161 / 55%), transparent 55%),
      radial-gradient(ellipse at 10% 90%, rgb(0 107 104 / 70%), transparent 55%),
      linear-gradient(160deg, #003e3b, var(--dark) 50%, #00605c);
    animation: drift 24s ease-in-out infinite alternate;
  }
  .fhero__bg::after {
    content: ''; position: absolute; inset: 0; opacity: 0.5;
    background-image: linear-gradient(rgb(255 255 255 / 6%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 6%) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 70% 50%, #000 10%, transparent 70%);
  }
  @keyframes drift { from { transform: scale(1) translateX(0); } to { transform: scale(1.06) translateX(-1.5%); } }

  .fhero__grid { position: relative; display: grid; gap: 40px; align-items: center; padding-block: 72px 110px; }
  @media (min-width: 960px) { .fhero__grid { grid-template-columns: 1.15fr 0.85fr; padding-block: 80px 120px; } }
  .fhero__content { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; justify-items: start; }
  .fhero__content > * { max-width: 100%; min-width: 0; }
  .fhero__content h1 { margin: 0; color: var(--white); font-size: clamp(2.2rem, 5.6vw, 3.9rem); }
  .fhero__content .eyebrow { margin: 0; color: var(--accent); }
  .fhero__claim { display: grid; gap: 8px; max-width: 620px; }
  .fhero__statement { margin: 0; font-family: var(--font-head); font-weight: 650; font-size: clamp(1.25rem, 2.4vw, 1.7rem); line-height: 1.25; }
  .fhero__unterzeile { margin: 0; font-size: 1.02rem; line-height: 1.55; color: var(--dark-lead); }
  .fhero__checks { margin-top: 2px; }
  .fhero__checks :global(.icon) { color: var(--accent); }
  .fhero__actions { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 12px; }
  .fhero__ghost { background: transparent; border-color: rgb(255 255 255 / 55%); color: var(--white); }
  .fhero__ghost:hover { background: rgb(255 255 255 / 12%); border-color: var(--white); }

  /* Wortwalze */
  .fhero__walze { display: block; height: 1.15em; overflow: hidden; }
  .fhero__band { display: flex; flex-direction: column; animation: walze calc(var(--n) * 3s) cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite; }
  .fhero__wort { display: block; height: 1.15em; line-height: 1.15; white-space: nowrap; color: var(--accent); }
  /* 4 Begriffe: Schritte bei 25/50/75 %, letzter Frame = erster */
  @keyframes walze {
    0%, 22% { transform: translateY(0); }
    25%, 47% { transform: translateY(-1.15em); }
    50%, 72% { transform: translateY(-2.3em); }
    75%, 97% { transform: translateY(-3.45em); }
    100% { transform: translateY(-4.6em); }
  }
  @media (prefers-reduced-motion: reduce) { .fhero__band { transform: none; } }

  .fhero__scroll {
    position: absolute; left: 50%; bottom: 18px; width: 48px; height: 48px;
    display: inline-flex; align-items: center; justify-content: center; color: var(--white); border-radius: 50%;
    animation: nudge 2.2s ease-in-out infinite;
  }
  @keyframes nudge { 0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.9; } 50% { transform: translateX(-50%) translateY(8px); opacity: 0.5; } }
  .fhero__in { animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: var(--d, 0ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }

  /* Mockup rechts (ab Tablet) */
  .fhero__visual { position: relative; max-width: 520px; width: 100%; margin-inline: auto; padding: 28px 0 36px; }
  @media (max-width: 699px) { .fhero__visual { display: none; } }
  .mock {
    background: var(--white); color: var(--ink); border-radius: 18px; overflow: hidden;
    box-shadow: 0 2px 4px rgb(0 0 0 / 10%), 0 40px 80px -24px rgb(0 0 0 / 55%);
    transform: perspective(1400px) rotateY(-6deg) rotateX(2deg);
  }
  @media (max-width: 959px) { .mock { transform: none; } }
  .mock__bar { display: flex; align-items: center; gap: 6px; padding: 11px 14px; border-bottom: 1px solid var(--line); background: #faf8f4; }
  .mock__bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .mock__bar span { margin-left: 10px; font-size: 0.74rem; color: var(--ink-soft); background: var(--paper-2); padding: 3px 12px; border-radius: 99px; }
  .mock__body { padding: 18px 20px 22px; display: grid; gap: 18px; }
  .mock__nav { display: flex; align-items: center; gap: 10px; }
  .mock__nav b { width: 54px; height: 12px; border-radius: 4px; background: var(--dark); margin-right: auto; }
  .mock__nav span { width: 30px; height: 7px; border-radius: 4px; background: var(--paper-2); }
  .mock__nav em { width: 46px; height: 18px; border-radius: 99px; background: var(--accent); }
  .mock__hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; align-items: center; }
  .mock__line { height: 8px; border-radius: 4px; background: var(--paper-2); margin-bottom: 8px; width: 90%; }
  .mock__line--lg { height: 16px; background: var(--dark); width: 100%; }
  .mock__line--short { width: 60%; margin-bottom: 14px; }
  .mock__line--sm { width: 60%; }
  .mock__btn { margin-top: 12px; width: 70px; height: 20px; border-radius: 99px; background: var(--accent); }
  .mock__img { aspect-ratio: 4 / 3.4; border-radius: 12px; background: radial-gradient(circle at 70% 30%, #bdeeec 0 18%, transparent 19%), linear-gradient(160deg, #4fd1cb, #00a6a1 55%, #006b68); }
  .mock__blocks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .mock__blocks span { height: 54px; border-radius: 10px; background: var(--paper-2); }
  .score {
    position: absolute; right: -14px; top: 0; display: flex; align-items: center; gap: 10px;
    background: var(--white); color: var(--ink); padding: 10px 16px 10px 10px; border-radius: 16px; box-shadow: 0 18px 40px -12px rgb(0 0 0 / 45%);
  }
  .score svg { width: 46px; height: 46px; transform: rotate(-90deg); }
  .score circle { fill: none; stroke: var(--paper-2); stroke-width: 3.5; }
  .score .score__ring { stroke: var(--accent); stroke-dasharray: 97.4; stroke-dashoffset: 97.4; stroke-linecap: round; animation: ring 1.4s 0.6s cubic-bezier(.2,.7,.2,1) forwards; }
  .score b { display: block; font-family: var(--font-head); font-size: 1.4rem; line-height: 1; }
  .score small { font-size: 0.7rem; color: var(--ink-soft); }
  @keyframes ring { to { stroke-dashoffset: 0; } }
  .toast {
    position: absolute; left: -22px; bottom: 50px; display: flex; align-items: center; gap: 10px;
    background: var(--white); color: var(--ink); border-radius: 14px; padding: 10px 14px 10px 10px; box-shadow: 0 18px 40px -14px rgb(0 0 0 / 45%);
    animation: pop 0.6s 1.4s cubic-bezier(.2,.9,.3,1.3) both;
  }
  .toast__icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: rgb(0 166 161 / 14%); color: var(--accent-ink); }
  .toast b { display: block; font-size: 0.86rem; }
  .toast small { font-size: 0.74rem; color: var(--ink-soft); }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(0.96); } }

  @media (max-width: 767px) {
    .fhero__grid { padding-block: 40px 80px; }
    .fhero__content { gap: 14px; }
    .fhero__statement { max-width: 20ch; }
    .fhero__unterzeile { font-size: 0.95rem; }
  }
</style>
