---
// Zahlen-Band unter dem Hero (Bauwelt-Muster „Trust-Band“) – Zähl-Animation beim Sichtbarwerden.
import { STATS } from '../config/home';
---

<div class="stats" id="weiter">
  <ul class="wrap stats__list">
    {STATS.map((s) => (
      <li class="stat">
        <b><span class="stat__n" data-count={s.value}>{s.value}</span>{s.suffix}</b>
        <span>{s.label}</span>
      </li>
    ))}
  </ul>
</div>

<script>
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('.stat__n');
  if (!ruhig && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const ziel = Number(el.dataset.count);
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / 1200);
          el.textContent = String(Math.round(ziel * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.5 });
    nums.forEach((n) => { n.textContent = '0'; io.observe(n); });
  }
</script>

<style>
  .stats { background: var(--white); border-bottom: 1px solid var(--line); scroll-margin-top: var(--header-h); }
  .stats__list { list-style: none; margin: 0 auto; padding: 22px 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 24px; }
  @media (min-width: 800px) { .stats__list { grid-template-columns: repeat(4, 1fr); padding-block: 28px; } }
  .stat { display: grid; gap: 2px; text-align: center; }
  .stat b { font-family: var(--font-head); font-size: clamp(1.6rem, 3.4vw, 2.4rem); font-weight: 750; line-height: 1; color: var(--accent-ink); letter-spacing: -0.02em; }
  .stat > span { font-size: 0.88rem; color: var(--ink-soft); }
  .stat b .stat__n { font: inherit; }
  @media (min-width: 800px) { .stat:not(:first-child) { border-left: 1px solid var(--line); } }
</style>
